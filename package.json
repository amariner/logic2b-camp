{
  "name": "logic-camp",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "turbo run typecheck lint test build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "build": "turbo run build",
    "format": "prettier --write .",
    "db:reset": "rm -rf tenants/demo/.wrangler/state && wrangler d1 migrations apply logic-camp-demo --local --config tenants/demo/wrangler.jsonc",
    "db:seed": "pnpm --filter @tenant/demo seed:sql && wrangler d1 execute logic-camp-demo --local --config tenants/demo/wrangler.jsonc --file tenants/demo/seed.sql -y",
    "db:seed:remote": "pnpm --filter @tenant/demo seed:remote",
    "e2e": "pnpm --filter @logic-camp/web e2e",
    "fotos": "node apps/web/scripts/foto-pipeline.mjs",
    "new:camping": "pnpm --filter @logic-camp/cli run new:camping --",
    "onboarding:rehearse": "pnpm --filter @logic-camp/cli run onboarding:rehearse --",
    "export:tenant": "pnpm --filter @logic-camp/cli run export:tenant",
    "backup:rehearse": "pnpm --filter @logic-camp/cli run backup:rehearse"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "eslint": "^9.31.0",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.36.0",
    "wrangler": "^4.24.0"
  }
}
