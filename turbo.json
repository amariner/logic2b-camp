{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["FFMPEG_PATH", "FFPROBE_PATH", "DYLD_LIBRARY_PATH"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["dist/**", ".astro/**"]
    }
  }
}
