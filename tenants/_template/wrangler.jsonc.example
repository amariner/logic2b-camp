// Plantilla — sustituir {slug} y database_id reales (se genera con `pnpm new:camping`, Fase 9)
{
  "$schema": "../../apps/api/node_modules/wrangler/config-schema.json",
  "name": "logic-camp-{slug}",
  "main": "../../apps/api/src/index.ts",
  "compatibility_date": "2026-07-01",
  "vars": { "TENANT_SLUG": "{slug}" },
  "d1_databases": [
    { "binding": "DB", "database_name": "logic-camp-{slug}", "database_id": "REPLACE_ME" }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "logic-camp-media" }],
  "kv_namespaces": [{ "binding": "CONFIG", "id": "REPLACE_ME" }]
}
