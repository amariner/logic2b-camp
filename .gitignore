# Másteres fotográficos de producción: se conservan localmente; Git publica
# solo los derivados WebP/AVIF/JPG que consume el tenant.
tenants/*/content/media/*-source.*
tenants/*/content/media/.staging/
tenants/*/content/media/.rejected/
tenants/*/content/media/.motion-staging/
tenants/*/content/media/.motion-rejected/

# Playwright (E2E)
test-results/
playwright-report/

# Volcados de bases de tenant (ADR 0026 §4). CONTIENEN DATOS PERSONALES:
# nombres, documentos de identidad y contacto de huéspedes reales. No se
# commitean jamás — se entregan al camping y se borran.
exports/

# Builds de verificación del escaparate (apps/web/scripts/check-portfolio.mjs)
dist-portfolio/
dist-capture/

# Másteres, respuestas del proveedor y QA local de la primera cabecera con vídeo.
output/olivar-motion/
/output/olivar-360/

# Originales de generación, capturas, logs y previsualizaciones locales.
/output/mardefondo/
/output/pinadamar/
