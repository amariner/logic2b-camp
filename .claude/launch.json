{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "mkdir -p apps/web/dist && pnpm exec wrangler dev --config tenants/demo/wrangler.jsonc --persist-to .wrangler-demo --port 8787"
      ],
      "port": 8787
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@logic-camp/web", "dev", "--", "--port", "4321"],
      "port": 4321
    },
    {
      "name": "site",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@logic-camp/site", "exec", "astro", "dev", "--port", "4330"],
      "port": 4330
    }
  ]
}
