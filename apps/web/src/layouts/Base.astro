---
import { config, getContent, localePath, media } from '../lib/content';
import '../styles/global.css';

interface Props {
  locale: string;
  /** ruta sin prefijo de idioma, para hreflang y el selector */
  path?: string;
  /** SEO por página; sin ellos se usa el de la home */
  title?: string;
  description?: string;
  /** páginas de proceso (funnel, resguardo): fuera de los buscadores */
  noindex?: boolean;
}

const { locale, path = '/', title, description, noindex = false } = Astro.props;
const c = getContent(locale);
const pageTitle = title ?? c.seo.title;
const pageDescription = description ?? c.seo.description;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['Campground', 'LodgingBusiness'],
  name: config.name,
  url: config.domain,
  telephone: config.contact.phone,
  email: config.contact.email,
  address: { '@type': 'PostalAddress', streetAddress: config.contact.address },
};

const navLinks = [
  ['/alojamientos', c.nav.alojamientos],
  ['/instalaciones', c.nav.instalaciones],
  ['/entorno', c.nav.entorno],
  ['/tarifas', c.nav.tarifas],
  ['/blog', c.nav.blog],
  ['/contacto', c.nav.contacto],
] as const;

// temas de demo (ADR 0009): sin flag en config, nada de esto llega al HTML
const demoThemes = config.demoThemes ?? [];
const defaultTheme = demoThemes[0];

// aplica el tema ANTES del primer paint (anti-FOUC). ?tema=x en la URL
// gana y se persiste: el comercial envía enlaces con el tema puesto.
const themeBootScript = `try{
var v=${JSON.stringify(demoThemes)};
var p=new URLSearchParams(location.search).get('tema');
if(p&&v.indexOf(p)>-1){if(p===v[0]){localStorage.removeItem('lc-theme')}else{localStorage.setItem('lc-theme',p)}}
var t=localStorage.getItem('lc-theme');
if(t&&v.indexOf(t)>-1)document.documentElement.dataset.theme=t;
}catch(e){}`;

// interacción del selector: cambia el atributo, persiste y marca el activo
const themeMenuScript = `
(function () {
  var menu = document.getElementById('lc-tema');
  if (!menu) return;
  var def = menu.dataset.default;
  var botones = menu.querySelectorAll('button[data-tema]');
  function marcar(t) {
    botones.forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.tema === t)); });
  }
  botones.forEach(function (b) {
    b.addEventListener('click', function () {
      var t = b.dataset.tema;
      if (t === def) {
        delete document.documentElement.dataset.theme;
        try { localStorage.removeItem('lc-theme'); } catch (e) {}
      } else {
        document.documentElement.dataset.theme = t;
        try { localStorage.setItem('lc-theme', t); } catch (e) {}
      }
      marcar(t);
      menu.removeAttribute('open');
    });
  });
  marcar(document.documentElement.dataset.theme || def);
})();
`;

// conmutador de nivel de demo (ADR 0013): mismo patrón que el de temas —
// anti-FOUC en <head> vía atributo en <html>, CSS puro decide qué héroe se ve
const showTierSwitch = config.demoTierSwitch === true;
const tierBootScript = `try{
var n=localStorage.getItem('lc-nivel');
if(n==='1')document.documentElement.dataset.nivel='1';
}catch(e){}`;

const tierMenuScript = `
(function () {
  var menu = document.getElementById('lc-nivel');
  if (!menu) return;
  var botones = menu.querySelectorAll('button[data-nivel]');
  function marcar(n) {
    botones.forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.nivel === n)); });
  }
  botones.forEach(function (b) {
    b.addEventListener('click', function () {
      var n = b.dataset.nivel;
      if (n === '3') {
        delete document.documentElement.dataset.nivel;
        try { localStorage.removeItem('lc-nivel'); } catch (e) {}
      } else {
        document.documentElement.dataset.nivel = n;
        try { localStorage.setItem('lc-nivel', n); } catch (e) {}
      }
      marcar(n);
      menu.removeAttribute('open');
    });
  });
  marcar(document.documentElement.dataset.nivel || '3');
})();
`;
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {(noindex || import.meta.env.BASE_URL !== '/') && <meta name="robots" content="noindex" />}
    <link rel="preload" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/fonts/ClashDisplay-Variable.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/fonts/InterVariable.woff2`} as="font" type="font/woff2" crossorigin />
    {media['favicon'] && <link rel="icon" type="image/svg+xml" href={media['favicon']} />}
    {media['apple-touch-icon'] && <link rel="apple-touch-icon" href={media['apple-touch-icon']} />}
    {config.locales.map((l) => (
      <link rel="alternate" hreflang={l} href={`${config.domain}${localePath(l, path)}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${config.domain}${localePath(config.defaultLocale, path)}`} />
    <link rel="canonical" href={`${config.domain}${localePath(locale, path)}`} />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/sitemap.xml`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={config.name} />
    <meta property="og:locale" content={locale} />
    {media['og'] && <meta property="og:image" content={`${config.domain}${media['og']}`} />}
    {media['og'] && <meta name="twitter:card" content="summary_large_image" />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {demoThemes.length > 0 && <script is:inline set:html={themeBootScript} />}
    {showTierSwitch && <script is:inline set:html={tierBootScript} />}
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-hueso text-tinta antialiased" data-demo-banner={config.isDemo && c.demo ? '' : undefined}>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-100 focus:rounded-(--lc-radius) focus:bg-pino focus:px-4 focus:py-2 focus:text-hueso"
    >
      {c.nav.menu} ↓
    </a>
    {/* header (+ banner de demo, ADR 0013): un único bloque fijo — el banner
       empuja el nav, no lo solapa, sea cual sea su altura (i18n varía) */}
    <div class="fixed inset-x-0 top-0 z-50">
      {config.isDemo && c.demo && (
        <p class="bg-pino px-4 py-1.5 text-center text-[12px] leading-snug text-hueso">
          {c.demo.banner}
        </p>
      )}
      <header class="bg-hueso/90 backdrop-blur-sm">
      <nav class="mx-auto flex h-14 max-w-7xl items-center justify-between gap-4 px-5 md:px-8">
        <a href={localePath(locale)} class="font-display text-[15px] font-semibold tracking-[0.14em] uppercase">
          {config.name.replace('Camping ', '')}
        </a>

        <div class="flex items-center gap-5">
          {/* nav completa en pantallas grandes */}
          <div class="hidden items-center gap-5 text-[13px] font-medium text-tinta-suave lg:flex">
            {navLinks.map(([href, label]) => (
              <a href={localePath(locale, href)} class="transition-colors hover:text-tinta">{label}</a>
            ))}
          </div>

          {/* selector de idioma: nativo, accesible, sin JS */}
          <details class="lc-menu relative">
            <summary
              class="flex cursor-pointer items-center gap-1 text-[13px] font-medium text-tinta uppercase"
              aria-label={c.nav.idioma}
            >
              {locale}<span aria-hidden="true" class="text-[10px] text-tinta-suave">▾</span>
            </summary>
            <ul class="absolute right-0 top-full z-50 mt-2 min-w-28 rounded-(--lc-radius) border border-arena/70 bg-hueso py-1 shadow-lg">
              {config.locales.map((l) => (
                <li>
                  <a
                    href={localePath(l, path)}
                    class:list={[
                      'block px-4 py-1.5 text-[13px] uppercase transition-colors hover:bg-arena-suave',
                      l === locale ? 'font-semibold text-tinta' : 'text-tinta-suave',
                    ]}
                    aria-current={l === locale ? 'true' : undefined}
                  >
                    {l}
                  </a>
                </li>
              ))}
            </ul>
          </details>

          {/* selector de temas de demo (ADR 0009): solo con config.demoThemes */}
          {demoThemes.length > 0 && (
            <details class="lc-menu relative" id="lc-tema" data-default={defaultTheme}>
              <summary
                class="flex cursor-pointer items-center gap-1.5 text-[13px] font-medium text-tinta"
                aria-label={c.nav.tema}
              >
                <span class="lc-swatch" aria-hidden="true" />
                <span class="hidden sm:inline">{c.nav.tema}</span>
                <span aria-hidden="true" class="text-[10px] text-tinta-suave">▾</span>
              </summary>
              <ul class="absolute right-0 top-full z-50 mt-2 min-w-36 rounded-(--lc-radius) border border-arena/70 bg-hueso py-1 shadow-lg">
                {demoThemes.map((tema) => (
                  <li>
                    <button
                      type="button"
                      data-tema={tema}
                      aria-pressed={tema === defaultTheme ? 'true' : 'false'}
                      class="flex w-full items-center gap-2.5 px-4 py-1.5 text-left text-[13px] text-tinta-suave transition-colors aria-pressed:font-semibold aria-pressed:text-tinta hover:bg-arena-suave"
                    >
                      <span class="lc-swatch" data-swatch={tema} aria-hidden="true" />
                      {c.temas?.[tema] ?? tema}
                    </button>
                  </li>
                ))}
              </ul>
            </details>
          )}

          {/* conmutador de nivel de demo (ADR 0013): solo con config.demoTierSwitch — atrezzo
             comercial, no un segundo build (el motor sigue en el bundle debajo) */}
          {showTierSwitch && c.demo && (
            <details class="lc-menu relative" id="lc-nivel">
              <summary
                class="flex cursor-pointer items-center gap-1.5 text-[13px] font-medium text-tinta"
                aria-label={c.demo.nivel}
              >
                <span class="hidden sm:inline">{c.demo.nivel}</span>
                <span aria-hidden="true" class="text-[10px] text-tinta-suave">▾</span>
              </summary>
              <ul class="absolute right-0 top-full z-50 mt-2 min-w-36 rounded-(--lc-radius) border border-arena/70 bg-hueso py-1 shadow-lg">
                <li>
                  <button
                    type="button"
                    data-nivel="3"
                    aria-pressed="true"
                    class="block w-full px-4 py-1.5 text-left text-[13px] text-tinta-suave transition-colors aria-pressed:font-semibold aria-pressed:text-tinta hover:bg-arena-suave"
                  >
                    {c.demo.nivel3}
                  </button>
                </li>
                <li>
                  <button
                    type="button"
                    data-nivel="1"
                    aria-pressed="false"
                    class="block w-full px-4 py-1.5 text-left text-[13px] text-tinta-suave transition-colors aria-pressed:font-semibold aria-pressed:text-tinta hover:bg-arena-suave"
                  >
                    {c.demo.nivel1}
                  </button>
                </li>
              </ul>
            </details>
          )}

          {/* menú móvil */}
          <details class="lc-menu relative lg:hidden">
            <summary class="cursor-pointer text-[13px] font-medium text-tinta">{c.nav.menu}</summary>
            <ul class="absolute right-0 top-full z-50 mt-2 min-w-48 rounded-(--lc-radius) border border-arena/70 bg-hueso py-1 shadow-lg">
              {navLinks.map(([href, label]) => (
                <li>
                  <a
                    href={localePath(locale, href)}
                    class="block px-4 py-2 text-[14px] text-tinta-suave transition-colors hover:bg-arena-suave hover:text-tinta"
                  >
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </div>
      </nav>
      </header>
    </div>

    <main id="contenido">
      <slot />
    </main>

    <footer class="border-t border-arena/60">
      <div class="mx-auto flex max-w-7xl flex-col gap-6 px-5 py-10 md:px-8">
        <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
          <p class="max-w-xs">
            <span class="font-display text-[14px] font-semibold tracking-[0.14em] uppercase">{config.name}</span>
            <span class="mt-1 block text-[13px] text-tinta-suave">{c.footer.aviso}</span>
          </p>
          <nav class="grid grid-cols-2 gap-x-10 gap-y-1.5 text-[13px] text-tinta-suave sm:grid-cols-3">
            {navLinks.map(([href, label]) => (
              <a href={localePath(locale, href)} class="transition-colors hover:text-tinta">{label}</a>
            ))}
          </nav>
        </div>
        <p class="tnum text-[13px] text-tinta-suave">
          {config.contact.address} · {config.contact.phone} · {config.contact.email}
        </p>
      </div>
    </footer>

    {demoThemes.length > 0 && <script is:inline set:html={themeMenuScript} />}
    {showTierSwitch && <script is:inline set:html={tierMenuScript} />}
  </body>
</html>
