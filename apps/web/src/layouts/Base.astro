---
import { config, data, demoTierSwitch, getContent, localePath, media } from '../lib/content';
import { getLegalUi } from '../lib/legal';
import LogoMark from '../components/LogoMark.astro';
import '../styles/global.css';

interface Props {
  locale: string;
  /** ruta sin prefijo de idioma, para hreflang y el selector */
  path?: string;
  /** SEO por página; sin ellos se usa el de la home */
  title?: string;
  description?: string;
  /** páginas de proceso (funnel, resguardo): fuera de los buscadores */
  noindex?: boolean;
}

const { locale, path = '/', title, description, noindex = false } = Astro.props;
const OG_LOCALE: Record<string, string> = {
  es: 'es_ES', ca: 'ca_ES', en: 'en_GB', fr: 'fr_FR', de: 'de_DE', nl: 'nl_NL',
};
const c = getContent(locale);
const pageTitle = title ?? c.seo.title;
const pageDescription = description ?? c.seo.description;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['Campground', 'LodgingBusiness'],
  name: config.name,
  url: config.domain,
  telephone: config.contact.phone,
  email: config.contact.email,
  address: { '@type': 'PostalAddress', streetAddress: config.contact.address },
};

const navLinks = [
  ['/alojamientos', c.nav.alojamientos],
  ['/instalaciones', c.nav.instalaciones],
  ['/entorno', c.nav.entorno],
  ['/tarifas', c.nav.tarifas],
  ['/blog', c.nav.blog],
  ['/contacto', c.nav.contacto],
] as const;

// páginas legales (ADR 0026 §2.5): solo en el pie, nunca en la nav principal.
// Las claves `footer.legal` y `footer.privacidad` llevaban seis idiomas escritas
// y huérfanas desde la Fase 4; a partir de aquí apuntan a algún sitio.
const legalLinks = [
  ['/aviso-legal', c.footer.legal],
  ['/privacidad', c.footer.privacidad],
  ['/cookies', c.footer.cookies],
] as const;

// OJO (ADR 0026 §2.5): `lc-theme` y `lc-nivel` son el ÚNICO almacenamiento de
// cliente de esta web, ambos funcionales, y por eso `/cookies` puede afirmar que
// no hay nada que consentir y no se muestra banner. Añadir aquí analítica que no
// sea *cookieless* rompe esa afirmación: obligaría a consentimiento previo y a
// reescribir la página. Ver `src/lib/legal.ts`.

// temas de demo (ADR 0009): sin flag en config, nada de esto llega al HTML
const demoThemes = config.demoThemes ?? [];
const defaultTheme = demoThemes[0];

// aplica el tema ANTES del primer paint (anti-FOUC). ?tema=x en la URL
// gana y se persiste: el comercial envía enlaces con el tema puesto.
const themeBootScript = `try{
var v=${JSON.stringify(demoThemes)};
var p=new URLSearchParams(location.search).get('tema');
if(p&&v.indexOf(p)>-1){if(p===v[0]){localStorage.removeItem('lc-theme')}else{localStorage.setItem('lc-theme',p)}}
var t=localStorage.getItem('lc-theme');
if(t&&v.indexOf(t)>-1)document.documentElement.dataset.theme=t;
}catch(e){}`;

// interacción del selector: cambia el atributo, persiste y marca el activo
const themeMenuScript = `
(function () {
  var menu = document.getElementById('lc-tema');
  if (!menu) return;
  var def = menu.dataset.default;
  var botones = menu.querySelectorAll('button[data-tema]');
  function marcar(t) {
    botones.forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.tema === t)); });
  }
  botones.forEach(function (b) {
    b.addEventListener('click', function () {
      var t = b.dataset.tema;
      if (t === def) {
        delete document.documentElement.dataset.theme;
        try { localStorage.removeItem('lc-theme'); } catch (e) {}
      } else {
        document.documentElement.dataset.theme = t;
        try { localStorage.setItem('lc-theme', t); } catch (e) {}
      }
      marcar(t);
      menu.removeAttribute('open');
    });
  });
  marcar(document.documentElement.dataset.theme || def);
})();
`;

// conmutador de nivel de demo (ADR 0013): mismo patrón que el de temas —
// anti-FOUC en <head> vía atributo en <html>, CSS puro decide qué héroe se ve
const showTierSwitch = demoTierSwitch;
const tierBootScript = `try{
var n=localStorage.getItem('lc-nivel');
if(n==='1')document.documentElement.dataset.nivel='1';
}catch(e){}`;

const tierMenuScript = `
(function () {
  var menu = document.getElementById('lc-nivel');
  if (!menu) return;
  var botones = menu.querySelectorAll('button[data-nivel]');
  function marcar(n) {
    botones.forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.nivel === n)); });
  }
  botones.forEach(function (b) {
    b.addEventListener('click', function () {
      var n = b.dataset.nivel;
      if (n === '3') {
        delete document.documentElement.dataset.nivel;
        try { localStorage.removeItem('lc-nivel'); } catch (e) {}
      } else {
        document.documentElement.dataset.nivel = n;
        try { localStorage.setItem('lc-nivel', n); } catch (e) {}
      }
      marcar(n);
      menu.removeAttribute('open');
    });
  });
  marcar(document.documentElement.dataset.nivel || '3');
})();
`;

// D3-V: el portfolio de nivel 3 debe recorrer reserva y recibo sin hablar con
// la D1 de Cala Sereno ni con un proveedor. Se instala antes de hidratar las
// islas y solo intercepta las rutas públicas del funnel. Todo lo demás conserva
// `window.fetch` nativo. El fixture nace del catálogo tipado del tenant: no hay
// precios ni tipos duplicados dentro de componentes.
const demoBookingCatalog = config.bookingTransport === 'demo-session'
  ? {
      slug: config.slug,
      unitTypes: data.unitTypes.map((type) => ({
        id: type.id,
        kind: type.kind,
        capacityMax: type.capacity_max,
        includedPersons: type.included_persons,
        unitCount: type.unitCount,
      })),
      seasons: data.seasons.map((season) => ({
        id: season.id,
        from: season.date_from,
        to: season.date_to,
        open: season.is_open,
      })),
      ratePlans: data.ratePlans.map((plan) => ({
        unitTypeId: plan.unit_type_id,
        seasonId: plan.season_id,
        baseCents: plan.base_cents,
        extraPersonCents: plan.extra_person_cents,
        childCents: plan.child_cents,
        petCents: plan.pet_cents,
        vehicleCents: plan.vehicle_cents,
        minStay: plan.min_stay,
      })),
      extras: data.extras.map((extra) => ({
        id: extra.id,
        priceCents: extra.price_cents,
        per: extra.per,
      })),
    }
  : null;

const demoBookingBootScript = demoBookingCatalog ? `
(function () {
  var catalog = ${JSON.stringify(demoBookingCatalog)};
  var nativeFetch = window.fetch.bind(window);
  var stateKey = 'logic2b-demo:' + catalog.slug + ':public-bookings:v1';
  var hold = 0;
  function response(body, status) {
    return Promise.resolve(new Response(body === null ? null : JSON.stringify(body), {
      status: status || 200,
      headers: body === null ? undefined : { 'content-type': 'application/json' }
    }));
  }
  function bodyOf(init) {
    try { return init && typeof init.body === 'string' ? JSON.parse(init.body) : {}; }
    catch (e) { return {}; }
  }
  function nights(from, to) {
    return Math.max(1, Math.round((Date.parse(to + 'T00:00:00Z') - Date.parse(from + 'T00:00:00Z')) / 86400000));
  }
  function seasonFor(date) {
    return catalog.seasons.find(function (season) { return season.open && date >= season.from && date < season.to; });
  }
  function quote(input) {
    var type = catalog.unitTypes.find(function (item) { return item.id === input.unitTypeId; });
    var season = seasonFor(input.dateFrom);
    var count = nights(input.dateFrom, input.dateTo);
    var plan = season && catalog.ratePlans.find(function (item) {
      return item.unitTypeId === input.unitTypeId && item.seasonId === season.id;
    });
    if (!type || !plan || count < plan.minStay) return null;
    var occupancy = input.occupancy || { adults: 2, childrenAges: [], pets: 0, vehicles: 1 };
    var adults = Number(occupancy.adults || 0);
    var children = Array.isArray(occupancy.childrenAges) ? occupancy.childrenAges.length : 0;
    var pets = Number(occupancy.pets || 0);
    var vehicles = Number(occupancy.vehicles || 1);
    var extraAdults = Math.max(0, adults - type.includedPersons);
    var lines = [{ concept: 'price.base', detail: { nights: count }, amountCents: plan.baseCents * count }];
    if (extraAdults) lines.push({ concept: 'price.extra_person', detail: { people: extraAdults, nights: count }, amountCents: extraAdults * plan.extraPersonCents * count });
    if (children) lines.push({ concept: 'price.child', detail: { people: children, nights: count }, amountCents: children * plan.childCents * count });
    if (pets) lines.push({ concept: 'price.pet', detail: { pets: pets, nights: count }, amountCents: pets * plan.petCents * count });
    if (vehicles > 1) lines.push({ concept: 'price.vehicle', detail: { vehicles: vehicles - 1, nights: count }, amountCents: (vehicles - 1) * plan.vehicleCents * count });
    (input.extraIds || []).forEach(function (id) {
      var extra = catalog.extras.find(function (item) { return item.id === id; });
      if (!extra) return;
      var multiplier = extra.per === 'night' ? count : extra.per === 'person' ? Math.max(1, adults + children) : 1;
      lines.push({ concept: 'extra.' + id, detail: { quantity: multiplier }, amountCents: extra.priceCents * multiplier });
    });
    var total = lines.reduce(function (sum, line) { return sum + line.amountCents; }, 0);
    return {
      nights: count,
      breakdown: { lines: lines, totalCents: total, touristTaxCents: (adults + children) * count * 70, currency: 'EUR' }
    };
  }
  function readBookings() {
    try { return JSON.parse(localStorage.getItem(stateKey) || '[]'); }
    catch (e) { return []; }
  }
  function saveBookings(items) { localStorage.setItem(stateKey, JSON.stringify(items)); }
  window.fetch = function (input, init) {
    var raw = typeof input === 'string' ? input : input.url;
    var url = new URL(raw, window.location.origin);
    var method = (init && init.method) || (typeof input === 'string' ? 'GET' : input.method) || 'GET';
    if (url.origin !== window.location.origin || !url.pathname.startsWith('/api/')) return nativeFetch(input, init);
    if (method === 'GET' && url.pathname === '/api/availability') {
      var from = url.searchParams.get('from');
      var to = url.searchParams.get('to');
      var adults = Number(url.searchParams.get('adults') || 2);
      var children = Number(url.searchParams.get('children') || 0);
      var season = from && seasonFor(from);
      var results = catalog.unitTypes.map(function (type, index) {
        var result = from && to && quote({
          unitTypeId: type.id, dateFrom: from, dateTo: to,
          occupancy: { adults: adults, childrenAges: Array(children).fill(8), pets: 0, vehicles: 1 }, extraIds: []
        });
        var fits = adults + children <= type.capacityMax;
        return {
          unitTypeId: type.id, kind: type.kind,
          status: !season ? 'closed' : result && fits ? 'available' : 'unavailable',
          availableUnits: result && fits ? Math.max(2, type.unitCount - 18 - index * 7) : 0,
          capacityMax: type.capacityMax,
          totalPriceCents: result && fits ? result.breakdown.totalCents : null,
          currency: 'EUR'
        };
      });
      var next = catalog.seasons.filter(function (item) { return item.open && from && item.from > from; }).map(function (item) { return item.from; }).sort()[0] || null;
      return response({ from: from, to: to, opensOn: season ? null : next, results: results });
    }
    if (method === 'POST' && url.pathname === '/api/quote') {
      var quoteBody = bodyOf(init);
      var quoted = quote(quoteBody);
      return quoted ? response(quoted) : response({ error: 'invalid_stay', issues: [{ code: 'stay.min_stay', params: { minStay: 2 } }] }, 422);
    }
    if (method === 'POST' && url.pathname === '/api/holds') {
      hold += 1;
      return response({ holdId: 'hld_mf_demo_' + hold, expiresAt: new Date(Date.now() + 15 * 60000).toISOString() }, 201);
    }
    if (method === 'DELETE' && /^\\/api\\/holds\\//.test(url.pathname)) return response(null, 204);
    if (method === 'POST' && url.pathname === '/api/bookings') {
      var bookingBody = bodyOf(init);
      var bookingQuote = quote(bookingBody);
      if (!bookingQuote) return response({ error: 'invalid_stay' }, 409);
      var items = readBookings();
      var code = 'MF-DEMO-' + String(items.length + 1).padStart(3, '0');
      var booking = {
        code: code, email: bookingBody.holder && bookingBody.holder.email,
        status: 'confirmed', dateFrom: bookingBody.dateFrom, dateTo: bookingBody.dateTo,
        unitTypeId: bookingBody.unitTypeId, occupancy: bookingBody.occupancy,
        extras: bookingBody.extraIds || [], totalCents: bookingQuote.breakdown.totalCents,
        paidCents: bookingQuote.breakdown.totalCents, touristTaxCents: bookingQuote.breakdown.touristTaxCents,
        breakdown: bookingQuote.breakdown
      };
      items.unshift(booking); saveBookings(items);
      return response({ code: code, status: 'confirmed', payment: { method: 'immediate' } }, 201);
    }
    var match = url.pathname.match(/^\\/api\\/bookings\\/([^/]+)(?:\\/(cancel|modify))?$/);
    if (match) {
      var codeValue = decodeURIComponent(match[1]);
      var itemsNow = readBookings();
      var found = itemsNow.find(function (item) { return item.code === codeValue; });
      var actionBody = bodyOf(init);
      var emailValue = method === 'GET' ? url.searchParams.get('email') : actionBody.email;
      if (!found || found.email !== emailValue) return response({ error: 'not_found' }, 404);
      if (method === 'GET') return response(Object.assign({}, found, { cancellation: found.status === 'confirmed' ? { refundCents: found.paidCents, daysBefore: 30, appliedRefundPct: 100 } : null }));
      if (method === 'POST' && match[2] === 'cancel') {
        found.status = 'cancelled'; saveBookings(itemsNow); return response({ code: found.code, status: found.status, refundCents: found.paidCents });
      }
      if (method === 'POST' && match[2] === 'modify') {
        var changed = quote(Object.assign({}, found, { dateFrom: actionBody.dateFrom, dateTo: actionBody.dateTo, extraIds: found.extras }));
        if (!changed) return response({ error: 'no_availability' }, 409);
        found.dateFrom = actionBody.dateFrom; found.dateTo = actionBody.dateTo;
        found.totalCents = changed.breakdown.totalCents; found.paidCents = changed.breakdown.totalCents;
        found.touristTaxCents = changed.breakdown.touristTaxCents; found.breakdown = changed.breakdown;
        saveBookings(itemsNow); return response({ code: found.code, totalCents: found.totalCents });
      }
    }
    return response({ error: 'demo_route_not_implemented' }, 404);
  };
})();
` : '';
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {(noindex || import.meta.env.BASE_URL !== '/') && <meta name="robots" content="noindex" />}
    <link rel="preload" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/fonts/ClashDisplay-Variable.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/fonts/InterVariable.woff2`} as="font" type="font/woff2" crossorigin />
    {media['favicon'] && <link rel="icon" type="image/svg+xml" href={media['favicon']} />}
    {media['apple-touch-icon'] && <link rel="apple-touch-icon" href={media['apple-touch-icon']} />}
    {config.locales.map((l) => (
      <link rel="alternate" hreflang={l} href={`${config.domain}${localePath(l, path)}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${config.domain}${localePath(config.defaultLocale, path)}`} />
    <link rel="canonical" href={`${config.domain}${localePath(locale, path)}`} />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/sitemap.xml`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={config.name} />
    <meta property="og:url" content={`${config.domain}${localePath(locale, path)}`} />
    <meta property="og:locale" content={OG_LOCALE[locale] ?? locale} />
    {config.locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l] ?? l} />)}
    {media['og'] && <meta property="og:image" content={`${config.domain}${media['og']}`} />}
    {media['og'] && <meta property="og:image:width" content="1200" />}
    {media['og'] && <meta property="og:image:height" content="630" />}
    {media['og'] && <meta property="og:image:alt" content={pageTitle} />}
    {media['og'] && <meta name="twitter:card" content="summary_large_image" />}
    {media['og'] && <meta name="twitter:image:alt" content={pageTitle} />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {demoThemes.length > 0 && <script is:inline set:html={themeBootScript} />}
    {showTierSwitch && <script is:inline set:html={tierBootScript} />}
    {demoBookingBootScript && <script is:inline set:html={demoBookingBootScript} />}
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-hueso text-tinta antialiased" data-demo-banner={config.isDemo && c.demo ? '' : undefined}>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-100 focus:rounded-(--lc-radius) focus:bg-pino focus:px-4 focus:py-2 focus:text-hueso"
    >
      {c.nav.menu} ↓
    </a>
    {/* header (+ banner de demo, ADR 0013): un único bloque fijo — el banner
       empuja el nav, no lo solapa, sea cual sea su altura (i18n varía) */}
    <div class="fixed inset-x-0 top-0 z-50">
      {config.isDemo && c.demo && (
        <p class="flex flex-wrap items-center justify-center gap-x-2 gap-y-0.5 bg-pino px-4 py-1.5 text-center text-[12px] leading-snug text-hueso">
          <span>{c.demo.banner}</span>
          {/* La otra cara de la demo. Vive en el banner y no en la nav del
             camping a propósito: es atrezzo comercial, y un camping real
             (sin `isDemo`) no genera ni el nodo. */}
          {c.demo.mostrador && (
            <a href={config.demoManagerPath ?? '/admin/'} class="font-semibold underline underline-offset-2 hover:no-underline">
              {c.demo.mostrador} →
            </a>
          )}
        </p>
      )}
      <header class="bg-hueso/90 backdrop-blur-sm">
      <nav class="mx-auto flex h-14 max-w-7xl items-center justify-between gap-4 px-5 md:px-8">
        <a href={localePath(locale)} class="font-display text-[15px] font-semibold tracking-[0.14em] uppercase">
          {config.name.replace('Camping ', '')}
        </a>

        <div class="flex items-center gap-5">
          {/* nav completa en pantallas grandes */}
          <div class="hidden items-center gap-5 text-[13px] font-medium text-tinta-suave lg:flex">
            {navLinks.map(([href, label]) => (
              <a href={localePath(locale, href)} class="transition-colors hover:text-tinta">{label}</a>
            ))}
          </div>

          {/* selector de idioma: nativo, accesible, sin JS */}
          <details class="lc-menu relative">
            <summary
              class="flex min-h-11 cursor-pointer items-center gap-1 text-[13px] font-medium text-tinta uppercase"
              aria-label={c.nav.idioma}
            >
              {locale}<span aria-hidden="true" class="text-[10px] text-tinta-suave">▾</span>
            </summary>
            <ul class="absolute right-0 top-full z-50 mt-2 min-w-28 rounded-(--lc-radius) border border-arena/70 bg-hueso py-1 shadow-lg">
              {config.locales.map((l) => (
                <li>
                  <a
                    href={localePath(l, path)}
                    class:list={[
                      'block px-4 py-1.5 text-[13px] uppercase transition-colors hover:bg-arena-suave',
                      l === locale ? 'font-semibold text-tinta' : 'text-tinta-suave',
                    ]}
                    aria-current={l === locale ? 'true' : undefined}
                  >
                    {l}
                  </a>
                </li>
              ))}
            </ul>
          </details>

          {/* selector de temas de demo (ADR 0009): solo con config.demoThemes */}
          {demoThemes.length > 0 && (
            <details class="lc-menu relative" id="lc-tema" data-default={defaultTheme}>
              <summary
                class="flex cursor-pointer items-center gap-1.5 text-[13px] font-medium text-tinta"
                aria-label={c.nav.tema}
              >
                <span class="lc-swatch" aria-hidden="true" />
                <span class="hidden sm:inline">{c.nav.tema}</span>
                <span aria-hidden="true" class="text-[10px] text-tinta-suave">▾</span>
              </summary>
              <ul class="absolute right-0 top-full z-50 mt-2 min-w-36 rounded-(--lc-radius) border border-arena/70 bg-hueso py-1 shadow-lg">
                {demoThemes.map((tema) => (
                  <li>
                    <button
                      type="button"
                      data-tema={tema}
                      aria-pressed={tema === defaultTheme ? 'true' : 'false'}
                      class="flex w-full items-center gap-2.5 px-4 py-1.5 text-left text-[13px] text-tinta-suave transition-colors aria-pressed:font-semibold aria-pressed:text-tinta hover:bg-arena-suave"
                    >
                      <span class="lc-swatch" data-swatch={tema} aria-hidden="true" />
                      {c.temas?.[tema] ?? tema}
                    </button>
                  </li>
                ))}
              </ul>
            </details>
          )}

          {/* conmutador de nivel de demo (ADR 0013): solo con config.demoTierSwitch — atrezzo
             comercial, no un segundo build (el motor sigue en el bundle debajo) */}
          {showTierSwitch && c.demo && (
            <details class="lc-menu relative" id="lc-nivel">
              <summary
                class="flex cursor-pointer items-center gap-1.5 text-[13px] font-medium text-tinta"
                aria-label={c.demo.nivel}
              >
                <span class="hidden sm:inline">{c.demo.nivel}</span>
                <span aria-hidden="true" class="text-[10px] text-tinta-suave">▾</span>
              </summary>
              <ul class="absolute right-0 top-full z-50 mt-2 min-w-36 rounded-(--lc-radius) border border-arena/70 bg-hueso py-1 shadow-lg">
                <li>
                  <button
                    type="button"
                    data-nivel="3"
                    aria-pressed="true"
                    class="block w-full px-4 py-1.5 text-left text-[13px] text-tinta-suave transition-colors aria-pressed:font-semibold aria-pressed:text-tinta hover:bg-arena-suave"
                  >
                    {c.demo.nivel3}
                  </button>
                </li>
                <li>
                  <button
                    type="button"
                    data-nivel="1"
                    aria-pressed="false"
                    class="block w-full px-4 py-1.5 text-left text-[13px] text-tinta-suave transition-colors aria-pressed:font-semibold aria-pressed:text-tinta hover:bg-arena-suave"
                  >
                    {c.demo.nivel1}
                  </button>
                </li>
              </ul>
            </details>
          )}

          {/* menú móvil */}
          <details class="lc-menu relative lg:hidden">
            <summary class="flex min-h-11 cursor-pointer items-center text-[13px] font-medium text-tinta">{c.nav.menu}</summary>
            <ul class="absolute right-0 top-full z-50 mt-2 min-w-48 rounded-(--lc-radius) border border-arena/70 bg-hueso py-1 shadow-lg">
              {navLinks.map(([href, label]) => (
                <li>
                  <a
                    href={localePath(locale, href)}
                    class="flex min-h-11 items-center px-4 py-2 text-[14px] text-tinta-suave transition-colors hover:bg-arena-suave hover:text-tinta"
                  >
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </div>
      </nav>
      </header>
    </div>

    <main id="contenido">
      <slot />
    </main>

    <footer class="border-t border-arena/60">
      <div class="mx-auto flex max-w-7xl flex-col gap-6 px-5 py-10 md:px-8">
        <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
          <p class="max-w-xs">
            <span class="font-display text-[14px] font-semibold tracking-[0.14em] uppercase">{config.name}</span>
            <span class="mt-1 block text-[13px] text-tinta-suave">{c.footer.aviso}</span>
          </p>
          <nav class="grid grid-cols-2 gap-x-10 gap-y-1.5 text-[13px] text-tinta-suave sm:grid-cols-3">
            {navLinks.map(([href, label]) => (
              <a href={localePath(locale, href)} class="transition-colors hover:text-tinta">{label}</a>
            ))}
          </nav>
        </div>
        <div class="flex flex-col gap-4 border-t border-arena/50 pt-6 sm:flex-row sm:items-start sm:justify-between">
          <div class="flex flex-col gap-2">
            <p class="tnum text-[13px] text-tinta-suave">
              {config.contact.address} · {config.contact.phone} · {config.contact.email}
            </p>
            <nav class="flex flex-wrap gap-x-5 gap-y-1.5 text-[13px]" aria-label={getLegalUi(locale).nav}>
              {legalLinks.map(([href, label]) => (
                <a href={localePath(locale, href)} class="text-tinta-suave transition-colors hover:text-tinta">
                  {label}
                </a>
              ))}
            </nav>
          </div>
          {/* firma discreta "powered by Logic2B" (ADR 0018) — único punto de la
             marca Logic2B en la web del camping (BRAND.md §0). Isotipo compartido
             (SVG, no runtime), hereda el color apagado del tenant; enlaza a la
             landing de producto (raíz de camp.logic2b.com). */}
          <a
            href="https://camp.logic2b.com/"
            class="group inline-flex items-center gap-1.5 self-start text-[12px] text-tinta-suave transition-colors hover:text-tinta sm:self-auto"
            aria-label={c.footer.poweredBy}
            title={c.footer.poweredBy}
          >
            <span>powered by</span>
            <LogoMark class="h-3.5 w-3.5 opacity-70 transition-opacity group-hover:opacity-100" label={c.footer.poweredBy} />
            <span class="font-medium">Logic2B</span>
          </a>
        </div>
      </div>
    </footer>

    {demoThemes.length > 0 && <script is:inline set:html={themeMenuScript} />}
    {showTierSwitch && <script is:inline set:html={tierMenuScript} />}
  </body>
</html>
