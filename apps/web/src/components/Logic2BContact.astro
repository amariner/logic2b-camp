---
import { LOGIC2B_CONTACT_SCROLL_PX, logic2bContact } from '@logic-camp/config/contact';

interface Props { locale: string }
const { locale } = Astro.props;
const contact = logic2bContact(locale, 'tenant');
const [brandLabel, actionLabel] = contact.label.split(' · ');
---

<a
  href={contact.href}
  target="_blank"
  rel="noopener noreferrer"
  class="lc-logic2b-contact"
  aria-label={contact.ariaLabel}
  title={`${contact.ariaLabel} · ${contact.phone}`}
  data-logic2b-contact
  data-contact-context="tenant"
  data-visible="false"
  tabindex="-1"
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
  </svg>
  <span>
    {brandLabel}
    {actionLabel && <span class="lc-logic2b-contact-action"> · {actionLabel}</span>}
  </span>
</a>

<script is:inline define:vars={{ threshold: LOGIC2B_CONTACT_SCROLL_PX }}>
  (() => {
    const contact = document.querySelector('[data-logic2b-contact]');
    const footer = document.querySelector('footer');
    if (!(contact instanceof HTMLAnchorElement)) return;
    let footerVisible = false;
    const update = () => {
      const visible = window.scrollY > threshold && !footerVisible;
      contact.dataset.visible = String(visible);
      contact.tabIndex = visible ? 0 : -1;
    };
    if (footer && 'IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        footerVisible = entries.some((entry) => entry.isIntersecting);
        update();
      }).observe(footer);
    }
    window.addEventListener('scroll', update, { passive: true });
    update();
  })();
</script>

<style>
  .lc-logic2b-contact {
    position: fixed;
    right: max(16px, env(safe-area-inset-right));
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 45;
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    gap: 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--lc-hueso) 18%, transparent);
    border-radius: 999px;
    background: var(--lc-tinta);
    padding: 11px;
    color: var(--lc-hueso);
    font-size: 13px;
    font-weight: 650;
    box-shadow: 0 14px 34px color-mix(in srgb, var(--lc-tinta) 24%, transparent);
    opacity: 0;
    pointer-events: none;
    transform: translateY(12px);
    transition: opacity 180ms ease, transform 180ms ease;
  }
  .lc-logic2b-contact[data-visible='true'] { opacity: 1; pointer-events: auto; transform: none; }
  .lc-logic2b-contact svg { width: 24px; height: 24px; flex: none; fill: #61d36f; }
  .lc-logic2b-contact > span {
    max-width: 0;
    overflow: hidden;
    opacity: 0;
    white-space: nowrap;
    transition: max-width 180ms ease, margin-left 180ms ease, opacity 120ms ease;
  }
  .lc-logic2b-contact:is(:hover, :focus-visible) > span {
    max-width: 150px;
    margin-left: 9px;
    opacity: 1;
  }
  .lc-logic2b-contact:hover { background: var(--lc-pino-oscuro); }
  .lc-logic2b-contact:focus-visible { outline-offset: 4px; }
  @media (max-width: 479px) {
    .lc-logic2b-contact-action { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lc-logic2b-contact { transition: none; transform: none; }
    .lc-logic2b-contact > span { transition: none; }
  }
</style>
