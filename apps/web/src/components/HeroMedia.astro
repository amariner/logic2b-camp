---
import type { ImageMetadata } from 'astro';
import { heroVideoMimeType } from '../lib/hero-motion.mjs';

interface Props {
  image: ImageMetadata;
  src: string;
  srcset: string;
  mobileImage?: ImageMetadata;
  mobileSrc?: string;
  mobileSrcset?: string;
  desktopVideo?: string;
  mobileVideo?: string;
  position?: string;
  motionLabels?: { pausar: string; reproducir: string };
  class?: string;
}

const {
  image,
  src,
  srcset,
  mobileImage,
  mobileSrc,
  mobileSrcset,
  desktopVideo,
  mobileVideo,
  position = 'center',
  motionLabels,
  class: className = '',
} = Astro.props;

---

<div class={`absolute inset-0 ${className}`} data-hero-media>
  <picture>
    {mobileImage && mobileSrc && mobileSrcset && (
      <source media="(max-width: 639px)" srcset={mobileSrcset} sizes="100vw" />
    )}
    <img
      src={src}
      srcset={srcset}
      sizes="100vw"
      width={image.width}
      height={image.height}
      alt=""
      class="lc-settle absolute inset-0 h-full w-full object-cover"
      style={`object-position: ${position}`}
      fetchpriority="high"
    />
  </picture>
  {desktopVideo && (
    <Fragment>
      <video
        class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-700 data-[ready]:opacity-100"
        style={`object-position: ${position}`}
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
        data-progressive-hero
      >
        {mobileVideo && (
          <source
            data-src={mobileVideo}
            media="(max-width: 639px)"
            type={heroVideoMimeType(mobileVideo)}
          />
        )}
        <source data-src={desktopVideo} type={heroVideoMimeType(desktopVideo)} />
      </video>
      {motionLabels && (
        <button type="button" hidden data-hero-motion-toggle
          data-pause-label={motionLabels.pausar} data-play-label={motionLabels.reproducir}
          class="absolute right-5 bottom-5 z-20 min-h-11 rounded-(--lc-radius) border border-hueso/50 bg-tinta/80 px-4 text-[12px] font-medium text-hueso hover:bg-tinta md:right-8 md:bottom-8"
        >{motionLabels.pausar}</button>
      )}
    </Fragment>
  )}
</div>

{desktopVideo && (
  <script>
    import { canPlayHeroMotion, syncHeroMotion } from '../lib/hero-motion.mjs';

    type ConnectionPreference = EventTarget & { saveData?: boolean };

    const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
    const connection = (navigator as Navigator & { connection?: ConnectionPreference }).connection;
    const heroVideos = Array.from(
      document.querySelectorAll<HTMLVideoElement>('[data-progressive-hero]'),
    );

    const canLoadMotion = () => {
      return canPlayHeroMotion({
        reducedMotion: motionPreference.matches,
        saveData: connection?.saveData === true,
      });
    };

    const controllers = heroVideos.map((video) => {
      const control = video.closest('[data-hero-media]')?.querySelector<HTMLButtonElement>('[data-hero-motion-toggle]');
      let userPaused = false;
      let visible = video.getBoundingClientRect().bottom > 0;
      const updateControl = () => {
        if (!control) return;
        control.hidden = !canLoadMotion() || video.readyState < 2 || Boolean(video.error);
        control.textContent = video.paused ? control.dataset.playLabel ?? '' : control.dataset.pauseLabel ?? '';
      };
      const sync = async () => {
        await syncHeroMotion(video, canLoadMotion() && !userPaused && visible && !document.hidden);
        updateControl();
      };
      control?.addEventListener('click', () => {
        userPaused = !video.paused;
        void sync();
      });
      for (const event of ['loadeddata', 'play', 'pause', 'error']) {
        video.addEventListener(event, updateControl);
      }
      video.addEventListener('error', () => video.removeAttribute('data-ready'));
      const observer = new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        void sync();
      });
      observer.observe(video);
      video.querySelectorAll('source[media]').forEach((source) => {
        window.matchMedia(source.getAttribute('media')!).addEventListener('change', () => {
          delete video.dataset.initialized;
          video.removeAttribute('data-ready');
          void sync();
        });
      });
      void sync();
      return sync;
    });

    const syncAllMotion = () => controllers.forEach((sync) => void sync());
    motionPreference.addEventListener('change', syncAllMotion);
    connection?.addEventListener('change', syncAllMotion);
    document.addEventListener('visibilitychange', syncAllMotion);
  </script>
)}
