---
import ResortHome from './ResortHome.astro';
import ClassicHome from './ClassicHome.astro';
import CoastalHome from './CoastalHome.astro';
import OutdoorHome from './OutdoorHome.astro';
import { config } from '../lib/content';
interface Props { locale: string }
const { locale } = Astro.props;
---
{config.presentation === 'resort' ? <ResortHome locale={locale} /> : config.presentation === 'coastal' ? <CoastalHome locale={locale} /> : config.presentation === 'outdoor' ? <OutdoorHome locale={locale} /> : <ClassicHome locale={locale} />}
