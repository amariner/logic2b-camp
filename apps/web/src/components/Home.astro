---
import { getImage, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import { config, demoTierSwitch, getContent, images, localePath, mode } from '../lib/content';
import HeroMostrador from '@booking/hero';
import EnquiryForm from './EnquiryForm.astro';
import Materia from './Materia.astro';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const c = getContent(locale);
const instant = mode === 'instant';
// conmutador de nivel de demo (ADR 0013): SOLO tras config.demoTierSwitch — atrezzo
// comercial dentro de un build tier 3 real, no un segundo build. Un camping real
// (demoTierSwitch nunca definido) sigue con el único héroe de su propio `instant`.
const showTierSwitch = demoTierSwitch;
// regla dura de niveles: si no hay motor, el wrapper no se importa y el bundle no lo arrastra
// héroe = LCP: srcset webp + preload en <head> (Lighthouse ≥95)
// Cada foto puede no existir: un camping recién dado de alta trae config,
// contenido y tarifas semanas antes que su sesión de fotos. Donde falte, la
// caja la ocupa <Materia> y NO se emite ni la etiqueta ni su preload.
async function buildHero(src: ImageMetadata | undefined) {
  return src ? getImage({ src, widths: [828, 1280, 1920, 2560], format: 'webp', quality: 60 }) : null;
}
const fotoDia = images['hero-dia'];
const staticHeroKey = config.staticHeroImage ?? 'hero-anochecer';
const fotoStatic = images[staticHeroKey];
const heroDia = instant || showTierSwitch ? await buildHero(fotoDia) : null;
const heroAnochecer = !instant || showTierSwitch ? await buildHero(fotoStatic) : null;
// el que se ve por defecto (sin JS ni preferencia guardada) sigue siendo el del `instant` de build
const heroPreload = instant ? heroDia : heroAnochecer;
const fotoLona = images['textura-lona'];
const lona = fotoLona
  ? await getImage({ src: fotoLona, width: 1200, format: 'webp', quality: 50 })
  : null;
---

<Base locale={locale} path="/">
  {heroPreload && (
    <link
      slot="head"
      rel="preload"
      as="image"
      imagesrcset={heroPreload.srcSet.attribute}
      imagesizes="100vw"
      fetchpriority="high"
    />
  )}
  {/* héroe nivel 3: el mostrador ES el héroe · héroe nivel 1: la promesa + una acción.
     Con showTierSwitch (ADR 0013) se generan LOS DOS y un `data-hero-nivel` + CSS puro
     (ver global.css) decide cuál se ve — el otro no se desmonta ni recarga por red. */}
  {(instant || showTierSwitch) && (
    <section class="relative" data-hero-nivel="3">
      <div class="relative h-[82svh] min-h-130 overflow-hidden">
        {/* sin foto NO se cae el héroe entero: en nivel 3 el héroe es el
            mostrador, y ese sigue montándose sobre la materia del tenant */}
        {heroDia && fotoDia ? (
          <img
            src={heroDia.src}
            srcset={heroDia.srcSet.attribute}
            sizes="100vw"
            width={fotoDia.width}
            height={fotoDia.height}
            alt=""
            class="lc-settle absolute inset-0 h-full w-full object-cover"
            fetchpriority="high"
          />
        ) : (
          <Materia class="absolute inset-0 h-full w-full" tono="clara" />
        )}
        <div class="absolute inset-0 bg-gradient-to-r from-hueso/70 via-hueso/20 to-transparent"></div>
        <div class="relative mx-auto flex h-full max-w-7xl items-center px-5 md:px-8">
          <h1 class="font-display max-w-3xl text-[clamp(2.6rem,7vw,6.5rem)] leading-[0.98] font-semibold tracking-tight text-balance">
            {c.hero3.titulo}
          </h1>
        </div>
      </div>

      {/* el mostrador, solapado sobre la foto y sticky después */}
      <div
        id="mostrador"
        class="sticky z-40 mx-auto -mt-16 max-w-5xl scroll-mt-20 px-5 md:px-8"
        style="top: var(--lc-chrome-h)"
      >
        {HeroMostrador && (
          <HeroMostrador
            labels={c.mostrador}
            typeNames={c.tipos.nombres}
            locale={locale}
            reservarBase={localePath(locale, '/reservar')}
          />
        )}
      </div>
      <p class="mx-auto mt-5 max-w-5xl px-5 text-[13px] text-tinta-suave md:px-8">{c.hero3.prueba}</p>
    </section>
  )}
  {(!instant || showTierSwitch) && (
    <section class="relative" data-hero-nivel={showTierSwitch ? '1' : undefined}>
      <div class="relative h-[88svh] min-h-130 overflow-hidden">
        {heroAnochecer && fotoStatic ? (
          <img
            src={heroAnochecer.src}
            srcset={heroAnochecer.srcSet.attribute}
            sizes="100vw"
            width={fotoStatic.width}
            height={fotoStatic.height}
            alt=""
            class="lc-settle absolute inset-0 h-full w-full object-cover"
            fetchpriority="high"
          />
        ) : (
          <Materia class="absolute inset-0 h-full w-full" tono="oscura" />
        )}
        <div class="absolute inset-0 bg-tinta/35"></div>
        <div class="relative mx-auto flex h-full max-w-7xl flex-col items-center justify-center gap-8 px-5 text-center md:px-8">
          <h1 class="font-display max-w-4xl text-[clamp(2.6rem,6.5vw,6rem)] leading-[1.02] font-semibold tracking-tight text-hueso text-balance">
            {c.hero1.titulo}
          </h1>
          <a
            href="#contacto"
            class="rounded-(--lc-radius) bg-hueso px-8 py-3.5 text-[15px] font-semibold text-tinta transition-colors hover:bg-arena-suave"
          >
            {c.hero1.cta} →
          </a>
        </div>
      </div>
      {/* ticker lento de datos */}
      <div class="overflow-hidden border-b border-arena/60 py-3" aria-hidden="true">
        <div class="lc-ticker flex w-max gap-10 text-[13px] tracking-wide text-tinta-suave uppercase">
          {[...c.ticker, ...c.ticker, ...c.ticker].map((t) => (
            <span class="flex items-center gap-10"><span>{t}</span><span class="text-arena">·</span></span>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ───────── Maneras de quedarse ───────── -->
  <section id="alojamientos" class="mx-auto max-w-7xl scroll-mt-20 px-5 py-section md:px-8 md:py-section-lg">
    <div class="mb-12 flex max-w-3xl flex-col gap-3">
      <h2 class="font-display text-[clamp(1.9rem,3.5vw,3rem)] leading-tight font-semibold tracking-tight">{c.tipos.titulo}</h2>
      <p class="text-[15px] text-tinta-suave">{c.tipos.subtitulo}</p>
    </div>
    <div class="grid gap-8 [grid-template-columns:repeat(auto-fit,minmax(min(100%,18rem),1fr))]">
      {c.tipos.cards.map((card, i) => (
        <a href={localePath(locale, '/alojamientos')} class="group flex flex-col gap-4">
          <div class="overflow-hidden rounded-(--lc-radius-lg)">
            {images[card.foto] ? (
              <Picture
                src={images[card.foto]!}
                alt={card.nombre}
                widths={[400, 800, 1200]}
                sizes="(min-width: 768px) 33vw, 100vw"
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                loading="lazy"
                class="aspect-3/2 w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
              />
            ) : (
              /* el giro por tarjeta evita que cuatro cajas sin foto se lean
                 como una rejilla rota en vez de como una decisión */
              <Materia class="aspect-3/2 w-full" giro={164 + i * 8} />
            )}
          </div>
          <div class="flex flex-col gap-1.5">
            <h3 class="font-display text-[19px] font-semibold">{card.nombre}</h3>
            <p class="text-[14px] leading-relaxed text-tinta-suave">{card.desc}</p>
          </div>
        </a>
      ))}
    </div>
    <p class="mt-10">
      <a
        href={localePath(locale, '/alojamientos')}
        class="text-[14px] font-semibold text-pino underline underline-offset-4 transition-colors hover:text-pino-oscuro"
      >
        {c.tipos.verTodo} →
      </a>
    </p>
  </section>

  <!-- ───────── firma: sombra de pino (materia, no vector) ───────── -->
  <div class="h-24 w-full overflow-hidden" role="presentation">
    {lona ? (
      <img src={lona.src} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover" />
    ) : (
      <Materia class="h-full w-full" giro={92} />
    )}
  </div>

  <!-- ───────── El entorno ───────── -->
  <section id="entorno" class="mx-auto grid max-w-7xl scroll-mt-20 gap-10 px-5 py-24 md:grid-cols-2 md:items-center md:px-8 md:py-32">
    <h2 class="font-display text-[clamp(1.9rem,3.5vw,3rem)] leading-tight font-semibold tracking-tight text-balance">
      {c.entorno.titulo}
    </h2>
    <div class="flex flex-col gap-5">
      <p class="text-[16px] leading-relaxed text-tinta-suave">{c.entorno.texto}</p>
      <a
        href={localePath(locale, '/entorno')}
        class="text-[14px] font-semibold text-pino underline underline-offset-4 transition-colors hover:text-pino-oscuro"
      >
        {c.nav.entorno} →
      </a>
    </div>
  </section>

  <!-- ───────── Solicitud → enquiries (TODOS los niveles) ───────── -->
  <section id="contacto" class="border-t border-arena/60 bg-arena-suave/50">
    <div class="mx-auto grid max-w-7xl scroll-mt-20 gap-10 px-5 py-24 md:grid-cols-[1fr_1.2fr] md:px-8 md:py-32">
      <div class="flex flex-col gap-3">
        <h2 class="font-display text-[clamp(1.9rem,3.5vw,3rem)] leading-tight font-semibold tracking-tight">{c.form.titulo}</h2>
        <p class="text-[15px] text-tinta-suave">{c.form.subtitulo}</p>
      </div>
      <EnquiryForm locale={locale} form={c.form} />
    </div>
  </section>
</Base>
