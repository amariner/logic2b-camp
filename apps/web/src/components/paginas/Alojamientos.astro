---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { data, eur, fill, getContent, localePath } from '../../lib/content';
import { fotoTipo } from '../../lib/fotos';
import PageIntro from '../PageIntro.astro';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const c = getContent(locale);
const a = c.alojamientos;

// precio "desde": el plan más barato del tipo (temporada de apertura)
const desde = (unitTypeId: string) =>
  Math.min(...data.ratePlans.filter((p) => p.unit_type_id === unitTypeId).map((p) => p.base_cents));

const grupos = [
  { titulo: a.parcelas, tipos: data.unitTypes.filter((t) => t.kind === 'pitch') },
  { titulo: a.alojados, tipos: data.unitTypes.filter((t) => t.kind === 'lodging') },
];
---

<Base locale={locale} path="/alojamientos" title={a.seo.title} description={a.seo.description}>
  <PageIntro titulo={a.titulo} intro={a.intro} />

  {grupos.map((grupo) => (
    <section class="mx-auto max-w-7xl px-5 pb-20 md:px-8">
      <h2 class="font-display mb-8 text-[13px] font-semibold tracking-[0.14em] text-tinta-suave uppercase">
        {grupo.titulo}
      </h2>
      <div class="grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
        {grupo.tipos.map((t) => (
          <a href={localePath(locale, `/alojamientos/${t.id}`)} class="group flex flex-col gap-3.5">
            <div class="overflow-hidden rounded-(--lc-radius-lg)">
              <Picture
                src={fotoTipo(t.id)}
                alt={c.tipos.nombres[t.id] ?? t.id}
                widths={[400, 800]}
                sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                formats={['avif', 'webp']}
            fallbackFormat="webp"
                loading="lazy"
                class="aspect-4/3 w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
              />
            </div>
            <div class="flex flex-col gap-1">
              <h3 class="font-display text-[17px] leading-snug font-semibold">{c.tipos.nombres[t.id] ?? t.id}</h3>
              <p class="text-[13px] leading-relaxed text-tinta-suave">{a.fichas[t.id]}</p>
              <p class="tnum mt-1.5 text-[14px] font-semibold">
                {fill(a.desdeNoche, { precio: eur(desde(t.id), locale) })}
              </p>
            </div>
          </a>
        ))}
      </div>
    </section>
  ))}
</Base>
