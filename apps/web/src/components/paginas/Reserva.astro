---
/** Gestión por código + email: ver (imprimible), cancelar y cambiar fechas. */
import Base from '../../layouts/Base.astro';
import { getContent } from '../../lib/content';
import ReservaGestion from '../funnel/ReservaGestion';
import PageIntro from '../PageIntro.astro';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const c = getContent(locale);
const r = c.reserva;
---

<Base locale={locale} path="/reserva" title={r.seo.title} description={r.seo.description} noindex>
  <PageIntro titulo={r.titulo} />
  <section class="mx-auto max-w-7xl px-5 pb-section md:px-8">
    <ReservaGestion
      client:load
      locale={locale}
      labels={{
        nueva: r.nueva,
        buscar: r.buscar,
        estado: r.estado,
        campos: r.campos,
        imprimir: r.imprimir,
        cancelar: r.cancelar,
        modificar: r.modificar,
        pago: r.pago,
      }}
      typeNames={c.tipos.nombres}
      conceptos={c.reservar.conceptos}
      extrasNombres={c.tarifas.extras.nombres}
      mostrador={c.mostrador}
    />
  </section>
</Base>
