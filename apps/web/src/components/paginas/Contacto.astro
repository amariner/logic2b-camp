---
import Base from '../../layouts/Base.astro';
import { config, getContent } from '../../lib/content';
import EnquiryForm from '../EnquiryForm.astro';
import PageIntro from '../PageIntro.astro';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const c = getContent(locale);
const p = c.contacto;
---

<Base locale={locale} path="/contacto" title={p.seo.title} description={p.seo.description}>
  <PageIntro titulo={p.titulo} intro={p.intro} />

  <section class="mx-auto grid max-w-7xl gap-14 px-5 pb-section md:grid-cols-[1fr_1.2fr] md:px-8">
    <div class="flex flex-col gap-10">
      <div>
        <h2 class="font-display mb-4 text-[13px] font-semibold tracking-[0.14em] text-tinta-suave uppercase">
          {p.datos.titulo}
        </h2>
        <dl class="flex flex-col gap-2.5 text-[15px]">
          <div class="flex flex-col gap-0.5">
            <dt class="text-[12px] font-medium tracking-wide text-tinta-suave uppercase">{p.datos.direccion}</dt>
            <dd>{config.contact.address}</dd>
          </div>
          <div class="flex flex-col gap-0.5">
            <dt class="text-[12px] font-medium tracking-wide text-tinta-suave uppercase">{p.datos.telefono}</dt>
            <dd><a href={`tel:${config.contact.phone.replace(/ /g, '')}`} class="tnum transition-colors hover:text-pino">{config.contact.phone}</a></dd>
          </div>
          <div class="flex flex-col gap-0.5">
            <dt class="text-[12px] font-medium tracking-wide text-tinta-suave uppercase">{p.datos.email}</dt>
            <dd><a href={`mailto:${config.contact.email}`} class="transition-colors hover:text-pino">{config.contact.email}</a></dd>
          </div>
        </dl>
      </div>

      <div>
        <h2 class="font-display mb-3 text-[13px] font-semibold tracking-[0.14em] text-tinta-suave uppercase">
          {p.horario.titulo}
        </h2>
        <p class="text-[14px] leading-relaxed text-tinta-suave">{p.horario.texto}</p>
      </div>

      <div>
        <h2 class="font-display mb-3 text-[13px] font-semibold tracking-[0.14em] text-tinta-suave uppercase">
          {p.llegar.titulo}
        </h2>
        <p class="text-[14px] leading-relaxed text-tinta-suave">{p.llegar.texto}</p>
      </div>
    </div>

    <div class="rounded-(--lc-radius-lg) border border-arena/60 bg-arena-suave/40 p-6 md:p-8">
      <h2 class="font-display mb-1 text-[19px] font-semibold">{c.form.titulo}</h2>
      <p class="mb-6 text-[14px] text-tinta-suave">{c.form.subtitulo}</p>
      <EnquiryForm locale={locale} form={c.form} />
    </div>
  </section>
</Base>
