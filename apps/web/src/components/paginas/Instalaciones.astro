---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getContent, images, localePath } from '../../lib/content';
import PageIntro from '../PageIntro.astro';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const c = getContent(locale);
const p = c.instalaciones;

const photoFor = (item: (typeof p.items)[number]) => {
  if (item.foto && images[item.foto]) return item.foto;
  if (item.id === 'recepcion' && images['vida-recepcion']) return 'vida-recepcion';
  if (images[`vida-servicio-${item.id}`]) return `vida-servicio-${item.id}`;
  if (images[`instalacion-${item.id}`]) return `instalacion-${item.id}`;
  return null;
};
const fotos = p.items.filter((item) => photoFor(item));
const sinFoto = p.items.filter((item) => !photoFor(item));
const recepcion = p.items.find((item) => item.recepcion || item.id === 'recepcion');
---

<Base locale={locale} path="/instalaciones" title={p.seo.title} description={p.seo.description}>
  <PageIntro titulo={p.titulo} intro={p.intro} />

  {fotos.length > 0 && (
    <section class="mx-auto max-w-7xl px-5 pb-16 md:px-8">
      <div class="grid gap-8 md:grid-cols-2">
        {fotos.map((item) => (
          <article class="flex flex-col gap-4">
            <Picture
              src={images[photoFor(item)!]!}
              alt={item.nombre}
              widths={[640, 1024, 1600]}
              sizes="(min-width: 768px) 50vw, 100vw"
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              loading="lazy"
              class="aspect-3/2 w-full rounded-(--lc-radius-lg) object-cover"
            />
            <div class="flex flex-col gap-1.5">
              <h2 class="font-display text-[19px] font-semibold">{item.nombre}</h2>
              <p class="text-[14px] leading-relaxed text-tinta-suave">{item.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="mx-auto max-w-7xl px-5 pb-section md:px-8">
    <div class="grid gap-x-10 gap-y-8 border-t border-arena/60 pt-12 sm:grid-cols-2 lg:grid-cols-3">
      {sinFoto.map((item) => (
        <article class="flex flex-col gap-1.5">
          <h2 class="font-display text-[16px] font-semibold">{item.nombre}</h2>
          <p class="text-[14px] leading-relaxed text-tinta-suave">{item.desc}</p>
        </article>
      ))}
    </div>
  </section>

  {recepcion && (
    <section class="border-t border-arena/60 bg-arena-suave/50">
      <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 px-5 py-12 sm:flex-row sm:items-center md:px-8">
        <div class="max-w-2xl">
          <h2 class="font-display text-[clamp(1.35rem,2.5vw,1.9rem)] font-semibold tracking-tight">{recepcion.nombre}</h2>
          <p class="mt-2 text-[14px] leading-relaxed text-tinta-suave">{recepcion.desc}</p>
        </div>
        <a class="inline-flex min-h-11 shrink-0 items-center rounded-full bg-pino px-6 py-3 text-[13px] font-semibold text-white transition-opacity hover:opacity-90" href={localePath(locale, '/contacto')}>
          {c.nav.contacto}<span class="ml-2" aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  )}
</Base>
