---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getContent, images } from '../../lib/content';
import PageIntro from '../PageIntro.astro';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const c = getContent(locale);
const p = c.instalaciones;

// si el tenant tiene foto de la instalación (instalacion-{id}.webp), se enseña
const fotos = p.items.filter((i) => images[`instalacion-${i.id}`]);
const sinFoto = p.items.filter((i) => !images[`instalacion-${i.id}`]);
---

<Base locale={locale} path="/instalaciones" title={p.seo.title} description={p.seo.description}>
  <PageIntro titulo={p.titulo} intro={p.intro} />

  {fotos.length > 0 && (
    <section class="mx-auto max-w-7xl px-5 pb-16 md:px-8">
      <div class="grid gap-8 md:grid-cols-2">
        {fotos.map((item) => (
          <article class="flex flex-col gap-4">
            <Picture
              src={images[`instalacion-${item.id}`]!}
              alt={item.nombre}
              widths={[640, 1024, 1600]}
              sizes="(min-width: 768px) 50vw, 100vw"
              formats={['avif', 'webp']}
            fallbackFormat="webp"
              loading="lazy"
              class="aspect-3/2 w-full rounded-(--lc-radius-lg) object-cover"
            />
            <div class="flex flex-col gap-1.5">
              <h2 class="font-display text-[19px] font-semibold">{item.nombre}</h2>
              <p class="text-[14px] leading-relaxed text-tinta-suave">{item.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="mx-auto max-w-7xl px-5 pb-24 md:px-8">
    <div class="grid gap-x-10 gap-y-8 border-t border-arena/60 pt-12 sm:grid-cols-2 lg:grid-cols-3">
      {sinFoto.map((item) => (
        <article class="flex flex-col gap-1.5">
          <h2 class="font-display text-[16px] font-semibold">{item.nombre}</h2>
          <p class="text-[14px] leading-relaxed text-tinta-suave">{item.desc}</p>
        </article>
      ))}
    </div>
  </section>
</Base>
