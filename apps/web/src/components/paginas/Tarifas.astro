---
import Base from '../../layouts/Base.astro';
import { data, eur, fecha, fill, getContent, localePath, mode } from '../../lib/content';
import PageIntro from '../PageIntro.astro';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const c = getContent(locale);
const t = c.tarifas;

// la tabla sale de rate_plans — la misma fuente que usa el motor para cobrar
const plan = (unitTypeId: string, seasonId: string) =>
  data.ratePlans.find((p) => p.unit_type_id === unitTypeId && p.season_id === seasonId);

// Suplementos de parcela: iguales para todos los tipos pitch dentro de cada
// temporada, así que basta con leer UNA parcela — la primera del propio tenant.
// Antes esto era `plan('ut_std', …)!`, el id de la demo escrito a mano en el
// core: cualquier camping que llame a sus parcelas de otra forma rompía la
// página entera de tarifas.
// Cabecera y cuerpo salen de la MISMA lista de pares (temporada, plan): si una
// temporada no tiene tarifa para ese tipo, no se pinta su columna en ninguno de
// los dos, en vez de descuadrar la tabla una celda.
const tipoSuplementos = data.unitTypes.find((u) => u.kind === 'pitch') ?? data.unitTypes[0];
const suplementos = (tipoSuplementos ? data.seasons : [])
  .map((s) => ({ season: s, p: plan(tipoSuplementos!.id, s.id) }))
  .filter((c): c is { season: (typeof data.seasons)[number]; p: NonNullable<typeof c.p> } =>
    Boolean(c.p),
  );
const filasSuplemento: [string, (p: (typeof suplementos)[number]['p']) => number][] = [
  [
    fill(t.suplementos.personaExtra!, { n: (tipoSuplementos?.included_persons ?? 2) + 1 }),
    (p) => p.extra_person_cents,
  ],
  [t.suplementos.nino!, (p) => p.child_cents],
  [t.suplementos.electricidad!, (p) => p.electricity_cents],
  [t.suplementos.vehiculo!, (p) => p.vehicle_cents],
  [t.suplementos.mascota!, (p) => p.pet_cents],
];
---

<Base locale={locale} path="/tarifas" title={t.seo.title} description={t.seo.description}>
  <PageIntro titulo={t.titulo} intro={t.intro} />

  <section class="mx-auto max-w-7xl px-5 pb-16 md:px-8">
    <div class="overflow-x-auto">
      <table class="w-full min-w-140 border-collapse text-[14px]">
        <thead>
          <tr class="border-b-2 border-tinta/20 text-left">
            <th class="py-3 pr-4 font-semibold">{t.tabla.tipo}</th>
            {data.seasons.map((s) => (
              <th class="px-4 py-3 text-right font-semibold whitespace-nowrap">
                {t.temporadas[s.id] ?? s.name}
                <span class="tnum mt-0.5 block text-[11px] font-normal text-tinta-suave">
                  {fecha(s.date_from, locale, { day: 'numeric', month: 'short' })} – {fecha(s.date_to, locale, { day: 'numeric', month: 'short' })}
                </span>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {data.unitTypes.map((tipo) => (
            <tr class="border-b border-arena/50">
              <td class="py-3 pr-4">
                <a
                  href={localePath(locale, `/alojamientos/${tipo.id}`)}
                  class="font-medium transition-colors hover:text-pino"
                >
                  {c.tipos.nombres[tipo.id] ?? tipo.id}
                </a>
              </td>
              {data.seasons.map((s) => {
                const p = plan(tipo.id, s.id);
                return (
                  <td class="tnum px-4 py-3 text-right whitespace-nowrap">
                    {p ? eur(p.base_cents, locale) : '—'}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="mx-auto grid max-w-7xl gap-14 px-5 pb-16 md:grid-cols-2 md:px-8">
    {/* `min-w-0`: un hijo de grid nace con `min-width:auto`, así que su ancho
        mínimo intrínseco —aquí, las cabeceras `whitespace-nowrap` de la tabla—
        estira la rejilla y saca el DOCUMENTO de la pantalla, por mucho
        `overflow-x-auto` que lleve el envoltorio de dentro. Se veía solo en los
        campings de nombres de temporada largos ("Final de temporada" desbordaba
        108px a 375px en un tenant real; los nombres cortos de la demo cabían). */}
    <div class="min-w-0">
      <h2 class="font-display mb-5 text-[17px] font-semibold">{t.suplementos.titulo}</h2>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-[14px]">
          <thead>
            <tr class="border-b border-tinta/20 text-left">
              <th class="py-2 pr-4 font-medium"></th>
              {suplementos.map(({ season: s }) => (
                <th class="px-3 py-2 text-right font-medium whitespace-nowrap">{t.temporadas[s.id] ?? s.name}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {filasSuplemento.map(([nombre, valor]) => (
              <tr class="border-b border-arena/50">
                <td class="py-2.5 pr-4">{nombre}</td>
                {suplementos.map(({ p }) => (
                  <td class="tnum px-3 py-2.5 text-right whitespace-nowrap">{eur(valor(p), locale)}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="min-w-0">
      <h2 class="font-display mb-5 text-[17px] font-semibold">{t.extras.titulo}</h2>
      <ul class="flex flex-col divide-y divide-arena/50 border-y border-arena/50 text-[14px]">
        {data.extras.map((e) => (
          <li class="flex items-baseline justify-between gap-4 py-2.5">
            <span>{t.extras.nombres[e.id] ?? e.name_i18n.es}</span>
            <span class="tnum font-medium whitespace-nowrap">
              {eur(e.price_cents, locale)} <span class="font-normal text-tinta-suave">{t.extras.por[e.per]}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="border-t border-arena/60 bg-arena-suave/50">
    <div class="mx-auto max-w-7xl px-5 py-16 md:px-8">
      <h2 class="font-display mb-5 text-[13px] font-semibold tracking-[0.14em] text-tinta-suave uppercase">
        {t.condiciones.titulo}
      </h2>
      <ul class="flex max-w-3xl flex-col gap-2.5 text-[14px] leading-relaxed text-tinta-suave">
        {t.condiciones.items.map((item) => (
          <li class="flex gap-3"><span class="text-pino">—</span><span>{item}</span></li>
        ))}
      </ul>
      {mode === 'instant' && (
        <a
          href={`${localePath(locale)}#mostrador`}
          class="mt-8 inline-block rounded-(--lc-radius) bg-pino px-7 py-3 text-[15px] font-semibold text-hueso transition-colors hover:bg-pino-oscuro"
        >
          {c.mostrador.buscar} →
        </a>
      )}
    </div>
  </section>
</Base>
