---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { config, fecha, getContent, getPosts, images, localePath } from '../../lib/content';
import PageIntro from '../PageIntro.astro';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const c = getContent(locale);
const p = c.blog;
const posts = getPosts(locale);
const hayTraducidos = posts.some((post) => post.frontmatter.lang === locale);
---

<Base locale={locale} path="/blog" title={p.seo.title} description={p.seo.description}>
  <PageIntro titulo={p.titulo} intro={p.intro} />

  <section class="mx-auto max-w-7xl px-5 pb-section md:px-8">
    {!hayTraducidos && locale !== config.defaultLocale && (
      <p class="mb-8 text-[13px] text-tinta-suave italic">{p.vacio}</p>
    )}
    <div class="grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <a href={localePath(locale, `/blog/${post.slug}`)} class="group flex flex-col gap-4">
          {post.frontmatter.photo && images[post.frontmatter.photo] && (
            <div class="overflow-hidden rounded-(--lc-radius-lg)">
              <Picture
                src={images[post.frontmatter.photo]!}
                alt=""
                widths={[400, 800]}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                formats={['avif', 'webp']}
            fallbackFormat="webp"
                loading="lazy"
                class="aspect-3/2 w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
              />
            </div>
          )}
          <div class="flex flex-col gap-2">
            <time datetime={post.frontmatter.date} class="tnum text-[12px] tracking-wide text-tinta-suave uppercase">
              {fecha(post.frontmatter.date, locale, { day: 'numeric', month: 'long', year: 'numeric' })}
            </time>
            <h2 class="font-display text-[19px] leading-snug font-semibold">{post.frontmatter.title}</h2>
            <p class="text-[14px] leading-relaxed text-tinta-suave">{post.frontmatter.description}</p>
            <span class="text-[13px] font-semibold text-pino">{p.leerMas} →</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>
