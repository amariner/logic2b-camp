---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Materia from '../Materia.astro';
import { config, getContent, images } from '../../lib/content';
import PageIntro from '../PageIntro.astro';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const c = getContent(locale);
const p = c.entornoPagina;
const fotoEntorno =
  images['entorno'] ??
  images['entorno-piedra-seca'] ??
  images[config.staticHeroImage ?? 'hero-dia'];
---

<Base locale={locale} path="/entorno" title={p.seo.title} description={p.seo.description}>
  <PageIntro titulo={p.titulo} intro={p.intro} />

  <section class="mx-auto max-w-7xl px-5 pb-16 md:px-8">
    {fotoEntorno ? (
      <Picture
        src={fotoEntorno}
        alt=""
        widths={[828, 1280, 1920, 2560]}
        sizes="100vw"
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        loading="eager"
        class="aspect-21/9 w-full rounded-(--lc-radius-lg) object-cover"
      />
    ) : (
      <Materia class="aspect-21/9 w-full rounded-(--lc-radius-lg)" />
    )}
  </section>

  <section class="mx-auto grid max-w-7xl gap-x-16 gap-y-12 px-5 pb-16 md:grid-cols-2 md:px-8">
    {p.secciones.map((s) => (
      <article class="flex max-w-xl flex-col gap-3">
        <h2 class="font-display text-[clamp(1.4rem,2.5vw,1.9rem)] leading-tight font-semibold tracking-tight">
          {s.titulo}
        </h2>
        <p class="text-[15px] leading-relaxed text-tinta-suave">{s.texto}</p>
      </article>
    ))}
  </section>

  {p.rutas && p.rutas.items.length > 0 && (
    <section class="mx-auto max-w-7xl px-5 pb-24 md:px-8 md:pb-32" aria-labelledby="rutas-titulo">
      <div class="mb-10 grid gap-4 md:grid-cols-2 md:items-end">
        <h2 id="rutas-titulo" class="font-display text-[clamp(1.7rem,3vw,2.5rem)] leading-tight font-semibold tracking-tight">
          {p.rutas.titulo}
        </h2>
        <p class="text-[14px] leading-relaxed text-tinta-suave">{p.rutas.intro}</p>
      </div>
      <div class="grid gap-8 lg:grid-cols-3">
        {p.rutas.items.slice(0, 3).map((ruta) => (
          <article class="overflow-hidden rounded-(--lc-radius-lg) border border-arena/60 bg-hueso">
            {images[ruta.foto] && (
              <Picture
                src={images[ruta.foto]!}
                alt={ruta.nombre}
                widths={[480, 800, 1200]}
                sizes="(min-width: 1024px) 33vw, 100vw"
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                loading="lazy"
                class="aspect-3/2 w-full object-cover"
              />
            )}
            <div class="flex flex-col gap-4 p-6">
              <div>
                <p class="text-[12px] font-semibold tracking-[0.12em] text-tinta-suave uppercase">{ruta.tipo}</p>
                <h3 class="font-display mt-1 text-[21px] font-semibold">{ruta.nombre}</h3>
                <p class="mt-2 text-[14px] leading-relaxed text-tinta-suave">{ruta.resumen}</p>
              </div>
              <dl class="grid grid-cols-2 gap-x-4 gap-y-3 text-[13px]">
                <div><dt class="text-tinta-suave">Duración</dt><dd class="font-medium">{ruta.duracion}</dd></div>
                <div><dt class="text-tinta-suave">Dificultad</dt><dd class="font-medium">{ruta.dificultad}</dd></div>
                <div><dt class="text-tinta-suave">Salida</dt><dd class="font-medium">{ruta.salida}</dd></div>
                <div><dt class="text-tinta-suave">Mejor momento</dt><dd class="font-medium">{ruta.momento}</dd></div>
              </dl>
              <p class="border-t border-arena/60 pt-4 text-[13px] leading-relaxed text-tinta-suave">{ruta.recomendacion}</p>
              {ruta.mapaUrl && (
                <a class="min-h-11 self-start py-3 text-[13px] font-semibold text-pino underline underline-offset-4" href={ruta.mapaUrl} rel="noreferrer" target="_blank">Ver mapa verificado ↗</a>
              )}
            </div>
          </article>
        ))}
      </div>
      <p class="mt-6 text-[12px] leading-relaxed text-tinta-suave">{p.rutas.aviso}</p>
    </section>
  )}

  <section class="border-t border-arena/60 bg-arena-suave/50">
    <div class="mx-auto max-w-7xl px-5 py-16 md:px-8">
      <h2 class="font-display mb-6 text-[13px] font-semibold tracking-[0.14em] text-tinta-suave uppercase">
        {p.distancias.titulo}
      </h2>
      <dl class="grid gap-x-10 gap-y-3 sm:grid-cols-2 lg:grid-cols-3">
        {p.distancias.items.map((d) => (
          <div class="flex items-baseline justify-between gap-4 border-b border-arena/50 pb-2.5 text-[14px]">
            <dt>{d.lugar}</dt>
            <dd class="tnum font-medium whitespace-nowrap">{d.valor}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Base>
