---
import { config, data } from '../../../lib/content';
import ReservarDetalle from '@booking/detalle';

// nivel sin motor → estas rutas no existen (0 páginas, 0 islas)
export function getStaticPaths() {
  if (import.meta.env.BOOKING_ENGINE !== 'instant') return [];
  return data.unitTypes.map((t) => ({ params: { tipo: t.id } }));
}
const { tipo } = Astro.params;
---

<ReservarDetalle locale={config.defaultLocale} unitTypeId={tipo!} />
