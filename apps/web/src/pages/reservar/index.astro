---
import { config, localePath, mode } from '../../lib/content';

// regla dura de niveles: sin motor no hay funnel NI sus islas en el bundle
const Reservar = mode === 'instant' ? (await import('../../components/paginas/Reservar.astro')).default : null;
const locale = config.defaultLocale;
---

{
  Reservar ? (
    <Reservar locale={locale} />
  ) : (
    <html lang={locale}>
      <head>
        <meta charset="utf-8" />
        <meta http-equiv="refresh" content={`0;url=${localePath(locale)}`} />
        <meta name="robots" content="noindex" />
        <title>{config.name}</title>
      </head>
      <body />
    </html>
  )
}
