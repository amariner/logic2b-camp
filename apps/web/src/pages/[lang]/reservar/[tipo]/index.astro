---
import { data, extraLocales } from '../../../../lib/content';
import ReservarDetalle from '@booking/detalle';

export function getStaticPaths() {
  if (import.meta.env.BOOKING_ENGINE !== 'instant') return [];
  return extraLocales.flatMap((lang) => data.unitTypes.map((t) => ({ params: { lang, tipo: t.id } })));
}
const { lang, tipo } = Astro.params;
---

<ReservarDetalle locale={lang!} unitTypeId={tipo!} />
