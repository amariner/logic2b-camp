---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Materia from '../components/Materia.astro';
import { config, getContent, images, localePath } from '../lib/content';

const locale = config.defaultLocale;
const c = getContent(locale);
// `hero-anochecer` es el nombre del ROL (héroe secundario), no de una foto que
// todo camping tenga: se cae al héroe estático del tenant y, si tampoco, a la
// materia de su paleta. Esta línea con `!` era la que impedía construir
// un tenant entero por una sola imagen ausente.
const fotoBase = images['hero-anochecer'] ?? images[config.staticHeroImage ?? 'hero-dia'];
const foto = fotoBase
  ? await getImage({ src: fotoBase, widths: [828, 1280, 1920], format: 'webp' })
  : null;
---

<Base locale={locale} path="/404" title={`404 — ${config.name}`} description={c.noEncontrada.texto}>
  <section class="relative">
    <div class="relative h-[88svh] min-h-130 overflow-hidden">
      {foto ? (
        <img
          src={foto.src}
          srcset={foto.srcSet.attribute}
          sizes="100vw"
          alt=""
          class="absolute inset-0 h-full w-full object-cover"
        />
      ) : (
        <Materia class="absolute inset-0 h-full w-full" tono="oscura" />
      )}
      <div class="absolute inset-0 bg-tinta/45"></div>
      <div class="relative mx-auto flex h-full max-w-7xl flex-col items-center justify-center gap-6 px-5 text-center md:px-8">
        <p class="tnum font-display text-[15px] font-semibold tracking-[0.3em] text-hueso/70">404</p>
        <h1 class="font-display max-w-3xl text-[clamp(2.2rem,5.5vw,4.5rem)] leading-[1.05] font-semibold tracking-tight text-hueso text-balance">
          {c.noEncontrada.titulo}
        </h1>
        <p class="max-w-xl text-[15px] leading-relaxed text-hueso/85">{c.noEncontrada.texto}</p>
        <a
          href={localePath(locale)}
          class="mt-2 rounded-(--lc-radius) bg-hueso px-8 py-3.5 text-[15px] font-semibold text-tinta transition-colors hover:bg-arena-suave"
        >
          {c.noEncontrada.cta} →
        </a>
      </div>
    </div>
  </section>
</Base>
