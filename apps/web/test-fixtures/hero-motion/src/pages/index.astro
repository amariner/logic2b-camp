---
import type { ImageMetadata } from 'astro';
import HeroMedia from '../../../../src/components/HeroMedia.astro';

const poster = {
  src: '/fixture/poster.svg',
  width: 32,
  height: 18,
  format: 'svg',
} satisfies ImageMetadata;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>HeroMedia browser fixture</title>
    <style>
      body { margin: 0; }
      main { position: relative; width: 320px; height: 180px; }
      [data-hero-media], picture, img, video { position: absolute; inset: 0; width: 100%; height: 100%; }
      img, video { object-fit: cover; }
      video { opacity: 0; }
      video[data-ready] { opacity: 1; }
    </style>
  </head>
  <body>
    <main aria-label="Fixture de HeroMedia">
      <HeroMedia
        image={poster}
        src="/fixture/poster.svg"
        srcset="/fixture/poster.svg 32w"
        desktopVideo="/fixture/desktop.mp4"
        mobileVideo="/fixture/mobile.webm"
      />
    </main>
  </body>
</html>
