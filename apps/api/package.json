{
  "name": "@logic-camp/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run && pnpm test:demo-links",
    "test:demo-links": "node --test scripts/check-demo-links.node.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "bundle:demo": "bash scripts/bundle-demo.sh",
    "deploy:demo": "pnpm bundle:demo && wrangler d1 migrations apply logic-camp-demo --config ../../tenants/demo/wrangler.jsonc --remote && wrangler deploy --config ../../tenants/demo/wrangler.jsonc"
  },
  "dependencies": {
    "@logic-camp/config": "workspace:*",
    "@logic-camp/core": "workspace:*",
    "@logic-camp/db": "workspace:*",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.8.0",
    "zod": "^4.4.3",
    "@logic-camp/hospedajes": "workspace:*",
    "@logic-camp/notifications": "workspace:*",
    "@logic-camp/payments": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.9.14",
    "@cloudflare/workers-types": "^4.20250705.0",
    "@logic-camp/tsconfig": "workspace:*",
    "vitest": "^3.2.0",
    "wrangler": "^4.24.0"
  }
}
