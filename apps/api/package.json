{
  "name": "@logic-camp/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy:demo": "pnpm --filter @logic-camp/web build && pnpm --filter @logic-camp/dashboard build && rm -rf ../web/dist/admin && cp -r ../dashboard/dist ../web/dist/admin && wrangler deploy --config ../../tenants/demo/wrangler.jsonc"
  },
  "dependencies": {
    "@logic-camp/config": "workspace:*",
    "@logic-camp/core": "workspace:*",
    "@logic-camp/db": "workspace:*",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.8.0",
    "zod": "^4.4.3",
    "@logic-camp/notifications": "workspace:*",
    "@logic-camp/payments": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.9.14",
    "@cloudflare/workers-types": "^4.20250705.0",
    "@logic-camp/tsconfig": "workspace:*",
    "vitest": "^3.2.0",
    "wrangler": "^4.24.0"
  }
}
