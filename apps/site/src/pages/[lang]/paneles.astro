---
import Paneles from '../../components/Paneles.astro';
import { LOCALES, type Locale } from '../../lib/i18n';

export function getStaticPaths() {
  return LOCALES.filter((locale) => locale !== 'es').map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
---
<Paneles locale={lang as Locale} />
