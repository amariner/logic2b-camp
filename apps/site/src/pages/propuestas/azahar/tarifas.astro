---
// Página comercial privada: las tarifas definitivas se confirman por recepción.
---
<!doctype html><html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="robots" content="noindex, nofollow, noarchive" /><title>Tarifas · Propuesta privada · Camping Azahar</title><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap" rel="stylesheet" /></head><body>
  <header class="nav shell"><a href="/propuestas/azahar/" class="brand"><img src="/propuestas/azahar/logo-transparent.png" alt="Camping Azahar Benicàssim" /></a><a class="back" href="/propuestas/azahar/">← Volver al camping</a><a class="book" href="#disponibilidad">Consultar fechas ↗</a></header>
  <main><section class="intro shell"><p class="eyebrow">Temporada 2026</p><h1>Tarifas claras.<br /><em>Verano fácil.</em></h1><p>El importe final depende de las fechas y del tipo de estancia. Consulta disponibilidad y recepción te enviará la mejor opción.</p></section>
  <section class="rates shell"><div class="rate-head"><span>Estancia</span><span>Desde</span><span>Ideal para</span></div><a href="/propuestas/azahar/alojamientos/caravanas-vintage/"><strong>Caravanas</strong><span>Consultar</span><span>Escapadas con carácter <b>↗</b></span></a><a href="/propuestas/azahar/alojamientos/parcelas/"><strong>Parcelas</strong><span>Consultar</span><span>Tienda, camper o caravana <b>↗</b></span></a><a href="/propuestas/azahar/alojamientos/mobil-home/"><strong>Mobile homes &amp; bungalows</strong><span>Consultar</span><span>Familias y estancias cómodas <b>↗</b></span></a></section>
  <section class="availability" id="disponibilidad"><div class="shell"><p class="eyebrow">Consulta disponibilidad</p><h2>¿Qué fechas<br /><em>tienes en mente?</em></h2><form data-booking-form data-accommodation="Consulta de tarifas"><label>Entrada<input name="entrada" type="date" required /></label><label>Salida<input name="salida" type="date" required /></label><label>Huéspedes<input name="huespedes" type="number" min="1" value="2" required /></label><label>Nombre<input name="nombre" type="text" autocomplete="name" placeholder="Nombre y apellidos" required /></label><label>Email<input name="email" type="email" autocomplete="email" placeholder="tu@email.com" required /></label><label>Teléfono<input name="telefono" type="tel" autocomplete="tel" placeholder="Opcional" /></label><label class="message">Mensaje<input name="mensaje" type="text" placeholder="¿Algo que debamos saber?" /></label><button type="submit">Ver disponibilidad <span>↗</span></button></form><p class="note">La consulta se abre en tu correo para enviarla directamente a recepción.</p></div></section></main>
  <footer class="shell"><img src="/propuestas/azahar/logo-transparent.png" alt="Camping Azahar Benicàssim" /><span>Benicàssim · A 70 m de la playa</span><span>© Camping Azahar</span></footer>
  <script>document.querySelectorAll<HTMLFormElement>('[data-booking-form]').forEach((form)=>{form.addEventListener('submit',(event)=>{event.preventDefault();const data=new FormData(form);const type=form.dataset.accommodation??'Consulta';const body=[`Consulta: ${type}`,`Entrada: ${data.get('entrada')}`,`Salida: ${data.get('salida')}`,`Huéspedes: ${data.get('huespedes')}`,`Nombre: ${data.get('nombre')}`,`Email: ${data.get('email')}`,`Teléfono: ${data.get('telefono') || 'No indicado'}`,`Mensaje: ${data.get('mensaje') || 'Sin mensaje'}`,'','Hola, me gustaría conocer las opciones disponibles para estas fechas.'].join('\n');window.location.href=`mailto:campingazahar.benicasim@gmail.com?subject=${encodeURIComponent('Consulta web · Tarifas')}&body=${encodeURIComponent(body)}`})})</script>
</body></html>
<style>:root{--ink:#153b37;--cream:#f5f0e8;--paper:#faf8f3;--orange:#e96735;--line:rgba(21,59,55,.2)}*{box-sizing:border-box}html{background:var(--paper);scroll-behavior:smooth}body{margin:0;color:var(--ink);font-family:"DM Sans",sans-serif}.shell{width:min(1240px,calc(100% - 48px));margin-inline:auto}.nav{height:96px;display:flex;align-items:center;border-bottom:1px solid var(--line);gap:28px}.brand img,footer img{display:block;width:130px;height:58px;object-fit:contain}.back{margin-left:auto;font-size:14px}.book{background:var(--ink);color:#fff;padding:14px 18px;font-weight:600;font-size:14px}a{color:inherit;text-decoration:none}.intro{padding:105px 0 75px}.eyebrow{margin:0 0 18px;color:var(--orange);font:500 11px/1.2 "DM Mono",monospace;letter-spacing:.1em;text-transform:uppercase}h1,h2{margin:0;font:500 clamp(53px,8.5vw,122px)/.86 Fraunces,Georgia,serif;letter-spacing:-.06em}h1 em,h2 em{font-style:italic}.intro>p:not(.eyebrow){max-width:410px;margin:34px 0 0;font-size:18px;line-height:1.5}.rates{padding-bottom:150px}.rate-head,.rates>a{display:grid;grid-template-columns:1.3fr .6fr 1fr;gap:30px;align-items:center;padding:23px 0;border-bottom:1px solid var(--line)}.rate-head{border-top:1px solid var(--line);color:rgba(21,59,55,.55);font:11px "DM Mono",monospace;letter-spacing:.08em;text-transform:uppercase}.rates strong{font:500 clamp(28px,3.5vw,48px)/1 Fraunces,Georgia,serif;letter-spacing:-.045em}.rates>a{transition:padding .2s ease,background .2s ease}.rates>a:hover{padding-inline:18px;background:var(--cream)}.rates b{float:right;font-size:18px}.availability{background:var(--cream);padding:130px 0}.availability h2{font-size:clamp(45px,6vw,82px);line-height:.92}.availability form{display:grid;grid-template-columns:repeat(4,1fr);margin-top:48px;border:1px solid var(--line);background:#fff;max-width:1050px}.availability label{display:flex;flex-direction:column;gap:8px;padding:17px 20px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);font:11px "DM Mono",monospace;text-transform:uppercase;letter-spacing:.07em}.availability .message{grid-column:span 3}.availability input{min-width:0;border:0;outline:0;padding:0;color:var(--ink);font:15px "DM Sans",sans-serif}.availability button{border:0;padding:16px 24px;background:var(--ink);color:#fff;font:600 14px "DM Sans",sans-serif;cursor:pointer}.availability button span{margin-left:10px;font-size:18px}.note{margin:14px 0 0;color:rgba(21,59,55,.55);font-size:12px}footer{display:flex;align-items:center;gap:28px;padding:34px 0;color:rgba(21,59,55,.65);font-size:12px}footer span:last-child{margin-left:auto}@media(max-width:720px){.shell{width:calc(100% - 40px)}.nav{height:78px}.brand img{width:100px;height:45px}.back{display:none}.book{margin-left:auto;padding:11px;font-size:12px}.intro{padding:72px 0 54px}.intro>p:not(.eyebrow){font-size:16px}.rates{padding-bottom:90px}.rate-head{display:none}.rates>a{grid-template-columns:1fr;padding:24px 0;gap:9px}.rates>a span:last-child{font-size:14px}.availability{padding:90px 0}.availability form{grid-template-columns:1fr}.availability label,.availability .message{grid-column:1;border-right:0;border-bottom:1px solid var(--line)}.availability button{padding:20px}footer{display:grid;grid-template-columns:1fr 1fr}footer span:last-child{margin-left:0;text-align:right}footer span:nth-child(2){grid-column:1/-1;grid-row:2}}</style>
