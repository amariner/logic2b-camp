---
export function getStaticPaths() {
  return [
    { params: { tipo: 'caravanas-vintage' }, props: { name: 'Caravanas', kicker: 'Una escapada con historia', images: ['/propuestas/azahar/parcela-2.jpg', '/propuestas/azahar/vida-camping.jpg', '/propuestas/azahar/parcela.jpg'], detail: '/propuestas/azahar/via-verde.jpg', description: 'Caravanas con personalidad, entre árboles y muy cerca del Mediterráneo.', notes: ['Ambiente retro', 'Entre pinos', 'A 70 m de la playa'] } },
    { params: { tipo: 'mobil-home' }, props: { name: 'Mobile homes y bungalows', kicker: 'Tu casa junto al mar', images: ['/propuestas/azahar/mobil-home.jpg', '/propuestas/azahar/mobile-home-clean-2.jpg', '/propuestas/azahar/bano.jpg'], detail: '/propuestas/azahar/piscina.jpg', description: 'Una estancia independiente para disfrutar del camping con la comodidad de una casa.', notes: ['Terraza privada', 'Sombra natural', 'Vida al aire libre'] } },
    { params: { tipo: 'parcelas' }, props: { name: 'Parcelas', kicker: 'Espacio para llegar y quedarse', images: ['/propuestas/azahar/parcela.jpg', '/propuestas/azahar/parcela-2.jpg', '/propuestas/azahar/vida-camping.jpg'], detail: '/propuestas/azahar/via-verde.jpg', description: 'Trae tu tienda, caravana o camper. Aquí tienes sombra, espacio y la tranquilidad del camping.', notes: ['Parcelas arboladas', 'Para tienda o caravana', 'Junto a la Vía Verde'] } },
  ];
}

const { name, kicker, images, detail, description, notes } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>{name} · Propuesta privada · Camping Azahar</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="nav shell">
      <a href="/propuestas/azahar/" class="brand"><img src="/propuestas/azahar/logo-transparent.png" alt="Camping Azahar Benicàssim" /></a>
      <a class="back" href="/propuestas/azahar/#estancias">← Todos los alojamientos</a>
      <a class="book" href="#reserva">Consultar disponibilidad ↗</a>
    </header>
    <main>
      <section class="intro shell">
        <div><p class="eyebrow">Camping Azahar · Benicàssim</p><h1>{name}</h1></div>
        <p>{kicker}. {description}</p>
      </section>
      <figure class="hero" data-slider>
        <div class="slides">
          {images.map((src: string, index: number) => (
            <img class:list={['slide', { active: index === 0 }]} src={src} alt={`${name} en Camping Azahar · imagen ${index + 1}`} aria-hidden={index !== 0 ? 'true' : 'false'} />
          ))}
        </div>
        <div class="slider-ui">
          <p><span data-current>01</span> / <span>{String(images.length).padStart(2, '0')}</span></p>
          <div><button type="button" data-prev aria-label="Imagen anterior">←</button><button type="button" data-next aria-label="Imagen siguiente">→</button></div>
        </div>
      </figure>
      <section class="quick-book shell" id="reserva">
        <div><p class="eyebrow">Consulta disponibilidad</p><h2>¿Te quedas<br /><em>por aquí?</em></h2><p>Déjanos tus fechas y recepción te responderá con las opciones disponibles.</p></div>
        <form data-booking-form data-accommodation={name}>
          <label>Entrada<input name="entrada" type="date" required /></label>
          <label>Salida<input name="salida" type="date" required /></label>
          <label>Huéspedes<input name="huespedes" type="number" min="1" value="2" required /></label>
          <label>Tu nombre<input name="nombre" type="text" autocomplete="name" required placeholder="Nombre y apellidos" /></label>
          <label>Email<input name="email" type="email" autocomplete="email" required placeholder="tu@email.com" /></label>
          <label>Teléfono<input name="telefono" type="tel" autocomplete="tel" placeholder="Opcional" /></label>
          <label>Mensaje<input name="mensaje" type="text" placeholder="¿Algo que debamos saber?" /></label>
          <button type="submit">Enviar consulta <span>↗</span></button>
        </form>
      </section>
      <section class="about shell">
        <p class="eyebrow">Para disfrutar a tu manera</p>
        <div class="about-grid"><h2>El camping,<br /><em>desde dentro.</em></h2><div><p>{description}</p><ul>{notes.map((note) => <li>{note}</li>)}</ul></div></div>
      </section>
      <section class="detail shell"><img src={detail} alt="Detalle de Camping Azahar" /><div><p class="eyebrow">Entre mar y pinos</p><h2>Un lugar para<br /><em>bajar el ritmo.</em></h2><p>La playa, la piscina y los caminos de Benicàssim están a una distancia que se recorre sin mirar el reloj.</p></div></section>
    </main>
    <footer class="shell"><img src="/propuestas/azahar/logo-transparent.png" alt="Camping Azahar Benicàssim" /><span>Benicàssim · A 70 m de la playa</span><span>© Camping Azahar</span></footer>
    <script>
      document.querySelectorAll<HTMLFormElement>('[data-booking-form]').forEach((form) => {
        form.addEventListener('submit', (event) => {
          event.preventDefault();
          const data = new FormData(form);
          const type = form.dataset.accommodation ?? 'Consulta';
          const body = [`Alojamiento: ${type}`, `Entrada: ${data.get('entrada')}`, `Salida: ${data.get('salida')}`, `Huéspedes: ${data.get('huespedes')}`, `Nombre: ${data.get('nombre')}`, `Email: ${data.get('email')}`, `Teléfono: ${data.get('telefono') || 'No indicado'}`, `Mensaje: ${data.get('mensaje') || 'Sin mensaje'}`, '', 'Hola, me gustaría consultar disponibilidad para estas fechas.'].join('\n');
          window.location.href = `mailto:campingazahar.benicasim@gmail.com?subject=${encodeURIComponent(`Consulta web · ${type}`)}&body=${encodeURIComponent(body)}`;
        });
      });
      document.querySelectorAll<HTMLElement>('[data-slider]').forEach((slider) => {
        const slides = [...slider.querySelectorAll<HTMLElement>('.slide')];
        const current = slider.querySelector<HTMLElement>('[data-current]');
        let index = 0;
        const show = (next: number) => {
          index = (next + slides.length) % slides.length;
          slides.forEach((slide, position) => {
            const active = position === index;
            slide.classList.toggle('active', active);
            slide.setAttribute('aria-hidden', String(!active));
          });
          if (current) current.textContent = String(index + 1).padStart(2, '0');
        };
        slider.querySelector('[data-prev]')?.addEventListener('click', () => show(index - 1));
        slider.querySelector('[data-next]')?.addEventListener('click', () => show(index + 1));
      });
    </script>
  </body>
</html>

<style>
  :root{--ink:#153b37;--cream:#f5f0e8;--paper:#faf8f3;--orange:#e96735;--line:rgba(21,59,55,.2)}*{box-sizing:border-box}html{background:var(--paper);scroll-behavior:smooth}body{margin:0;color:var(--ink);font-family:"DM Sans",sans-serif}.shell{width:min(1240px,calc(100% - 48px));margin-inline:auto}.nav{height:96px;display:flex;align-items:center;border-bottom:1px solid var(--line);gap:28px}.brand img,footer img{display:block;width:130px;height:58px;object-fit:contain}.back{margin-left:auto;font-size:14px}.book{background:var(--ink);color:#fff;padding:14px 18px;font-weight:600;font-size:14px}.intro{display:flex;justify-content:space-between;align-items:end;gap:60px;padding:95px 0 65px}.eyebrow{margin:0 0 18px;color:var(--orange);font:500 11px/1.2 "DM Mono",monospace;letter-spacing:.1em;text-transform:uppercase}h1,h2{margin:0;font:500 clamp(52px,8vw,118px)/.86 Fraunces,Georgia,serif;letter-spacing:-.06em}h2{font-size:clamp(45px,6vw,82px);line-height:.92}h2 em{font-style:italic}.intro>p{max-width:365px;margin:0;font-size:18px;line-height:1.48}.hero{position:relative;width:min(1400px,100% - 24px);height:min(70vw,720px);margin:0 auto;overflow:hidden;background:#d8dfd2}.slides,.slide{position:absolute;inset:0}.slide{width:100%;height:100%;object-fit:cover;opacity:0;transform:scale(1.015);filter:saturate(.82) contrast(1.03);transition:opacity .55s ease,transform .8s ease}.slide.active{opacity:1;transform:scale(1)}.slider-ui{position:absolute;z-index:2;right:24px;bottom:24px;display:flex;align-items:center;gap:20px;padding:9px 10px 9px 17px;color:#fff;background:rgba(12,42,38,.82);backdrop-filter:blur(8px)}.slider-ui p{margin:0;font:11px "DM Mono",monospace;letter-spacing:.08em}.slider-ui div{display:flex}.slider-ui button{display:grid;place-items:center;width:43px;height:43px;border:0;border-left:1px solid rgba(255,255,255,.25);color:#fff;background:transparent;font-size:19px;cursor:pointer}.slider-ui button:hover{background:rgba(255,255,255,.1)}.quick-book{display:grid;grid-template-columns:1fr 1fr;gap:9%;margin-top:84px;padding:68px;color:#fff;background:var(--ink)}.quick-book>div>p:not(.eyebrow){max-width:350px;margin:26px 0 0;color:rgba(255,255,255,.72);line-height:1.5}.quick-book form{padding:28px;background:#fff;color:var(--ink);box-shadow:0 20px 45px rgba(0,0,0,.18)}.quick-book label{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:14px 0;border-bottom:1px solid var(--line);font:11px "DM Mono",monospace;letter-spacing:.07em;text-transform:uppercase}.quick-book input{width:60%;border:0;background:transparent;outline:0;color:var(--ink);font:15px "DM Sans",sans-serif;text-align:right}.quick-book button{width:100%;margin-top:20px;border:0;padding:18px;background:var(--orange);color:#fff;font:600 14px "DM Sans",sans-serif;cursor:pointer}.quick-book button:hover{background:#d85a2d}.quick-book button span{margin-left:10px;font-size:18px}.about{padding:148px 0}.about-grid{display:grid;grid-template-columns:1.15fr .7fr;gap:12%;align-items:end}.about-grid>div{font-size:20px;line-height:1.46}.about-grid p{margin:0 0 34px}.about ul{border-top:1px solid var(--line);margin:0;padding:0;list-style:none}.about li{padding:13px 0;border-bottom:1px solid var(--line);font-size:15px}.detail{display:grid;grid-template-columns:1.2fr .8fr;gap:8%;align-items:center;padding-bottom:145px}.detail img{width:100%;height:560px;object-fit:cover;filter:saturate(.8)}.detail div>p:not(.eyebrow){margin:28px 0 0;max-width:350px;line-height:1.5}footer{display:flex;align-items:center;gap:28px;padding:34px 0;color:rgba(21,59,55,.65);font-size:12px}footer span:nth-child(3){margin-left:auto}@media(max-width:720px){.shell{width:calc(100% - 40px)}.nav{height:78px;gap:14px}.brand img{width:100px;height:45px}.back{display:none}.book{margin-left:auto;font-size:12px;padding:11px}.intro{display:block;padding:67px 0 40px}.intro>p{margin-top:31px;font-size:16px}.hero{height:460px;width:100%}.slider-ui{right:14px;bottom:14px}.quick-book{display:block;margin-top:50px;padding:38px 24px}.quick-book form{margin-top:38px;padding:22px}.about{padding:90px 0}.about-grid,.detail{grid-template-columns:1fr;gap:35px}.about-grid>div{font-size:18px}.detail{padding-bottom:90px}.detail img{height:420px}footer{display:grid;grid-template-columns:1fr 1fr}footer span:nth-child(3){margin-left:0;text-align:right}footer span:nth-child(2){grid-column:1/-1;grid-row:2}}
</style>
