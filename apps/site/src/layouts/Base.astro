---
import Wordmark from '../components/Wordmark.astro';
import HeaderIcon from '../components/HeaderIcon.astro';
import ProjectRequestDialog from '../components/ProjectRequestDialog.astro';
import { DEFAULT_LOCALE, LOCALES, localePath, type Locale } from '../lib/i18n';
import '../styles/global.css';
/* Después de global.css a propósito: el remapeo de tokens y los estilos de
 * prosa botánicos deben ganar la cascada a los del DS neutro. */
import '../styles/botanical.css';

interface Props {
  locale: Locale;
  content: {
    seo: { title: string; description: string };
    nav: Record<string, string>;
    footer: Record<string, string>;
    contacto: {
      kicker: string;
      solicitudTitulo: string;
      solicitudTexto: string;
      solicitudEnviar: string;
      campos: { nombre: string; camping: string; email: string; telefono: string; mensaje: string };
      enviando: string;
      ok: string;
      error: string;
    };
  };
  /** Ruta SIN prefijo de idioma ('/' la landing, 'docs/…' las guías). Manda en canonical y hreflang. */
  ruta?: string;
  /** SEO propio de la página; si no viene, el de la landing. */
  seo?: { title: string; description: string };
}
const { locale, content, ruta = '/', seo } = Astro.props;
const c = content;

const site = 'https://camp.logic2b.com';
const meta = seo ?? c.seo;
const canonical = new URL(localePath(locale, ruta), site).href;
// Una tarjeta por idioma (`pnpm --filter @logic-camp/site og` las genera desde
// este mismo content/{lang}.json): compartir el enlace en inglés y que salga
// una tarjeta en español es el detalle que delata a un producto descuidado.
const ogImage = `${site}${locale === DEFAULT_LOCALE ? '/og.png' : `/og-${locale}.png`}`;
const OG_LOCALE: Record<Locale, string> = { es: 'es_ES', en: 'en_GB' };

/* ---------- Datos estructurados (JSON-LD) ----------
 * Solo hechos verificables del producto: nada de `aggregateRating` ni reseñas
 * inventadas —además de ser mentira, Google las penaliza cuando no hay reseñas
 * reales que las respalden—. Sin `offers` por ahora: la página mezcla planes
 * disponibles, uno en desarrollo y otro de roadmap, con condiciones de alta
 * que deben confirmarse antes de contratar. */
const datosEstructurados = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site}/#logic2b`,
      name: 'Logic2B',
      url: 'https://logic2b.com',
      email: 'hola@logic2b.com',
      address: { '@type': 'PostalAddress', addressLocality: 'Castellón', addressCountry: 'ES' },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${site}/#producto`,
      name: 'Logic2B Campings',
      url: site,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      description: c.seo.description,
      inLanguage: LOCALES as unknown as string[],
      publisher: { '@id': `${site}/#logic2b` },
      image: ogImage,
    },
  ],
};
// Absolutas (`/#producto`, no `#producto`) para que el header funcione igual
// desde la landing y desde cualquier página de guías (ADR 0025).
const inicio = localePath(locale);
// En producción el Worker monta el gestor en /admin/. En desarrollo se sirve
// como aplicación Vite independiente, para que los enlaces de la landing sean
// comprobables sin montar todo el Worker local.
const managerHref = import.meta.env.DEV ? 'http://localhost:5173/admin/' : '/admin/';
// MENÚ ÚNICO del sitio: header y footer pintan ESTA lista, en este orden
// (secciones del home según aparecen al hacer scroll, luego páginas propias).
// Si un destino entra o sale, se toca solo aquí y los dos menús siguen iguales.
const nav = [
  { href: `${inicio}#producto`, label: c.nav.producto, icon: 'product' },
  { href: `${inicio}#planning`, label: c.nav.planning, icon: 'planning' },
  { href: `${inicio}#niveles`, label: c.nav.niveles, icon: 'plans' },
  { href: localePath(locale, 'temas/'), label: c.nav.temas, icon: 'themes' },
  { href: localePath(locale, 'precios/'), label: c.nav.precios, icon: 'pricing' },
  { href: localePath(locale, 'docs/'), label: c.nav.docs, icon: 'guides' },
] as const;
// Acciones (también compartidas): demo pública, gestor demo y el CTA de contacto.
const acciones = [
  { href: '/demo/', label: c.nav.demo, icon: 'demo' },
  { href: managerHref, label: c.nav.mostrador, icon: 'manager' },
] as const;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={canonical} />
    {
      LOCALES.map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(localePath(l, ruta), site).href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('es', ruta), site).href} />
    <link rel="icon" href="/logo-mark.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/InterVariable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {/* El wordmark está en la cabecera: sin precarga, el logo repinta al llegar
        la fuente. Las dos caras, que el «2B» es media marca. */}
    <link rel="preload" href="/fonts/poppins-600-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-800-logo.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Logic2B Campings" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {
      LOCALES.filter((l) => l !== locale).map((l) => (
        <meta property="og:locale:alternate" content={OG_LOCALE[l]} />
      ))
    }
    {/* Sin `width`/`height` algunas redes recortan a cuadrado en vez de servir
        la tarjeta ancha; el `alt` es lo que oye quien navega con lector. */}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={meta.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={meta.title} />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(datosEstructurados).replace(/</g, '\\u003c')}
    />
  </head>
  <body class="theme-botanical min-h-screen bg-background text-foreground antialiased">
    <header
      class="sticky top-0 z-40 border-b border-border bg-background/85 backdrop-blur supports-[backdrop-filter]:bg-background/70"
    >
      {/* Raíles de logic2b.com: contenedor 1440px, gutter 24→32px, 50px de alto. */}
      <div class="site-header-inner mx-auto flex h-[50px] max-w-[1440px] items-center gap-2 px-4 sm:gap-[34px] sm:px-[clamp(24px,4vw,32px)]">
        {/* El envoltorio ya no es un `<a>`: el wordmark lleva dentro sus dos
            enlaces («Logic2B» → logic2b.com · «Campings» → inicio) y HTML no
            permite anidarlos. */}
        <Wordmark class="shrink-0 text-base sm:text-lg" href={localePath(locale)} />
        <nav class="hidden items-center gap-6 text-sm text-muted-foreground xl:flex" aria-label="Navegación principal">
          {nav.map((n) => <a href={n.href} class="transition-colors hover:text-foreground">{n.label}</a>)}
        </nav>
        <div class="site-header-actions ml-auto flex items-center gap-4">
          <a
            href={acciones[0]!.href}
            class="site-header-demo inline-flex shrink-0 items-center text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
          >{acciones[0]!.label}</a>
          <button
            type="button"
            class="site-header-start inline-flex shrink-0 items-center bg-primary text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90"
            data-project-request-open
          >{c.nav.contacto}</button>
          <button
            type="button"
            class="site-menu-toggle"
            aria-label="Abrir menú"
            aria-controls="site-menu"
            aria-expanded="false"
            data-site-menu-toggle
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </button>
        </div>
        <div id="site-menu" class="site-menu" hidden data-site-menu>
          <nav class="site-menu__links" aria-label="Navegación">
            {
              nav.map((n) => (
                <a href={n.href} class="site-menu__link" data-site-menu-link>
                  <HeaderIcon name={n.icon} class="site-menu__icon" />
                  <span>{n.label}</span>
                </a>
              ))
            }
          </nav>
          <div class="site-menu__actions">
            {
              acciones.map((a) => (
                <a href={a.href} class="site-menu__link" data-site-menu-link>
                  <HeaderIcon name={a.icon} class="site-menu__icon" />
                  <span>{a.label}</span>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-border bg-muted/40">
      {/* Mismos raíles que el header: el wordmark de arriba y el de abajo alinean. */}
      <div class="mx-auto max-w-[1440px] px-[clamp(24px,4vw,32px)] py-12">
        <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
          <div class="max-w-sm">
            <div class="flex items-center">
              <Wordmark class="text-lg" href={localePath(locale)} />
            </div>
            <p class="mt-3 text-sm text-muted-foreground">{c.footer.tagline}</p>
          </div>
          <nav class="flex flex-wrap gap-10 text-sm">
            {/* El mismo array que el header, columna a columna: los dos menús
                no pueden divergir porque son la misma lista. */}
            <div class="flex flex-col gap-2">
              {nav.map((n) => <a href={n.href} class="text-muted-foreground hover:text-foreground">{n.label}</a>)}
            </div>
            <div class="flex flex-col gap-2">
              {acciones.map((a) => <a href={a.href} class="text-muted-foreground hover:text-foreground">{a.label}</a>)}
              <a href={`${inicio}#contacto`} class="text-muted-foreground hover:text-foreground">{c.nav.contacto}</a>
            </div>
            <div class="flex flex-col gap-2">
              {
                LOCALES.map((l) => (
                  <a
                    href={localePath(l, ruta)}
                    class:list={[
                      'hover:text-foreground',
                      l === locale ? 'font-medium text-foreground' : 'text-muted-foreground',
                    ]}
                  >
                    {l.toUpperCase()}
                  </a>
                ))
              }
            </div>
          </nav>
        </div>
        <p class="mt-10 border-t border-border pt-6 text-xs text-muted-foreground">
          © 2026 · {c.footer.powered}
        </p>
      </div>
    </footer>

    <ProjectRequestDialog contacto={c.contacto} locale={locale} />

    {/* Reveal on scroll (ADR 0027), compartido por todas las páginas: cualquier
        .lc-reveal del slot funciona igual en home, temas, precios y guías. */}
    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const elements = document.querySelectorAll('.lc-reveal');
      document.documentElement.classList.add('lc-js');
      if (reduce || !('IntersectionObserver' in window)) {
        elements.forEach((element) => element.classList.add('lc-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('lc-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        elements.forEach((element) => observer.observe(element));
      }
    </script>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('[data-site-menu-toggle]');
      const menu = document.querySelector<HTMLElement>('[data-site-menu]');
      const closeMenu = () => {
        if (!toggle || !menu) return;
        menu.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
      };

      toggle?.addEventListener('click', () => {
        if (!menu) return;
        const isOpen = menu.hidden;
        menu.hidden = !isOpen;
        toggle.setAttribute('aria-expanded', String(isOpen));
      });

      document.querySelectorAll('[data-site-menu-link]').forEach((link) => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeMenu();
      });
      document.addEventListener('click', (event) => {
        if (menu && toggle && !menu.hidden && !menu.contains(event.target as Node) && !toggle.contains(event.target as Node)) {
          closeMenu();
        }
      });
    </script>
  </body>
</html>
