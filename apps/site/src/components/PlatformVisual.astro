---
interface Props {
  kind: string;
  label: string;
  alt: string;
  locale?: string;
}

const { kind, label, alt, locale = 'es' } = Astro.props;
const english = locale === 'en';

const copy = english
  ? {
      publicWebsite: 'Public website',
      detailView: 'Focused detail',
      directBooking: 'Direct booking',
      enquiryReady: 'Enquiry ready',
      enquiryDetails: '12–16 Aug · 2 adults + 1 child',
      webHeadline: 'Wake up by the Mediterranean',
      sea: 'MEDITERRANEAN SEA',
      bookingDates: '12–16 Aug',
      monthShort: 'AUG',
      bookingAmount: '€468',
      accommodation: 'Pitch P-24',
      traveller: 'Ana Martín',
      confirmed: 'Confirmed',
      bookingNumber: 'Direct booking #2481',
      stay: 'Stay',
      nights: '4 nights',
      amount: 'Total',
      paid: 'Deposit received · €140',
      guestValue: '2 adults + 1 child',
      context: 'Operational context',
      contextValue: 'Pet · expected arrival 19:00',
      planningUpdated: 'Planner updated',
      request: 'Request',
      deposit: 'Deposit',
      units: '3 units in focus',
      gap: 'Operational gap',
      fits: 'Fits without overlap',
      checkout: 'Departure 11:00',
      checkin: 'Arrival 16:00',
      pool: 'Pool',
      available: 'Available',
      occupied: 'Occupied',
      selectedPitch: 'Pitch A-19',
      pitchTraits: '78 m² · shade · 10 A',
      pitchDates: 'Available 12–16 Aug',
      assignHere: 'Assign here',
      decision: 'Decision pending',
      weekend: 'Weekend 21–23 Aug',
      suggestedAction: 'Open 3 more family pitches',
      noAvailability: 'searches without availability',
      expectedOccupancy: 'expected occupancy',
      impact: 'Estimated impact',
      impactValue: '+€1,240',
      impactRange: 'Expected range €940–1,480',
      review: 'Review change',
      humanControl: 'The decision remains yours',
    }
  : {
      publicWebsite: 'Web pública',
      detailView: 'Detalle ampliado',
      directBooking: 'Reserva directa',
      enquiryReady: 'Consulta preparada',
      enquiryDetails: '12–16 ago · 2 adultos + 1 niño',
      webHeadline: 'Despierta junto al Mediterráneo',
      sea: 'MAR MEDITERRÁNEO',
      bookingDates: '12–16 ago',
      monthShort: 'AGO',
      bookingAmount: '468 €',
      accommodation: 'Parcela P-24',
      traveller: 'Ana Martín',
      confirmed: 'Confirmada',
      bookingNumber: 'Reserva directa #2481',
      stay: 'Estancia',
      nights: '4 noches',
      amount: 'Total',
      paid: 'Señal recibida · 140 €',
      guestValue: '2 adultos + 1 niño',
      context: 'Contexto operativo',
      contextValue: 'Mascota · llegada prevista 19:00',
      planningUpdated: 'Planning actualizado',
      request: 'Solicitud',
      deposit: 'Señal',
      units: '3 unidades en foco',
      gap: 'Hueco operativo',
      fits: 'Encaja sin solape',
      checkout: 'Salida 11:00',
      checkin: 'Entrada 16:00',
      pool: 'Piscina',
      available: 'Disponible',
      occupied: 'Ocupada',
      selectedPitch: 'Parcela A-19',
      pitchTraits: '78 m² · sombra · 10 A',
      pitchDates: 'Libre 12–16 ago',
      assignHere: 'Asignar aquí',
      decision: 'Decisión pendiente',
      weekend: 'Fin de semana 21–23 ago',
      suggestedAction: 'Abrir 3 parcelas familiares',
      noAvailability: 'búsquedas sin disponibilidad',
      expectedOccupancy: 'ocupación prevista',
      impact: 'Impacto estimado',
      impactValue: '+1.240 €',
      impactRange: 'Rango previsto 940–1.480 €',
      review: 'Revisar cambio',
      humanControl: 'La decisión sigue siendo tuya',
    };

const planningDays = english ? ['M 11', 'T 12', 'W 13', 'T 14'] : ['L 11', 'M 12', 'X 13', 'J 14'];
---

<div class="platform-art" data-kind={kind} role="img" aria-label={alt}>
  <header class="art-chrome" aria-hidden="true">
    <span class="art-chrome-dots"><i></i><i></i><i></i></span>
    <strong>{label}</strong>
    <span class="art-chrome-mode">{kind === 'web' ? copy.publicWebsite : copy.detailView}</span>
  </header>

  {
    kind === 'web' && (
      <div class="art-scene web-scene" aria-hidden="true">
        <div class="web-browser">
          <div class="web-address">
            <span class="web-lock">◇</span>
            <strong>campingmediterraneo.es</strong>
            <span>↗</span>
          </div>
          <div class="web-viewport">
            <img src="/captura-web.webp" alt="" loading="lazy" decoding="async" />
          </div>
        </div>

        <div class="web-phone">
          <span class="phone-speaker"></span>
          <div class="phone-photo">
            <small>{copy.sea}</small>
            <strong>{copy.webHeadline}</strong>
          </div>
          <div class="phone-search">
            <span>{copy.bookingDates}</span>
            <b>→</b>
          </div>
        </div>

        <div class="web-proof">
          <span class="proof-check">✓</span>
          <p><small>{copy.enquiryReady}</small><strong>{copy.enquiryDetails}</strong></p>
          <span class="proof-channel">{copy.directBooking}</span>
        </div>
      </div>
    )
  }

  {
    kind === 'reservas' && (
      <div class="art-scene booking-scene" aria-hidden="true">
        <div class="booking-track">
          <span class="done"><i>✓</i>{copy.request}</span>
          <b></b>
          <span class="done"><i>✓</i>{copy.deposit}</span>
          <b></b>
          <span class="active"><i>3</i>{copy.confirmed}</span>
        </div>

        <article class="booking-card">
          <header class="booking-card-head">
            <span class="booking-check">✓</span>
            <div>
              <small>{copy.bookingNumber}</small>
              <strong>{copy.traveller}</strong>
            </div>
            <span class="booking-status">{copy.confirmed}</span>
          </header>

          <div class="booking-fields">
            <section><small>{copy.stay}</small><strong>{copy.bookingDates}</strong><span>{copy.nights}</span></section>
            <section><small>{copy.accommodation}</small><strong>P-24</strong><span>{copy.guestValue}</span></section>
            <section><small>{copy.amount}</small><strong>{copy.bookingAmount}</strong><span>{copy.paid}</span></section>
          </div>

          <div class="booking-context">
            <span class="context-icon">i</span>
            <p><small>{copy.context}</small><strong>{copy.contextValue}</strong></p>
            <span class="sync-state"><i></i>{copy.planningUpdated}</span>
          </div>
        </article>
      </div>
    )
  }

  {
    kind === 'planning' && (
      <div class="art-scene planning-scene" aria-hidden="true">
        <div class="planning-toolbar">
          <span>←</span><strong>11 — 14 {copy.monthShort}</strong><span>→</span>
          <small>{copy.units}</small>
        </div>

        <div class="planning-zoom">
          <div class="planning-days"><i></i>{planningDays.map((day) => <span>{day}</span>)}</div>
          <div class="planning-row">
            <b>P-21</b>
            <i class="planning-stay stay-martin">Martín · 5N</i>
          </div>
          <div class="planning-row selected-row">
            <b>P-22</b>
            <i class="planning-ghost"></i>
            <i class="planning-stay stay-lopez">López · 4N <span>✓</span></i>
          </div>
          <div class="planning-row">
            <b>P-24</b>
            <i class="planning-stay stay-ruiz">Ruiz · 3N</i>
          </div>
          <span class="planning-now"></span>
        </div>

        <aside class="planning-popover">
          <span class="popover-kicker"><i></i>{copy.gap}</span>
          <strong>{copy.fits}</strong>
          <div><span>{copy.checkout}</span><b>→</b><span>{copy.checkin}</span></div>
        </aside>
      </div>
    )
  }

  {
    kind === 'plano' && (
      <div class="art-scene map-scene" aria-hidden="true">
        <div class="map-toolbar">
          <strong>{copy.bookingDates}</strong>
          <span><i class="free-dot"></i>{copy.available}</span>
          <span><i class="busy-dot"></i>{copy.occupied}</span>
        </div>

        <div class="map-zoom">
          <span class="pool-edge"><i>≈</i><strong>{copy.pool}</strong></span>
          <span class="map-path path-one"></span>
          <span class="map-path path-two"></span>
          <span class="map-tree tree-one">✦</span>
          <span class="map-tree tree-two">✦</span>
          <span class="map-tree tree-three">✦</span>

          <span class="pitch pitch-a17"><i>•</i>A-17</span>
          <span class="pitch free pitch-a18"><i>○</i>A-18</span>
          <span class="pitch selected pitch-a19"><i>✓</i>A-19</span>
          <span class="pitch pitch-a20"><i>•</i>A-20</span>
          <span class="pitch free pitch-a21"><i>○</i>A-21</span>
          <span class="pitch pitch-a22"><i>•</i>A-22</span>

          <article class="pitch-card">
            <span class="pitch-card-status"><i></i>{copy.available}</span>
            <strong>{copy.selectedPitch}</strong>
            <p>{copy.pitchTraits}</p>
            <div><span>{copy.pitchDates}</span><b>{copy.assignHere} →</b></div>
          </article>
        </div>
      </div>
    )
  }

  {
    kind === 'operativa' && (
      <div class="art-scene operations-scene" aria-hidden="true">
        <article class="decision-card">
          <header>
            <span class="decision-spark">↗</span>
            <div><small>{copy.weekend}</small><span>{copy.decision}</span></div>
          </header>

          <h4>{copy.suggestedAction}</h4>

          <div class="decision-evidence">
            <section><strong>18</strong><span>{copy.noAvailability}</span></section>
            <section><strong>92%</strong><span>{copy.expectedOccupancy}</span></section>
          </div>

          <div class="decision-impact">
            <p><small>{copy.impact}</small><strong>{copy.impactValue}</strong><span>{copy.impactRange}</span></p>
            <span class="impact-line"><i></i><b></b><i></i></span>
          </div>

          <footer>
            <span class="human-control"><i>◇</i>{copy.humanControl}</span>
            <span class="review-action">{copy.review}<b>→</b></span>
          </footer>
        </article>
      </div>
    )
  }
</div>

<style>
  .platform-art {
    --art-accent: #24776d;
    --art-soft: #d8eee8;
    --art-deep: #123f3a;
    position: relative;
    min-height: clamp(440px, 43vw, 600px);
    isolation: isolate;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--art-accent) 25%, white);
    border-radius: 24px;
    background:
      radial-gradient(circle at 14% 4%, rgb(255 255 255 / 86%), transparent 32%),
      linear-gradient(145deg, color-mix(in srgb, var(--art-soft) 82%, white), color-mix(in srgb, var(--art-soft) 45%, white));
    color: var(--art-deep);
    box-shadow: 0 28px 68px color-mix(in srgb, var(--art-deep) 15%, transparent);
  }

  .platform-art::before {
    position: absolute;
    z-index: -1;
    inset: 56px 0 0;
    background-image: radial-gradient(color-mix(in srgb, var(--art-accent) 18%, transparent) .8px, transparent .8px);
    background-size: 18px 18px;
    content: '';
    mask-image: linear-gradient(to bottom, black, transparent 82%);
  }

  .platform-art[data-kind='reservas'] { --art-accent: #bd5a3d; --art-soft: #f4d7cd; --art-deep: #5d2a20; }
  .platform-art[data-kind='planning'] { --art-accent: #685fa7; --art-soft: #e4e0f4; --art-deep: #302a63; }
  .platform-art[data-kind='plano'] { --art-accent: #6c803f; --art-soft: #e4eccd; --art-deep: #35461d; }
  .platform-art[data-kind='operativa'] { --art-accent: #b57a21; --art-soft: #f3e1b9; --art-deep: #563b13; }

  .art-chrome {
    position: relative;
    z-index: 5;
    display: flex;
    height: 58px;
    align-items: center;
    gap: 11px;
    border-bottom: 1px solid color-mix(in srgb, var(--art-accent) 17%, transparent);
    padding: 0 21px;
    background: rgb(255 255 255 / 72%);
    backdrop-filter: blur(12px);
  }
  .art-chrome-dots { display: flex; gap: 5px; }
  .art-chrome-dots i { width: 7px; height: 7px; border-radius: 50%; background: color-mix(in srgb, var(--art-accent) 30%, white); }
  .art-chrome-dots i:first-child { background: var(--art-accent); }
  .art-chrome strong { font-size: 12px; }
  .art-chrome-mode { margin-left: auto; border: 1px solid color-mix(in srgb, var(--art-accent) 15%, transparent); border-radius: 999px; background: rgb(255 255 255 / 68%); padding: 7px 10px; color: color-mix(in srgb, var(--art-deep) 65%, white); font-size: 9px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .art-scene { position: relative; height: clamp(382px, 38vw, 542px); padding: clamp(18px, 2.6vw, 34px); }

  /* Web: una web real en lugar de analítica. */
  .web-scene { padding: clamp(20px, 2.8vw, 38px) clamp(26px, 4.6vw, 70px) clamp(28px, 3.6vw, 48px); }
  .web-browser { height: 100%; overflow: hidden; border: 1px solid rgb(17 48 44 / 14%); border-radius: 18px; background: #f7f6ef; box-shadow: 0 24px 46px rgb(17 48 44 / 20%); transform: rotate(-.65deg); }
  .web-address { display: flex; height: 38px; align-items: center; gap: 7px; border-bottom: 1px solid rgb(17 48 44 / 10%); padding: 0 13px; background: #fff; color: #173d38; font-size: 8px; }
  .web-address strong { font-size: 8px; font-weight: 700; }
  .web-address > span:last-child { margin-left: auto; font-size: 11px; }
  .web-lock { display: grid; width: 15px; height: 15px; place-items: center; border-radius: 50%; background: #e5efe9; }
  .web-viewport { height: calc(100% - 38px); overflow: hidden; }
  .web-viewport img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 36%; }
  .web-phone { position: absolute; bottom: 17px; left: 15px; width: clamp(82px, 9vw, 114px); overflow: hidden; border: 5px solid #173d38; border-radius: 20px; background: #f6f4e9; box-shadow: 0 18px 34px rgb(17 48 44 / 25%); transform: rotate(2.2deg); }
  .phone-speaker { display: block; width: 24px; height: 3px; margin: 6px auto; border-radius: 9px; background: rgb(255 255 255 / 38%); }
  .phone-photo { display: flex; height: clamp(92px, 11vw, 138px); flex-direction: column; justify-content: flex-end; gap: 5px; padding: 10px 8px; background: linear-gradient(0deg, rgb(5 33 29 / 70%), transparent 72%), url('/hero-atmosfera-movil.webp') center / cover; color: white; }
  .phone-photo small { font-size: 5px; font-weight: 800; letter-spacing: .08em; }
  .phone-photo strong { font-size: clamp(8px, .9vw, 12px); line-height: 1.08; }
  .phone-search { display: flex; align-items: center; justify-content: space-between; padding: 9px 7px; font-size: 6px; font-weight: 800; }
  .phone-search b { display: grid; width: 19px; height: 19px; place-items: center; border-radius: 50%; background: #1b5c4a; color: white; }
  .web-proof { position: absolute; right: clamp(12px, 2vw, 26px); bottom: clamp(12px, 2vw, 24px); display: grid; grid-template-columns: auto 1fr; gap: 3px 10px; align-items: center; min-width: min(290px, 56%); border: 1px solid rgb(17 48 44 / 12%); border-radius: 16px; background: rgb(255 255 255 / 94%); padding: 13px 14px; box-shadow: 0 16px 32px rgb(17 48 44 / 18%); }
  .proof-check { display: grid; grid-row: 1 / span 2; width: 30px; height: 30px; place-items: center; border-radius: 50%; background: #1f725c; color: white; font-size: 13px; font-weight: 900; }
  .web-proof p { display: grid; gap: 3px; }
  .web-proof small { color: #63736f; font-size: 7px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .web-proof strong { font-size: 10px; }
  .proof-channel { grid-column: 2; width: max-content; border-radius: 999px; background: #e4efe9; padding: 4px 7px; color: #235c4e; font-size: 7px; font-weight: 800; }

  /* Reservas: una ficha concreta y todo su contexto. */
  .booking-scene { display: flex; flex-direction: column; justify-content: center; }
  .booking-track { display: flex; max-width: 480px; align-items: center; align-self: center; margin-bottom: 16px; color: color-mix(in srgb, var(--art-deep) 52%, white); }
  .booking-track span { display: flex; align-items: center; gap: 5px; font-size: 8px; font-weight: 800; white-space: nowrap; }
  .booking-track span i { display: grid; width: 20px; height: 20px; place-items: center; border: 1px solid color-mix(in srgb, var(--art-accent) 24%, transparent); border-radius: 50%; background: white; font-size: 7px; font-style: normal; }
  .booking-track .done i { background: color-mix(in srgb, var(--art-accent) 16%, white); color: var(--art-accent); }
  .booking-track .active { color: var(--art-deep); }
  .booking-track .active i { border-color: var(--art-accent); background: var(--art-accent); color: white; }
  .booking-track b { width: clamp(22px, 4vw, 58px); height: 1px; margin-inline: 7px; background: color-mix(in srgb, var(--art-accent) 22%, transparent); }
  .booking-card { width: min(100%, 590px); margin-inline: auto; overflow: hidden; border: 1px solid color-mix(in srgb, var(--art-accent) 15%, transparent); border-radius: 22px; background: rgb(255 255 255 / 90%); box-shadow: 0 24px 48px color-mix(in srgb, var(--art-deep) 15%, transparent); }
  .booking-card-head { display: flex; align-items: center; gap: 12px; border-bottom: 1px solid color-mix(in srgb, var(--art-accent) 12%, transparent); padding: 18px 20px; }
  .booking-check { display: grid; width: 40px; height: 40px; flex: none; place-items: center; border-radius: 13px; background: var(--art-accent); color: white; font-size: 17px; font-weight: 900; }
  .booking-card-head div { display: grid; gap: 4px; }
  .booking-card-head small { color: color-mix(in srgb, var(--art-deep) 52%, white); font-size: 8px; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; }
  .booking-card-head strong { font-size: 16px; }
  .booking-status { margin-left: auto; border-radius: 999px; background: color-mix(in srgb, var(--art-accent) 13%, white); padding: 7px 10px; color: var(--art-accent); font-size: 8px; font-weight: 900; }
  .booking-fields { display: grid; grid-template-columns: 1fr 1.08fr 1.12fr; padding: 18px 20px; }
  .booking-fields section { display: grid; gap: 5px; min-width: 0; padding-inline: 14px; }
  .booking-fields section:first-child { padding-left: 0; }
  .booking-fields section + section { border-left: 1px solid color-mix(in srgb, var(--art-accent) 12%, transparent); }
  .booking-fields small, .booking-context small { color: color-mix(in srgb, var(--art-deep) 52%, white); font-size: 7px; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; }
  .booking-fields strong { overflow: hidden; font-size: 13px; text-overflow: ellipsis; white-space: nowrap; }
  .booking-fields span { overflow: hidden; color: color-mix(in srgb, var(--art-deep) 62%, white); font-size: 8px; text-overflow: ellipsis; white-space: nowrap; }
  .booking-context { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 10px; align-items: center; margin: 0 12px 12px; border-radius: 15px; background: color-mix(in srgb, var(--art-soft) 68%, white); padding: 12px; }
  .context-icon { display: grid; width: 27px; height: 27px; place-items: center; border-radius: 9px; background: var(--art-deep); color: white; font-size: 11px; font-weight: 900; }
  .booking-context p { display: grid; gap: 3px; min-width: 0; }
  .booking-context p strong { overflow: hidden; font-size: 9px; text-overflow: ellipsis; white-space: nowrap; }
  .sync-state { display: flex; align-items: center; gap: 5px; border-radius: 999px; background: white; padding: 7px 9px; font-size: 7px; font-weight: 800; white-space: nowrap; }
  .sync-state i { width: 6px; height: 6px; border-radius: 50%; background: var(--art-accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--art-accent) 14%, transparent); }

  /* Planning: solo el gesto que resuelve un hueco. */
  .planning-toolbar { display: flex; height: 38px; align-items: center; gap: 9px; border: 1px solid color-mix(in srgb, var(--art-accent) 15%, transparent); border-radius: 12px; background: rgb(255 255 255 / 76%); padding: 0 11px; }
  .planning-toolbar > span { display: grid; width: 23px; height: 23px; place-items: center; border-radius: 8px; background: white; font-size: 9px; }
  .planning-toolbar strong { font-size: 9px; letter-spacing: .05em; }
  .planning-toolbar small { margin-left: auto; color: color-mix(in srgb, var(--art-deep) 56%, white); font-size: 8px; font-weight: 700; }
  .planning-zoom { position: relative; margin-top: 14px; overflow: hidden; border: 1px solid color-mix(in srgb, var(--art-accent) 14%, transparent); border-radius: 16px; background: rgb(255 255 255 / 84%); box-shadow: 0 18px 38px color-mix(in srgb, var(--art-deep) 11%, transparent); }
  .planning-days, .planning-row { display: grid; grid-template-columns: 64px repeat(4, 1fr); }
  .planning-days { height: 36px; align-items: center; border-bottom: 1px solid color-mix(in srgb, var(--art-accent) 12%, transparent); color: color-mix(in srgb, var(--art-deep) 54%, white); font-size: 8px; text-align: center; }
  .planning-row { position: relative; height: 64px; background: repeating-linear-gradient(90deg, transparent 0 calc((100% - 64px) / 4 - 1px), color-mix(in srgb, var(--art-accent) 9%, transparent) calc((100% - 64px) / 4 - 1px) calc((100% - 64px) / 4)); }
  .planning-row + .planning-row { border-top: 1px solid color-mix(in srgb, var(--art-accent) 10%, transparent); }
  .planning-row > b { display: grid; z-index: 2; place-items: center; background: rgb(255 255 255 / 92%); font-size: 9px; }
  .selected-row { background-color: color-mix(in srgb, var(--art-soft) 42%, white); }
  .planning-stay, .planning-ghost { position: absolute; top: 14px; height: 36px; border-radius: 10px; }
  .planning-stay { display: flex; z-index: 2; align-items: center; padding: 0 10px; background: color-mix(in srgb, var(--art-accent) 74%, white); color: white; font-size: 8px; font-style: normal; font-weight: 800; box-shadow: 0 7px 14px color-mix(in srgb, var(--art-deep) 12%, transparent); }
  .planning-stay span { display: grid; width: 16px; height: 16px; place-items: center; margin-left: auto; border-radius: 50%; background: white; color: var(--art-accent); }
  .stay-martin { left: calc(64px + (100% - 64px) * .04); width: calc((100% - 64px) * .52); }
  .stay-lopez { left: calc(64px + (100% - 64px) * .28); width: calc((100% - 64px) * .65); background: var(--art-accent); }
  .stay-ruiz { left: calc(64px + (100% - 64px) * .63); width: calc((100% - 64px) * .45); }
  .planning-ghost { left: calc(64px + (100% - 64px) * .035); width: calc((100% - 64px) * .21); border: 1.5px dashed color-mix(in srgb, var(--art-accent) 55%, white); background: color-mix(in srgb, var(--art-accent) 8%, transparent); }
