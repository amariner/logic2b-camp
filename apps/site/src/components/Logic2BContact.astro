---
import {
  LOGIC2B_CONTACT_SCROLL_PX,
  logic2bContact,
  type Logic2BContactContext,
} from '@logic-camp/config/contact';
import { siWhatsapp } from 'simple-icons';

interface Props {
  locale: string;
  context: Logic2BContactContext;
}

const { locale, context } = Astro.props;
const contact = logic2bContact(locale, context);
---

<a
  href={contact.href}
  target="_blank"
  rel="noopener noreferrer"
  class="l2b-contact-float"
  aria-label={contact.ariaLabel}
  title={`${contact.ariaLabel} · ${contact.phone}`}
  data-logic2b-contact
  data-contact-context={context}
  data-visible="false"
  tabindex="-1"
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d={siWhatsapp.path} />
  </svg>
  <span>{contact.label}</span>
</a>

<audio
  src="/media/contact-reception-chime.wav"
  preload="auto"
  aria-hidden="true"
  data-logic2b-contact-chime
></audio>

<script is:inline define:vars={{ threshold: LOGIC2B_CONTACT_SCROLL_PX }}>
  (() => {
    const contact = document.querySelector('[data-logic2b-contact]');
    const chime = document.querySelector('[data-logic2b-contact-chime]');
    const footer = document.querySelector('footer');
    const consent = document.querySelector('[data-consent-banner]');
    const dialog = document.getElementById('project-request-dialog');
    if (!(contact instanceof HTMLAnchorElement)) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const announcementKey = 'logic2b-contact-announced-v1';
    let footerVisible = false;
    let wasVisible = false;
    let retryChime = false;
    let announced = false;
    try {
      announced = sessionStorage.getItem(announcementKey) === '1';
    } catch {}

    const playChime = () => {
      if (!(chime instanceof HTMLAudioElement)) return;
      chime.volume = 0.55;
      chime.currentTime = 0;
      const playback = chime.play();
      if (playback) {
        playback.then(() => { retryChime = false; }).catch(() => { retryChime = true; });
      }
    };
    const retryBlockedChime = () => {
      if (retryChime && contact.dataset.visible === 'true') playChime();
    };
    const announce = () => {
      announced = true;
      try {
        sessionStorage.setItem(announcementKey, '1');
      } catch {}
      if (!reduceMotion) {
        contact.classList.add('is-announcing');
        window.setTimeout(() => contact.classList.remove('is-announcing'), 600);
      }
      if (document.visibilityState === 'visible') playChime();
      else retryChime = true;
    };

    const blocked = () =>
      footerVisible ||
      (consent instanceof HTMLElement && !consent.hidden) ||
      (dialog instanceof HTMLDialogElement && dialog.open);
    const update = () => {
      const visible = window.scrollY > threshold && !blocked();
      contact.dataset.visible = String(visible);
      contact.tabIndex = visible ? 0 : -1;
      if (visible && !wasVisible && !announced) announce();
      wasVisible = visible;
    };

    if (footer && 'IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        footerVisible = entries.some((entry) => entry.isIntersecting);
        update();
      }).observe(footer);
    }
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('pointerdown', retryBlockedChime, { passive: true });
    window.addEventListener('touchstart', retryBlockedChime, { passive: true });
    window.addEventListener('keydown', retryBlockedChime);
    document.addEventListener('visibilitychange', retryBlockedChime);
    new MutationObserver(update).observe(document.body, {
      attributes: true,
      subtree: true,
      attributeFilter: ['hidden', 'open'],
    });
    update();
  })();
</script>

<style>
  .l2b-contact-float {
    --contact-green: #137a3b;
    position: fixed;
    right: calc(
      max(
        clamp(16px, 2.5vw, 36px),
        calc((100vw - 1600px) / 2),
        env(safe-area-inset-right)
      ) + 8px
    );
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 45;
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    gap: 10px;
    border: 3px solid var(--contact-green);
    border-radius: 14px;
    background: rgb(19 122 59 / 10%);
    padding: 8px 14px 8px 10px;
    color: var(--contact-green);
    font-size: 14px;
    font-weight: 700;
    box-shadow: none;
    opacity: 0;
    pointer-events: none;
    transform: translateY(12px);
    transition:
      border-color 180ms ease,
      color 180ms ease,
      opacity 180ms ease,
      transform 180ms ease;
  }
  .l2b-contact-float[data-visible='true'] {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }
  .l2b-contact-float.is-announcing {
    animation: l2b-contact-greeting 560ms cubic-bezier(.22, .61, .36, 1) both;
  }
  .l2b-contact-float svg {
    width: 25px;
    height: 25px;
    flex: none;
    fill: currentColor;
  }
  .l2b-contact-float:hover {
    border-color: var(--botanical-ink);
    background: rgb(19 122 59 / 10%);
    color: var(--botanical-ink);
    transform: translateY(-1px);
  }
  .l2b-contact-float:focus-visible {
    outline: 3px solid var(--botanical-ink);
    outline-offset: 4px;
  }
  @keyframes l2b-contact-greeting {
    0%, 100% { transform: translateX(0) rotate(0); }
    24% { transform: translateX(-1px) rotate(-.35deg); }
    48% { transform: translateX(1px) rotate(.35deg); }
    72% { transform: translateX(-.5px) rotate(-.15deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .l2b-contact-float { transition: none; transform: none; }
    .l2b-contact-float.is-announcing { animation: none; }
  }
</style>
