---
interface Props {
  alt: string;
  mapAlt: string;
  windowLabel: string;
  mapTitle: string;
  mapStatus: string;
  mapMetric: string;
  mapLegend: {
    libre: string;
    ocupada: string;
    bloqueada: string;
  };
}

const { alt, mapAlt, windowLabel, mapTitle, mapStatus, mapMetric, mapLegend } = Astro.props;
const days = Array.from({ length: 15 }, (_, index) => index + 1);
const rows = Array.from({ length: 12 }, (_, index) => index + 1);
const bookings = [
  { row: 0, start: 1, span: 4, tone: 'ink' },
  { row: 0, start: 9, span: 4, tone: 'sage' },
  { row: 1, start: 0, span: 3, tone: 'mint' },
  { row: 1, start: 5, span: 6, tone: 'ink' },
  { row: 2, start: 2, span: 5, tone: 'ink' },
  { row: 2, start: 9, span: 5, tone: 'sage' },
  { row: 3, start: 0, span: 4, tone: 'sage' },
  { row: 3, start: 6, span: 5, tone: 'ink' },
  { row: 4, start: 3, span: 5, tone: 'ink' },
  { row: 4, start: 10, span: 4, tone: 'mint' },
  { row: 5, start: 0, span: 5, tone: 'ink' },
  { row: 5, start: 7, span: 6, tone: 'sage' },
  { row: 6, start: 2, span: 3, tone: 'mint' },
  { row: 6, start: 6, span: 6, tone: 'ink' },
  { row: 7, start: 0, span: 4, tone: 'ink' },
  { row: 7, start: 5, span: 3, tone: 'sage' },
  { row: 7, start: 10, span: 4, tone: 'ink' },
  { row: 8, start: 1, span: 6, tone: 'sage' },
  { row: 8, start: 9, span: 5, tone: 'ink' },
  { row: 9, start: 0, span: 3, tone: 'mint' },
  { row: 9, start: 4, span: 7, tone: 'ink' },
  { row: 10, start: 2, span: 5, tone: 'ink' },
  { row: 10, start: 9, span: 4, tone: 'sage' },
  { row: 11, start: 0, span: 5, tone: 'sage' },
  { row: 11, start: 6, span: 7, tone: 'ink' },
];
const mapUnits = [
  { x: 660, y: 451, status: 'occupied', angle: -5, label: 'P-01' },
  { x: 712, y: 446, status: 'free', angle: -5, label: 'P-02' },
  { x: 764, y: 440, status: 'occupied', angle: -5, label: 'P-03' },
  { x: 816, y: 434, status: 'blocked', angle: -5, label: 'P-04' },
  { x: 651, y: 488, status: 'occupied', angle: 4, label: 'P-05' },
  { x: 705, y: 481, status: 'occupied', angle: 4, label: 'P-06' },
  { x: 759, y: 474, status: 'free', angle: 4, label: 'P-07' },
  { x: 813, y: 467, status: 'occupied', angle: 4, label: 'P-08' },
  { x: 867, y: 460, status: 'free', angle: 4, label: 'P-09' },
  { x: 677, y: 534, status: 'free', angle: -5, label: 'P-10' },
  { x: 731, y: 527, status: 'occupied', angle: -5, label: 'P-11' },
  { x: 785, y: 520, status: 'occupied', angle: -5, label: 'P-12' },
  { x: 839, y: 513, status: 'blocked', angle: -5, label: 'P-13' },
  { x: 893, y: 506, status: 'occupied', angle: -5, label: 'P-14' },
];
const mapTrees = [[648, 569], [672, 575], [900, 552], [925, 545], [974, 498], [950, 570]];
---

<svg class="planning-visual" viewBox="0 0 1040 650" role="img" aria-labelledby="planning-art-title planning-art-desc">
  <title id="planning-art-title">{alt}</title>
  <desc id="planning-art-desc">{mapAlt}</desc>
  <defs>
    <filter id="map-shadow" x="-20%" y="-20%" width="140%" height="160%">
      <feDropShadow dx="0" dy="10" stdDeviation="10" flood-color="#0f3e17" flood-opacity=".16" />
    </filter>
    <pattern id="blocked-pattern" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <rect width="5" height="5" fill="#b6ced5" />
      <path d="M0 0V5" stroke="#0f3e17" stroke-width="1" opacity=".25" />
    </pattern>
  </defs>

  <path d="M-80 570c145-110 256-116 365-28s217 83 332-8 250-103 500 18" class="contour" />
  <path d="M-75 608c147-107 258-111 366-24s215 80 330-11 253-98 502 21" class="contour" />

  <rect x="28" y="28" width="954" height="528" rx="20" fill="#fffefc" />
  <rect x="28" y="28" width="954" height="52" rx="20" fill="#e1f4df" />
  <rect x="28" y="60" width="954" height="20" fill="#e1f4df" />
  <circle cx="52" cy="54" r="5" fill="#b1dbb8" />
  <circle cx="68" cy="54" r="5" fill="#cfe7d3" />
  <circle cx="84" cy="54" r="5" fill="#fffefc" />
  <text x="104" y="58" class="window-label">{windowLabel}</text>
  <rect x="830" y="43" width="126" height="24" rx="8" fill="#0f3e17" />
  <text x="865" y="59" class="button-label">+ RESERVA</text>

  <rect x="48" y="101" width="148" height="426" rx="12" fill="#e1f4df" />
  <text x="68" y="128" class="eyebrow">ALOJAMIENTOS</text>
  <rect x="68" y="144" width="108" height="28" rx="8" fill="#0f3e17" />
  <circle cx="84" cy="158" r="5" fill="#b1dbb8" />
  <rect x="96" y="154" width="56" height="7" rx="3.5" fill="#fffefc" opacity=".82" />
  {[0, 1, 2, 3].map((item) => (
    <g transform={`translate(0 ${item * 44})`}>
      <circle cx="84" cy="198" r="5" fill="#0f3e17" opacity=".48" />
      <rect x="96" y="194" width={item === 2 ? '48' : '66'} height="7" rx="3.5" fill="#0f3e17" opacity=".36" />
    </g>
  ))}
  <rect x="68" y="393" width="108" height="1" fill="#0f3e17" opacity=".12" />
  <text x="68" y="422" class="eyebrow">OCUPACIÓN</text>
  <text x="68" y="466" class="occupancy">86%</text>
  <rect x="68" y="482" width="108" height="7" rx="3.5" fill="#fffefc" />
  <rect x="68" y="482" width="92" height="7" rx="3.5" fill="#0f3e17" />

  <rect x="216" y="101" width="746" height="426" rx="12" fill="#fffefc" stroke="#e8e9e4" />
  <text x="238" y="128" class="eyebrow">AGOSTO 2026</text>
  <rect x="823" y="112" width="56" height="20" rx="10" fill="#e1f4df" />
  <rect x="888" y="112" width="54" height="20" rx="10" fill="#cfe7d3" />
  <path d="M238 148H942" stroke="#e8e9e4" />

  {days.map((day, index) => (
    <g>
      {day === 9 && <circle cx={283 + index * 43} cy="168" r="13" fill="#0f3e17" class="day-circle" />}
      <text x={283 + index * 43} y="171" class:list={['day', day === 9 && 'today']}>{day}</text>
      <path d={`M${260 + index * 43} 182V507`} stroke="#e8e9e4" opacity={day % 7 === 3 || day % 7 === 4 ? '.9' : '.52'} />
      {(day % 7 === 3 || day % 7 === 4) && <rect x={260 + index * 43} y="183" width="43" height="324" fill="#e1f4df" opacity=".42" />}
    </g>
  ))}

  {rows.map((row, index) => (
    <g>
      <text x="232" y={207 + index * 25} class="row-label">A-{String(row).padStart(2, '0')}</text>
      <path d={`M260 ${201 + index * 25}H942`} stroke="#e8e9e4" />
    </g>
  ))}

  {bookings.map((booking, index) => (
    <g>
      <rect
        x={264 + booking.start * 43}
        y={190 + booking.row * 25}
        width={booking.span * 43 - 7}
        height="18"
        rx="5"
        fill={booking.tone === 'ink' ? '#0f3e17' : booking.tone === 'sage' ? '#b1dbb8' : '#cfe7d3'}
      />
      <circle
        cx={275 + booking.start * 43}
        cy={199 + booking.row * 25}
        r="2.5"
        fill={booking.tone === 'ink' ? '#fffefc' : '#0f3e17'}
        opacity=".72"
      />
      {index % 3 === 0 && (
        <rect
          x={283 + booking.start * 43}
          y={197 + booking.row * 25}
          width={Math.min(booking.span * 18, 44)}
          height="4"
          rx="2"
          fill={booking.tone === 'ink' ? '#fffefc' : '#0f3e17'}
          opacity=".42"
        />
      )}
    </g>
  ))}

  <path d="M630 183V507" stroke="#0f3e17" stroke-width="2" stroke-dasharray="4 5" opacity=".45" />
  <rect x="606" y="154" width="48" height="20" rx="10" fill="#0f3e17" />
  <text x="620" y="168" class="today-label">HOY</text>

  <g class="map-card">
    <rect x="620" y="356" width="392" height="274" rx="19" fill="#fffefc" filter="url(#map-shadow)" />
    <rect x="634" y="370" width="364" height="54" rx="12" fill="#fffefc" stroke="#e8e9e4" />
    <circle cx="652" cy="389" r="5" fill="#0f3e17" />
    <text x="664" y="392" class="map-title">{mapTitle}</text>
    <rect x="898" y="380" width="84" height="19" rx="9.5" fill="#e1f4df" />
    <circle cx="910" cy="389.5" r="3" fill="#0f3e17" />
    <text x="919" y="392" class="map-status">{mapStatus}</text>
    <text x="651" y="413" class="map-metric">{mapMetric}</text>

    <rect x="634" y="432" width="364" height="160" rx="12" fill="#e1f4df" />
    <path d="M625 498c54-52 105-62 156-30s101 27 150-13 80-43 102-30M619 522c58-50 108-57 156-26s98 27 148-12 83-40 111-25" class="map-contour" />
    <path d="M643 584c53-58 106-68 157-34s101 25 147-20 72-55 92-59" fill="none" stroke="#b6ced5" stroke-width="31" stroke-linecap="round" />
    <path d="M643 584c53-58 106-68 157-34s101 25 147-20 72-55 92-59" fill="none" stroke="#fffefc" stroke-width="5" stroke-dasharray="10 8" stroke-linecap="round" />
    <path d="M801 550c-5-32 5-62 33-91" fill="none" stroke="#b6ced5" stroke-width="18" stroke-linecap="round" />
    <path d="M801 550c-5-32 5-62 33-91" fill="none" stroke="#fffefc" stroke-width="3" stroke-dasharray="7 6" stroke-linecap="round" />

    {mapUnits.map((unit) => (
      <g transform={`rotate(${unit.angle} ${unit.x + 22} ${unit.y + 13})`}>
        <rect
          x={unit.x}
          y={unit.y}
          width="44"
          height="25"
          rx="6"
          fill={unit.status === 'occupied' ? '#0f3e17' : unit.status === 'blocked' ? 'url(#blocked-pattern)' : '#fffefc'}
          stroke="#0f3e17"
          stroke-width={unit.status === 'free' ? '1.2' : '.7'}
          opacity={unit.status === 'free' ? '.96' : '1'}
        />
        <text x={unit.x + 7} y={unit.y + 16} class:list={['map-unit-label', unit.status === 'occupied' && 'is-occupied']}>{unit.label}</text>
        {unit.label === 'P-08' && <circle cx={unit.x + 36} cy={unit.y + 7} r="3.5" fill="#b1dbb8" stroke="#fffefc" stroke-width="1.2" />}
      </g>
    ))}

    <g class="map-pool">
      <rect x="919" y="528" width="61" height="39" rx="9" fill="#b6ced5" stroke="#fffefc" stroke-width="3" />
      <path d="M930 541c5-4 10-4 15 0s10 4 15 0M930 550c5-4 10-4 15 0s10 4 15 0" fill="none" stroke="#fffefc" stroke-width="2" stroke-linecap="round" />
    </g>
    <g class="map-reception">
      <rect x="930" y="445" width="49" height="37" rx="8" fill="#fffefc" stroke="#0f3e17" stroke-width="1.2" />
      <path d="m936 453 18-10 19 10" fill="#b1dbb8" stroke="#0f3e17" stroke-width="1.2" stroke-linejoin="round" />
      <rect x="950" y="460" width="9" height="22" rx="2" fill="#0f3e17" />
      <circle cx="956" cy="471" r="1" fill="#fffefc" />
    </g>
    {mapTrees.map(([x, y]) => (
      <g transform={`translate(${x} ${y})`}>
        <path d="M0 12 7 0l7 12H9l5 8H0l5-8Z" fill="#b1dbb8" stroke="#0f3e17" stroke-width="1" stroke-linejoin="round" />
        <path d="M7 20v5" stroke="#0f3e17" stroke-width="1.4" stroke-linecap="round" />
      </g>
    ))}

    <g class="map-controls">
      <rect x="968" y="435" width="21" height="45" rx="7" fill="#fffefc" stroke="#e8e9e4" />
      <path d="M974 446h9m-4.5-4.5v9M974 468h9" stroke="#0f3e17" stroke-width="1.5" stroke-linecap="round" />
      <path d="M968 457h21" stroke="#e8e9e4" />
    </g>

    <g class="map-legend">
      <circle cx="652" cy="611" r="4" fill="#fffefc" stroke="#0f3e17" />
      <text x="661" y="614" class="map-legend-label">{mapLegend.libre}</text>
      <circle cx="750" cy="611" r="4" fill="#0f3e17" />
      <text x="759" y="614" class="map-legend-label">{mapLegend.ocupada}</text>
      <circle cx="865" cy="611" r="4" fill="#b6ced5" stroke="#0f3e17" />
      <text x="874" y="614" class="map-legend-label">{mapLegend.bloqueada}</text>
    </g>
  </g>
</svg>

<style>
  .planning-visual { display:block; width:100%; height:auto; }
  .contour { fill:none; stroke:#0f3e17; stroke-width:1.3; opacity:.13; }
  .window-label,.eyebrow,.button-label,.day,.row-label,.today-label { font-family:Arial,sans-serif; fill:#0f3e17; }
  .window-label { font-size:10px; opacity:.62; }
  .eyebrow { font-size:8px; font-weight:700; letter-spacing:1px; }
  .button-label,.today-label { fill:#fffefc; font-size:7px; font-weight:700; letter-spacing:.5px; }
  .occupancy { font-family:Georgia,serif; font-size:38px; fill:#0f3e17; }
  .day { font-size:8px; text-anchor:middle; }
  .day.today { position:relative; z-index:1; fill:#fffefc; }
  .day-circle { transform-box:fill-box; transform-origin:center; }
  .row-label { font-size:7px; opacity:.58; }
  .map-card { transform:translateY(0); }
  .map-title,.map-status,.map-metric,.map-unit-label,.map-legend-label { font-family:Arial,sans-serif; fill:#0f3e17; }
  .map-title { font-size:10px; font-weight:700; letter-spacing:.45px; text-transform:uppercase; }
  .map-status { font-size:6px; font-weight:700; letter-spacing:.4px; text-transform:uppercase; }
  .map-metric { font-size:7px; font-weight:600; opacity:.58; }
  .map-contour { fill:none; stroke:#0f3e17; stroke-width:1; opacity:.09; }
  .map-unit-label { font-size:5.5px; font-weight:700; letter-spacing:.2px; }
  .map-unit-label.is-occupied { fill:#fffefc; }
  .map-legend-label { font-size:6px; font-weight:600; opacity:.62; }
</style>
