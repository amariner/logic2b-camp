---
/** Índice de UNA guía: portada + lista de sus páginas. Compartido por `/docs/{guia}/` y su variante por idioma. */
import Docs from '../layouts/Docs.astro';
import { getGuia, type Guia } from '../lib/docs';
import { getContent, localePath, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  guia: Guia;
}
const { locale, guia } = Astro.props;
const c = getContent(locale);
const d = c.docs;
const meta = d.guias[guia];
const paginas = getGuia(guia, locale);
const ruta = `docs/${guia}/`;
---

<Docs
  locale={locale}
  guia={guia}
  paginas={paginas}
  seo={{ title: `${meta.nombre} — Logic2B Campings`, description: meta.texto }}
  ruta={ruta}
>
  <p class="botanical-eyebrow">{meta.para}</p>
  {/* Sin font-display ni bold: el h1 hereda la serif tinta del tema botánico. */}
  <h1 class="mt-3 text-3xl sm:text-4xl">{meta.nombre}</h1>
  <p class="mt-4 max-w-2xl text-lg text-muted-foreground">{meta.texto}</p>

  {
    paginas.length > 0 && (
      <a href={localePath(locale, `${ruta}${paginas[0]!.slug}/`)} class="botanical-button mt-7">
        {d.empezar}
        <span aria-hidden="true">&rarr;</span>
      </a>
    )
  }

  <ol class="mt-10 divide-y divide-border border-t border-border">
    {
      paginas.map((p, i) => (
        <li>
          <a
            href={localePath(locale, `${ruta}${p.slug}/`)}
            class="flex gap-4 py-4 transition-colors hover:bg-muted/40"
          >
            <span class="tnum w-6 shrink-0 text-sm text-muted-foreground">{i + 1}</span>
            <span class="min-w-0">
              <span class="block font-medium">{p.frontmatter.title}</span>
              <span class="mt-0.5 block text-sm text-muted-foreground">
                {p.frontmatter.description}
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</Docs>
