---
import ManagementPanelVisual from './ManagementPanelVisual.astro';
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  content: any;
  href: string;
}

const { locale, content, href } = Astro.props;
const managerBase = import.meta.env.DEV ? 'http://localhost:5173/admin' : '/admin';
const visualLabels = locale === 'es'
  ? { gestion: 'Vista simulada del panel Gestión', avanzado: 'Vista simulada del panel Avanzado' }
  : { gestion: 'Simulated Management dashboard view', avanzado: 'Simulated Advanced dashboard view' };
---

<section class="management-panels-showcase" aria-labelledby="management-panels-title">
  <div class="management-panels-shell">
    <header class="management-panels-head lc-reveal">
      <div>
        <p>{content.kicker}</p>
        <h2 id="management-panels-title">{content.titulo}</h2>
      </div>
      <div class="management-panels-intro">
        <p>{content.texto}</p>
        <a href={href}>{content.verTodos}<span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <div class="management-panels-grid">
      {content.tipos.map((tipo: any, index: number) => (
        <article class:list={['management-panel-card', `is-${tipo.id}`, 'lc-reveal']} style={`--lc-delay:${index * 80}ms`}>
          <ManagementPanelVisual variant={tipo.id} label={tipo.nombre} ariaLabel={visualLabels[tipo.id as keyof typeof visualLabels]} />
          <div class="management-panel-copy">
            <div class="management-panel-meta"><span>{tipo.etiqueta}</span><b>{String(index + 1).padStart(2, '0')}</b></div>
            <h3>{tipo.titulo}</h3>
            <p>{tipo.texto}</p>
            <ul>{tipo.incluye.map((item: string) => <li><span aria-hidden="true">✓</span>{item}</li>)}</ul>
            <a class="management-panel-link" href={`${managerBase}/${tipo.ruta}`}>
              <span>{tipo.cta}</span><i aria-hidden="true">↗</i>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .management-panels-showcase{padding:clamp(78px,9vw,138px) 0;background:var(--botanical-ink);color:var(--botanical-paper)}
  .management-panels-shell{width:min(1500px,calc(100% - 48px));margin:0 auto}.management-panels-head{display:grid;grid-template-columns:1.12fr .88fr;gap:clamp(40px,9vw,150px);align-items:end}.management-panels-head>div:first-child>p{font-size:11px;font-weight:750;letter-spacing:.12em;text-transform:uppercase;color:#b9d0bd}.management-panels-head h2{max-width:790px;margin-top:17px;color:inherit;font-family:var(--botanical-serif);font-size:clamp(43px,5.5vw,82px);font-weight:400;letter-spacing:-.045em;line-height:.94}.management-panels-intro{display:grid;gap:25px}.management-panels-intro>p{max-width:580px;font-size:clamp(15px,1.3vw,19px);line-height:1.6;color:rgb(250 249 245 / 70%)}.management-panels-intro>a{display:inline-flex;width:max-content;align-items:center;gap:10px;border-bottom:1px solid rgb(250 249 245 / 42%);padding-bottom:5px;color:inherit;font-size:13px;font-weight:700}.management-panels-intro>a span{font-size:17px}
  .management-panels-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin-top:clamp(45px,6vw,78px)}.management-panel-card{min-width:0;border-radius:30px;background:#f5f7f3;padding:16px;color:var(--botanical-ink)}.management-panel-card.is-avanzado{background:#edf1e9}.management-panel-copy{padding:clamp(24px,3vw,42px) clamp(12px,2vw,28px) 20px}.management-panel-meta{display:flex;align-items:center;justify-content:space-between}.management-panel-meta span{font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:rgb(15 62 23 / 52%)}.management-panel-meta b{font-family:var(--botanical-serif);font-size:22px;font-weight:400;color:rgb(15 62 23 / 35%)}.management-panel-copy h3{max-width:590px;margin-top:20px;font-family:var(--botanical-serif);font-size:clamp(31px,3.1vw,48px);font-weight:400;letter-spacing:-.035em;line-height:1}.management-panel-copy>p{max-width:590px;margin-top:17px;font-size:14px;line-height:1.62;color:rgb(15 62 23 / 67%)}.management-panel-copy ul{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:11px;margin-top:27px}.management-panel-copy li{display:flex;align-items:flex-start;gap:7px;border-top:1px solid rgb(15 62 23 / 13%);padding-top:10px;font-size:11px;line-height:1.35}.management-panel-copy li span{font-weight:900;color:#2e7c42}.management-panel-link{display:flex;align-items:center;justify-content:space-between;margin-top:30px;border-top:1px solid rgb(15 62 23 / 16%);padding-top:17px;color:inherit;font-size:13px;font-weight:800}.management-panel-link i{display:grid;width:38px;height:38px;place-items:center;border-radius:50%;background:var(--botanical-ink);color:white;font-size:16px;font-style:normal;transition:transform .2s ease}.management-panel-link:hover i{transform:translate(2px,-2px)}.is-avanzado .management-panel-link i{background:#dbe947;color:var(--botanical-ink)}
  @media(max-width:1000px){.management-panels-grid{grid-template-columns:1fr}.management-panels-head{gap:50px}.management-panel-copy ul{grid-template-columns:repeat(3,1fr)}}
  @media(max-width:720px){.management-panels-shell{width:min(100% - 28px,1500px)}.management-panels-head{grid-template-columns:1fr;gap:28px}.management-panels-head h2{font-size:clamp(40px,14vw,62px)}.management-panel-card{border-radius:22px;padding:10px}.management-panel-copy{padding:25px 11px 16px}.management-panel-copy ul{grid-template-columns:1fr}.management-panel-copy h3{font-size:35px}}
</style>
