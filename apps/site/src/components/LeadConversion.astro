---
import Base from '../layouts/Base.astro';
import { getContent, localePath, type Locale } from '../lib/i18n';
import { getManagementPanelViews } from '../lib/managementPanels';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = getContent(locale);
const planOptions = c.pricingShowcase.items.map((plan) => ({
  id: plan.id,
  name: plan.nombre,
  monthlyPrice: plan.precio,
  monthlyPeriod: plan.periodo,
  annualPrice: plan.precioAnual,
  annualPeriod: plan.periodoAnual,
  onboarding: 'onboarding' in plan ? plan.onboarding : '',
}));
const themeOptions = c.temas.items.map((theme) => ({
  id: theme.slug,
  name: theme.nombre,
  style: theme.estilo,
}));
const panelOptions = getManagementPanelViews(locale).map(({ id, name }) => ({ id, name }));
const panelSelectedLabel = locale === 'es' ? 'Panel seleccionado' : 'Selected dashboard';
const panelMessage = locale === 'es'
  ? 'Me interesa el panel {panel} y quiero adaptarlo a la operativa de mi camping.'
  : 'I am interested in the {panel} dashboard and want to adapt it to my campsite operation.';
---

<Base
  locale={locale}
  content={c}
  ruta="empezar/"
  seo={{ title: c.conversion.seoTitle, description: c.conversion.seoDescription }}
>
  <div class="conversion-page botanical-page">
    <section class="botanical-shell conversion-layout" aria-labelledby="conversion-title">
      <div class="conversion-copy">
        <p class="botanical-eyebrow">{c.conversion.kicker}</p>
        <h1 id="conversion-title">{c.conversion.titulo}</h1>
        <p>{c.conversion.texto}</p>
        <ul>
          {c.conversion.beneficios.map((benefit) => (
            <li><span aria-hidden="true">✓</span>{benefit}</li>
          ))}
        </ul>
      </div>

      <div class="conversion-card">
        <p class="botanical-eyebrow">{c.conversion.formKicker}</p>
        <h2>{c.conversion.formTitulo}</h2>
        <p class="conversion-card-copy">{c.conversion.formTexto}</p>

        <div class="conversion-selection" data-conversion-selection hidden>
          <div>
            <p data-conversion-selection-label>{c.contacto.planSeleccionado}</p>
            <h3 data-conversion-plan-name></h3>
          </div>
          <div class="conversion-selection-price" data-conversion-selection-price>
            <strong data-conversion-plan-price></strong>
            <span data-conversion-plan-period></span>
          </div>
          <small data-conversion-plan-onboarding hidden></small>
        </div>

        <form id="conversion-lead-form" novalidate>
          <input type="hidden" name="lang" value={locale} />
          <input type="hidden" name="plan" data-conversion-plan-input />
          <input type="hidden" name="billing" data-conversion-billing-input />
          <input type="hidden" name="theme" data-conversion-theme-input />
          <label>
            <span>{c.contacto.campos.nombre}</span>
            <input name="name" autocomplete="name" required />
          </label>
          <label>
            <span>{c.contacto.campos.camping}</span>
            <input name="campingName" autocomplete="organization" required />
          </label>
          <label class="conversion-span-two">
            <span>{c.contacto.campos.email}</span>
            <input name="email" type="email" inputmode="email" autocomplete="email" data-conversion-email required />
          </label>
          <label>
            <span>{c.contacto.campos.telefono}</span>
            <input name="phone" type="tel" autocomplete="tel" />
          </label>
          <label>
            <span>{c.contacto.campos.mensaje}</span>
            <input name="message" placeholder={c.conversion.mensajePlaceholder} />
          </label>
          <label class="botanical-honeypot" aria-hidden="true">
            <span>{c.contacto.honeypot}</span>
            <input name="website" tabindex="-1" autocomplete="off" />
          </label>
          <label class="conversion-consent conversion-span-two">
            <input name="accept" type="checkbox" value="true" required />
            <span>
              {c.contacto.privacidadAntes}{' '}
              <a href={localePath(locale, 'privacidad/')}>{c.contacto.privacidadEnlace}</a>.
            </span>
          </label>
          <button
            class="botanical-button conversion-submit conversion-span-two"
            type="submit"
            data-send={c.conversion.enviar}
            data-sending={c.contacto.enviando}
          >
            <span data-conversion-submit-label>{c.conversion.enviar}</span><span aria-hidden="true">→</span>
          </button>
          <p id="conversion-lead-message" class="conversion-span-two" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </div>

  <script is:inline define:vars={{ ok: c.contacto.ok, demo: c.contacto.demo, err: c.contacto.error, planOptions, themeOptions, panelOptions, panelSelectedLabel, panelMessage, themeSelectedLabel: c.conversion.temaSeleccionado, themeMessage: c.conversion.mensajeTema }}>
  const conversionForm = document.getElementById('conversion-lead-form');
  const conversionEmail = conversionForm?.querySelector('[data-conversion-email]');
  const conversionPlanInput = conversionForm?.querySelector('[data-conversion-plan-input]');
  const conversionBillingInput = conversionForm?.querySelector('[data-conversion-billing-input]');
  const conversionThemeInput = conversionForm?.querySelector('[data-conversion-theme-input]');
  const conversionMessageInput = conversionForm?.querySelector('[name="message"]');
  const conversionSelection = document.querySelector('[data-conversion-selection]');
  const conversionSelectionLabel = conversionSelection?.querySelector('[data-conversion-selection-label]');
  const conversionSelectionPrice = conversionSelection?.querySelector('[data-conversion-selection-price]');
  const conversionPlanName = conversionSelection?.querySelector('[data-conversion-plan-name]');
  const conversionPlanPrice = conversionSelection?.querySelector('[data-conversion-plan-price]');
  const conversionPlanPeriod = conversionSelection?.querySelector('[data-conversion-plan-period]');
  const conversionPlanOnboarding = conversionSelection?.querySelector('[data-conversion-plan-onboarding]');
  const conversionSubmit = conversionForm?.querySelector('button[type="submit"]');
  const conversionSubmitLabel = conversionSubmit?.querySelector('[data-conversion-submit-label]');
  const conversionMessage = document.getElementById('conversion-lead-message');
  const conversionParams = new URLSearchParams(window.location.search);
  const requestedEmail = conversionParams.get('email')?.trim() ?? '';
  const requestedPlanId = conversionParams.get('plan')?.trim() ?? '';
  const requestedBilling = conversionParams.get('billing') === 'annual' ? 'annual' : 'monthly';
  const requestedPlan = planOptions.find((plan) => plan.id === requestedPlanId);
  const requestedThemeId = conversionParams.get('theme')?.trim() ?? '';
  const requestedTheme = themeOptions.find((theme) => theme.id === requestedThemeId);
  const requestedPanelId = conversionParams.get('panel')?.trim() ?? '';
  const requestedPanel = panelOptions.find((panel) => panel.id === requestedPanelId);

  if (conversionEmail instanceof HTMLInputElement && requestedEmail) {
    conversionEmail.value = requestedEmail;
  }

  if (requestedPlan) {
    const syncRequestedPlan = () => {
      if (conversionPlanInput) conversionPlanInput.value = requestedPlan.id;
      if (conversionBillingInput) conversionBillingInput.value = requestedBilling;
    };
    syncRequestedPlan();
    window.addEventListener('pageshow', syncRequestedPlan, { once: true });
    if (conversionPlanName) conversionPlanName.textContent = requestedPlan.name;
    if (conversionPlanPrice) {
      conversionPlanPrice.textContent = requestedBilling === 'annual'
        ? requestedPlan.annualPrice
        : requestedPlan.monthlyPrice;
    }
    if (conversionPlanPeriod) {
      conversionPlanPeriod.textContent = requestedBilling === 'annual'
        ? requestedPlan.annualPeriod
        : requestedPlan.monthlyPeriod;
    }
    if (conversionPlanOnboarding instanceof HTMLElement && requestedPlan.onboarding) {
      conversionPlanOnboarding.textContent = requestedPlan.onboarding;
      conversionPlanOnboarding.hidden = false;
    }
    if (conversionSelection instanceof HTMLElement) conversionSelection.hidden = false;
  } else if (requestedTheme) {
    const syncRequestedTheme = () => {
      if (conversionThemeInput) conversionThemeInput.value = requestedTheme.id;
    };
    syncRequestedTheme();
    window.addEventListener('pageshow', syncRequestedTheme, { once: true });
    if (conversionSelectionLabel) conversionSelectionLabel.textContent = themeSelectedLabel;
    if (conversionPlanName) conversionPlanName.textContent = requestedTheme.name;
    if (conversionSelectionPrice instanceof HTMLElement) conversionSelectionPrice.hidden = true;
    if (conversionMessageInput instanceof HTMLInputElement && !conversionMessageInput.value) {
      conversionMessageInput.value = themeMessage.replace('{theme}', requestedTheme.name);
    }
    if (conversionSelection instanceof HTMLElement) conversionSelection.hidden = false;
  } else if (requestedPanel) {
    if (conversionSelectionLabel) conversionSelectionLabel.textContent = panelSelectedLabel;
    if (conversionPlanName) conversionPlanName.textContent = requestedPanel.name;
    if (conversionSelectionPrice instanceof HTMLElement) conversionSelectionPrice.hidden = true;
    if (conversionMessageInput instanceof HTMLInputElement && !conversionMessageInput.value) {
      conversionMessageInput.value = panelMessage.replace('{panel}', requestedPanel.name);
    }
    if (conversionSelection instanceof HTMLElement) conversionSelection.hidden = false;
  }

  conversionForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(conversionForm instanceof HTMLFormElement) || !conversionForm.reportValidity()) return;
    if (!(conversionSubmit instanceof HTMLButtonElement)) return;

    const data = Object.fromEntries(new FormData(conversionForm).entries());
    if (requestedPlan) {
      data.plan = requestedPlan.id;
      data.billing = requestedBilling;
    }
    if (requestedTheme) data.theme = requestedTheme.id;
    data.accept = data.accept === 'true';
    conversionSubmit.disabled = true;
    if (conversionSubmitLabel) conversionSubmitLabel.textContent = conversionSubmit.dataset.sending ?? '';
    if (conversionMessage) conversionMessage.textContent = '';

    try {
      const response = await fetch('/api/leads', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(data),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error('bad');
      if (conversionMessage) conversionMessage.textContent = result.outcome === 'demo' ? demo : ok;
      if (result.outcome === 'delivered') {
        window.l2bTrackEvent?.('camp_submit_lead', {
          form: 'conversion',
          locale: document.documentElement.lang,
          plan_id: requestedPlan?.id ?? '',
          billing: requestedPlan ? requestedBilling : '',
          theme_id: requestedTheme?.id ?? '',
        });
      }
    } catch {
      if (conversionMessage) conversionMessage.textContent = err;
    } finally {
      conversionSubmit.disabled = false;
      if (conversionSubmitLabel) conversionSubmitLabel.textContent = conversionSubmit.dataset.send ?? '';
    }
  });
  </script>
</Base>

<style>
  .conversion-page {
    min-height: 100svh;
    padding: clamp(36px, 5vw, 74px) 0 clamp(76px, 9vw, 128px);
  }

  .conversion-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(520px, 1.18fr);
    gap: clamp(60px, 9vw, 148px);
    align-items: center;
    min-height: calc(100svh - 190px);
  }

  .conversion-copy h1 {
    max-width: 650px;
    margin: 22px 0 0;
    font-size: clamp(58px, 6.4vw, 102px);
    letter-spacing: -0.055em;
    line-height: 0.94;
  }

  .conversion-copy > p:not(.botanical-eyebrow) {
    max-width: 560px;
    margin: 32px 0 0;
    color: color-mix(in srgb, var(--botanical-ink) 72%, white);
    font-size: clamp(16px, 1.45vw, 19px);
    line-height: 1.55;
  }

  .conversion-copy ul {
    display: grid;
    gap: 13px;
    margin: 34px 0 0;
    padding: 0;
    list-style: none;
  }

  .conversion-copy li {
    display: flex;
    align-items: center;
    gap: 12px;
    color: color-mix(in srgb, var(--botanical-ink) 76%, white);
    font-size: 14px;
  }

  .conversion-copy li span {
    display: grid;
    width: 24px;
    height: 24px;
    place-items: center;
    border-radius: 50%;
    background: var(--botanical-sage);
    color: var(--botanical-ink);
    font-size: 12px;
    font-weight: 700;
  }

  .conversion-card {
    border: 1px solid color-mix(in srgb, var(--botanical-ink) 11%, transparent);
    border-radius: clamp(22px, 2.4vw, 34px);
    background: color-mix(in srgb, var(--botanical-keylime) 44%, var(--botanical-paper));
    box-shadow: 0 24px 70px color-mix(in srgb, var(--botanical-ink) 11%, transparent);
    padding: clamp(30px, 4vw, 58px);
  }

  .conversion-card h2 {
    margin: 15px 0 0;
    font-size: clamp(36px, 3.6vw, 56px);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .conversion-card-copy {
    max-width: 580px;
    margin: 20px 0 0;
    color: color-mix(in srgb, var(--botanical-ink) 68%, white);
    font-size: 14px;
    line-height: 1.55;
  }

  .conversion-selection {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px 24px;
    margin-top: 24px;
    border: 1px solid color-mix(in srgb, var(--botanical-ink) 13%, transparent);
    border-radius: 18px;
    background: color-mix(in srgb, var(--botanical-paper) 82%, white);
    padding: 18px 20px;
  }

  .conversion-selection[hidden] {
    display: none;
  }

  .conversion-selection p {
    color: color-mix(in srgb, var(--botanical-ink) 58%, white);
    font-size: 10px;
    font-weight: 720;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .conversion-selection h3 {
    margin-top: 5px;
    color: var(--botanical-ink);
    font-size: clamp(23px, 2.1vw, 30px);
    font-weight: 590;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .conversion-selection-price {
    display: flex;
    align-items: baseline;
    gap: 6px;
    color: var(--botanical-ink);
  }

  .conversion-selection-price strong {
    font-size: clamp(25px, 2.4vw, 34px);
    font-weight: 590;
    letter-spacing: -0.045em;
  }

  .conversion-selection-price span,
  .conversion-selection small {
    color: color-mix(in srgb, var(--botanical-ink) 60%, white);
    font-size: 10px;
    font-weight: 620;
  }

  .conversion-selection small {
    grid-column: 1 / -1;
    border-top: 1px solid color-mix(in srgb, var(--botanical-ink) 10%, transparent);
    padding-top: 10px;
  }

  .conversion-card form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: 34px;
  }

  .conversion-card .botanical-honeypot {
    display: none;
  }

  .conversion-card label:not(.conversion-consent):not(.botanical-honeypot) {
    display: grid;
    gap: 8px;
  }

  .conversion-card label > span:first-child {
    color: color-mix(in srgb, var(--botanical-ink) 66%, white);
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .conversion-card input:not([type='checkbox']) {
    width: 100%;
    min-height: 54px;
    border: 1px solid color-mix(in srgb, var(--botanical-ink) 16%, transparent);
    border-radius: 12px;
    outline: 0;
    background: var(--botanical-paper);
    padding: 13px 15px;
    color: var(--botanical-ink);
    font: inherit;
    font-size: 15px;
  }

  .conversion-card input:not([type='checkbox']):focus {
    border-color: color-mix(in srgb, var(--botanical-ink) 50%, transparent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--botanical-sage) 40%, transparent);
  }

  .conversion-span-two {
    grid-column: 1 / -1;
  }

  .conversion-consent {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: color-mix(in srgb, var(--botanical-ink) 66%, white);
    font-size: 12px;
    line-height: 1.45;
  }

  .conversion-consent input {
    margin-top: 2px;
  }

  .conversion-consent a {
    color: var(--botanical-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .conversion-submit {
    width: 100%;
    min-height: 58px;
    border: 0;
    border-radius: 999px;
    font: inherit;
    font-size: 15px;
    font-weight: 650;
    cursor: pointer;
  }

  .conversion-submit:disabled {
    cursor: wait;
    opacity: 0.68;
  }

  #conversion-lead-message {
    min-height: 20px;
    margin: -4px 0 0;
    color: color-mix(in srgb, var(--botanical-ink) 74%, white);
    font-size: 13px;
    text-align: center;
  }

  @media (max-width: 960px) {
    .conversion-layout {
      grid-template-columns: 1fr;
      gap: 52px;
      min-height: 0;
    }

    .conversion-copy {
      text-align: center;
    }

    .conversion-copy h1,
    .conversion-copy > p:not(.botanical-eyebrow) {
      margin-inline: auto;
    }

    .conversion-copy ul {
      width: max-content;
      max-width: 100%;
      margin-inline: auto;
      text-align: left;
    }
  }

  @media (max-width: 560px) {
    .conversion-page {
      padding-top: 42px;
    }

    .conversion-copy h1 {
      font-size: 52px;
    }

    .conversion-card {
      padding: 28px 20px;
    }

    .conversion-card form {
      grid-template-columns: 1fr;
    }

    .conversion-selection {
      grid-template-columns: 1fr;
    }

    .conversion-span-two {
      grid-column: auto;
    }
  }
</style>
