---
import Base from '../layouts/Base.astro';
import ManagementPanelVisual from './ManagementPanelVisual.astro';
import { getContent, localePath, type Locale } from '../lib/i18n';
import { getManagementPanelUi, getManagementPanelViews } from '../lib/managementPanels';

interface Props { locale: Locale; slug: string }
const { locale, slug } = Astro.props;
const c = getContent(locale);
const views = getManagementPanelViews(locale);
const ui = getManagementPanelUi(locale);
const panel = views.find(item=>item.id===slug);
if(!panel) throw new Error(`Panel comercial desconocido: ${slug}`);
const index = views.findIndex(item=>item.id===slug);
const related = [1,2,3].map(offset=>views[(index+offset)%views.length]);
const panelPath = (id:string)=>localePath(locale,`paneles/${id}/`);
const conversionHref = `${localePath(locale,'empezar/')}?panel=${encodeURIComponent(panel.id)}`;
const levelName = panel.level==='gestion'?ui.management:ui.advanced;
---

<Base locale={locale} content={c} ruta={`paneles/${panel.id}/`} seo={{title:`${panel.name} — ${ui.seoSuffix}`,description:panel.description}}>
  <article class="panel-detail-page">
    <header class="panel-detail-head botanical-shell"><nav aria-label={ui.back}><a href={localePath(locale,'paneles/')}><span aria-hidden="true">←</span>{ui.back}</a></nav><div class="panel-detail-heading"><div><p class="botanical-eyebrow">{ui.detailKicker}</p><h1>{panel.name}</h1></div><p>{panel.description}</p></div></header>

    <section class="panel-detail-preview botanical-shell" aria-label={`${ui.browser}: ${panel.name}`}>
      <div class="panel-detail-stage" data-panel-detail-stage>
        <div class="panel-detail-browser"><div class="panel-detail-bar"><i></i><i></i><i></i><span>panel.tudominio.com/{panel.id}</span><button type="button" data-panel-detail-expand aria-expanded="false" aria-label={ui.expand}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5"></path></svg><span aria-hidden="true">×</span></button></div><div class="panel-detail-screen"><iframe src={panel.href} title={`${ui.browser}: ${panel.name}`}></iframe></div></div>
        <aside class="panel-detail-side"><p class="panel-detail-side-kicker">{ui.live}</p><h2>{panel.name}</h2><p>{panel.description}</p><div class="panel-detail-tags"><span>{levelName}</span>{panel.tags.slice(0,2).map(tag=><span>{tag}</span>)}</div><ul>{panel.points.map(point=><li><span aria-hidden="true">✓</span>{point}</li>)}</ul><div class="panel-detail-actions"><a class="is-primary" href={conversionHref}>{ui.request}<span aria-hidden="true">→</span></a><a href={panel.href} target="_blank" rel="noopener">{ui.full}<span aria-hidden="true">↗</span></a></div><small>{ui.note}</small></aside>
      </div>
    </section>

    <section class="panel-detail-info botanical-shell"><div class="panel-detail-story"><p class="botanical-eyebrow">{ui.solves}</p><h2>{ui.howTitle}</h2><p>{panel.story}</p><ul>{panel.points.map((point,i)=><li><b>{String(i+1).padStart(2,'0')}</b><span>{point}</span></li>)}</ul></div><aside class="panel-detail-facts"><h3>{ui.details}</h3><dl><div><dt>{ui.level}</dt><dd>{levelName}</dd></div><div><dt>{ui.status}</dt><dd>{ui.statusValue}</dd></div><div><dt>{ui.delivery}</dt><dd>{ui.deliveryValue}</dd></div></dl><h3>{ui.includes}</h3><div class="panel-detail-fact-tags">{panel.tags.map(tag=><span>{tag}</span>)}</div><a href={conversionHref}>{ui.request}<span aria-hidden="true">→</span></a></aside></section>

    <section class="panel-detail-related botanical-shell"><header><h2>{ui.related}</h2><a href={localePath(locale,'paneles/')}>{ui.allRelated}<span aria-hidden="true">→</span></a></header><div>{related.map(item=><a class="panel-detail-related-card" href={panelPath(item.id)}><ManagementPanelVisual locale={locale} variant={item.level} label={item.name} ariaLabel={`${ui.cardCta}: ${item.name}`}/><span><b>{item.name}</b><small>{item.eyebrow}</small><i aria-hidden="true">→</i></span></a>)}</div></section>
  </article>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-panel-detail-stage]').forEach(stage=>{const trigger=stage.querySelector<HTMLButtonElement>('[data-panel-detail-expand]');const setExpanded=(expanded:boolean)=>{stage.classList.toggle('is-expanded',expanded);document.documentElement.classList.toggle('panel-preview-locked',expanded);trigger?.setAttribute('aria-expanded',String(expanded))};trigger?.addEventListener('click',()=>setExpanded(!stage.classList.contains('is-expanded')));addEventListener('keydown',event=>{if(event.key==='Escape'&&stage.classList.contains('is-expanded'))setExpanded(false)})});
</script>

<style>
  :global(html.panel-preview-locked){overflow:hidden}.panel-detail-page{overflow:hidden;background:var(--botanical-paper)}.panel-detail-head{padding:clamp(46px,6vw,84px) 0 clamp(36px,5vw,62px)}.panel-detail-head nav a{display:inline-flex;min-height:44px;align-items:center;gap:9px;color:rgb(15 62 23/.67);font-size:12px;font-weight:750}.panel-detail-heading{display:grid;grid-template-columns:1.08fr .92fr;gap:clamp(40px,8vw,120px);align-items:end;margin-top:clamp(40px,5vw,66px)}.panel-detail-heading h1{max-width:920px;margin-top:15px;font-family:var(--botanical-serif);font-size:clamp(62px,8vw,128px);font-weight:400;letter-spacing:-.065em;line-height:.82}.panel-detail-heading>p{max-width:600px;color:rgb(15 62 23/.67);font-size:clamp(16px,1.35vw,20px);line-height:1.6}
  .panel-detail-preview{padding-bottom:clamp(70px,8vw,118px)}.panel-detail-stage{display:grid;grid-template-columns:minmax(0,1fr) clamp(310px,26vw,390px);gap:16px;border-radius:24px;background:rgb(223 236 220/.55);padding:16px}.panel-detail-browser{min-width:0;overflow:hidden;border:1px solid rgb(15 62 23/.13);border-radius:16px;background:white;box-shadow:0 18px 50px rgb(15 62 23/.13)}.panel-detail-bar{display:flex;min-height:46px;align-items:center;gap:7px;border-bottom:1px solid rgb(15 62 23/.1);padding:0 9px 0 16px}.panel-detail-bar>i{width:10px;height:10px;border-radius:50%;background:rgb(15 62 23/.18)}.panel-detail-bar>span{margin-left:8px;color:rgb(15 62 23/.48);font-size:12px}.panel-detail-bar button{display:grid;width:44px;height:44px;margin-left:auto;place-items:center;border:0;border-radius:12px;background:transparent;color:var(--botanical-ink);cursor:pointer}.panel-detail-bar svg{width:20px;height:20px}.panel-detail-bar button>span{display:none;font:300 26px/1 var(--botanical-sans)}.panel-detail-screen{height:clamp(530px,55vw,760px)}.panel-detail-screen iframe{display:block;width:100%;height:100%;border:0}.panel-detail-side{display:flex;min-width:0;flex-direction:column;padding:clamp(26px,3vw,42px) clamp(18px,2vw,28px)}.panel-detail-side-kicker{font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;opacity:.52}.panel-detail-side h2{margin-top:12px;font-family:var(--botanical-serif);font-size:clamp(38px,4vw,58px);font-weight:400;letter-spacing:-.045em;line-height:.95}.panel-detail-side>p:not(.panel-detail-side-kicker){margin-top:18px;color:rgb(15 62 23/.65);font-size:14px;line-height:1.55}.panel-detail-tags,.panel-detail-fact-tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:18px}.panel-detail-tags span,.panel-detail-fact-tags span{border:1px solid rgb(15 62 23/.14);border-radius:999px;padding:6px 10px;color:rgb(15 62 23/.65);font-size:10px}.panel-detail-side ul{display:grid;gap:12px;margin-top:25px}.panel-detail-side li{display:grid;grid-template-columns:16px 1fr;gap:8px;color:rgb(15 62 23/.7);font-size:12px}.panel-detail-actions{display:grid;gap:8px;margin-top:auto;padding-top:28px}.panel-detail-actions a,.panel-detail-facts>a{display:flex;min-height:48px;align-items:center;justify-content:space-between;border:1px solid rgb(15 62 23/.18);border-radius:999px;padding:0 17px;color:var(--botanical-ink);font-size:12px;font-weight:800}.panel-detail-actions a.is-primary{border-color:var(--botanical-ink);background:var(--botanical-ink);color:white}.panel-detail-side>small{margin-top:13px;color:rgb(15 62 23/.49);font-size:10px;line-height:1.45}.panel-detail-stage.is-expanded{position:fixed;inset:0;z-index:100;grid-template-columns:minmax(0,1fr) clamp(320px,27vw,410px);border-radius:0;padding:14px}.panel-detail-stage.is-expanded .panel-detail-screen{height:calc(100dvh - 76px)}.panel-detail-stage.is-expanded .panel-detail-bar svg{display:none}.panel-detail-stage.is-expanded .panel-detail-bar button>span{display:block}
  .panel-detail-info{display:grid;grid-template-columns:minmax(0,1fr) minmax(290px,.4fr);gap:clamp(55px,10vw,150px);padding-bottom:clamp(80px,10vw,145px)}.panel-detail-story h2{max-width:900px;margin-top:18px;font-family:var(--botanical-serif);font-size:clamp(45px,6vw,86px);font-weight:400;letter-spacing:-.05em;line-height:.95}.panel-detail-story>p:not(.botanical-eyebrow){max-width:760px;margin-top:27px;color:rgb(15 62 23/.67);font-size:clamp(16px,1.35vw,20px);line-height:1.65}.panel-detail-story ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 30px;margin-top:50px}.panel-detail-story li{display:grid;grid-template-columns:42px 1fr;gap:12px;border-top:1px solid rgb(15 62 23/.12);padding:18px 0}.panel-detail-story li b{color:#5f8d67;font-family:var(--botanical-serif);font-size:22px;font-weight:400}.panel-detail-story li span{font-size:13px;line-height:1.5}.panel-detail-facts{align-self:start;border:1px solid rgb(15 62 23/.11);border-radius:20px;background:white;padding:28px;box-shadow:0 16px 44px rgb(15 62 23/.06)}.panel-detail-facts h3{font-size:10px;letter-spacing:.1em;text-transform:uppercase}.panel-detail-facts dl{display:grid;gap:13px;margin:20px 0 28px}.panel-detail-facts dl>div{display:flex;justify-content:space-between;gap:20px;border-bottom:1px solid rgb(15 62 23/.1);padding-bottom:11px;font-size:12px}.panel-detail-facts dt{opacity:.52}.panel-detail-facts dd{font-weight:700;text-align:right}.panel-detail-facts>a{margin-top:25px;background:var(--botanical-ink);color:white}.panel-detail-related{padding-bottom:clamp(85px,10vw,145px)}.panel-detail-related>header{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:30px}.panel-detail-related h2{font-family:var(--botanical-serif);font-size:clamp(36px,4vw,58px);font-weight:400}.panel-detail-related header>a{display:inline-flex;min-height:44px;align-items:center;gap:10px;border-bottom:1px solid rgb(15 62 23/.3);font-size:12px;font-weight:800}.panel-detail-related>div{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.panel-detail-related-card{overflow:hidden;border:1px solid rgb(15 62 23/.1);border-radius:18px;background:white}.panel-detail-related-card :global(.management-panel-visual){aspect-ratio:1.45;min-height:0}.panel-detail-related-card>span{display:grid;grid-template-columns:1fr auto;gap:7px 15px;padding:18px 20px}.panel-detail-related-card b{font-size:20px}.panel-detail-related-card small{grid-column:1;font-size:10px;opacity:.56}.panel-detail-related-card i{grid-row:1/span 2;grid-column:2;align-self:center;font-style:normal}
  @media(max-width:1000px){.panel-detail-stage{grid-template-columns:1fr}.panel-detail-side{min-height:540px}.panel-detail-info{grid-template-columns:1fr}.panel-detail-facts{width:100%}}@media(max-width:760px){.panel-detail-heading{grid-template-columns:1fr;gap:28px}.panel-detail-heading h1{font-size:64px}.panel-detail-stage{padding:0}.panel-detail-browser{border-radius:18px 18px 0 0}.panel-detail-screen{height:330px}.panel-detail-side{min-height:0;padding:28px 20px}.panel-detail-side ul{display:none}.panel-detail-stage.is-expanded{grid-template: minmax(300px,55dvh) minmax(0,1fr)/1fr;padding:0}.panel-detail-stage.is-expanded .panel-detail-browser{border-radius:0}.panel-detail-stage.is-expanded .panel-detail-screen{height:calc(55dvh - 46px)}.panel-detail-stage.is-expanded .panel-detail-side{overflow-y:auto}.panel-detail-story ul{grid-template-columns:1fr}.panel-detail-related>header{align-items:flex-start;flex-direction:column}.panel-detail-related>div{grid-template-columns:1fr}}
</style>
