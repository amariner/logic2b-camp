---
import ThemeMiniature from './ThemeMiniature.astro';

interface ThemeItem {
  nombre: string;
  estilo: string;
  imagen: string;
  variante: string;
  estado: string;
  href: string;
}

interface Props {
  items: ThemeItem[];
  status: string;
  button: string;
  href: string;
}

const { items, status, button, href } = Astro.props;
const left = items.filter((_, index) => index % 2 === 0);
const right = items.filter((_, index) => index % 2 === 1);
---

<div class="camp-theme-rail" aria-label={button}>
  <div class="camp-theme-column camp-theme-column-left">
    <div class="camp-theme-track">
      {[...left, ...left].map((theme, index) => (
        <article class="camp-theme-card" aria-hidden={index >= left.length ? 'true' : undefined}>
          <ThemeMiniature
            name={theme.nombre}
            style={theme.estilo}
            image={theme.imagen}
            variant={theme.variante}
            eager={index === 0}
          />
          <div class="camp-theme-meta">
            <span><i></i>{theme.nombre}</span>
            <small>{theme.estado || status}</small>
          </div>
        </article>
      ))}
    </div>
  </div>
  <div class="camp-theme-column camp-theme-column-right">
    <div class="camp-theme-track">
      {[...right, ...right].map((theme, index) => (
        <article class="camp-theme-card" aria-hidden={index >= right.length ? 'true' : undefined}>
          <ThemeMiniature
            name={theme.nombre}
            style={theme.estilo}
            image={theme.imagen}
            variant={theme.variante}
            eager={index === 0}
          />
          <div class="camp-theme-meta">
            <span><i></i>{theme.nombre}</span>
            <small>{theme.estado || status}</small>
          </div>
        </article>
      ))}
    </div>
  </div>
  <a class="camp-theme-link" href={href}>{button}<span aria-hidden="true">→</span></a>
</div>

<style>
  .camp-theme-rail {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    height: clamp(520px, 47vw, 680px);
    min-height: 520px;
    overflow: hidden;
  }
  .camp-theme-rail::before,
  .camp-theme-rail::after {
    position: absolute;
    z-index: 3;
    right: 0;
    left: 0;
    height: 76px;
    content: '';
    pointer-events: none;
  }
  .camp-theme-rail::before { top: 0; background: linear-gradient(var(--botanical-slate), transparent); }
  .camp-theme-rail::after { bottom: 0; background: linear-gradient(transparent, var(--botanical-slate)); }
  .camp-theme-column { overflow: hidden; }
  .camp-theme-track {
    display: grid;
    gap: 12px;
    will-change: transform;
  }
  .camp-theme-column-left .camp-theme-track { animation: camp-themes-down 48s linear infinite; }
  .camp-theme-column-right .camp-theme-track { animation: camp-themes-up 54s linear infinite; }
  .camp-theme-rail:hover .camp-theme-track { animation-play-state: paused; }
  .camp-theme-card {
    overflow: hidden;
    border-radius: 14px;
    background: var(--botanical-paper);
  }
  .camp-theme-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 11px 13px 13px;
    color: var(--botanical-ink);
  }
  .camp-theme-meta span {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    font-weight: 600;
  }
  .camp-theme-meta i {
    width: 7px;
    height: 7px;
    flex: none;
    border-radius: 50%;
    background: var(--botanical-sage);
  }
  .camp-theme-meta small {
    overflow: hidden;
    color: color-mix(in srgb, var(--botanical-ink) 56%, white);
    font-size: 9px;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .camp-theme-link {
    position: absolute;
    z-index: 5;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    min-height: 92px;
    align-items: end;
    justify-content: center;
    gap: 18px;
    padding: 42px 16px 16px;
    background: linear-gradient(transparent, color-mix(in srgb, var(--botanical-slate) 94%, transparent) 48%);
    color: var(--botanical-ink);
    font-size: 13px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @keyframes camp-themes-up {
    from { transform: translateY(0); }
    to { transform: translateY(calc(-50% - 6px)); }
  }
  @keyframes camp-themes-down {
    from { transform: translateY(calc(-50% - 6px)); }
    to { transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .camp-theme-track { animation-play-state: paused !important; }
  }
  @media (max-width: 560px) {
    .camp-theme-rail { height: 520px; min-height: 0; gap: 8px; }
    .camp-theme-track { gap: 8px; }
    .camp-theme-meta { padding: 9px; }
    .camp-theme-meta small { display: none; }
  }
</style>
