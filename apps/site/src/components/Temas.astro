---
import Base from '../layouts/Base.astro';
import ThemeMiniature from './ThemeMiniature.astro';
import { getContent, localePath, type Locale } from '../lib/i18n';
import { portfolioImage } from '../lib/portfolio';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = getContent(locale);
const detail = c.temas.detalle;
const detailPath = (slug: string) => localePath(locale, `temas/${slug}/`);
const describe = (name: string) => detail.descripcion.replace('{theme}', name);
const levels = [...new Set(c.temas.items.map((theme) => theme.estilo.split(' · ')[0]))];
---

<Base locale={locale} content={c} ruta="temas/" seo={c.temas.seo}>
  <div class="theme-catalog-page">
    <section class="theme-catalog-hero botanical-shell botanical-subpage-hero">
      <div>
        <p class="botanical-eyebrow">{c.temas.kicker}</p>
        <h1 class="botanical-heading">{c.temas.titulo}</h1>
      </div>
      <div class="theme-catalog-hero-intro">
        <strong>{String(c.temas.items.length).padStart(2, '0')}</strong>
        <p class="botanical-copy">{c.temas.texto}</p>
        <a href={`${localePath(locale)}#demos`}>{c.temas.volver}<span aria-hidden="true">←</span></a>
      </div>
    </section>

    <section class="theme-catalog-browser botanical-shell" aria-label={c.temas.kicker} data-theme-catalog>
      <div class="theme-catalog-toolbar">
        <label class="theme-catalog-search">
          <span class="botanical-visually-hidden">{detail.buscar}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
          <input type="search" placeholder={detail.buscarPlaceholder} data-theme-search />
        </label>
        <div class="theme-catalog-filters" role="group" aria-label={detail.filtrarAria}>
          <button type="button" class="is-active" data-theme-filter="" aria-pressed="true">{detail.todos}</button>
          {levels.map((level) => <button type="button" data-theme-filter={level} aria-pressed="false">{level}</button>)}
        </div>
      </div>

      <div class="theme-catalog-grid" data-theme-grid>
        {
          c.temas.items.map((theme, index) => {
            const level = theme.estilo.split(' · ')[0];
            const direction = theme.estilo.split(' · ').slice(1).join(' · ');
            return (
              <article class="theme-catalog-card" data-theme-card data-theme-level={level} data-theme-searchable={`${theme.nombre} ${theme.estilo} ${theme.estado}`}>
                <a class="theme-catalog-visual" href={detailPath(theme.slug)} aria-label={`${theme.nombre} · ${detail.verFicha}`}>
                  <ThemeMiniature name={theme.nombre} style={theme.estilo} image={portfolioImage(theme.slug, theme.imagen)} variant={theme.variante} eager={index < 3} />
                </a>
                <div class="theme-catalog-meta">
                  <div class="theme-catalog-meta-top"><h2>{theme.nombre}</h2><span>{level}</span></div>
                  <p>{describe(theme.nombre)}</p>
                  <div class="theme-catalog-tags"><span>{direction}</span><span>{detail.etiquetas[0]}</span></div>
                  <a class="theme-catalog-open" href={detailPath(theme.slug)}>{detail.verFicha}<span aria-hidden="true">→</span></a>
                </div>
              </article>
            );
          })
        }
      </div>
      <p class="theme-catalog-empty" hidden role="status" data-theme-empty>{detail.sinResultados}</p>
    </section>

    <section class="theme-catalog-note botanical-shell">
      <p>{c.temas.nota}</p>
      <a class="botanical-button" href={`${localePath(locale)}#contacto`}>{c.nav.contacto}<span aria-hidden="true">→</span></a>
    </section>
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-theme-catalog]').forEach((catalog) => {
    const search = catalog.querySelector<HTMLInputElement>('[data-theme-search]');
    const filters = [...catalog.querySelectorAll<HTMLButtonElement>('[data-theme-filter]')];
    const cards = [...catalog.querySelectorAll<HTMLElement>('[data-theme-card]')];
    const empty = catalog.querySelector<HTMLElement>('[data-theme-empty]');
    let activeLevel = '';
    const normalize = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    const update = () => {
      const query = normalize(search?.value.trim() ?? '');
      let visible = 0;
      cards.forEach((card) => {
        const matchesLevel = !activeLevel || card.dataset.themeLevel === activeLevel;
        const matchesQuery = !query || normalize(card.dataset.themeSearchable ?? '').includes(query);
        card.hidden = !(matchesLevel && matchesQuery);
        if (!card.hidden) visible += 1;
      });
      if (empty) empty.hidden = visible !== 0;
    };
    filters.forEach((filter) => filter.addEventListener('click', () => {
      activeLevel = filter.dataset.themeFilter ?? '';
      filters.forEach((candidate) => {
        const active = candidate === filter;
        candidate.classList.toggle('is-active', active);
        candidate.setAttribute('aria-pressed', String(active));
      });
      update();
    }));
    search?.addEventListener('input', update);
  });
</script>

<style>
  .theme-catalog-page { overflow:hidden; background:var(--botanical-paper); }
  .theme-catalog-hero { display:grid; grid-template-columns:1.2fr .8fr; gap:clamp(40px,8vw,120px); align-items:end; padding:clamp(76px,9vw,132px) 0 clamp(58px,7vw,96px); }
  .theme-catalog-hero h1 { max-width:900px; margin-top:18px; }
  .theme-catalog-hero-intro { display:grid; grid-template-columns:auto 1fr; gap:18px 22px; align-items:start; }
  .theme-catalog-hero-intro>strong { grid-row:1 / span 2; color:var(--botanical-sage); font-family:var(--botanical-serif); font-size:clamp(58px,7vw,104px); font-weight:400; letter-spacing:-.06em; line-height:.78; }
  .theme-catalog-hero-intro .botanical-copy { max-width:560px; }
  .theme-catalog-hero-intro>a { display:inline-flex; width:max-content; align-items:center; gap:9px; border-bottom:1px solid color-mix(in srgb,var(--botanical-ink) 30%,transparent); padding-bottom:4px; color:var(--botanical-ink); font-size:13px; font-weight:720; }
  .theme-catalog-browser { padding-bottom:clamp(70px,10vw,140px); }
  .theme-catalog-toolbar { display:flex; align-items:center; justify-content:space-between; gap:20px; margin-bottom:30px; border-top:1px solid color-mix(in srgb,var(--botanical-ink) 13%,transparent); padding-top:22px; }
  .theme-catalog-search { display:flex; width:min(340px,100%); min-height:48px; align-items:center; gap:10px; border:1px solid color-mix(in srgb,var(--botanical-ink) 16%,transparent); border-radius:999px; background:white; padding:0 16px; }
  .theme-catalog-search svg { width:18px; height:18px; flex:none; color:color-mix(in srgb,var(--botanical-ink) 54%,white); }
  .theme-catalog-search input { width:100%; border:0; outline:0; background:transparent; color:var(--botanical-ink); font:inherit; font-size:16px; }
  .theme-catalog-search:focus-within { outline:2px solid var(--botanical-ink); outline-offset:3px; }
  .theme-catalog-search input::placeholder { color:color-mix(in srgb,var(--botanical-ink) 48%,white); }
  .theme-catalog-filters { display:flex; flex-wrap:wrap; justify-content:flex-end; gap:8px; }
  .theme-catalog-filters button { min-height:44px; border:1px solid color-mix(in srgb,var(--botanical-ink) 15%,transparent); border-radius:999px; background:transparent; padding:0 16px; color:color-mix(in srgb,var(--botanical-ink) 66%,white); font:inherit; font-size:12px; font-weight:700; cursor:pointer; }
  .theme-catalog-filters button.is-active { border-color:var(--botanical-ink); background:var(--botanical-ink); color:white; }
  .theme-catalog-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; }
  .theme-catalog-card { overflow:hidden; border:1px solid color-mix(in srgb,var(--botanical-ink) 10%,transparent); border-radius:22px; background:white; box-shadow:0 14px 38px rgb(15 62 23 / 5%); transition:transform 220ms ease,border-color 220ms ease,box-shadow 220ms ease; }
  .theme-catalog-card:hover { border-color:color-mix(in srgb,var(--botanical-ink) 24%,transparent); box-shadow:0 20px 48px rgb(15 62 23 / 10%); transform:translateY(-4px); }
  .theme-catalog-card[hidden] { display:none; }
  .theme-catalog-visual { display:block; margin:10px 10px 0; overflow:hidden; border-radius:15px; }
  .theme-catalog-visual :global(.theme-miniature) { aspect-ratio:1.42; transition:transform 600ms cubic-bezier(.16,1,.3,1); }
  .theme-catalog-card:hover .theme-catalog-visual :global(.theme-miniature) { transform:scale(1.025); }
  .theme-catalog-meta { padding:22px 24px 25px; }
  .theme-catalog-meta-top { display:flex; align-items:baseline; justify-content:space-between; gap:16px; }
  .theme-catalog-meta h2 { color:var(--botanical-ink); font-size:clamp(23px,2vw,30px); letter-spacing:-.035em; line-height:1; }
  .theme-catalog-meta-top>span { color:color-mix(in srgb,var(--botanical-ink) 50%,white); font-size:9px; font-weight:800; letter-spacing:.09em; text-transform:uppercase; }
  .theme-catalog-meta>p { min-height:4.5em; margin-top:15px; color:color-mix(in srgb,var(--botanical-ink) 65%,white); font-size:13px; line-height:1.5; }
  .theme-catalog-tags { display:flex; flex-wrap:wrap; gap:7px; margin-top:18px; }
  .theme-catalog-tags span { border:1px solid color-mix(in srgb,var(--botanical-ink) 13%,transparent); border-radius:999px; padding:5px 10px; color:color-mix(in srgb,var(--botanical-ink) 62%,white); font-size:10px; }
  .theme-catalog-open { display:flex; min-height:44px; align-items:center; justify-content:space-between; gap:18px; margin-top:20px; border-top:1px solid color-mix(in srgb,var(--botanical-ink) 11%,transparent); padding-top:15px; color:var(--botanical-ink); font-size:12px; font-weight:800; }
  .theme-catalog-open span { font-size:16px; transition:transform 160ms ease; }
  .theme-catalog-open:hover span { transform:translateX(3px); }
  .theme-catalog-empty { border:1px solid color-mix(in srgb,var(--botanical-ink) 12%,transparent); border-radius:20px; padding:70px 24px; color:color-mix(in srgb,var(--botanical-ink) 65%,white); text-align:center; }
  .theme-catalog-note { display:flex; align-items:center; justify-content:space-between; gap:30px; margin-bottom:clamp(28px,5vw,70px); border-radius:22px; background:var(--botanical-sage); padding:clamp(30px,5vw,58px); }
  .theme-catalog-note p { max-width:760px; color:var(--botanical-ink); font-family:var(--botanical-serif); font-size:clamp(24px,3vw,40px); line-height:1.15; }
  .theme-catalog-note .botanical-button { flex:none; }
  @media(prefers-reduced-motion:reduce){.theme-catalog-card,.theme-catalog-visual :global(.theme-miniature),.theme-catalog-open span{transition:none}}
  @media(max-width:1100px){.theme-catalog-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.theme-catalog-toolbar{align-items:flex-start;flex-direction:column}.theme-catalog-filters{justify-content:flex-start}}
  @media(max-width:760px){
    .theme-catalog-hero,.theme-catalog-grid{grid-template-columns:1fr}
    .theme-catalog-hero{gap:34px}
    .theme-catalog-hero-intro{grid-template-columns:70px 1fr}
    .theme-catalog-hero-intro>strong{font-size:66px}
    .theme-catalog-toolbar{margin-bottom:20px}
    .theme-catalog-search{width:100%}
    .theme-catalog-filters{width:100%; flex-wrap:nowrap; overflow-x:auto; padding-bottom:4px; scrollbar-width:none}
    .theme-catalog-filters::-webkit-scrollbar{display:none}
    .theme-catalog-filters button{flex:none}
    .theme-catalog-meta>p{min-height:0}
    .theme-catalog-note{align-items:flex-start;flex-direction:column}
  }
</style>
