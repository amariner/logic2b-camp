---
import PlatformVisual from './PlatformVisual.astro';

interface PlatformItem {
  icono: string;
  etiqueta: string;
  titulo: string;
  resumen: string;
  puntos: string[];
  detalle: string;
  capturaAlt: string;
}

interface Props {
  locale: string;
  kicker: string;
  titulo: string;
  aria: string;
  items: PlatformItem[];
}

const { locale, kicker, titulo, aria, items } = Astro.props;

const iconPaths: Record<string, string[]> = {
  web: ['M3.5 5.5h17v13h-17zM3.5 9h17', 'M7 7.25h.01M10 7.25h.01', 'M8 14h8'],
  reservas: ['M5 4h14v16H5zM8 2v4M16 2v4M5 8h14', 'M9 13h6M12 10v6'],
  planning: ['M4 5h16v15H4zM4 9h16M8 3v4M16 3v4', 'M8 13h3v3H8zM14 13h2M14 16h2'],
  plano: ['m4 6 5-3 6 3 5-3v15l-5 3-6-3-5 3V6Z', 'M9 3v15M15 6v15'],
  operativa: ['M4 19V9M10 19V5M16 19v-7M22 19V7M2 19h22', 'M4 7l6-4 6 6 6-4'],
};
---

<section id="plataforma" class="platform-section" aria-labelledby="platform-title" data-platform-showcase>
  <div class="platform-shell">
    <header class="platform-heading lc-reveal">
      <p class="botanical-eyebrow">{kicker}</p>
      <h2 id="platform-title">{titulo}</h2>
    </header>

    <div class="platform-tabs" role="tablist" aria-label={aria}>
      {
        items.map((item, index) => (
          <button
            id={`platform-tab-${index}`}
            type="button"
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`platform-panel-${index}`}
            tabindex={index === 0 ? 0 : -1}
            data-platform-tab={index}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              {(iconPaths[item.icono] ?? iconPaths.web!).map((path) => <path d={path} />)}
            </svg>
            <span>{item.etiqueta}</span>
          </button>
        ))
      }
    </div>

    <div class="platform-panels">
      {
        items.map((item, index) => (
          <article
            id={`platform-panel-${index}`}
            class="platform-panel"
            role="tabpanel"
            aria-labelledby={`platform-tab-${index}`}
            hidden={index !== 0}
            data-platform-panel={index}
            data-platform-kind={item.icono}
          >
            <div class="platform-copy">
              <span class="platform-index">{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.titulo}</h3>
              <p class="platform-summary">{item.resumen}</p>
              <ul>
                {item.puntos.map((point) => <li><span aria-hidden="true">→</span>{point}</li>)}
              </ul>
              <p class="platform-detail">{item.detalle}</p>
            </div>

            <figure class="platform-visual">
              <div class="platform-stage">
                <PlatformVisual kind={item.icono} label={item.etiqueta} alt={item.capturaAlt} locale={locale} />
              </div>
            </figure>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-platform-showcase]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-platform-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-platform-panel]')];
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const select = (index: number, focus = false) => {
      tabs.forEach((tab, tabIndex) => {
        const active = tabIndex === index;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && focus) tab.focus();
      });
      panels.forEach((panel, panelIndex) => {
        panel.hidden = panelIndex !== index;
      });
      if (focus || root.getBoundingClientRect().width <= 767) {
        tabs[index]?.scrollIntoView({
          behavior: reducedMotion ? 'auto' : 'smooth',
          block: 'nearest',
          inline: 'center',
        });
      }
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(index));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const next = event.key === 'Home'
          ? 0
          : event.key === 'End'
            ? tabs.length - 1
            : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
        select(next, true);
      });
    });
  });
</script>

<style>
  .platform-section {
    overflow: hidden;
    background: color-mix(in srgb, var(--botanical-keylime) 74%, var(--botanical-paper));
    padding-block: clamp(78px, 9vw, 132px);
    scroll-margin-top: 112px;
  }

  .platform-shell {
    width: calc(100% - clamp(32px, 5vw, 72px));
    max-width: 1600px;
    margin-inline: auto;
  }

  .platform-heading {
    max-width: 1060px;
    margin-inline: auto;
    text-align: center;
  }

  .platform-heading h2 {
    margin-top: 18px;
    font-size: clamp(52px, 6vw, 92px);
    letter-spacing: -.05em;
    line-height: .98;
    text-wrap: balance;
  }

  .platform-tabs {
    display: flex;
    width: max-content;
    max-width: 100%;
    gap: 4px;
    margin: clamp(46px, 6vw, 78px) auto 0;
    overflow-x: auto;
    border: 0;
    border-radius: 20px;
    background: color-mix(in srgb, var(--botanical-paper) 94%, transparent);
    padding: 7px;
    box-shadow: 0 14px 34px color-mix(in srgb, var(--botanical-ink) 7%, transparent);
    scrollbar-width: none;
  }

  .platform-tabs::-webkit-scrollbar {
    display: none;
  }

  .platform-tabs button {
    display: inline-flex;
    min-height: 54px;
    align-items: center;
    gap: 9px;
    border: 0;
    border-radius: 14px;
    padding: 10px clamp(16px, 2vw, 30px);
    color: color-mix(in srgb, var(--botanical-ink) 65%, white);
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
    transition: color 160ms ease, background-color 160ms ease;
  }

  .platform-tabs button:hover {
    background: color-mix(in srgb, var(--botanical-keylime) 34%, transparent);
    color: var(--botanical-ink);
  }

  .platform-tabs button:focus-visible {
    outline: 2px solid var(--botanical-ink);
    outline-offset: 2px;
    background: color-mix(in srgb, var(--botanical-keylime) 62%, var(--botanical-paper));
  }

  .platform-tabs button[aria-selected='true'] {
    background: color-mix(in srgb, var(--botanical-keylime) 68%, var(--botanical-paper));
    color: var(--botanical-ink);
    font-weight: 700;
  }

  .platform-tabs svg {
    width: 20px;
    height: 20px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.65;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .platform-panels {
    margin-top: clamp(54px, 7vw, 88px);
  }

  .platform-panel {
    display: grid;
    grid-template-columns: minmax(260px, .34fr) minmax(0, .66fr);
    gap: clamp(40px, 7vw, 110px);
    align-items: center;
    animation: platform-panel-in 420ms cubic-bezier(.22, .8, .24, 1) both;
  }

  .platform-panel[hidden] {
    display: none;
  }

  .platform-copy {
    max-width: 420px;
  }

  .platform-index {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--botanical-ink);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .12em;
  }

  .platform-index::after {
    width: 70px;
    height: 1px;
    background: color-mix(in srgb, var(--botanical-ink) 28%, transparent);
    content: '';
  }

  .platform-copy h3 {
    margin-top: 24px;
    font-family: inherit;
    font-size: clamp(30px, 3vw, 44px);
    font-weight: 600;
    letter-spacing: -.04em;
    line-height: 1.08;
  }

  .platform-summary {
    margin-top: 18px;
    color: var(--botanical-charcoal);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.5;
  }

  .platform-copy ul {
    display: grid;
    gap: 15px;
    margin-top: 28px;
  }

  .platform-copy li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 8px;
    color: var(--botanical-ink);
    font-size: 15px;
    line-height: 1.4;
  }

  .platform-copy li span {
    font-weight: 700;
  }

  .platform-detail {
    margin-top: 28px;
    color: color-mix(in srgb, var(--botanical-charcoal) 58%, white);
    font-size: 15px;
    line-height: 1.6;
  }

  .platform-visual {
    min-width: 0;
  }

  .platform-stage {
    min-height: clamp(480px, 49vw, 660px);
    border: 1px solid rgb(255 255 255 / 54%);
    border-radius: clamp(22px, 2.4vw, 34px);
    padding: clamp(12px, 1.5vw, 20px);
    background:
      radial-gradient(circle at 10% 5%, rgb(255 255 255 / 88%), transparent 34%),
      rgb(255 255 255 / 26%);
    box-shadow: inset 0 1px rgb(255 255 255 / 78%);
  }

  @keyframes platform-panel-in {
    from { opacity: .2; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 1023px) {
    .platform-panel {
      grid-template-columns: 1fr;
      gap: 38px;
    }

    .platform-copy {
      max-width: 680px;
    }

    .platform-stage {
      min-height: 480px;
    }
  }

  @media (max-width: 767px) {
    .platform-section {
      padding-block: 68px 78px;
      scroll-margin-top: 92px;
    }

    .platform-heading h2 {
      font-size: clamp(42px, 12.8vw, 54px);
    }

    .platform-tabs {
      width: 100%;
      justify-content: flex-start;
      margin-top: 38px;
      border-radius: 17px;
      scroll-padding-inline: 8px;
      scroll-snap-type: x proximity;
    }

    .platform-tabs button {
      min-height: 48px;
      padding-inline: 15px;
      font-size: 13px;
      scroll-snap-align: center;
    }

    .platform-panels {
      margin-top: 44px;
    }

    .platform-copy h3 {
      font-size: 32px;
    }

    .platform-summary {
      font-size: 16px;
    }

    .platform-stage {
      min-height: 300px;
      border-radius: 22px;
      padding: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .platform-panel { animation: none; }
  }
</style>
