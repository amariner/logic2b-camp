---
import Base from '../layouts/Base.astro';
import { getContent, localePath, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = getContent(locale);

/* FAQPage de schema.org, construido desde las MISMAS preguntas que se pintan
 * abajo. Google exige que la respuesta esté visible en la página — lo está, en
 * los `<details>`; el día que alguien quite la sección, este marcado se va con
 * ella porque lee el mismo array. */
const faqEstructurada = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faq.items.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

/* Iconos lucide inline (sin dependencia de runtime): uno por punto de dolor. */
const iconosProblema = [
  // calendar-x — "tu web no reserva"
  'M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2ZM10 14l4 4M14 14l-4 4',
  // percent — la comisión
  'M19 5 5 19M6.5 9a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM17.5 20a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
  // table — el cuaderno y el excel
  'M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5ZM3 9h18M9 21V9',
  // languages — seis idiomas
  'm5 8 6 6M4 14l6-6 2-3M2 5h12M7 2h1M22 22l-5-10-5 10M14 18h6',
];
---

<Base locale={locale} content={c}>
  {/* ---------- Héroe atmosférico (ADR 0027) ---------- */}
  <section class="relative isolate overflow-hidden">
    {/* Fotografía de fondo: atmósfera contenida, contrato de arte del ADR 0024. */}
    <picture class="pointer-events-none absolute inset-0 -z-20">
      <source media="(max-width: 640px)" srcset="/hero-atmosfera-movil.webp" />
      <img
        src="/hero-atmosfera.webp"
        alt=""
        role="presentation"
        class="h-full w-full object-cover"
        fetchpriority="high"
        width="1376"
        height="768"
      />
    </picture>
    {/* Scrim: garantiza AA del texto claro sobre la foto, en claro y oscuro. */}
    <div
      class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(100deg,rgba(10,14,12,0.82)_0%,rgba(10,14,12,0.62)_38%,rgba(10,14,12,0.28)_62%,rgba(10,14,12,0.45)_100%),linear-gradient(to_top,rgba(10,14,12,0.55),transparent_40%)]"
    >
    </div>

    <div class="mx-auto grid max-w-6xl items-end gap-10 px-4 py-20 sm:px-6 sm:py-24 lg:grid-cols-[1.1fr_0.9fr] lg:py-28">
      <div>
        <p class="text-sm font-medium uppercase tracking-wide text-white/70">{c.hero.kicker}</p>
        <h1
          class="mt-4 max-w-3xl font-display text-4xl font-bold leading-[1.08] tracking-tighter text-white sm:text-5xl md:text-6xl"
        >
          {c.hero.titulo}
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/85">{c.hero.subtitulo}</p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="#contacto"
            class="inline-flex items-center rounded-lg bg-white px-5 py-2.5 text-sm font-semibold text-neutral-900 transition-opacity hover:opacity-90"
          >{c.hero.ctaDemo}</a>
          <a
            href="/demo/"
            class="inline-flex items-center rounded-lg border border-white/40 bg-white/10 px-5 py-2.5 text-sm font-medium text-white backdrop-blur-sm transition-colors hover:bg-white/20"
          >{c.hero.ctaVer} →</a>
        </div>
        <p class="mt-6 text-sm text-white/70">{c.hero.nota}</p>
      </div>

      {/* El héroe enseña el producto de verdad: la web del tenant con su widget,
          captura real del dev (patrón C5), no una maqueta. */}
      <figure class="lc-reveal hidden lg:block">
        <div class="overflow-hidden rounded-xl border border-white/20 bg-neutral-900/80 shadow-2xl backdrop-blur-sm">
          <div class="flex items-center gap-1.5 border-b border-white/10 px-3 py-2">
            <span class="size-2.5 rounded-full bg-white/25"></span>
            <span class="size-2.5 rounded-full bg-white/25"></span>
            <span class="size-2.5 rounded-full bg-white/25"></span>
            <span class="ml-3 truncate rounded bg-white/10 px-2 py-0.5 text-[11px] text-white/60">
              camping-calasereno.example
            </span>
          </div>
          <img
            src="/captura-web.webp"
            alt={c.hero.capturaWebAlt}
            width="1280"
            height="860"
            loading="eager"
            class="block w-full"
          />
        </div>
      </figure>
    </div>
  </section>

  {/* ---------- Problema ---------- */}
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <h2 class="lc-reveal max-w-2xl font-display text-2xl font-bold tracking-tight sm:text-3xl">{c.problema.titulo}</h2>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        c.problema.puntos.map((p, i) => (
          <div class="lc-reveal rounded-xl border border-border bg-card p-5" style={`--lc-delay:${i * 60}ms`}>
            <span class="inline-flex size-9 items-center justify-center rounded-lg bg-primary/10 text-primary">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-5"
                aria-hidden="true"
              >
                <path d={iconosProblema[i]} />
              </svg>
            </span>
            <h3 class="mt-3 font-medium">{p.titulo}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{p.texto}</p>
          </div>
        ))
      }
    </div>
  </section>

  {/* ---------- Producto: un sistema, dos caras ---------- */}
  <section id="producto" class="border-y border-border bg-muted/30 scroll-mt-16">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <h2 class="lc-reveal font-display text-2xl font-bold tracking-tight sm:text-3xl">{c.producto.titulo}</h2>
      <p class="lc-reveal mt-3 max-w-2xl text-muted-foreground">{c.producto.subtitulo}</p>
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        {
          c.producto.bloques.map((b, i) => (
            <div class="lc-reveal overflow-hidden rounded-xl border border-border bg-card" style={`--lc-delay:${i * 80}ms`}>
              {/* Enseñar, no contar: captura real de cada cara del producto. */}
              <div class="border-b border-border bg-muted/40 px-6 pt-6">
                <img
                  src={i === 0 ? '/captura-web.webp' : '/captura-planning.webp'}
                  alt={b.capturaAlt}
                  width={i === 0 ? 1280 : 1376}
                  height={i === 0 ? 860 : 859}
                  loading="lazy"
                  class="block w-full rounded-t-lg border border-b-0 border-border shadow-sm"
                />
              </div>
              <div class="p-7">
                <h3 class="font-display text-xl font-bold tracking-tight">{b.titulo}</h3>
                <p class="mt-3 leading-relaxed text-muted-foreground">{b.texto}</p>
                <ul class="mt-5 space-y-2 text-sm">
                  {b.puntos.map((pt) => (
                    <li class="flex items-start gap-2">
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="mt-0.5 size-4 shrink-0 text-primary"
                        aria-hidden="true"
                      >
                        <path d="M20 6 9 17l-5-5" />
                      </svg>
                      <span>{pt}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- Planning (pieza estrella) ---------- */}
  <section id="planning" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 scroll-mt-16">
    <div class="lc-reveal max-w-2xl">
      <p class="text-sm font-medium uppercase tracking-wide text-muted-foreground">{c.planning.kicker}</p>
      <h2 class="mt-3 font-display text-2xl font-bold tracking-tight sm:text-3xl">{c.planning.titulo}</h2>
      <p class="mt-4 leading-relaxed text-muted-foreground">{c.planning.texto}</p>
    </div>

    {/* La captura grande: el elemento firma merece el ancho completo. */}
    <figure class="lc-reveal relative mt-10">
      <img
        src="/captura-planning.webp"
        alt={c.planning.capturaAlt}
        class="w-full rounded-xl border border-border shadow-md"
        loading="lazy"
        width="1376"
        height="859"
      />
      {/* El plano, la otra vista firma, asomando como tarjeta. */}
      <img
        src="/captura-plano.webp"
        alt={c.planning.planoAlt}
        class="absolute -bottom-6 -right-2 hidden w-64 rotate-1 rounded-lg border border-border bg-card shadow-xl sm:block md:w-80"
        loading="lazy"
        width="1280"
        height="800"
      />
    </figure>

    <div class="mt-14 flex flex-wrap items-center gap-x-8 gap-y-3 sm:mt-16">
      {
        c.planning.puntos.map((pt) => (
          <p class="lc-reveal flex items-center gap-2 text-sm text-muted-foreground">
            <span class="size-1.5 rounded-full bg-primary" />
            {pt}
          </p>
        ))
      }
      <a
        href="/demo/admin/"
        class="lc-reveal inline-flex items-center rounded-lg border border-border bg-background px-4 py-2 text-sm font-medium transition-colors hover:bg-accent"
      >{c.planning.cta} →</a>
    </div>
  </section>

  {/* ---------- Escalabilidad: la franja de cifras ----------
      Versión temprana de D5.2 (docs/FRENTE-D-ESCAPARATE.md §3): solo cifras
      que ya son verdad hoy — nada que dependa del portfolio de demos. */}
  <section id="escala" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 scroll-mt-16">
    <div class="lc-reveal max-w-2xl">
      <p class="text-sm font-medium uppercase tracking-wide text-muted-foreground">{c.escala.kicker}</p>
      <h2 class="mt-3 font-display text-2xl font-bold tracking-tight sm:text-3xl">{c.escala.titulo}</h2>
      <p class="mt-4 leading-relaxed text-muted-foreground">{c.escala.subtitulo}</p>
    </div>
    <div class="mt-12 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        c.escala.cifras.map((cf, i) => (
          <div class="lc-reveal border-t border-border pt-5" style={`--lc-delay:${i * 70}ms`}>
            <p class="font-display text-5xl font-bold tracking-tighter">{cf.n}</p>
            <h3 class="mt-3 font-medium">{cf.titulo}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{cf.texto}</p>
          </div>
        ))
      }
    </div>
    <p class="lc-reveal mt-10 text-sm text-muted-foreground">{c.escala.nota}</p>
  </section>

  {/* ---------- Niveles / planes: la escalera ---------- */}
  <section id="niveles" class="border-y border-border bg-muted/30 scroll-mt-16">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <h2 class="lc-reveal font-display text-2xl font-bold tracking-tight sm:text-3xl">{c.niveles.titulo}</h2>
      <p class="lc-reveal mt-3 max-w-2xl text-muted-foreground">{c.niveles.subtitulo}</p>
      {/* La escalera como recorrido (Frente D §3): eliges tu tamaño y la landing
          te señala tu nivel. Orientación, no un quiz — sin datos ni backend. */}
      <div
        class="lc-reveal mt-8 flex flex-wrap items-center gap-x-3 gap-y-2"
        role="group"
        aria-label={c.niveles.selector.pregunta}
      >
        <p class="mr-1 text-sm font-medium">{c.niveles.selector.pregunta}</p>
        {
          c.niveles.selector.opciones.map((o, i) => (
            <button
              type="button"
              data-nivel-chip={i}
              aria-pressed="false"
              class="inline-flex items-center rounded-lg border border-border bg-background px-3.5 py-1.5 text-sm font-medium transition-colors hover:bg-accent aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-foreground"
            >
              {o}
            </button>
          ))
        }
      </div>
      <p
        id="nivel-sugerido"
        data-plantilla={c.niveles.selector.resultado}
        class="mt-4 text-sm font-medium"
        role="status"
        aria-live="polite"
        hidden
      >
      </p>
      <div class="lc-niveles-grid mt-10 grid items-end gap-5 md:grid-cols-2 lg:grid-cols-4">
        {
          c.niveles.items.map((n, i) => (
            <div
              class:list={[
                'lc-reveal lc-nivel flex flex-col rounded-xl border bg-card p-6',
                n.destacado
                  ? 'border-primary shadow-lg ring-1 ring-primary lg:-translate-y-3 lg:pb-9'
                  : 'border-border',
              ]}
              data-nivel-card={i}
              data-nombre={n.nombre}
              style={`--lc-delay:${i * 70}ms`}
            >
              {/* Escalera: el número de nivel da la progresión de un vistazo. */}
              <div class="flex items-center justify-between gap-2">
                <span
                  class:list={[
                    'font-display text-sm font-bold tabular-nums',
                    n.destacado ? 'text-primary' : 'text-muted-foreground',
                  ]}
                >
                  {String(i + 1).padStart(2, '0')}
                </span>
                {n.destacado && (
                  <span class="rounded-md bg-primary px-2 py-0.5 text-[11px] font-semibold text-primary-foreground">
                    {c.niveles.recomendado}
                  </span>
                )}
              </div>
              <h3 class="mt-2 font-display text-lg font-bold tracking-tight">{n.nombre}</h3>
              <p class="mt-1 text-sm font-medium text-muted-foreground">{n.para}</p>
              <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{n.texto}</p>
              <ul class="mt-5 space-y-2 text-sm">
                {n.incluye.map((it) => (
                  <li class="flex items-start gap-2">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="mt-0.5 size-4 shrink-0 text-primary"
                      aria-hidden="true"
                    >
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                    <span>{it}</span>
                  </li>
                ))}
              </ul>
              <a
                href="#contacto"
                class:list={[
                  'mt-6 inline-flex items-center justify-center rounded-lg px-4 py-2 text-sm font-medium transition-colors',
                  n.destacado
                    ? 'bg-primary text-primary-foreground hover:opacity-90'
                    : 'border border-border hover:bg-accent',
                ]}
              >
                {c.nav.contacto}
              </a>
            </div>
          ))
        }
      </div>
      <p class="mt-8 text-sm text-muted-foreground">
        {c.niveles.nota}
        <a
          href={localePath(locale, 'docs/dueno/')}
          class="ml-1.5 font-medium text-primary underline underline-offset-4 hover:opacity-80"
          >{c.docs.guias.dueno.nombre} &rarr;</a
        >
      </p>
    </div>
  </section>

  {/* ---------- Guías (C6, ADR 0025) ---------- */}
  <section class="mx-auto max-w-6xl px-4 pt-20 sm:px-6">
    <h2 class="lc-reveal font-display text-2xl font-bold tracking-tight sm:text-3xl">{c.docs.titulo}</h2>
    <p class="lc-reveal mt-3 max-w-2xl text-muted-foreground">{c.docs.subtitulo}</p>
    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      {
        (['recepcion', 'dueno', 'tecnica'] as const).map((g, i) => (
          <a
            href={localePath(locale, `docs/${g}/`)}
            class="lc-reveal rounded-xl border border-border bg-card p-5 transition-colors hover:border-primary/60 hover:bg-muted/40"
            style={`--lc-delay:${i * 60}ms`}
          >
            <p class="text-xs font-medium tracking-wide text-primary uppercase">
              {c.docs.guias[g].para}
            </p>
            <h3 class="mt-1.5 font-display text-base font-semibold tracking-tight">
              {c.docs.guias[g].nombre}
            </h3>
            <p class="mt-2 text-sm text-muted-foreground">{c.docs.guias[g].texto}</p>
          </a>
        ))
      }
    </div>
  </section>

  {/* ---------- Alta en una tarde ---------- */}
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="lc-reveal rounded-2xl border border-border bg-card p-8 sm:p-12">
      <h2 class="max-w-xl font-display text-2xl font-bold tracking-tight sm:text-3xl">{c.alta.titulo}</h2>
      <p class="mt-4 max-w-2xl leading-relaxed text-muted-foreground">{c.alta.texto}</p>
    </div>
  </section>

  {/* ---------- FAQ ---------- */}
  <section class="border-t border-border bg-muted/30">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(faqEstructurada).replace(/</g, '\\u003c')}
    />
    <div class="mx-auto max-w-3xl px-4 py-20 sm:px-6">
      <h2 class="lc-reveal font-display text-2xl font-bold tracking-tight sm:text-3xl">{c.faq.titulo}</h2>
      <div class="mt-8 divide-y divide-border">
        {
          c.faq.items.map((f) => (
            <details class="group py-4">
              <summary class="flex cursor-pointer items-center justify-between gap-4 font-medium marker:content-['']">
                {f.q}
                <span class="text-muted-foreground transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- Contacto / pedir demo ---------- */}
  <section id="contacto" class="mx-auto max-w-3xl px-4 py-20 sm:px-6 scroll-mt-16">
    <p class="text-sm font-medium uppercase tracking-wide text-muted-foreground">{c.contacto.kicker}</p>
    <h2 class="mt-3 font-display text-2xl font-bold tracking-tight sm:text-3xl">{c.contacto.titulo}</h2>
    <p class="mt-3 text-muted-foreground">{c.contacto.texto}</p>

    <form id="lead-form" class="mt-8 grid gap-4 sm:grid-cols-2" novalidate>
      <input type="hidden" name="lang" value={locale} />
      <label class="grid gap-1.5 text-sm">
        <span class="font-medium">{c.contacto.campos.nombre}</span>
        <input
          name="name"
          required
          class="h-9 rounded-md border border-input bg-background px-3 text-sm outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
        />
      </label>
      <label class="grid gap-1.5 text-sm">
        <span class="font-medium">{c.contacto.campos.camping}</span>
        <input
          name="campingName"
          required
          class="h-9 rounded-md border border-input bg-background px-3 text-sm outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
        />
      </label>
      <label class="grid gap-1.5 text-sm">
        <span class="font-medium">{c.contacto.campos.email}</span>
        <input
          name="email"
          type="email"
          required
          class="h-9 rounded-md border border-input bg-background px-3 text-sm outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
        />
      </label>
      <label class="grid gap-1.5 text-sm">
        <span class="font-medium">{c.contacto.campos.telefono}</span>
        <input
          name="phone"
          class="h-9 rounded-md border border-input bg-background px-3 text-sm outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
        />
      </label>
      <label class="grid gap-1.5 text-sm sm:col-span-2">
        <span class="font-medium">{c.contacto.campos.mensaje}</span>
        <textarea
          name="message"
          rows="3"
          class="rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
        ></textarea>
      </label>
      <div class="sm:col-span-2 flex flex-wrap items-center gap-4">
        <button
          type="submit"
          class="inline-flex items-center rounded-lg bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90 disabled:opacity-60"
          data-send={c.contacto.enviar}
          data-sending={c.contacto.enviando}
        >{c.contacto.enviar}</button>
        <p id="lead-msg" class="text-sm" role="status" aria-live="polite"></p>
      </div>
    </form>

    <p class="mt-6 text-sm text-muted-foreground">
      {c.contacto.verDemoTexto} <a href="/demo/" class="font-medium text-foreground underline underline-offset-4">{c.nav.verDemo} →</a>
    </p>
  </section>
</Base>

<script
  define:vars={{ ok: getContent(locale).contacto.ok, err: getContent(locale).contacto.error }}
>
  const form = document.getElementById('lead-form');
  const msg = document.getElementById('lead-msg');
  const btn = form?.querySelector('button[type=submit]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const data = Object.fromEntries(new FormData(form).entries());
    btn.disabled = true;
    btn.textContent = btn.dataset.sending;
    msg.textContent = '';
    try {
      const res = await fetch('/api/leads', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error('bad');
      msg.textContent = ok;
      msg.className = 'text-sm text-foreground';
      form.reset();
    } catch {
      msg.textContent = err;
      msg.className = 'text-sm text-destructive';
    } finally {
      btn.disabled = false;
      btn.textContent = btn.dataset.send;
    }
  });
</script>

<script>
  // La escalera como recorrido: el chip señala el nivel (y se desmarca al
  // repetir el clic). Mientras hay elección, el anillo es del visitante — la
  // tarjeta destacada estática cede el protagonismo (CSS de abajo).
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-nivel-chip]')];
  const niveles = [...document.querySelectorAll<HTMLElement>('[data-nivel-card]')];
  const grid = document.querySelector<HTMLElement>('.lc-niveles-grid');
  const sugerido = document.getElementById('nivel-sugerido');
  const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const idx = Number(chip.dataset.nivelChip);
      const repetido = chip.getAttribute('aria-pressed') === 'true';
      chips.forEach((ch) => ch.setAttribute('aria-pressed', String(ch === chip && !repetido)));
      niveles.forEach((card, i) => card.classList.toggle('lc-elegido', !repetido && i === idx));
      grid?.classList.toggle('lc-con-eleccion', !repetido);
      if (sugerido) {
        sugerido.hidden = repetido;
        if (!repetido) {
          const nombre = niveles[idx]?.dataset.nombre ?? '';
          sugerido.textContent = (sugerido.dataset.plantilla ?? '').replace('{nivel}', nombre);
        }
      }
      if (!repetido) niveles[idx]?.scrollIntoView({ behavior: quieto ? 'auto' : 'smooth', block: 'nearest' });
    });
  });
</script>

<style>
  /* El nivel elegido en el recorrido lleva el anillo; la tarjeta destacada
     estática (ring-1 de Tailwind) lo suelta mientras la elección dure. */
  .lc-nivel.lc-elegido {
    border-color: var(--primary);
    box-shadow: 0 0 0 2px var(--primary);
  }
  .lc-niveles-grid.lc-con-eleccion .lc-nivel:not(.lc-elegido) {
    border-color: var(--border);
    box-shadow: none;
  }
</style>

<script>
  // Reveal on scroll, sutil. prefers-reduced-motion ya anula la transición vía
  // el bloque global de global.css; aquí además saltamos el observer entero.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const els = document.querySelectorAll('.lc-reveal');
  document.documentElement.classList.add('lc-js');
  if (reduce || !('IntersectionObserver' in window)) {
    els.forEach((el) => el.classList.add('lc-visible'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('lc-visible');
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '0px 0px -8% 0px' },
    );
    els.forEach((el) => io.observe(el));
  }
</script>
