---
import Base from '../layouts/Base.astro';
import EcosystemRail from './EcosystemRail.astro';
import IntegrationsShowcase from './IntegrationsShowcase.astro';
import PlatformShowcase from './PlatformShowcase.astro';
import PricingShowcase from './PricingShowcase.astro';
import ThemeRail from './ThemeRail.astro';
import ThemeShowcaseSlider from './ThemeShowcaseSlider.astro';
import ManagementPanelsShowcase from './ManagementPanelsShowcase.astro';
import WorkflowSlider from './WorkflowSlider.astro';
import { GUIAS } from '../lib/docs';
import { getContent, localePath, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = getContent(locale);
const heroWords = [...c.hero.tituloPalabras, c.hero.tituloPalabras[0]];
const ecosystemHighlights = c.escala.ecosistema.items.slice(0, 8);
const managementDemoHref = '/demos/pinadamar/gestion/#/planning';

const faqEstructurada = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faq.items.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

---

<Base locale={locale} content={c}>
  <div class="botanical-landing">
    <section class="botanical-shell botanical-hero" aria-labelledby="hero-title">
      <div class="botanical-hero-intro">
        <p class="botanical-eyebrow">{c.hero.kicker}</p>
        <h1 id="hero-title" class="botanical-hero-heading" aria-label={c.hero.tituloAccesible}>
          <span class="botanical-hero-title-line" aria-hidden="true">{c.hero.tituloAntes}</span>
          <span class="botanical-hero-accent" aria-hidden="true">
            <span class="botanical-word-counter">
              {heroWords.map((word) => <span>{word}</span>)}
            </span>
          </span>
          <span class="botanical-hero-title-line" aria-hidden="true">{c.hero.tituloDespues}</span>
        </h1>
        <p class="botanical-copy botanical-hero-subtitle">{c.hero.subtitulo}</p>

        <form
          class="botanical-hero-cta"
          method="get"
          action={localePath(locale, 'empezar/')}
          data-hero-lead-form
        >
          <label class="botanical-visually-hidden" for={`hero-email-${locale}`}>{c.hero.emailLabel}</label>
          <input
            id={`hero-email-${locale}`}
            class="botanical-hero-email"
            name="email"
            type="email"
            inputmode="email"
            autocomplete="email"
            placeholder={c.hero.emailPlaceholder}
            required
          />
          <button type="submit" class="botanical-button">
            <span>{c.hero.emailCta}</span>
          </button>
        </form>

        <ul class="botanical-hero-shortcuts" aria-label={c.hero.kicker}>
          <li>
            <a href="/demo/">
              <span class="botanical-hero-check" aria-hidden="true">✓</span>
              <span>{c.hero.ctaVer}</span>
            </a>
          </li>
          <li>
            <button type="button" data-camp-tour-trigger aria-haspopup="dialog">
              <span class="botanical-hero-check" aria-hidden="true">✓</span>
              <span data-camp-tour-label>{c.hero.ctaComoFunciona}</span>
            </button>
          </li>
          <li>
            <a href={managementDemoHref}>
              <span class="botanical-hero-check" aria-hidden="true">✓</span>
              <span>{c.hero.ctaMostrador}</span>
            </a>
          </li>
        </ul>
        <p class="botanical-note botanical-hero-note">{c.hero.nota}</p>
      </div>

      <div class="botanical-hero-themes lc-reveal" aria-label={c.temas.estado}>
        <ThemeRail
          items={c.temas.items}
          status={c.temas.estado}
          button={c.temas.verTodos}
          pauseLabel={c.temas.pausar}
          resumeLabel={c.temas.reanudar}
          href={localePath(locale, 'temas/')}
        />
      </div>
    </section>

    <section id="escala" class="botanical-brand-band lc-reveal" aria-labelledby="ecosystem-title">
      <div class="botanical-brand-band-inner">
        <div class="botanical-brand-band-heading">
          <span aria-hidden="true"></span>
          <p id="ecosystem-title" class="botanical-brand-band-label">{c.escala.titulo}</p>
          <span aria-hidden="true"></span>
        </div>
        <EcosystemRail items={ecosystemHighlights} label={c.escala.ecosistema.aria} />
      </div>
    </section>

    <WorkflowSlider {...c.workflow} />

    <PlatformShowcase {...c.platformShowcase} locale={locale} />

    <IntegrationsShowcase {...c.integrationsShowcase} />

    <PricingShowcase {...c.pricingShowcase} locale={locale} requestHref={localePath(locale, 'empezar/')} />

    <ThemeShowcaseSlider locale={locale} content={c.temas} href={localePath(locale, 'temas/')} />

    <ManagementPanelsShowcase locale={locale} content={c.paneles} href={localePath(locale, 'paneles/')} />

    <section class="botanical-shell botanical-section botanical-aftercare">
      <article class="botanical-aftercare-card lc-reveal">
        <p class="botanical-eyebrow">{c.alta.titulo}</p>
        <h2 class="botanical-heading-sm">{c.alta.titulo}</h2>
        <p class="botanical-copy">{c.alta.texto}</p>
      </article>

      <article class="botanical-aftercare-card lc-reveal">
        <p class="botanical-eyebrow">{c.nav.docs}</p>
        <h2 class="botanical-heading-sm">{c.docs.titulo}</h2>
        <p class="botanical-copy">{c.docs.subtitulo}</p>
        <div class="botanical-guide-grid">
          {
            GUIAS.map((guia) => (
              <a href={localePath(locale, `docs/${guia}/`)} class="botanical-guide">
                <span>{c.docs.guias[guia].nombre}</span>
                <span>{c.docs.guias[guia].para} →</span>
              </a>
            ))
          }
        </div>
      </article>
    </section>

    <section class="botanical-faq botanical-section">
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(faqEstructurada).replace(/</g, '\\u003c')}
      />
      <div class="botanical-shell botanical-faq-grid">
        <div class="lc-reveal">
          <p class="botanical-eyebrow">FAQ</p>
          <h2 class="botanical-heading-sm" style="margin-top:18px">{c.faq.titulo}</h2>
        </div>
        <div class="botanical-faq-list">
          {
            c.faq.items.map((f) => (
              <details class="lc-reveal">
                <summary>
                  <span>{f.q}</span><span class="botanical-faq-plus" aria-hidden="true">+</span>
                </summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

  </div>
</Base>
