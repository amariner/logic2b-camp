---
import ThemeMiniature from './ThemeMiniature.astro';
import { portfolioImage } from '../lib/portfolio';
import { localePath, type Locale } from '../lib/i18n';

interface ThemeItem {
  slug: string;
  nombre: string;
  estilo: string;
  imagen: string;
  variante: string;
  estado: string;
  href?: string;
}

interface Props {
  locale: Locale;
  href: string;
  content: {
    kicker: string;
    titulo: string;
    texto: string;
    verTodos: string;
    estado: string;
    detalle: {
      kicker: string;
      descripcion: string;
      previewAria: string;
      abrirPreview: string;
      cerrarPreview: string;
      verFicha: string;
      verDemo: string;
      solicitar: string;
      masInformacion: string;
      notaPreview: string;
      cargandoPreview: string;
      puntos: string[];
      etiquetas: string[];
    };
    items: ThemeItem[];
  };
}

const { locale, href, content: c } = Astro.props;
const previousLabel = locale === 'es' ? 'Ver los temas anteriores' : 'View previous themes';
const nextLabel = locale === 'es' ? 'Ver los temas siguientes' : 'View next themes';
const sliderLabel = locale === 'es' ? 'Doce temas web para campings' : 'Twelve website themes for campsites';
const detail = c.detalle;
const detailPath = (slug: string) => localePath(locale, `temas/${slug}/`);
const conversionPath = (slug: string) => `${localePath(locale, 'empezar/')}?theme=${encodeURIComponent(slug)}`;
---

<section id="demos" class="theme-showcase botanical-section" aria-labelledby="theme-showcase-title" data-theme-showcase>
  <div class="botanical-shell">
    <header class="theme-showcase-heading lc-reveal">
      <div>
        <p class="botanical-eyebrow">{c.kicker}</p>
        <h2 id="theme-showcase-title" class="botanical-heading-sm">{c.titulo}</h2>
      </div>
      <div class="theme-showcase-intro">
        <p class="botanical-copy">{c.texto}</p>
        <a href={href}>{c.verTodos}<span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <div class="theme-showcase-toolbar lc-reveal">
      <p><strong>{String(c.items.length).padStart(2, '0')}</strong> {c.estado}</p>
      <div class="theme-showcase-controls">
        <button type="button" aria-label={previousLabel} data-theme-showcase-prev disabled>
          <span aria-hidden="true">←</span>
        </button>
        <button type="button" aria-label={nextLabel} data-theme-showcase-next>
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>

    <div class="theme-showcase-track" role="region" aria-label={sliderLabel} tabindex="0" data-theme-showcase-track>
      {
        c.items.map((theme, index) => (
          <article class="theme-showcase-card">
            {theme.href ? (
              <button
                class="theme-showcase-visual"
                type="button"
                aria-label={`${detail.abrirPreview}: ${theme.nombre}`}
                aria-controls={`theme-preview-${theme.slug}`}
                aria-haspopup="dialog"
                data-theme-preview-open={`theme-preview-${theme.slug}`}
              >
                <ThemeMiniature
                  name={theme.nombre}
                  style={theme.estilo}
                  image={portfolioImage(theme.slug, theme.imagen)}
                  variant={theme.variante}
                  eager={index < 4}
                  sizes="(max-width: 767px) 82vw, (max-width: 1023px) 46vw, (max-width: 1600px) 24vw, 360px"
                />
              </button>
            ) : (
              <div class="theme-showcase-visual">
                <ThemeMiniature
                  name={theme.nombre}
                  style={theme.estilo}
                  image={portfolioImage(theme.slug, theme.imagen)}
                  variant={theme.variante}
                  eager={index < 4}
                  sizes="(max-width: 767px) 82vw, (max-width: 1023px) 46vw, (max-width: 1600px) 24vw, 360px"
                />
              </div>
            )}
            <div class="theme-showcase-card-body">
              <div class="theme-showcase-card-meta">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <small>{theme.estado}</small>
              </div>
              <h3>{theme.nombre}</h3>
              <p>{theme.estilo}</p>
              {theme.href && (
                <button
                  class="theme-showcase-open"
                  type="button"
                  aria-label={`${detail.abrirPreview}: ${theme.nombre}`}
                  aria-controls={`theme-preview-${theme.slug}`}
                  aria-haspopup="dialog"
                  data-theme-preview-open={`theme-preview-${theme.slug}`}
                >↗</button>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>

  {
    c.items.filter((theme) => theme.href).map((theme) => (
      <dialog
        id={`theme-preview-${theme.slug}`}
        class="theme-preview-dialog"
        aria-labelledby={`theme-preview-title-${theme.slug}`}
        data-theme-preview-dialog
      >
        <div class="theme-preview-layout">
          <button class="theme-preview-close" type="button" data-theme-preview-close aria-label={detail.cerrarPreview}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="m6 6 12 12M18 6 6 18" />
            </svg>
          </button>
          <div class="theme-preview-browser" data-theme-preview-browser data-loading>
            <div class="theme-preview-bar">
              <i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i>
              <span>{theme.slug}.tudominio.com</span>
            </div>
            <div class="theme-preview-screen">
              <div class="theme-preview-loading" role="status" aria-live="polite" data-theme-preview-loading>
                <span aria-hidden="true"></span>
                <small>{detail.cargandoPreview}</small>
              </div>
              <iframe
                src="about:blank"
                data-theme-preview-frame
                data-theme-preview-src={theme.href}
                title={detail.previewAria.replace('{theme}', theme.nombre)}
                loading="lazy"
                aria-busy="true"
              ></iframe>
            </div>
          </div>
          <aside class="theme-preview-side">
            <h2 id={`theme-preview-title-${theme.slug}`}>{theme.nombre}</h2>
            <div class="theme-preview-actions">
              <a class="theme-preview-primary" href={conversionPath(theme.slug)}>{detail.solicitar}<span aria-hidden="true">→</span></a>
              <a class="theme-preview-secondary" href={detailPath(theme.slug)}>{detail.masInformacion}<span aria-hidden="true">↗</span></a>
            </div>
          </aside>
        </div>
      </dialog>
    ))
  }
</section>

<script>
  import { syncShowcasePreviewScroll } from '../lib/showcasePreview';

  document.querySelectorAll<HTMLElement>('[data-theme-showcase]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-theme-showcase-track]');
    const previous = root.querySelector<HTMLButtonElement>('[data-theme-showcase-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-theme-showcase-next]');
    if (!track || !previous || !next) return;

    const updateControls = () => {
      const maximum = Math.max(0, track.scrollWidth - track.clientWidth);
      previous.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= maximum - 2;
    };

    const move = (direction: -1 | 1) => {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const card = track.querySelector<HTMLElement>('.theme-showcase-card');
      const gap = Number.parseFloat(getComputedStyle(track).columnGap) || 0;
      const visibleCards = window.innerWidth >= 1024 ? 4 : window.innerWidth >= 768 ? 2 : 1;
      const distance = card ? (card.offsetWidth + gap) * visibleCards : track.clientWidth;
      track.scrollBy({
        left: direction * distance,
        behavior: reduceMotion ? 'auto' : 'smooth',
      });
    };

    previous.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));
    track.addEventListener('scroll', updateControls, { passive: true });
    window.addEventListener('resize', updateControls, { passive: true });
    updateControls();
  });

  const themePreviewOpeners = new WeakMap<HTMLDialogElement, HTMLButtonElement>();

  const prepareThemeFrame = (dialog: HTMLDialogElement) => {
    const frame = dialog.querySelector<HTMLIFrameElement>('[data-theme-preview-frame]');
    const browser = dialog.querySelector<HTMLElement>('[data-theme-preview-browser]');
    if (!frame || !browser) return;

    if (frame.dataset.previewLoadBound !== 'true') {
      frame.dataset.previewLoadBound = 'true';
      frame.addEventListener('load', () => {
        if (frame.getAttribute('src') === 'about:blank') return;
        frame.dataset.previewLoaded = 'true';
        frame.removeAttribute('aria-busy');
        browser.removeAttribute('data-loading');
      });
    }

    if (frame.dataset.previewLoaded !== 'true') {
      browser.setAttribute('data-loading', '');
      frame.setAttribute('aria-busy', 'true');
    }
    if (frame.dataset.themePreviewSrc && frame.getAttribute('src') === 'about:blank') {
      frame.src = frame.dataset.themePreviewSrc;
    }
  };

  document.querySelectorAll<HTMLButtonElement>('[data-theme-preview-open]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const id = trigger.dataset.themePreviewOpen;
      const dialog = id ? document.getElementById(id) : null;
      if (dialog instanceof HTMLDialogElement) {
        themePreviewOpeners.set(dialog, trigger);
        trigger.closest<HTMLElement>('[data-theme-motion]')?.setAttribute('data-preview-paused', 'true');
        dialog.querySelector<HTMLElement>('.theme-preview-side')?.scrollTo(0, 0);
        prepareThemeFrame(dialog);
        if (!dialog.open) dialog.showModal();
        syncShowcasePreviewScroll();
      }
    });
  });

  document.querySelectorAll<HTMLDialogElement>('[data-theme-preview-dialog]').forEach((dialog) => {
    dialog.querySelector<HTMLButtonElement>('[data-theme-preview-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      const frame = dialog.querySelector<HTMLIFrameElement>('[data-theme-preview-frame]');
      const browser = dialog.querySelector<HTMLElement>('[data-theme-preview-browser]');
      dialog.querySelector<HTMLElement>('.theme-preview-side')?.scrollTo(0, 0);
      if (frame) {
        frame.src = 'about:blank';
        delete frame.dataset.previewLoaded;
        frame.setAttribute('aria-busy', 'true');
      }
      browser?.setAttribute('data-loading', '');
      syncShowcasePreviewScroll();
      const opener = themePreviewOpeners.get(dialog);
      const rail = opener?.closest<HTMLElement>('[data-theme-motion]');
      let focusTarget: HTMLElement | undefined = opener;
      if (opener && rail) {
        const openerBox = opener.getBoundingClientRect();
        const railBox = rail.getBoundingClientRect();
        const isClone = opener.closest('article')?.getAttribute('aria-hidden') === 'true';
        const isVisible =
          openerBox.top >= railBox.top &&
          openerBox.bottom <= railBox.bottom &&
          openerBox.left >= railBox.left &&
          openerBox.right <= railBox.right;
        if (isClone || !isVisible) {
          focusTarget = rail.querySelector<HTMLElement>('.camp-theme-link') ?? opener;
        }
      }
      focusTarget?.focus({ preventScroll: true });
      if (rail) requestAnimationFrame(() => rail.removeAttribute('data-preview-paused'));
    });
  });
</script>

<style>
  .theme-showcase {
    overflow: hidden;
    background: var(--botanical-keylime);
  }
  .theme-showcase-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, .72fr);
    gap: clamp(36px, 8vw, 120px);
    align-items: end;
  }
  .theme-showcase-heading h2 { margin-top:18px; }
  .theme-showcase-intro { max-width:610px; }
  .theme-showcase-intro a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    border-bottom: 1px solid color-mix(in srgb,var(--botanical-ink) 34%,transparent);
    padding-bottom: 3px;
    color: var(--botanical-ink);
    font-size: 13px;
    font-weight: 720;
  }
  .theme-showcase-intro a span { transition:transform 160ms ease; }
  .theme-showcase-intro a:hover span { transform:translate(2px,-2px); }
  .theme-showcase-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: clamp(38px,5vw,62px);
  }
  .theme-showcase-toolbar p {
    color: color-mix(in srgb,var(--botanical-ink) 62%,white);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .theme-showcase-toolbar strong { color:var(--botanical-ink); }
  .theme-showcase-controls { display:flex; gap:8px; }
  .theme-showcase-controls button {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid color-mix(in srgb,var(--botanical-ink) 18%,transparent);
    border-radius: 50%;
    background: var(--botanical-paper);
    color: var(--botanical-ink);
    font: inherit;
    font-size: 17px;
    cursor: pointer;
    transition: background-color 160ms ease,opacity 160ms ease,transform 160ms ease;
  }
  .theme-showcase-controls button:hover:not(:disabled) { transform:translateY(-2px); background:white; }
  .theme-showcase-controls button:disabled { opacity:.28; cursor:default; }
  .theme-showcase-track {
    --theme-showcase-gutter: max(24px, calc((100vw - 1500px) / 2));
    display: grid;
    width: 100vw;
    grid-auto-columns: calc((100vw - var(--theme-showcase-gutter) - var(--theme-showcase-gutter) - 42px) / 4);
    grid-auto-flow: column;
    gap: 14px;
    margin-top: 0;
    margin-left: calc(50% - 50vw);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    padding: 26px var(--theme-showcase-gutter) 50px;
    scroll-behavior: smooth;
    scroll-padding-inline: var(--theme-showcase-gutter);
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    box-sizing: border-box;
    -webkit-overflow-scrolling: touch;
  }
  .theme-showcase-track::-webkit-scrollbar { display:none; }
  .theme-showcase-track:focus-visible { outline:2px solid var(--botanical-ink); outline-offset:6px; }
  .theme-showcase-card {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb,var(--botanical-ink) 9%,transparent);
    border-radius: 22px;
    background: var(--botanical-paper);
    box-shadow: 0 14px 34px color-mix(in srgb,var(--botanical-ink) 6%,transparent);
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
  .theme-showcase-visual { display:block; width:calc(100% - 20px); margin:10px 10px 0; overflow:hidden; border:0; border-radius:15px; padding:0; background:transparent; cursor:zoom-in; text-align:inherit; }
  .theme-showcase-visual :global(.theme-miniature) { aspect-ratio:1.35; }
  .theme-showcase-card-body { position:relative; padding:16px 18px 20px; }
  .theme-showcase-card-meta { display:flex; align-items:center; justify-content:space-between; gap:10px; }
  .theme-showcase-card-meta span,.theme-showcase-card-meta small {
    color: color-mix(in srgb,var(--botanical-ink) 70%,white);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .07em;
    text-transform: uppercase;
  }
  .theme-showcase-card-meta small { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .theme-showcase-card h3 { margin-top:11px; padding-right:60px; color:var(--botanical-ink); font-size:clamp(20px,1.65vw,25px); letter-spacing:-.035em; line-height:1; }
  .theme-showcase-card-body > p { min-height:2.8em; margin-top:7px; padding-right:60px; color:color-mix(in srgb,var(--botanical-ink) 74%,white); font-size:12px; line-height:1.45; }
  .theme-showcase-open {
    position: absolute;
    right: 16px;
    bottom: 18px;
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border-radius: 50%;
    background: color-mix(in srgb,var(--botanical-keylime) 68%,white);
    color: var(--botanical-ink);
    border:0;
    font:inherit;
    font-size: 15px;
    cursor:zoom-in;
    transition: transform 160ms ease,background-color 160ms ease;
  }
  .theme-showcase-open:hover { transform:translate(2px,-2px); background:var(--botanical-keylime); }
  :global(html.showcase-preview-open) { overflow:hidden; overscroll-behavior:none; }
  .theme-preview-dialog {
    width:min(1760px,calc(100vw - 32px));
    max-width:none;
    height:calc(100dvh - 32px);
    max-height:none;
    margin:auto;
    overflow:hidden;
    border:0;
    border-radius:24px;
    padding:0;
    background:var(--botanical-paper);
    color:var(--botanical-ink);
    box-shadow:0 32px 90px rgb(6 33 12 / 32%);
    overscroll-behavior:contain;
  }
  .theme-preview-dialog::backdrop { background:rgb(6 24 10 / 64%); backdrop-filter:blur(8px); }
  .theme-preview-layout { position:relative; display:grid; height:100%; grid-template-columns:minmax(0,1fr) clamp(240px,19vw,286px); }
  .theme-preview-close { position:absolute; top:16px; right:16px; z-index:5; display:grid; width:44px; height:44px; place-items:center; border:1px solid color-mix(in srgb,var(--botanical-ink) 18%,transparent); border-radius:12px; background:color-mix(in srgb,var(--botanical-paper) 94%,transparent); color:var(--botanical-ink); cursor:pointer; backdrop-filter:blur(10px); box-shadow:0 8px 24px rgb(6 33 12 / 12%); touch-action:manipulation; transition:background-color 160ms ease,border-color 160ms ease,transform 160ms ease; }
  .theme-preview-close svg { width:20px; height:20px; }
  .theme-preview-close:hover { background:var(--botanical-mint); }
  .theme-preview-close:active { transform:scale(.96); }
  .theme-preview-browser { min-width:0; margin:14px 0 14px 14px; overflow:hidden; border:1px solid color-mix(in srgb,var(--botanical-ink) 14%,transparent); border-radius:16px; background:white; box-shadow:0 18px 50px rgb(15 62 23 / 13%); }
  .theme-preview-bar { display:flex; min-height:46px; align-items:center; gap:7px; border-bottom:1px solid color-mix(in srgb,var(--botanical-ink) 10%,transparent); padding:0 10px 0 16px; background:#fffefc; }
  .theme-preview-bar>i { width:10px; height:10px; border-radius:50%; background:color-mix(in srgb,var(--botanical-ink) 18%,white); }
  .theme-preview-bar>span { min-width:0; flex:1; margin-left:8px; overflow:hidden; color:color-mix(in srgb,var(--botanical-ink) 64%,white); font-size:12px; text-overflow:ellipsis; white-space:nowrap; }
  .theme-preview-screen { position:relative; height:calc(100% - 46px); overflow:hidden; background:white; }
  .theme-preview-screen iframe { position:relative; z-index:1; display:block; width:100%; height:100%; border:0; background:white; transition:opacity 180ms ease; }
  .theme-preview-loading { position:absolute; inset:0; z-index:2; display:grid; place-content:center; justify-items:center; gap:12px; background:color-mix(in srgb,var(--botanical-paper) 94%,white); color:color-mix(in srgb,var(--botanical-ink) 62%,white); opacity:0; visibility:hidden; pointer-events:none; transition:opacity 180ms ease,visibility 180ms ease; }
  .theme-preview-loading>span { width:28px; height:28px; border:2px solid color-mix(in srgb,var(--botanical-ink) 15%,transparent); border-top-color:var(--botanical-ink); border-radius:50%; animation:theme-preview-spin .8s linear infinite; }
  .theme-preview-loading small { font-size:11px; font-weight:700; }
  .theme-preview-browser[data-loading] .theme-preview-loading { opacity:1; visibility:visible; }
  .theme-preview-browser[data-loading] iframe { opacity:.35; }
  .theme-preview-side { display:flex; min-height:0; flex-direction:column; padding:78px 18px 20px; }
  .theme-preview-side h2 { margin:0; font-family:var(--botanical-serif); font-size:clamp(30px,2.5vw,40px); font-weight:400; letter-spacing:-.04em; line-height:.96; }
  .theme-preview-actions { display:grid; gap:7px; margin-top:20px; }
  .theme-preview-actions a { display:flex; min-height:44px; align-items:center; justify-content:space-between; gap:10px; border-radius:999px; padding:0 14px; font-size:11px; font-weight:800; }
  .theme-preview-primary { background:var(--botanical-ink); color:white; }
  .theme-preview-secondary { border:1px solid color-mix(in srgb,var(--botanical-ink) 20%,transparent); color:var(--botanical-ink); }
  @keyframes theme-preview-spin { to { transform:rotate(360deg); } }
  @media (prefers-reduced-motion:reduce) {
    .theme-showcase-track { scroll-behavior:auto; }
    .theme-showcase-intro a span,.theme-showcase-open,.theme-preview-screen iframe,.theme-preview-loading { transition:none; }
    .theme-preview-loading>span { animation:none; border-color:var(--botanical-ink); }
  }
  @media (max-width:1023px) {
    .theme-showcase-track { grid-auto-columns:calc((100vw - var(--theme-showcase-gutter) - var(--theme-showcase-gutter) - 14px) / 2); }
  }
  @media (max-width:767px) {
    .theme-showcase-heading { grid-template-columns:1fr; gap:22px; }
    .theme-showcase-track { --theme-showcase-gutter:14px; grid-auto-columns:min(82vw,310px); }
    .theme-showcase-controls button { width:44px; height:44px; }
    .theme-showcase-card-body { padding:18px 18px 22px; }
    .theme-showcase-card-meta span,.theme-showcase-card-meta small { font-size:10px; }
    .theme-showcase-card h3 { font-size:26px; }
    .theme-showcase-card-body > p { font-size:13px; }
    .theme-preview-dialog { width:calc(100vw - 24px); height:calc(100vh - 24px); height:calc(100dvh - 24px); border-radius:18px; }
    .theme-preview-dialog::backdrop { background:rgb(6 24 10 / 48%); backdrop-filter:blur(4px); }
    .theme-preview-layout { grid-template-columns:1fr; grid-template-rows:minmax(0,1fr) auto; }
    .theme-preview-browser { margin:0; border-width:0 0 1px; border-radius:0; }
    .theme-preview-bar { min-height:52px; padding-right:58px; }
    .theme-preview-screen { height:calc(100% - 52px); }
    .theme-preview-close { top:max(4px,env(safe-area-inset-top)); right:max(4px,env(safe-area-inset-right)); border-color:transparent; box-shadow:none; }
    .theme-preview-side { display:grid; grid-template-columns:minmax(0,.6fr) minmax(0,1.4fr); gap:10px; align-items:center; padding:8px max(12px,env(safe-area-inset-right)) max(10px,env(safe-area-inset-bottom)) max(12px,env(safe-area-inset-left)); }
    .theme-preview-side h2 { min-width:0; overflow:hidden; font-size:clamp(20px,6vw,25px); line-height:1; text-overflow:ellipsis; white-space:nowrap; }
    .theme-preview-actions { grid-template-columns:repeat(2,minmax(0,1fr)); gap:6px; margin-top:0; }
    .theme-preview-actions a { min-height:44px; gap:5px; padding:0 10px; font-size:10px; line-height:1.05; }
  }
