---
import type { Locale } from '../lib/i18n';
import { getContent, localePath } from '../lib/i18n';
import Base from '../layouts/Base.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = getContent(locale);
const p = c.inteligente;
const demoHref = '/demos/mardefondo/gestion/#/control-total/centro';
---

<Base locale={locale} content={c} ruta="inteligente/" seo={p.seo}>
  <div class="botanical-page intelligent-page">
    <section class="intelligent-hero botanical-shell botanical-subpage-hero">
      <div>
        <p class="botanical-eyebrow">{p.kicker}</p>
        <h1 class="botanical-heading">{p.titulo}</h1>
        <p class="intelligent-price">{p.precio}</p>
      </div>
      <div class="intelligent-hero-copy">
        <p class="botanical-copy">{p.intro}</p>
        <div class="intelligent-actions">
          <a class="botanical-button" href={demoHref}>{p.demo}<span aria-hidden="true">→</span></a>
          <button type="button" class="intelligent-secondary" data-project-request-open data-project-request-plan="Inteligente · Control total">{p.contacto}</button>
        </div>
        <p class="intelligent-disclaimer">{p.aviso}</p>
      </div>
    </section>

    <section class="intelligent-families botanical-section">
      <div class="botanical-shell">
        <div class="intelligent-section-head">
          <h2 class="botanical-heading-sm">{p.familiasTitulo}</h2>
          <p class="botanical-copy">{p.familiasIntro}</p>
        </div>
        <div class="intelligent-family-grid">
          {p.familias.map((familia, index) => (
            <article class="intelligent-family lc-reveal" style={`--lc-delay:${(index % 4) * 55}ms`}>
              <div class="intelligent-family-top">
                <span class="intelligent-family-index">{String(index + 1).padStart(2, '0')}</span>
                <span class:list={['intelligent-status', `status-${Math.min(index, 4)}`]}>{familia.estado}</span>
              </div>
              <h3>{familia.nombre}</h3>
              <p>{familia.texto}</p>
              <ul>{familia.capacidades.map((capacidad) => <li>{capacidad}</li>)}</ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="botanical-shell botanical-section intelligent-states">
      <div class="intelligent-section-head"><h2 class="botanical-heading-sm">{p.estadosTitulo}</h2></div>
      <div class="intelligent-state-matrix">
        {p.estados.map((estado, index) => (
          <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{estado.nombre}</h3><p>{estado.texto}</p></article>
        ))}
      </div>
    </section>

    <section class="intelligent-day botanical-section">
      <div class="botanical-shell">
        <h2 class="botanical-heading-sm">{p.jornadaTitulo}</h2>
        <ol class="intelligent-timeline">
          {p.jornada.map((decision, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{decision}</strong></li>)}
        </ol>
      </div>
    </section>

    <section class="botanical-shell botanical-section">
      <div class="intelligent-section-head"><h2 class="botanical-heading-sm">{p.flujosTitulo}</h2></div>
      <div class="intelligent-flow-grid">
        {p.flujos.map((flujo) => (
          <article class="intelligent-flow lc-reveal">
            <h3>{flujo.nombre}</h3>
            <ol>{flujo.pasos.map((paso, index) => <li><span>{index + 1}</span><strong>{paso}</strong>{index < flujo.pasos.length - 1 && <b aria-hidden="true">→</b>}</li>)}</ol>
          </article>
        ))}
      </div>
    </section>

    <section class="botanical-shell intelligent-autonomy">
      <div><p class="botanical-eyebrow">Human in control</p><h2>{p.autonomiaTitulo}</h2></div>
      <p>{p.autonomiaTexto}</p>
    </section>

    <section class="botanical-shell botanical-section intelligent-close">
      <h2 class="botanical-heading-sm">{p.cierreTitulo}</h2>
      <p class="botanical-copy">{p.cierreTexto}</p>
      <div class="intelligent-actions">
        <a class="botanical-button" href={demoHref}>{p.demo}<span aria-hidden="true">→</span></a>
        <a class="intelligent-secondary" href={localePath(locale, 'docs/direccion/')}>{c.docs.guias.direccion.nombre}</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .intelligent-hero { display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(38px,8vw,118px);align-items:end;padding:clamp(70px,9vw,128px) 0 clamp(58px,8vw,108px); }
  .intelligent-hero h1{margin-top:18px;max-width:850px}.intelligent-hero-copy{display:grid;gap:24px}.intelligent-price{display:inline-flex;margin-top:28px;border:1px solid color-mix(in srgb,var(--botanical-ink) 24%,transparent);border-radius:999px;padding:9px 14px;font-size:13px;font-weight:650}.intelligent-actions{display:flex;flex-wrap:wrap;gap:10px;align-items:center}.intelligent-secondary{display:inline-flex;min-height:46px;align-items:center;justify-content:center;border:1px solid color-mix(in srgb,var(--botanical-ink) 30%,transparent);border-radius:8px;padding:0 19px;color:var(--botanical-ink);font-size:13px;font-weight:650;background:transparent}.intelligent-disclaimer{font-size:11px;line-height:1.55;color:color-mix(in srgb,var(--botanical-ink) 62%,white)}
  .intelligent-families{background:var(--botanical-mint)}.intelligent-section-head{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:end;margin-bottom:40px}.intelligent-family-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.intelligent-family{display:flex;min-height:330px;flex-direction:column;border-radius:12px;background:var(--botanical-paper);padding:24px}.intelligent-family-top{display:flex;justify-content:space-between;gap:8px;align-items:center}.intelligent-family-index{font-family:var(--botanical-serif);font-size:20px}.intelligent-status{border-radius:999px;background:var(--botanical-keylime);padding:5px 8px;font-size:9px;font-weight:700;letter-spacing:.05em;text-transform:uppercase}.intelligent-family:nth-child(n+5) .intelligent-status{background:var(--botanical-slate)}.intelligent-family:nth-child(n+7) .intelligent-status{background:color-mix(in srgb,var(--botanical-ink) 12%,white)}.intelligent-family h3{margin-top:28px;font-size:22px;line-height:1.08}.intelligent-family>p{margin-top:10px;color:color-mix(in srgb,var(--botanical-ink) 70%,white);font-size:13px;line-height:1.55}.intelligent-family ul{display:grid;gap:8px;margin-top:auto;padding-top:24px;font-size:12px}.intelligent-family li{border-top:1px solid color-mix(in srgb,var(--botanical-ink) 15%,transparent);padding-top:8px}
  .intelligent-state-matrix{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border:1px solid color-mix(in srgb,var(--botanical-ink) 18%,transparent);border-radius:12px;overflow:hidden}.intelligent-state-matrix article{min-height:210px;padding:24px;border-right:1px solid color-mix(in srgb,var(--botanical-ink) 18%,transparent)}.intelligent-state-matrix article:last-child{border:0}.intelligent-state-matrix span{font-family:var(--botanical-serif);font-size:30px;color:color-mix(in srgb,var(--botanical-ink) 38%,white)}.intelligent-state-matrix h3{margin-top:32px;font-size:18px}.intelligent-state-matrix p{margin-top:8px;font-size:12px;line-height:1.5;color:color-mix(in srgb,var(--botanical-ink) 66%,white)}
  .intelligent-day{background:var(--botanical-ink);color:var(--botanical-paper)}.intelligent-timeline{display:grid;grid-template-columns:repeat(7,1fr);margin-top:42px}.intelligent-timeline li{position:relative;display:grid;gap:16px;border-top:1px solid color-mix(in srgb,var(--botanical-paper) 35%,transparent);padding:22px 14px 0 0}.intelligent-timeline li:before{content:'';position:absolute;top:-5px;left:0;width:9px;height:9px;border-radius:50%;background:var(--botanical-keylime)}.intelligent-timeline span{font-size:10px;color:color-mix(in srgb,var(--botanical-paper) 65%,transparent)}.intelligent-timeline strong{max-width:130px;font-size:13px;line-height:1.3}
  .intelligent-flow-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.intelligent-flow{border-radius:12px;background:var(--botanical-slate);padding:28px}.intelligent-flow:nth-child(2){background:var(--botanical-keylime)}.intelligent-flow:nth-child(3){background:var(--botanical-mint)}.intelligent-flow h3{font-size:25px}.intelligent-flow ol{display:grid;gap:2px;margin-top:24px}.intelligent-flow li{display:grid;grid-template-columns:24px 1fr 18px;align-items:center;min-height:44px;border-top:1px solid color-mix(in srgb,var(--botanical-ink) 18%,transparent);font-size:12px}.intelligent-flow li span{font-family:var(--botanical-serif);font-size:16px}.intelligent-flow li b{font-weight:400}
  .intelligent-autonomy{display:grid;grid-template-columns:.8fr 1.2fr;gap:60px;margin-top:clamp(50px,7vw,96px);border-radius:14px;background:var(--botanical-keylime);padding:clamp(30px,5vw,58px)}.intelligent-autonomy h2{margin-top:12px;font-size:clamp(30px,4vw,52px);line-height:1}.intelligent-autonomy>p{max-width:700px;font-size:16px;line-height:1.65}.intelligent-close{display:grid;justify-items:center;text-align:center}.intelligent-close .botanical-copy{max-width:700px;margin-top:18px}.intelligent-close .intelligent-actions{margin-top:28px}
  @media(max-width:1000px){.intelligent-family-grid{grid-template-columns:repeat(2,1fr)}.intelligent-timeline{grid-template-columns:repeat(4,1fr);gap:30px 0}.intelligent-flow-grid{grid-template-columns:1fr}}
  @media(max-width:720px){.intelligent-hero,.intelligent-section-head,.intelligent-autonomy{grid-template-columns:1fr}.intelligent-hero{gap:32px}.intelligent-family-grid,.intelligent-state-matrix{grid-template-columns:1fr}.intelligent-family{min-height:280px}.intelligent-state-matrix article{min-height:0;border-right:0;border-bottom:1px solid color-mix(in srgb,var(--botanical-ink) 18%,transparent)}.intelligent-state-matrix h3{margin-top:14px}.intelligent-timeline{grid-template-columns:1fr 1fr}.intelligent-autonomy{gap:24px}.intelligent-actions>*{width:100%}}
</style>
