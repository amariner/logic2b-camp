---
/** Una página de guía. Compartido por `/docs/{guia}/{slug}/` y su variante por idioma. */
import Docs from '../layouts/Docs.astro';
import PlanningGestures from './PlanningGestures.astro';
import { esFallback, getDoc, getGuia, vecinos, type Guia } from '../lib/docs';
import { getContent, localePath, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  guia: Guia;
  slug: string;
}
const { locale, guia, slug } = Astro.props;
const c = getContent(locale);
const d = c.docs;

const doc = getDoc(guia, slug, locale);
if (!doc) return Astro.redirect(localePath(locale, `docs/${guia}/`));

const paginas = getGuia(guia, locale);
const { anterior, siguiente } = vecinos(guia, slug, locale);
const { Content } = doc;
const showPlanningGestures = guia === 'recepcion' && slug === 'mover';
---

<Docs
  locale={locale}
  guia={guia}
  paginas={paginas}
  actual={slug}
  seo={{
    title: `${doc.frontmatter.title} — ${d.guias[guia].nombre} · Logic2B Campings`,
    description: doc.frontmatter.description,
  }}
  ruta={`docs/${guia}/${slug}/`}
>
  {
    esFallback(doc, locale) && (
      <p lang={doc.frontmatter.lang} class="botanical-callout mb-8">
        {d.fallback}
      </p>
    )
  }

  <article>
    {/* Sin font-display ni bold: el h1 hereda la serif tinta del tema botánico. */}
    <h1 class="text-3xl sm:text-4xl">{doc.frontmatter.title}</h1>
    <p class="mt-3 text-lg text-muted-foreground">{doc.frontmatter.description}</p>
    {showPlanningGestures && <PlanningGestures />}
    <div class="lc-prosa mt-8">
      <Content />
    </div>
  </article>

  <nav
    class="mt-14 flex flex-col gap-3 border-t border-border pt-6 sm:flex-row sm:justify-between"
    aria-label={d.indice}
  >
    {
      anterior ? (
        <a
          href={localePath(locale, `docs/${guia}/${anterior.slug}/`)}
          rel="prev"
          class="group min-w-0 rounded-[14px] border border-border px-4 py-3 transition-colors hover:border-primary/60 hover:bg-muted/40"
        >
          <span class="block text-xs text-muted-foreground">{d.anterior}</span>
          <span class="mt-0.5 block truncate text-sm font-medium">
            {anterior.frontmatter.title}
          </span>
        </a>
      ) : (
        <span />
      )
    }
    {
      siguiente && (
        <a
          href={localePath(locale, `docs/${guia}/${siguiente.slug}/`)}
          rel="next"
          class="group min-w-0 rounded-[14px] border border-border px-4 py-3 text-right transition-colors hover:border-primary/60 hover:bg-muted/40 sm:ml-auto"
        >
          <span class="block text-xs text-muted-foreground">{d.siguiente}</span>
          <span class="mt-0.5 block truncate text-sm font-medium">
            {siguiente.frontmatter.title}
          </span>
        </a>
      )
    }
  </nav>
</Docs>
