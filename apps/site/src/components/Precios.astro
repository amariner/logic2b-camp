---
/**
 * Página de precios: reutiliza las tarjetas y el selector de facturación de la
 * home para que nombres, importes y condiciones tengan una sola fuente.
 * Debajo explica mantenimiento y servicios adicionales.
 */
import type { Locale } from '../lib/i18n';
import { getContent, localePath } from '../lib/i18n';
import Base from '../layouts/Base.astro';
import PricingShowcase from './PricingShowcase.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = getContent(locale);
const p = c.precios;
---

<Base locale={locale} content={c} ruta="precios/" seo={p.seo}>
  <div class="botanical-page">
    <section class="pricing-hero botanical-shell botanical-subpage-hero">
      <div>
        <p class="botanical-eyebrow">{p.kicker}</p>
        <h1 class="botanical-heading">{p.titulo}</h1>
      </div>
      <p class="botanical-copy">{p.intro}</p>
    </section>

    <PricingShowcase
      {...c.pricingShowcase}
      locale={locale}
      titulo={p.planesTitulo}
      requestHref={localePath(locale, 'empezar/')}
      legalNote={p.iva}
    />

    <section class="botanical-shell botanical-section botanical-aftercare pricing-detalle">
      <article class="botanical-aftercare-card lc-reveal">
        <h2 class="botanical-heading-sm">{p.incluyeTitulo}</h2>
        <ul class="botanical-checks">
          {
            p.incluye.map((item) => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
        <p class="pricing-nota">{p.noIncluye}</p>
      </article>

      <article class="botanical-aftercare-card lc-reveal">
        <h2 class="botanical-heading-sm">{p.desarrolloTitulo}</h2>
        <p class="botanical-copy">{p.desarrolloIntro}</p>
        <ul class="pricing-bolsas">
          {
            p.bolsas.map((item) => (
              <li>
                <div>
                  <h3>{item.nombre}</h3>
                  <p>{item.texto}</p>
                </div>
                <strong>{item.precio}</strong>
              </li>
            ))
          }
        </ul>
      </article>
    </section>

    <section class="botanical-shell">
      <div class="pricing-packs lc-reveal">
        <h2>{p.packsTitulo}</h2>
        <p class="pricing-packs-intro">{p.packsIntro}</p>
        <div class="pricing-packs-grid">
          {
            p.packs.map((pack) => (
              <article>
                <h3>{pack.nombre}</h3>
                <strong>{pack.precio}</strong>
                <p>{pack.texto}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="botanical-shell botanical-section pricing-cta">
      <div class="botanical-centered-head lc-reveal">
        <h2 class="botanical-heading-sm">{p.ctaTitulo}</h2>
        <p class="botanical-copy">{p.ctaTexto}</p>
        <a href={localePath(locale, 'empezar/')} class="botanical-button">
          {p.cta}<span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </div>
</Base>

<style>
  /* Héroe con la retícula de /temas/: título a la izquierda, intro apoyada
   * en la línea base a la derecha. */
  .pricing-hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(40px, 8vw, 120px);
    align-items: end;
    padding: clamp(70px, 9vw, 128px) 0 clamp(56px, 7vw, 92px);
  }

  .pricing-hero h1 {
    max-width: 840px;
    margin-top: 18px;
  }

  .pricing-hero .botanical-copy {
    max-width: 560px;
  }

  .pricing-detalle .botanical-checks {
    margin-top: 26px;
    font-size: 14px;
  }

  .pricing-nota {
    max-width: 520px;
    margin-top: 26px;
    color: color-mix(in srgb, var(--botanical-ink) 62%, white);
    font-size: 12px;
    line-height: 1.55;
  }

  .pricing-bolsas {
    display: grid;
    margin-top: 26px;
  }

  .pricing-bolsas li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    border-top: 1px solid color-mix(in srgb, var(--botanical-ink) 18%, transparent);
    padding: 16px 0;
  }

  .pricing-bolsas h3 {
    font-size: 19px;
    line-height: 1.2;
  }

  .pricing-bolsas p {
    margin-top: 5px;
    color: color-mix(in srgb, var(--botanical-ink) 66%, white);
    font-size: 13px;
    line-height: 1.5;
  }

  .pricing-bolsas strong {
    flex: none;
    color: var(--botanical-ink);
    font-family: var(--botanical-serif);
    font-size: 20px;
    font-weight: 400;
    white-space: nowrap;
  }

  /* El momento de contraste de la página, como el panel salvia del contacto
   * en el home: packs de salida sobre tinta. */
  .pricing-packs {
    border-radius: 14px;
    background: var(--botanical-ink);
    padding: clamp(32px, 5vw, 58px);
  }

  .pricing-packs h2 {
    max-width: 680px;
    color: var(--botanical-paper);
    font-size: clamp(30px, 3.6vw, 44px);
    line-height: 1.1;
  }

  .pricing-packs-intro {
    max-width: 650px;
    margin-top: 14px;
    color: color-mix(in srgb, var(--botanical-paper) 78%, transparent);
    font-size: 14px;
    line-height: 1.55;
  }

  .pricing-packs-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-top: 38px;
  }

  .pricing-packs-grid article {
    border-radius: 14px;
    background: color-mix(in srgb, var(--botanical-paper) 9%, transparent);
    padding: 24px;
  }

  .pricing-packs-grid h3 {
    color: var(--botanical-paper);
    font-size: 20px;
    line-height: 1.2;
  }

  .pricing-packs-grid strong {
    display: block;
    margin-top: 14px;
    color: var(--botanical-paper);
    font-family: var(--botanical-serif);
    font-size: 24px;
    font-weight: 400;
  }

  .pricing-packs-grid p {
    margin-top: 10px;
    color: color-mix(in srgb, var(--botanical-paper) 74%, transparent);
    font-size: 13px;
    line-height: 1.5;
  }

  .pricing-cta .botanical-copy {
    max-width: 640px;
    margin-top: 20px;
  }

  .pricing-cta .botanical-button {
    margin-top: 32px;
  }

  @media (max-width: 1023px) {
    .pricing-packs-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .pricing-hero {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  @media (max-width: 560px) {
    .pricing-packs-grid {
      grid-template-columns: 1fr;
    }

    .pricing-bolsas li {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
