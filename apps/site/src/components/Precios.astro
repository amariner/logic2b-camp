---
/**
 * Página de precios con la identidad botánica del home: héroe sobre papel,
 * banda mint con los cuatro planes (mismas tarjetas que #niveles de la
 * landing, aquí con alta Y cuota), dos tarjetas keylime/slate para lo que
 * incluye la cuota y el desarrollo a medida, panel tinta con los packs y
 * cierre centrado hacia #contacto. El contenido es el mismo de siempre
 * (content/{lang}.json); solo cambia la piel y la estructura.
 */
import type { Locale } from '../lib/i18n';
import { getContent, localePath } from '../lib/i18n';
import Base from '../layouts/Base.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = getContent(locale);
const p = c.precios;
const inicio = localePath(locale);
---

<Base locale={locale} content={c} ruta="precios/" seo={p.seo}>
  <div class="botanical-page">
    <section class="pricing-hero botanical-shell">
      <div>
        <p class="botanical-eyebrow">{p.kicker}</p>
        <h1 class="botanical-heading">{p.titulo}</h1>
      </div>
      <p class="botanical-copy">{p.intro}</p>
    </section>

    <section class="botanical-plans-wrap botanical-section">
      <div class="botanical-shell">
        <div class="lc-reveal">
          <p class="botanical-eyebrow">{c.niveles.kicker}</p>
          <h2 class="botanical-heading-sm">{p.planesTitulo}</h2>
        </div>

        <div class="botanical-plans-grid">
          {
            p.planes.map((plan, i) => (
              <article
                class:list={['botanical-plan lc-reveal', plan.destacado && 'is-featured']}
                style={`--lc-delay:${i * 70}ms`}
              >
                <div class="botanical-plan-top">
                  <span class="botanical-plan-index">{String(i).padStart(2, '0')}</span>
                </div>
                <h3>{plan.nombre}</h3>
                <p class="botanical-plan-for">{plan.para}</p>
                <p class="botanical-plan-result-copy">{plan.resultado}</p>
                <p class="botanical-plan-description">{plan.texto}</p>
                <div class="botanical-price pricing-price">
                  <div>
                    <span>{p.altaLabel}</span>
                    <strong>{plan.alta}</strong>
                  </div>
                  <div>
                    <span>{p.cuotaLabel}</span>
                    <strong>{plan.cuota}</strong>
                  </div>
                </div>
                <ul class="botanical-checks">
                  {plan.incluye.map((item) => (
                    <li>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M20 6 9 17l-5-5" />
                      </svg>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
                <button
                  type="button"
                  class="botanical-button"
                  data-project-request-open
                  data-project-request-plan={plan.nombre}
                >
                  {i === 0 ? c.contacto.iniciarWeb : c.contacto.solicitarPlan}<span aria-hidden="true">→</span>
                </button>
              </article>
            ))
          }
        </div>
        <p class="botanical-note-wide">{p.iva}</p>
      </div>
    </section>

    <section class="botanical-shell botanical-section botanical-aftercare pricing-detalle">
      <article class="botanical-aftercare-card lc-reveal">
        <h2 class="botanical-heading-sm">{p.incluyeTitulo}</h2>
        <ul class="botanical-checks">
          {
            p.incluye.map((item) => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
        <p class="pricing-nota">{p.noIncluye}</p>
      </article>

      <article class="botanical-aftercare-card lc-reveal">
        <h2 class="botanical-heading-sm">{p.desarrolloTitulo}</h2>
        <p class="botanical-copy">{p.desarrolloIntro}</p>
        <ul class="pricing-bolsas">
          {
            p.bolsas.map((item) => (
              <li>
                <div>
                  <h3>{item.nombre}</h3>
                  <p>{item.texto}</p>
                </div>
                <strong>{item.precio}</strong>
              </li>
            ))
          }
        </ul>
      </article>
    </section>

    <section class="botanical-shell">
      <div class="pricing-packs lc-reveal">
        <h2>{p.packsTitulo}</h2>
        <div class="pricing-packs-grid">
          {
            p.packs.map((pack) => (
              <article>
                <h3>{pack.nombre}</h3>
                <strong>{pack.precio}</strong>
                <p>{pack.texto}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="botanical-shell botanical-section pricing-cta">
      <div class="botanical-centered-head lc-reveal">
        <h2 class="botanical-heading-sm">{p.ctaTitulo}</h2>
        <p class="botanical-copy">{p.ctaTexto}</p>
        <a href={`${inicio}#contacto`} class="botanical-button">
          {p.cta}<span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </div>
</Base>

<style>
  /* Héroe con la retícula de /temas/: título a la izquierda, intro apoyada
   * en la línea base a la derecha. */
  .pricing-hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(40px, 8vw, 120px);
    align-items: end;
    padding: clamp(70px, 9vw, 128px) 0 clamp(56px, 7vw, 92px);
  }

  .pricing-hero h1 {
    max-width: 840px;
    margin-top: 18px;
  }

  .pricing-hero .botanical-copy {
    max-width: 560px;
  }

  /* Alta y cuota conviven en el bloque de precio de la tarjeta: dos cifras
   * serif más contenidas que la única de la landing. */
  .pricing-price {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  .pricing-price span {
    display: block;
    color: color-mix(in srgb, var(--botanical-ink) 60%, white);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pricing-price strong {
    margin-top: 4px;
    font-size: 21px;
  }

  .pricing-price > div:last-child {
    text-align: right;
  }

  .pricing-detalle .botanical-checks {
    margin-top: 26px;
    font-size: 14px;
  }

  .pricing-nota {
    max-width: 520px;
    margin-top: 26px;
    color: color-mix(in srgb, var(--botanical-ink) 62%, white);
    font-size: 12px;
    line-height: 1.55;
  }

  .pricing-bolsas {
    display: grid;
    margin-top: 26px;
  }

  .pricing-bolsas li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    border-top: 1px solid color-mix(in srgb, var(--botanical-ink) 18%, transparent);
    padding: 16px 0;
  }

  .pricing-bolsas h3 {
    font-size: 19px;
    line-height: 1.2;
  }

  .pricing-bolsas p {
    margin-top: 5px;
    color: color-mix(in srgb, var(--botanical-ink) 66%, white);
    font-size: 13px;
    line-height: 1.5;
  }

  .pricing-bolsas strong {
    flex: none;
    color: var(--botanical-ink);
    font-family: var(--botanical-serif);
    font-size: 20px;
    font-weight: 400;
    white-space: nowrap;
  }

  /* El momento de contraste de la página, como el panel salvia del contacto
   * en el home: packs de salida sobre tinta. */
  .pricing-packs {
    border-radius: 14px;
    background: var(--botanical-ink);
    padding: clamp(32px, 5vw, 58px);
  }

  .pricing-packs h2 {
    max-width: 680px;
    color: var(--botanical-paper);
    font-size: clamp(30px, 3.6vw, 44px);
    line-height: 1.1;
  }

  .pricing-packs-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-top: 38px;
  }

  .pricing-packs-grid article {
    border-radius: 14px;
    background: color-mix(in srgb, var(--botanical-paper) 9%, transparent);
    padding: 24px;
  }

  .pricing-packs-grid h3 {
    color: var(--botanical-paper);
    font-size: 20px;
    line-height: 1.2;
  }

  .pricing-packs-grid strong {
    display: block;
    margin-top: 14px;
    color: var(--botanical-paper);
    font-family: var(--botanical-serif);
    font-size: 24px;
    font-weight: 400;
  }

  .pricing-packs-grid p {
    margin-top: 10px;
    color: color-mix(in srgb, var(--botanical-paper) 74%, transparent);
    font-size: 13px;
    line-height: 1.5;
  }

  .pricing-cta .botanical-copy {
    max-width: 640px;
    margin-top: 20px;
  }

  .pricing-cta .botanical-button {
    margin-top: 32px;
  }

  @media (max-width: 1023px) {
    .pricing-packs-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .pricing-hero {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  @media (max-width: 560px) {
    .pricing-packs-grid {
      grid-template-columns: 1fr;
    }

    .pricing-bolsas li {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
