---
import type { Locale } from '../lib/i18n';
import { getContent, localePath } from '../lib/i18n';
import Base from '../layouts/Base.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = getContent(locale);
const p = c.precios;
---

<Base locale={locale} content={c} ruta="precios/" seo={p.seo}>
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
    <p class="text-sm font-medium uppercase tracking-wide text-muted-foreground">{p.kicker}</p>
    <h1 class="mt-4 max-w-4xl font-display text-4xl font-bold tracking-tight sm:text-6xl">{p.titulo}</h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">{p.intro}</p>
  </section>
  <section class="border-y border-border bg-muted/25">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <h2 class="font-display text-3xl font-bold tracking-tight">{p.planesTitulo}</h2>
      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {p.planes.map((plan) => (
          <article class:list={['rounded-xl border bg-background p-7', plan.destacado ? 'border-primary shadow-sm' : 'border-border']}>
            <p class="text-sm font-medium text-muted-foreground">{plan.para}</p>
            <h3 class="mt-2 font-display text-2xl font-bold">{plan.nombre}</h3>
            <div class="mt-7 flex items-end justify-between gap-4 border-b border-border pb-6">
              <div><span class="block text-xs uppercase tracking-wide text-muted-foreground">{p.altaLabel}</span><strong class="text-xl">{plan.alta}</strong></div>
              <div class="text-right"><span class="block text-xs uppercase tracking-wide text-muted-foreground">{p.cuotaLabel}</span><strong class="text-xl">{plan.cuota}</strong></div>
            </div>
            <p class="mt-6 leading-relaxed text-muted-foreground">{plan.texto}</p>
          </article>
        ))}
      </div>
      <p class="mt-5 text-sm text-muted-foreground">{p.iva}</p>
    </div>
  </section>
  <section class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-2">
    <div>
      <h2 class="font-display text-3xl font-bold tracking-tight">{p.incluyeTitulo}</h2>
      <ul class="mt-7 space-y-4">{p.incluye.map((item) => <li class="flex gap-3 leading-relaxed"><span aria-hidden="true" class="text-primary">✓</span><span>{item}</span></li>)}</ul>
      <p class="mt-7 border-l-2 border-border pl-4 text-sm leading-relaxed text-muted-foreground">{p.noIncluye}</p>
    </div>
    <div>
      <h2 class="font-display text-3xl font-bold tracking-tight">{p.desarrolloTitulo}</h2>
      <p class="mt-4 leading-relaxed text-muted-foreground">{p.desarrolloIntro}</p>
      <div class="mt-7 divide-y divide-border rounded-xl border border-border bg-background">
        {p.bolsas.map((item) => <div class="grid gap-2 p-5 sm:grid-cols-[1fr_auto]"><div><h3 class="font-semibold">{item.nombre}</h3><p class="mt-1 text-sm text-muted-foreground">{item.texto}</p></div><strong class="whitespace-nowrap">{item.precio}</strong></div>)}
      </div>
    </div>
  </section>
  <section class="bg-foreground text-background">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <h2 class="font-display text-3xl font-bold tracking-tight">{p.packsTitulo}</h2>
      <div class="mt-9 grid gap-px overflow-hidden rounded-xl bg-background/20 sm:grid-cols-2 lg:grid-cols-4">
        {p.packs.map((pack) => <article class="bg-foreground p-6"><h3 class="font-semibold">{pack.nombre}</h3><strong class="mt-3 block text-xl">{pack.precio}</strong><p class="mt-3 text-sm leading-relaxed text-background/65">{pack.texto}</p></article>)}
      </div>
    </div>
  </section>
  <section class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6">
    <h2 class="font-display text-3xl font-bold tracking-tight">{p.ctaTitulo}</h2>
    <p class="mx-auto mt-5 max-w-2xl leading-relaxed text-muted-foreground">{p.ctaTexto}</p>
    <a href={`${localePath(locale)}#contacto`} class="mt-8 inline-flex rounded-lg bg-primary px-5 py-3 font-medium text-primary-foreground">{p.cta} →</a>
  </section>
</Base>
