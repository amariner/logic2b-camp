---
/** Índice de las tres guías (ADR 0025 §4). Compartido por `/docs/` y `/{lang}/docs/`. */
import { getGuia, GUIAS } from '../lib/docs';
import { getContent, localePath, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = getContent(locale);
const d = c.docs;

const guias = GUIAS.map((g) => ({ guia: g, meta: d.guias[g], paginas: getGuia(g, locale) }));
---

<div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 lg:py-20">
  <h1 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">{d.titulo}</h1>
  <p class="mt-3 max-w-2xl text-lg text-muted-foreground">{d.subtitulo}</p>

  <div class="mt-12 space-y-4">
    {
      guias.map(({ guia, meta, paginas }) => (
        <a
          href={localePath(locale, `docs/${guia}/`)}
          class="block rounded-xl border border-border bg-card p-6 transition-colors hover:border-primary/60 hover:bg-muted/40"
        >
          <p class="text-xs font-medium tracking-wide text-primary uppercase">{meta.para}</p>
          <h2 class="mt-1.5 font-display text-xl font-semibold tracking-tight">{meta.nombre}</h2>
          <p class="mt-2 text-muted-foreground">{meta.texto}</p>
          <p class="tnum mt-4 text-sm text-muted-foreground">
            {d.paginas.replace('{n}', String(paginas.length))}
            <span class="ml-2 text-primary" aria-hidden="true">
              &rarr;
            </span>
          </p>
        </a>
      ))
    }
  </div>
</div>
