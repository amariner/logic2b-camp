---
/**
 * Índice de las cuatro guías (ADR 0025 §4), compartido por `/docs/` y
 * `/{lang}/docs/`, con la identidad botánica del home: héroe a dos columnas
 * como /temas/ y una tarjeta de color por guía (rotación keylime/mint/slate).
 */
import { getGuia, GUIAS } from '../lib/docs';
import { getContent, localePath, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = getContent(locale);
const d = c.docs;

const guias = GUIAS.map((g) => ({ guia: g, meta: d.guias[g], paginas: getGuia(g, locale) }));
---

<div class="botanical-page">
  <section class="docs-hero botanical-shell">
    <div>
      <p class="botanical-eyebrow">{c.nav.docs}</p>
      <h1 class="botanical-heading">{d.titulo}</h1>
    </div>
    <p class="botanical-copy">{d.subtitulo}</p>
  </section>

  <section class="docs-grid botanical-shell" aria-label={d.titulo}>
    {
      guias.map(({ guia, meta, paginas }, i) => (
        <a
          href={localePath(locale, `docs/${guia}/`)}
          class="docs-card lc-reveal"
          style={`--lc-delay:${i * 70}ms`}
        >
          <p class="docs-card-para">{meta.para}</p>
          <h2>{meta.nombre}</h2>
          <p class="docs-card-texto">{meta.texto}</p>
          <p class="docs-card-pie">
            <span>{d.paginas.replace('{n}', String(paginas.length))}</span>
            <span aria-hidden="true">→</span>
          </p>
        </a>
      ))
    }
  </section>
</div>

<style>
  .docs-hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(40px, 8vw, 120px);
    align-items: end;
    padding: clamp(70px, 9vw, 128px) 0 clamp(56px, 7vw, 92px);
  }

  .docs-hero h1 {
    max-width: 840px;
    margin-top: 18px;
  }

  .docs-hero .botanical-copy {
    max-width: 560px;
  }

  .docs-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    padding-bottom: clamp(70px, 10vw, 140px);
  }

  .docs-card {
    display: flex;
    flex-direction: column;
    border-radius: 14px;
    background: var(--botanical-keylime);
    padding: clamp(28px, 4vw, 44px);
    transition: transform 160ms ease;
  }

  .docs-card:nth-child(3n + 2) {
    background: var(--botanical-mint);
  }

  .docs-card:nth-child(3n + 3) {
    background: var(--botanical-slate);
  }

  .docs-card:hover {
    transform: translateY(-2px);
  }

  .docs-card-para {
    color: color-mix(in srgb, var(--botanical-ink) 62%, white);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .docs-card h2 {
    margin-top: 12px;
    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.05;
  }

  .docs-card-texto {
    max-width: 520px;
    margin-top: 12px;
    /* 76% como .botanical-copy: al 70% no llega a AA sobre la tarjeta slate. */
    color: color-mix(in srgb, var(--botanical-ink) 76%, white);
    font-size: 14px;
    line-height: 1.55;
  }

  .docs-card-pie {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-top: 34px;
    color: var(--botanical-ink);
    font-size: 13px;
    font-weight: 600;
  }

  .docs-card-pie span:last-child {
    display: inline-flex;
    width: 42px;
    height: 42px;
    flex: none;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--botanical-ink);
    color: var(--botanical-paper);
    font-size: 16px;
    font-weight: 400;
  }

  @media (max-width: 760px) {
    .docs-hero,
    .docs-grid {
      grid-template-columns: 1fr;
    }

    .docs-hero {
      gap: 28px;
    }
  }
</style>
