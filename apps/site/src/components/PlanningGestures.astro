---
/**
 * Captura accesible de los tres gestos firma del planning (ADR 0040).
 * La documentación mantiene prosa española por página, así que la pieza lleva
 * `lang="es"` también cuando se muestra dentro del fallback EN/CA.
 */
import { existsSync } from 'node:fs';

const videoPath = '/media/logic2b-gestos-planning.mp4';
const posterPath = '/media/logic2b-gestos-planning-poster.webp';
const trackPath = '/media/logic2b-gestos-planning.es.vtt';

for (const file of [
  '../../public/media/logic2b-gestos-planning.mp4',
  '../../public/media/logic2b-gestos-planning-poster.webp',
  '../../public/media/logic2b-gestos-planning.es.vtt',
]) {
  if (!existsSync(new URL(file, import.meta.url))) throw new Error(`Falta el activo ${file}`);
}

const steps = [
  {
    title: 'Mover una estancia',
    text: 'La barra completa avanza un día y el planning confirma las fechas nuevas con opción de deshacer.',
  },
  {
    title: 'Estirar la salida',
    text: 'El borde derecho añade una noche; antes de guardar, aparece el precio recalculado para revisión.',
  },
  {
    title: 'Crear arrastrando',
    text: 'Una selección sobre una fila libre abre el alta con tipo, unidad y fechas precargados. La captura termina sin crear la reserva.',
  },
];
---

<section
  id="video-gestos-planning"
  lang="es"
  class="planning-video"
  aria-labelledby="planning-video-title"
>
  <header>
    <p class="botanical-eyebrow">Demostración guiada · 30 segundos</p>
    <h2 id="planning-video-title">Los tres gestos, en movimiento</h2>
    <p>
      Mover, estirar y empezar una reserva desde un hueco libre, sobre el planning real de la
      demo.
    </p>
  </header>

  <figure>
    <div class="planning-video-frame">
      <video
        controls
        playsinline
        tabindex="0"
        preload="metadata"
        poster={posterPath}
        aria-label="Demostración de los gestos para mover, estirar y crear una reserva desde el planning"
        aria-describedby="planning-video-scope planning-video-transcript"
      >
        <source src={videoPath} type="video/mp4" />
        <track
          kind="captions"
          src={trackPath}
          srclang="es"
          label="Descripción en español"
          default
        />
        <a href={videoPath}>Descargar el vídeo de los gestos del planning</a>
      </video>
    </div>
    <figcaption id="planning-video-scope">
      Datos ficticios. Mover y estirar usan el adaptador reversible de la demo. El alta se abre
      precargada, pero no se confirma ni se crea ninguna reserva.
    </figcaption>
  </figure>

  <div id="planning-video-transcript" class="planning-video-transcript">
    <h3>Qué ocurre en la captura</h3>
    <ol>
      {
        steps.map((step, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <strong>{step.title}</strong>
              <p>{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .planning-video {
    display: grid;
    gap: 1.25rem;
    margin-top: 2rem;
    padding: clamp(1rem, 3vw, 1.5rem);
    border: 1px solid var(--border);
    border-radius: 18px;
    background: color-mix(in srgb, var(--muted) 44%, transparent);
  }
  .planning-video header {
    max-width: 46rem;
  }
  .planning-video header h2 {
    margin-top: .45rem;
    color: var(--foreground);
    font-size: clamp(1.25rem, 3vw, 1.65rem);
    line-height: 1.15;
  }
  .planning-video header > p:last-child {
    margin-top: .55rem;
    color: var(--muted-foreground);
    font-size: .95rem;
    line-height: 1.6;
  }
  .planning-video figure {
    min-width: 0;
  }
  .planning-video-frame {
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--foreground) 18%, transparent);
    border-radius: 14px;
    background: #111b1d;
    box-shadow: 0 18px 48px color-mix(in srgb, var(--foreground) 12%, transparent);
  }
  .planning-video video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #111b1d;
  }
  .planning-video video:focus,
  .planning-video video:focus-visible {
    outline: 3px solid var(--primary);
    outline-offset: -5px;
  }
  .planning-video figcaption {
    margin-top: .7rem;
    color: var(--muted-foreground);
    font-size: .75rem;
    line-height: 1.55;
  }
  .planning-video-transcript {
    border-top: 1px solid var(--border);
  }
  .planning-video-transcript h3 {
    padding: .9rem 0 .35rem;
    color: var(--foreground);
    font-size: .85rem;
    font-weight: 700;
  }
  .planning-video-transcript li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: .65rem;
    padding: .75rem 0;
    border-top: 1px solid var(--border);
  }
  .planning-video-transcript li > span {
    padding-top: .1rem;
    color: var(--muted-foreground);
    font-size: .65rem;
    font-variant-numeric: tabular-nums;
    font-weight: 800;
    letter-spacing: .08em;
  }
  .planning-video-transcript strong {
    color: var(--foreground);
    font-size: .82rem;
  }
  .planning-video-transcript p {
    margin-top: .2rem;
    color: var(--muted-foreground);
    font-size: .78rem;
    line-height: 1.5;
  }
  @media (prefers-reduced-motion: reduce) {
    .planning-video video {
      scroll-behavior: auto;
    }
  }
</style>
