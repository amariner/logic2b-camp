---
import type { Locale } from '../lib/i18n';

interface WebBlock {
  titulo: string;
  texto: string;
  imagen: string;
  capturaAlt: string;
  href: string;
  marca: string;
  previewKicker: string;
  previewTitulo: string;
  incluye: string[];
}

interface ManagerBlock {
  titulo: string;
  texto: string;
  imagen: string;
  capturaAlt: string;
  ruta?: string;
  modo: string;
  incluye: string[];
}

interface PricingItem {
  id: string;
  nombre: string;
  etiqueta?: string;
  precio: string;
  periodo: string;
  precioAnual: string;
  periodoAnual: string;
  precioAnualAnterior?: string;
  detallePrecio?: string;
  onboarding?: string;
  tono: string;
  ofertaTitulo: string;
  ofertaTexto: string;
  incluye: string[];
  web: WebBlock;
  gestor: ManagerBlock;
}

interface Props {
  locale: Locale;
  kicker: string;
  titulo: string;
  texto: string;
  billingAria: string;
  billingMonthly: string;
  billingAnnual: string;
  billingDiscount: string;
  slideWebLabel: string;
  slideManagerLabel: string;
  ctaWeb: string;
  ctaGestor: string;
  assistText: string;
  assistCta: string;
  requestCta: string;
  requestHref: string;
  aria: string;
  items: PricingItem[];
}

const { locale, kicker, titulo, texto, billingAria, billingMonthly, billingAnnual, billingDiscount, slideManagerLabel, ctaWeb, ctaGestor, assistText, assistCta, requestCta, requestHref, aria, items } = Astro.props;
const managerDemoHrefs = {
  gestion: '/demos/pinadamar/gestion/#/planning',
  avanzado: '/demos/mardefondo/gestion/#/inteligente',
} as const;
const getManagerDemoHref = (planId: string) => planId === 'avanzado'
  ? managerDemoHrefs.avanzado
  : managerDemoHrefs.gestion;
const availabilityCopy = locale === 'es'
  ? { arrival: 'Llegada', departure: 'Salida', guests: 'Huéspedes', month: 'AGO' }
  : { arrival: 'Arrival', departure: 'Departure', guests: 'Guests', month: 'AUG' };
---

<section id="precios" class="pricing-showcase" aria-labelledby="pricing-showcase-title">
  <div class="pricing-shell">
    <header class="pricing-heading lc-reveal">
      <p class="botanical-eyebrow">{kicker}</p>
      <h2 id="pricing-showcase-title">{titulo}</h2>
      <p>{texto}</p>
    </header>

    <div class="pricing-billing lc-reveal" role="group" aria-label={billingAria} data-pricing-billing>
      <button type="button" class="is-active" aria-pressed="true" data-billing-option="monthly">
        {billingMonthly}
      </button>
      <button type="button" aria-pressed="false" data-billing-option="annual">
        {billingAnnual}<span>{billingDiscount}</span>
      </button>
    </div>

    <div class="pricing-grid" aria-label={aria}>
      {
        items.map((plan, index) => (
          <article class:list={['pricing-card', `pricing-card--${plan.tono}`, index === 1 && 'is-featured', 'lc-reveal']}>
            <div class="pricing-card-summary">
              <div class="pricing-card-summary-copy">
                <header class="pricing-card-head">
                  <h3>{plan.nombre}</h3>
                </header>
                <div class="pricing-card-price">
                <div class:list={['pricing-card-price-value', plan.id === 'avanzado' && 'is-stacked']}>
                  <strong data-pricing-price data-monthly={plan.precio} data-annual={plan.precioAnual}>{plan.precio}</strong>
                  <span data-pricing-period data-monthly={plan.periodo} data-annual={plan.periodoAnual}>{plan.periodo}</span>
                  {plan.precioAnualAnterior && (
                    <del class="pricing-annual-original" data-pricing-original hidden>{plan.precioAnualAnterior}</del>
                  )}
                </div>
                  {plan.detallePrecio && <small class="pricing-price-detail">{plan.detallePrecio}</small>}
                  {plan.onboarding && <small>{plan.onboarding}</small>}
                </div>
              </div>
              <a
                class:list={['pricing-request', plan.id === 'gestion' && 'is-primary']}
                href={`${requestHref}?plan=${encodeURIComponent(plan.id)}&billing=monthly`}
                data-request-base={`${requestHref}?plan=${encodeURIComponent(plan.id)}`}
              >
                {requestCta}<span class="pricing-request-icon" aria-hidden="true">↗</span>
              </a>
            </div>

            <figure class="pricing-visual-stage">
              <div class="pricing-browser">
                <div class="pricing-browser-top" aria-hidden="true">
                  <span><i></i><i></i><i></i></span>
                  <b>{plan.web.marca}</b>
                  <em></em>
                </div>
                <div class="pricing-browser-hero">
                  <div class="pricing-browser-copy" aria-hidden="true">
                    <small>{plan.web.previewKicker}</small>
                    <strong>{plan.web.previewTitulo}</strong>
                    <span></span><span></span>
                  </div>
                  <img src={plan.web.imagen} alt={plan.web.capturaAlt} loading="lazy" decoding="async" />
                </div>
                <div class="pricing-availability" aria-hidden="true">
                  <span><small>{availabilityCopy.arrival}</small><b>05 {availabilityCopy.month}</b></span>
                  <span><small>{availabilityCopy.departure}</small><b>12 {availabilityCopy.month}</b></span>
                  <span><small>{availabilityCopy.guests}</small><b>2 + 1</b></span>
                  <i>→</i>
                </div>
              </div>
              {
                plan.gestor.modo === 'email' && (
                  <div class="pricing-manager-peek pricing-mail-peek" aria-hidden="true">
                    <div class="pricing-manager-peek-head">
                      <span class="pricing-manager-peek-icon pricing-mail-icon">
                        <svg viewBox="0 0 24 18" fill="none">
                          <path d="M2 16V4.2L6 7.3V16H2Z" fill="#4285F4" />
                          <path d="M18 16V7.3L22 4.2V16H18Z" fill="#34A853" />
                          <path d="M2 4.2 4.6 2.3 12 8l7.4-5.7L22 4.2 12 12 2 4.2Z" fill="#EA4335" />
                          <path d="M2 4.2V2.8C2 1.8 3.2 1.2 4 1.8l8 6.2-2.1 2.9L2 4.2Z" fill="#C5221F" />
                          <path d="M22 4.2V2.8c0-1-1.2-1.6-2-1L12 8l2.1 2.9L22 4.2Z" fill="#FBBC04" />
                        </svg>
                      </span>
                      <strong>Gmail</strong>
                      <i class="pricing-manager-status"></i>
                    </div>
                    <div class="pricing-mail-list">
                      <span class="is-unread"><i></i><b></b><em></em></span>
                      <span><i></i><b></b><em></em></span>
                      <span><i></i><b></b><em></em></span>
                    </div>
                  </div>
                )
              }
              {
                plan.gestor.modo === 'demo' && (
                  <div class:list={['pricing-manager-peek', plan.id === 'avanzado' && 'is-intelligent']} aria-hidden="true">
                    <div class="pricing-manager-peek-head">
                      <span class="pricing-manager-peek-icon">
                        {
                          plan.id === 'avanzado' ? (
                            <svg viewBox="0 0 24 24" fill="none">
                              <path d="M4 18V6M4 18h16" />
                              <path d="m7 14 4-4 3 2 4-5" />
                            </svg>
                          ) : (
                            <svg viewBox="0 0 24 24" fill="none">
                              <rect x="4" y="5" width="16" height="15" rx="3" />
                              <path d="M8 3v4M16 3v4M4 10h16M8 14h3M14 14h2" />
                            </svg>
                          )
                        }
                      </span>
                      <strong>{slideManagerLabel}</strong>
                      <i class="pricing-manager-status"></i>
                    </div>
                    {
                      plan.id === 'avanzado' ? (
                        <div class="pricing-manager-kpis">
                          <span><b>78%</b><i></i></span>
                          <span><b>24</b><i></i></span>
                          <span><b>94%</b><i></i></span>
                        </div>
                      ) : (
                        <div class="pricing-manager-planning">
                          <span></span><span></span><span></span><span></span>
                          <i class="booking-a"></i><i class="booking-b"></i><i class="booking-c"></i>
                        </div>
                      )
                    }
                  </div>
                )
              }
            </figure>

            <section class="pricing-product" aria-labelledby={`pricing-offer-${index}`}>
              <h4 id={`pricing-offer-${index}`}>{plan.ofertaTitulo}</h4>
              <p>{plan.ofertaTexto}</p>
              <ul class="pricing-feature-list">
                {plan.incluye.slice(0, 3).map((feature) => <li><span aria-hidden="true">✓</span>{feature}</li>)}
              </ul>
              <div class="pricing-demo-actions">
                <a class="pricing-cta" href={plan.web.href}>
                  {ctaWeb}<span aria-hidden="true">↗</span>
                </a>
                {plan.gestor.modo === 'demo' && (
                  <a class="pricing-cta" href={getManagerDemoHref(plan.id)}>
                    {ctaGestor}<span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </section>

          </article>
        ))
      }
    </div>
    <div class="pricing-assist lc-reveal">
      <p>{assistText}</p>
      <a href={requestHref}>
        {assistCta}
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<script>
  const pricingBillingRoot = document.querySelector('[data-pricing-billing]');
  const pricingBillingButtons = pricingBillingRoot?.querySelectorAll('[data-billing-option]') ?? [];
  const pricingPriceNodes = document.querySelectorAll('[data-pricing-price]');
  const pricingPeriodNodes = document.querySelectorAll('[data-pricing-period]');
  const pricingOriginalNodes = document.querySelectorAll('[data-pricing-original]');
  const pricingRequestLinks = document.querySelectorAll('[data-request-base]');

  const applyPricingBilling = (billing: 'monthly' | 'annual') => {
    document.querySelector('.pricing-showcase')?.setAttribute('data-billing', billing);
    pricingBillingButtons.forEach((button) => {
      const active = button.getAttribute('data-billing-option') === billing;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', String(active));
    });
    pricingPriceNodes.forEach((node) => {
      node.textContent = node.getAttribute(`data-${billing}`) ?? '';
    });
    pricingPeriodNodes.forEach((node) => {
      node.textContent = node.getAttribute(`data-${billing}`) ?? '';
    });
    pricingOriginalNodes.forEach((node) => {
      if (node instanceof HTMLElement) node.hidden = billing !== 'annual';
    });
    pricingRequestLinks.forEach((link) => {
      const base = link.getAttribute('data-request-base');
      if (!base) return;
      link.setAttribute('href', `${base}&billing=${billing}`);
    });
  };

  pricingBillingButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const billing = button.getAttribute('data-billing-option');
      if (billing === 'monthly' || billing === 'annual') applyPricingBilling(billing);
    });
  });
</script>

<style>
  .pricing-showcase {
    overflow: hidden;
    background: color-mix(in srgb, var(--botanical-keylime) 48%, var(--botanical-paper));
    padding-block: clamp(70px, 7vw, 108px);
    scroll-margin-top: 112px;
  }
  .pricing-shell { width:calc(100% - clamp(32px,5vw,72px)); max-width:1600px; margin-inline:auto; }
  .pricing-heading { max-width:1040px; margin-inline:auto; text-align:center; }
  .pricing-heading h2 { margin-top:18px; color:var(--botanical-ink); font-size:clamp(52px,5.8vw,88px); letter-spacing:-.055em; line-height:.98; text-wrap:balance; }
  .pricing-heading > p:last-child { max-width:720px; margin:24px auto 0; color:color-mix(in srgb,var(--botanical-charcoal) 70%,white); font-size:clamp(16px,1.5vw,19px); line-height:1.55; }

  .pricing-billing { display:flex; width:max-content; max-width:100%; gap:4px; margin:clamp(28px,3vw,38px) auto 0; border:0; border-radius:20px; background:color-mix(in srgb,var(--botanical-paper) 94%,transparent); padding:7px; box-shadow:0 14px 34px color-mix(in srgb,var(--botanical-ink) 7%,transparent); }
  .pricing-billing button { display:flex; min-height:48px; align-items:center; gap:8px; border:0; border-radius:14px; background:transparent; padding:10px 20px; color:color-mix(in srgb,var(--botanical-ink) 65%,white); font:inherit; font-size:13px; font-weight:650; cursor:pointer; transition:background-color 160ms ease,color 160ms ease; }
  .pricing-billing button:hover { background:color-mix(in srgb,var(--botanical-keylime) 34%,transparent); color:var(--botanical-ink); }
  .pricing-billing button:focus-visible { outline:0; background:color-mix(in srgb,var(--botanical-keylime) 62%,var(--botanical-paper)); }
  .pricing-billing button.is-active { background:color-mix(in srgb,var(--botanical-keylime) 68%,var(--botanical-paper)); color:var(--botanical-ink); font-weight:750; }
  .pricing-billing button span { border-radius:999px; background:color-mix(in srgb,var(--botanical-keylime) 72%,white); padding:3px 7px; color:var(--botanical-ink); font-size:9px; font-weight:800; }

  .pricing-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:clamp(16px,1.8vw,26px); margin-top:clamp(28px,3.4vw,42px); align-items:stretch; }
  .pricing-card { position:relative; display:flex; overflow:hidden; flex-direction:column; border:1px solid color-mix(in srgb,var(--botanical-ink) 10%,transparent); border-radius:clamp(24px,2.2vw,32px); background:var(--botanical-paper); box-shadow:0 14px 34px color-mix(in srgb,var(--botanical-ink) 5%,transparent); }
  .pricing-card.is-featured { border-color:color-mix(in srgb,var(--botanical-ink) 46%,transparent); background:color-mix(in srgb,var(--botanical-slate) 9%,var(--botanical-paper)); box-shadow:0 28px 68px color-mix(in srgb,var(--botanical-ink) 16%,transparent); }
  .pricing-card--forest { border-color:color-mix(in srgb,#9a7a3d 30%,transparent); background:color-mix(in srgb,var(--botanical-paper) 96%,#eadbb7); box-shadow:0 20px 48px color-mix(in srgb,var(--botanical-ink) 8%,transparent); }

  .pricing-card-summary { display:grid; min-height:126px; grid-template-columns:minmax(0,1fr) auto; align-items:start; gap:18px; padding:20px 24px 16px; }
  .pricing-card-summary-copy { min-width:0; }
  .pricing-card-head { min-height:0; padding:0; }
  .pricing-card-head h3 { color:var(--botanical-ink); font-family:inherit; font-size:clamp(29px,2.35vw,36px); font-weight:580; letter-spacing:-.05em; line-height:1; }
  .pricing-card.is-featured .pricing-card-head h3 { font-weight:660; }

  .pricing-visual-stage { position:relative; overflow:hidden; height:clamp(188px,15vw,216px); margin:0 18px; border-radius:18px; background:color-mix(in srgb,var(--botanical-keylime) 66%,var(--botanical-paper)); padding:13px 14px; }
  .pricing-card--water .pricing-visual-stage { background:color-mix(in srgb,var(--botanical-slate) 48%,var(--botanical-paper)); }
  .pricing-card--forest .pricing-visual-stage { background:color-mix(in srgb,var(--botanical-keylime) 48%,#87ba91); }
  .pricing-browser { position:relative; overflow:hidden; height:100%; border-radius:14px; background:rgb(255 255 255 / 96%); box-shadow:0 14px 28px rgb(15 62 23 / 12%); }
  .pricing-browser-top { display:grid; height:28px; grid-template-columns:auto 1fr auto; align-items:center; gap:8px; padding-inline:10px; }
  .pricing-browser-top > span { display:flex; gap:4px; }
  .pricing-browser-top i { width:5px; height:5px; border-radius:50%; background:color-mix(in srgb,var(--botanical-keylime) 72%,var(--botanical-ink)); }
  .pricing-browser-top b { overflow:hidden; color:color-mix(in srgb,var(--botanical-ink) 68%,white); font-size:7px; font-weight:650; text-overflow:ellipsis; white-space:nowrap; }
  .pricing-browser-top em { width:42px; height:8px; border-radius:999px; background:var(--botanical-ink); }
  .pricing-browser-hero { display:grid; height:118px; grid-template-columns:.95fr 1.05fr; margin:0 9px; overflow:hidden; border-radius:11px; background:color-mix(in srgb,var(--botanical-keylime) 72%,var(--botanical-paper)); }
  .pricing-browser-copy { display:flex; min-width:0; flex-direction:column; justify-content:center; padding:13px; }
  .pricing-browser-copy small { color:var(--botanical-ink); font-size:6px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; }
  .pricing-browser-copy strong { margin-top:6px; color:var(--botanical-ink); font-family:var(--botanical-serif); font-size:clamp(17px,1.55vw,23px); font-weight:500; letter-spacing:-.045em; line-height:.96; }
  .pricing-browser-copy > span { width:82%; height:3px; margin-top:9px; border-radius:999px; background:color-mix(in srgb,var(--botanical-ink) 24%,transparent); }
  .pricing-browser-copy > span + span { width:58%; margin-top:5px; }
  .pricing-browser-hero img { width:100%; height:118px; object-fit:cover; filter:saturate(.9) contrast(.96); }
  .pricing-availability { position:relative; z-index:2; display:grid; width:calc(100% - 34px); min-height:44px; grid-template-columns:repeat(3,1fr) 32px; align-items:center; gap:4px; margin:-16px auto 0; border:1px solid color-mix(in srgb,var(--botanical-ink) 9%,transparent); border-radius:11px; background:white; padding:6px 6px 6px 9px; box-shadow:0 8px 16px rgb(15 62 23 / 9%); }
  .pricing-availability span { min-width:0; border-right:1px solid color-mix(in srgb,var(--botanical-ink) 10%,transparent); }
  .pricing-availability small,.pricing-availability b { display:block; }
  .pricing-availability small { color:color-mix(in srgb,var(--botanical-ink) 58%,white); font-size:5px; font-weight:750; letter-spacing:.05em; text-transform:uppercase; }
  .pricing-availability b { margin-top:3px; color:var(--botanical-ink); font-size:7px; }
  .pricing-availability > i { display:grid; width:29px; height:29px; place-items:center; border-radius:8px; background:var(--botanical-ink); color:white; font-size:13px; font-style:normal; }
  .pricing-manager-peek { position:absolute; right:7px; bottom:7px; z-index:4; width:50%; min-width:164px; height:92px; overflow:hidden; border:4px solid rgb(255 255 255 / 96%); border-radius:14px; background:#f8fbf7; box-shadow:0 15px 30px rgb(8 34 14 / 28%); }
  .pricing-manager-peek-head { display:grid; height:29px; grid-template-columns:19px minmax(0,1fr) auto; align-items:center; gap:6px; border-bottom:1px solid rgb(15 62 23 / 9%); padding:4px 7px; background:rgb(255 255 255 / 97%); }
  .pricing-manager-peek-icon { display:grid; width:19px; height:19px; place-items:center; border-radius:6px; background:var(--botanical-ink); color:white; }
  .pricing-manager-peek-icon svg { width:12px; height:12px; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
  .pricing-manager-peek-head strong { overflow:hidden; color:var(--botanical-ink); font-size:6px; font-weight:800; letter-spacing:.025em; text-overflow:ellipsis; text-transform:uppercase; white-space:nowrap; }
  .pricing-manager-status { width:6px; height:6px; border-radius:50%; background:#63bc73; box-shadow:0 0 0 3px rgb(99 188 115 / 15%); }
  .pricing-manager-planning { position:relative; display:grid; height:59px; grid-template-columns:repeat(4,1fr); background:repeating-linear-gradient(to bottom,transparent 0,transparent 19px,rgb(15 62 23 / 7%) 19px,rgb(15 62 23 / 7%) 20px); }
  .pricing-manager-planning > span { border-right:1px solid rgb(15 62 23 / 7%); }
  .pricing-manager-planning > i { position:absolute; height:9px; border-radius:3px; box-shadow:inset 0 0 0 1px rgb(255 255 255 / 28%); }
  .pricing-manager-planning .booking-a { top:8px; left:6%; width:42%; background:#acd9b3; }
  .pricing-manager-planning .booking-b { top:25px; left:34%; width:54%; background:var(--botanical-slate); }
  .pricing-manager-planning .booking-c { top:43px; left:13%; width:35%; background:#edc983; }
  .pricing-manager-peek.is-intelligent { background:color-mix(in srgb,var(--botanical-keylime) 18%,white); }
  .pricing-manager-peek.is-intelligent .pricing-manager-peek-icon { background:color-mix(in srgb,var(--botanical-ink) 88%,#6f8d74); }
  .pricing-manager-kpis { display:grid; height:59px; grid-template-columns:repeat(3,1fr); gap:5px; padding:7px; }
  .pricing-manager-kpis > span { min-width:0; border:1px solid rgb(15 62 23 / 8%); border-radius:7px; background:white; padding:6px; box-shadow:0 3px 8px rgb(15 62 23 / 5%); }
  .pricing-manager-kpis b { display:block; color:var(--botanical-ink); font-size:10px; }
  .pricing-manager-kpis i { display:block; height:3px; margin-top:7px; border-radius:999px; background:linear-gradient(90deg,var(--botanical-ink) 74%,rgb(15 62 23 / 10%) 74%); }
  .pricing-mail-peek { background:#f7f8fa; }
  .pricing-mail-icon { border:1px solid rgb(32 33 36 / 8%); background:white; }
  .pricing-mail-icon svg { width:14px; height:11px; stroke:none; }
  .pricing-mail-peek .pricing-manager-status { background:#4285f4; box-shadow:0 0 0 3px rgb(66 133 244 / 14%); }
  .pricing-mail-list { display:grid; height:59px; grid-template-rows:repeat(3,1fr); padding:3px 5px; background:#f6f8fc; }
  .pricing-mail-list > span { position:relative; display:grid; grid-template-columns:12px minmax(0,1fr) 24px; align-items:center; gap:5px; border-bottom:1px solid rgb(60 64 67 / 8%); padding-inline:4px; }
  .pricing-mail-list > span:last-child { border-bottom:0; }
  .pricing-mail-list > span.is-unread { border-radius:4px; background:white; box-shadow:0 2px 6px rgb(60 64 67 / 9%); }
  .pricing-mail-list i { width:8px; height:8px; border-radius:50%; background:#d7dbe1; }
  .pricing-mail-list .is-unread i { background:#4285f4; }
  .pricing-mail-list b,.pricing-mail-list em { display:block; height:4px; border-radius:999px; background:#c9ced6; }
  .pricing-mail-list .is-unread b { background:#5f6368; }
  .pricing-mail-list em { width:70%; justify-self:end; background:#e2e5e9; }

  .pricing-product { flex:1; padding:20px 24px 24px; }
  .pricing-product h4 { color:var(--botanical-ink); font-size:clamp(19px,1.5vw,22px); font-weight:610; letter-spacing:-.03em; line-height:1.08; }
