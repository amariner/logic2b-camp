---
interface WebBlock {
  titulo: string;
  texto: string;
  imagen: string;
  capturaAlt: string;
  href: string;
  marca: string;
  previewKicker: string;
  previewTitulo: string;
  incluye: string[];
}

interface ManagerBlock {
  titulo: string;
  texto: string;
  imagen: string;
  capturaAlt: string;
  ruta?: string;
  modo: string;
  incluye: string[];
}

interface PricingItem {
  id: string;
  nombre: string;
  etiqueta?: string;
  precio: string;
  periodo: string;
  precioAnual: string;
  periodoAnual: string;
  precioAnualAnterior?: string;
  detallePrecio?: string;
  onboarding?: string;
  tono: string;
  ofertaTitulo: string;
  ofertaTexto: string;
  incluye: string[];
  web: WebBlock;
  gestor: ManagerBlock;
}

interface Props {
  kicker: string;
  titulo: string;
  texto: string;
  billingAria: string;
  billingMonthly: string;
  billingAnnual: string;
  billingDiscount: string;
  slideWebLabel: string;
  slideManagerLabel: string;
  ctaWeb: string;
  ctaGestor: string;
  assistText: string;
  assistCta: string;
  requestCta: string;
  requestHref: string;
  aria: string;
  items: PricingItem[];
}

const { kicker, titulo, texto, billingAria, billingMonthly, billingAnnual, billingDiscount, slideWebLabel, slideManagerLabel, ctaWeb, ctaGestor, assistText, assistCta, requestCta, requestHref, aria, items } = Astro.props;
const managerBase = import.meta.env.DEV ? 'http://localhost:5173/admin' : '/admin';
---

<section id="precios" class="pricing-showcase" aria-labelledby="pricing-showcase-title">
  <div class="pricing-shell">
    <header class="pricing-heading lc-reveal">
      <p class="botanical-eyebrow">{kicker}</p>
      <h2 id="pricing-showcase-title">{titulo}</h2>
      <p>{texto}</p>
    </header>

    <div class="pricing-billing lc-reveal" role="group" aria-label={billingAria} data-pricing-billing>
      <button type="button" class="is-active" aria-pressed="true" data-billing-option="monthly">
        {billingMonthly}
      </button>
      <button type="button" aria-pressed="false" data-billing-option="annual">
        {billingAnnual}<span>{billingDiscount}</span>
      </button>
    </div>

    <div class="pricing-grid" aria-label={aria}>
      {
        items.map((plan, index) => (
          <article class:list={['pricing-card', `pricing-card--${plan.tono}`, index === 1 && 'is-featured', 'lc-reveal']}>
            <header class="pricing-card-head">
              <h3>{plan.nombre}</h3>
              {plan.etiqueta && <strong>{plan.etiqueta}</strong>}
            </header>

            <div class:list={['pricing-visual-stage', plan.gestor.modo === 'demo' && 'has-slider']}>
              <figure class="pricing-web-demo pricing-visual-slide">
                <div class="pricing-browser">
                  <div class="pricing-browser-top" aria-hidden="true">
                    <span><i></i><i></i><i></i></span>
                    <b>{plan.web.marca}</b>
                    <em></em>
                  </div>
                  <div class="pricing-browser-hero">
                    <div class="pricing-browser-copy" aria-hidden="true">
                      <small>{plan.web.previewKicker}</small>
                      <strong>{plan.web.previewTitulo}</strong>
                      <span></span><span></span>
                    </div>
                    <img src={plan.web.imagen} alt={plan.web.capturaAlt} loading="lazy" decoding="async" />
                  </div>
                  <div class="pricing-availability" aria-hidden="true">
                    <span><small>Llegada</small><b>05 AGO</b></span>
                    <span><small>Salida</small><b>12 AGO</b></span>
                    <span><small>Huéspedes</small><b>2 + 1</b></span>
                    <i>→</i>
                  </div>
                </div>
                {plan.gestor.modo === 'demo' && <figcaption>{slideWebLabel}</figcaption>}
              </figure>

              {
                plan.gestor.modo === 'demo' && (
                  <figure
                    class:list={['pricing-manager-demo', 'pricing-visual-slide', plan.gestor.imagen === 'avanzado' && 'is-intelligent']}
                    role="img"
                    aria-label={plan.gestor.capturaAlt}
                  >
                    <div class="manager-window" aria-hidden="true">
                      <header class="manager-window-head">
                        <strong><i></i>Logic2B</strong>
                        <span><i></i><i></i><i></i></span>
                      </header>
                      <div class="manager-window-body">
                        <aside class="manager-sidebar">
                          <b></b><i></i><i></i><i></i><i></i><i></i>
                        </aside>
                        {
                          plan.gestor.imagen === 'avanzado' ? (
                            <div class="manager-intelligence">
                              <header><span></span><b></b></header>
                              <div class="manager-kpis">
                                <span><small>78%</small><i></i></span>
                                <span><small>24</small><i></i></span>
                                <span><small>94%</small><i></i></span>
                              </div>
                              <div class="manager-insight-row">
                                <div class="manager-bars">
                                  <i></i><i></i><i></i><i></i><i></i><i></i>
                                </div>
                                <div class="manager-recommendation">
                                  <span>✓</span><i></i><i></i><i></i>
                                </div>
                              </div>
                            </div>
                          ) : (
                            <div class="manager-planning">
                              <header><span></span><b></b></header>
                              <div class="manager-days"><span>12</span><span>13</span><span>14</span><span>15</span><span>16</span></div>
                              <div class="manager-calendar">
                                <i class="booking booking-a"></i>
                                <i class="booking booking-b"></i>
                                <i class="booking booking-c"></i>
                                <i class="booking booking-d"></i>
                              </div>
                              <span class="manager-occupancy"><b>78%</b><i></i></span>
                            </div>
                          )
                        }
                      </div>
                    </div>
                    <figcaption>{slideManagerLabel}</figcaption>
                  </figure>
                )
              }
              {plan.gestor.modo === 'demo' && <span class="pricing-slider-dots" aria-hidden="true"><i></i><i></i></span>}
            </div>

            <section class="pricing-product" aria-labelledby={`pricing-offer-${index}`}>
              <h4 id={`pricing-offer-${index}`}>{plan.ofertaTitulo}</h4>
              <p>{plan.ofertaTexto}</p>
              <ul class="pricing-feature-list">
                {plan.incluye.map((feature) => <li><span aria-hidden="true">✓</span>{feature}</li>)}
              </ul>
              <div class="pricing-demo-actions">
                <a class="pricing-cta" href={plan.web.href}>
                  {ctaWeb}<span aria-hidden="true">↗</span>
                </a>
                {plan.gestor.modo === 'demo' && (
                  <a class="pricing-cta" href={`${managerBase}/${plan.gestor.ruta ?? ''}`}>
                    {ctaGestor}<span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </section>

            <footer class="pricing-card-price">
              <div class="pricing-card-price-row">
                <div class:list={['pricing-card-price-value', plan.id === 'avanzado' && 'is-stacked']}>
                  <strong data-pricing-price data-monthly={plan.precio} data-annual={plan.precioAnual}>{plan.precio}</strong>
                  <span data-pricing-period data-monthly={plan.periodo} data-annual={plan.periodoAnual}>{plan.periodo}</span>
                  {plan.precioAnualAnterior && (
                    <del class="pricing-annual-original" data-pricing-original hidden>{plan.precioAnualAnterior}</del>
                  )}
                </div>
                <a
                  class="pricing-request"
                  href={`${requestHref}?plan=${encodeURIComponent(plan.id)}&billing=monthly`}
                  data-request-base={`${requestHref}?plan=${encodeURIComponent(plan.id)}`}
                >
                  {requestCta}
                </a>
              </div>
              {plan.detallePrecio && <small class="pricing-price-detail">{plan.detallePrecio}</small>}
              {plan.onboarding && <small>{plan.onboarding}</small>}
            </footer>
          </article>
        ))
      }
    </div>
    <div class="pricing-assist lc-reveal">
      <p>{assistText}</p>
      <a href={requestHref}>
        {assistCta}
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <path d="M4 13v-2a8 8 0 0 1 16 0v2" />
          <path d="M5 13h2a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1H6a2 2 0 0 1-2-2v-3a1 1 0 0 1 1-1Z" />
          <path d="M19 13h-2a1 1 0 0 0-1 1v4a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1v-4a1 1 0 0 0-1-1Z" />
          <path d="M16 19c-.7 1.2-1.9 2-4 2h-1" />
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  const pricingBillingRoot = document.querySelector('[data-pricing-billing]');
  const pricingBillingButtons = pricingBillingRoot?.querySelectorAll('[data-billing-option]') ?? [];
  const pricingPriceNodes = document.querySelectorAll('[data-pricing-price]');
  const pricingPeriodNodes = document.querySelectorAll('[data-pricing-period]');
  const pricingOriginalNodes = document.querySelectorAll('[data-pricing-original]');
  const pricingRequestLinks = document.querySelectorAll('[data-request-base]');

  const applyPricingBilling = (billing: 'monthly' | 'annual') => {
    document.querySelector('.pricing-showcase')?.setAttribute('data-billing', billing);
    pricingBillingButtons.forEach((button) => {
      const active = button.getAttribute('data-billing-option') === billing;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', String(active));
    });
    pricingPriceNodes.forEach((node) => {
      node.textContent = node.getAttribute(`data-${billing}`) ?? '';
    });
    pricingPeriodNodes.forEach((node) => {
      node.textContent = node.getAttribute(`data-${billing}`) ?? '';
    });
    pricingOriginalNodes.forEach((node) => {
      if (node instanceof HTMLElement) node.hidden = billing !== 'annual';
    });
    pricingRequestLinks.forEach((link) => {
      const base = link.getAttribute('data-request-base');
      if (!base) return;
      link.setAttribute('href', `${base}&billing=${billing}`);
    });
  };

  pricingBillingButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const billing = button.getAttribute('data-billing-option');
      if (billing === 'monthly' || billing === 'annual') applyPricingBilling(billing);
    });
  });
</script>

<style>
  .pricing-showcase {
    overflow: hidden;
    background: color-mix(in srgb, var(--botanical-keylime) 48%, var(--botanical-paper));
    padding-block: clamp(70px, 7vw, 108px);
    scroll-margin-top: 112px;
  }
  .pricing-shell { width:calc(100% - clamp(32px,5vw,72px)); max-width:1600px; margin-inline:auto; }
  .pricing-heading { max-width:1040px; margin-inline:auto; text-align:center; }
  .pricing-heading h2 { margin-top:18px; color:var(--botanical-ink); font-size:clamp(52px,5.8vw,88px); letter-spacing:-.055em; line-height:.98; text-wrap:balance; }
  .pricing-heading > p:last-child { max-width:720px; margin:24px auto 0; color:color-mix(in srgb,var(--botanical-charcoal) 70%,white); font-size:clamp(16px,1.5vw,19px); line-height:1.55; }

  .pricing-billing { display:flex; width:max-content; max-width:100%; gap:4px; margin:clamp(28px,3vw,38px) auto 0; border:1px solid color-mix(in srgb,var(--botanical-ink) 13%,transparent); border-radius:999px; background:rgb(255 255 255 / 62%); padding:4px; box-shadow:0 10px 24px color-mix(in srgb,var(--botanical-ink) 6%,transparent); backdrop-filter:blur(8px); }
  .pricing-billing button { display:flex; min-height:40px; align-items:center; gap:7px; border:0; border-radius:999px; background:transparent; padding:9px 15px; color:color-mix(in srgb,var(--botanical-ink) 62%,white); font:inherit; font-size:12px; font-weight:700; cursor:pointer; transition:background-color 160ms ease,color 160ms ease; }
  .pricing-billing button.is-active { background:var(--botanical-ink); color:white; }
  .pricing-billing button span { border-radius:999px; background:color-mix(in srgb,var(--botanical-keylime) 78%,white); padding:3px 6px; color:var(--botanical-ink); font-size:9px; font-weight:800; }

  .pricing-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:clamp(16px,1.8vw,26px); margin-top:clamp(28px,3.4vw,42px); align-items:stretch; }
  .pricing-card { position:relative; display:flex; overflow:hidden; flex-direction:column; border:1px solid color-mix(in srgb,var(--botanical-ink) 10%,transparent); border-radius:clamp(24px,2.2vw,32px); background:var(--botanical-paper); box-shadow:0 14px 34px color-mix(in srgb,var(--botanical-ink) 5%,transparent); }
  .pricing-card.is-featured { border-color:color-mix(in srgb,var(--botanical-ink) 46%,transparent); background:color-mix(in srgb,var(--botanical-slate) 9%,var(--botanical-paper)); box-shadow:0 28px 68px color-mix(in srgb,var(--botanical-ink) 16%,transparent); }
  .pricing-card.is-featured::before,.pricing-card--forest::before { position:absolute; inset:0 0 auto; z-index:6; height:4px; background:var(--botanical-ink); content:""; }
  .pricing-card--forest { border-color:color-mix(in srgb,#9a7a3d 30%,transparent); background:color-mix(in srgb,var(--botanical-paper) 96%,#eadbb7); box-shadow:0 20px 48px color-mix(in srgb,var(--botanical-ink) 8%,transparent); }
  .pricing-card--forest::before { height:2px; background:color-mix(in srgb,#9a7a3d 72%,var(--botanical-ink)); }

  .pricing-visual-stage { position:relative; isolation:isolate; overflow:hidden; height:clamp(232px,18vw,250px); margin:0 12px; border-radius:clamp(17px,1.8vw,23px); background:color-mix(in srgb,var(--botanical-keylime) 68%,var(--botanical-paper)); }
  .pricing-card--water .pricing-visual-stage { background:color-mix(in srgb,var(--botanical-slate) 48%,var(--botanical-paper)); }
  .pricing-card--forest .pricing-visual-stage { background:color-mix(in srgb,var(--botanical-keylime) 48%,#87ba91); }
  .pricing-visual-slide { position:absolute; inset:0; overflow:hidden; margin:0; padding:clamp(15px,1.5vw,19px) clamp(14px,1.6vw,22px); }
  .pricing-visual-slide figcaption { position:absolute; top:9px; right:10px; z-index:4; border:1px solid color-mix(in srgb,var(--botanical-ink) 10%,transparent); border-radius:999px; background:rgb(255 255 255 / 84%); padding:5px 8px; color:color-mix(in srgb,var(--botanical-ink) 70%,white); font-size:8px; font-weight:760; letter-spacing:.08em; text-transform:uppercase; backdrop-filter:blur(7px); }
  .has-slider .pricing-web-demo { animation:pricing-slide-web 12s ease-in-out infinite; }
  .has-slider .pricing-manager-demo { opacity:0; animation:pricing-slide-manager 12s ease-in-out infinite; }
  .pricing-slider-dots { position:absolute; left:50%; bottom:8px; z-index:5; display:flex; gap:4px; transform:translateX(-50%); border-radius:999px; background:rgb(255 255 255 / 78%); padding:4px 6px; backdrop-filter:blur(7px); }
  .pricing-slider-dots i { width:5px; height:5px; border-radius:50%; background:color-mix(in srgb,var(--botanical-ink) 22%,white); }
  .pricing-slider-dots i:first-child { animation:pricing-dot-web 12s ease-in-out infinite; }
  .pricing-slider-dots i:last-child { animation:pricing-dot-manager 12s ease-in-out infinite; }
  @keyframes pricing-slide-web { 0%,42%,100% { opacity:1; transform:scale(1); } 49%,93% { opacity:0; transform:scale(.992); } }
  @keyframes pricing-slide-manager { 0%,42%,100% { opacity:0; transform:scale(.992); } 49%,93% { opacity:1; transform:scale(1); } }
  @keyframes pricing-dot-web { 0%,42%,100% { background:var(--botanical-ink); } 49%,93% { background:color-mix(in srgb,var(--botanical-ink) 22%,white); } }
  @keyframes pricing-dot-manager { 0%,42%,100% { background:color-mix(in srgb,var(--botanical-ink) 22%,white); } 49%,93% { background:var(--botanical-ink); } }
  .pricing-browser { position:relative; overflow:hidden; height:100%; border-radius:16px; background:rgb(255 255 255 / 94%); box-shadow:0 16px 32px rgb(15 62 23 / 12%); }
  .pricing-browser-top { display:grid; height:32px; grid-template-columns:auto 1fr auto; align-items:center; gap:9px; padding-inline:12px; }
  .pricing-browser-top > span { display:flex; gap:4px; }
  .pricing-browser-top i { width:6px; height:6px; border-radius:50%; background:color-mix(in srgb,var(--botanical-keylime) 72%,var(--botanical-ink)); }
  .pricing-browser-top b { overflow:hidden; color:color-mix(in srgb,var(--botanical-ink) 68%,white); font-size:8px; font-weight:650; text-overflow:ellipsis; white-space:nowrap; }
  .pricing-browser-top em { width:46px; height:9px; border-radius:999px; background:var(--botanical-ink); }
  .pricing-browser-hero { display:grid; height:132px; grid-template-columns:.95fr 1.05fr; margin:0 10px; overflow:hidden; border-radius:12px; background:color-mix(in srgb,var(--botanical-keylime) 72%,var(--botanical-paper)); }
  .pricing-browser-copy { display:flex; min-width:0; flex-direction:column; justify-content:center; padding:15px; }
  .pricing-browser-copy small { color:var(--botanical-ink); font-size:7px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; }
  .pricing-browser-copy strong { margin-top:7px; color:var(--botanical-ink); font-family:var(--botanical-serif); font-size:clamp(18px,1.7vw,25px); font-weight:500; letter-spacing:-.045em; line-height:.95; }
  .pricing-browser-copy > span { width:82%; height:3px; margin-top:11px; border-radius:999px; background:color-mix(in srgb,var(--botanical-ink) 24%,transparent); }
  .pricing-browser-copy > span + span { width:58%; margin-top:6px; }
  .pricing-browser-hero img { width:100%; height:132px; object-fit:cover; filter:saturate(.9) contrast(.96); }

  .pricing-availability { position:relative; z-index:2; display:grid; width:calc(100% - 38px); min-height:50px; grid-template-columns:repeat(3,1fr) 36px; align-items:center; gap:5px; margin:-18px auto 13px; border:1px solid color-mix(in srgb,var(--botanical-ink) 9%,transparent); border-radius:12px; background:white; padding:7px 7px 7px 11px; box-shadow:0 9px 18px rgb(15 62 23 / 9%); }
  .pricing-availability span { min-width:0; border-right:1px solid color-mix(in srgb,var(--botanical-ink) 10%,transparent); }
  .pricing-availability small,.pricing-availability b { display:block; }
  .pricing-availability small { color:color-mix(in srgb,var(--botanical-ink) 58%,white); font-size:6px; font-weight:750; letter-spacing:.06em; text-transform:uppercase; }
  .pricing-availability b { margin-top:4px; color:var(--botanical-ink); font-size:8px; }
  .pricing-availability > i { display:grid; width:32px; height:32px; place-items:center; border-radius:9px; background:var(--botanical-ink); color:white; font-size:15px; font-style:normal; }
  .pricing-card-head { display:flex; min-height:70px; align-items:center; justify-content:space-between; gap:14px; padding:15px 25px 12px; }
  .pricing-card-head h3 { color:var(--botanical-ink); font-family:inherit; font-size:clamp(29px,2.35vw,36px); font-weight:580; letter-spacing:-.05em; line-height:1; }
  .pricing-card-head strong { flex:none; border-radius:999px; background:var(--botanical-ink); padding:7px 10px; color:var(--botanical-paper); font-size:9px; font-weight:750; letter-spacing:.05em; text-transform:uppercase; }
  .pricing-card.is-featured .pricing-card-head h3 { font-weight:660; }
  .pricing-card--forest .pricing-card-head strong { border:1px solid color-mix(in srgb,#9a7a3d 50%,transparent); background:color-mix(in srgb,#eadbb7 40%,white); color:color-mix(in srgb,#775a28 82%,var(--botanical-ink)); }

  .pricing-product { flex:1; border-top:1px solid color-mix(in srgb,var(--botanical-ink) 10%,transparent); padding:clamp(18px,1.65vw,23px); }
  .pricing-product h4 { min-height:2.16em; color:var(--botanical-ink); font-size:clamp(20px,1.65vw,24px); font-weight:570; letter-spacing:-.035em; line-height:1.08; }
  .pricing-product > p { min-height:2.84em; margin-top:8px; color:color-mix(in srgb,var(--botanical-charcoal) 68%,white); font-size:13px; line-height:1.42; }
  .pricing-feature-list { display:grid; gap:6px; margin-top:12px; }
  .pricing-feature-list li { display:grid; grid-template-columns:18px 1fr; gap:7px; color:var(--botanical-charcoal); font-size:12px; line-height:1.35; }
  .pricing-feature-list li span { color:var(--botanical-ink); font-weight:800; }

  .pricing-manager-demo { background:color-mix(in srgb,var(--botanical-slate) 32%,var(--botanical-paper)); }
  .pricing-manager-demo.is-intelligent { background:color-mix(in srgb,var(--botanical-keylime) 42%,#a7c6aa); }
  .manager-window { height:100%; overflow:hidden; border:1px solid rgb(15 62 23 / 8%); border-radius:12px; background:rgb(255 255 255 / 96%); box-shadow:0 13px 28px rgb(15 62 23 / 10%); }
  .manager-window-head { display:flex; height:27px; align-items:center; justify-content:space-between; border-bottom:1px solid rgb(15 62 23 / 8%); padding-inline:10px; }
  .manager-window-head strong { display:flex; align-items:center; gap:5px; color:var(--botanical-ink); font-size:7px; font-weight:800; }
  .manager-window-head strong i { width:4px; height:10px; border-radius:2px; background:var(--botanical-ink); box-shadow:5px -2px 0 color-mix(in srgb,var(--botanical-keylime) 58%,var(--botanical-ink)); }
  .manager-window-head > span { display:flex; gap:3px; }
  .manager-window-head > span i { width:4px; height:4px; border-radius:50%; background:rgb(15 62 23 / 22%); }
  .manager-window-body { display:grid; height:calc(100% - 27px); grid-template-columns:36px 1fr; }
  .manager-sidebar { display:flex; flex-direction:column; align-items:center; gap:9px; border-right:1px solid rgb(15 62 23 / 7%); padding-top:11px; background:color-mix(in srgb,var(--botanical-paper) 78%,white); }
  .manager-sidebar b,.manager-sidebar i { display:block; width:13px; height:4px; border-radius:999px; background:rgb(15 62 23 / 18%); }
  .manager-sidebar b { width:18px; height:18px; border-radius:6px; background:var(--botanical-ink); }
  .manager-planning,.manager-intelligence { position:relative; min-width:0; padding:10px 10px 9px; }
  .manager-planning > header,.manager-intelligence > header { display:flex; align-items:center; justify-content:space-between; }
