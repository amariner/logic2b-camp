---
interface WebBlock {
  titulo: string;
  texto: string;
  imagen: string;
  capturaAlt: string;
  href: string;
  marca: string;
  previewKicker: string;
  previewTitulo: string;
  incluye: string[];
}

interface ManagerBlock {
  titulo: string;
  texto: string;
  imagen: string;
  capturaAlt: string;
  ruta?: string;
  modo: string;
  incluye: string[];
}

interface PricingItem {
  nombre: string;
  etiqueta?: string;
  precio: string;
  periodo: string;
  tono: string;
  web: WebBlock;
  gestor: ManagerBlock;
}

interface Props {
  kicker: string;
  titulo: string;
  texto: string;
  webLabel: string;
  gestorLabel: string;
  ctaWeb: string;
  ctaGestor: string;
  assistText: string;
  assistCta: string;
  aria: string;
  nota: string;
  items: PricingItem[];
}

const { kicker, titulo, texto, webLabel, gestorLabel, ctaWeb, ctaGestor, assistText, assistCta, aria, nota, items } = Astro.props;
const managerBase = import.meta.env.DEV ? 'http://localhost:5173/admin' : '/admin';
---

<section id="precios" class="pricing-showcase" aria-labelledby="pricing-showcase-title">
  <div class="pricing-shell">
    <header class="pricing-heading lc-reveal">
      <p class="botanical-eyebrow">{kicker}</p>
      <h2 id="pricing-showcase-title">{titulo}</h2>
      <p>{texto}</p>
    </header>

    <div class="pricing-grid" aria-label={aria}>
      {
        items.map((plan, index) => (
          <article class:list={['pricing-card', `pricing-card--${plan.tono}`, index === 1 && 'is-featured', 'lc-reveal']}>
            <header class="pricing-card-head">
              <h3>{plan.nombre}</h3>
              {plan.etiqueta && <strong>{plan.etiqueta}</strong>}
            </header>

            <figure class="pricing-web-demo">
              <div class="pricing-browser">
                <div class="pricing-browser-top" aria-hidden="true">
                  <span><i></i><i></i><i></i></span>
                  <b>{plan.web.marca}</b>
                  <em></em>
                </div>
                <div class="pricing-browser-hero">
                  <div class="pricing-browser-copy" aria-hidden="true">
                    <small>{plan.web.previewKicker}</small>
                    <strong>{plan.web.previewTitulo}</strong>
                    <span></span><span></span>
                  </div>
                  <img src={plan.web.imagen} alt={plan.web.capturaAlt} loading="lazy" decoding="async" />
                </div>
                <div class="pricing-availability" aria-hidden="true">
                  <span><small>Llegada</small><b>05 AGO</b></span>
                  <span><small>Salida</small><b>12 AGO</b></span>
                  <span><small>Huéspedes</small><b>2 + 1</b></span>
                  <i>→</i>
                </div>
              </div>
              <span class="pricing-confirmation" aria-hidden="true"><i>✓</i><b></b><b></b></span>
            </figure>

            <section class="pricing-product pricing-product--web" aria-labelledby={`pricing-web-${index}`}>
              <p class="pricing-product-label">{webLabel}</p>
              <h4 id={`pricing-web-${index}`}>{plan.web.titulo}</h4>
              <p>{plan.web.texto}</p>
              <ul class="pricing-feature-list">
                {plan.web.incluye.map((feature) => <li><span aria-hidden="true">✓</span>{feature}</li>)}
              </ul>
              <a class="pricing-cta pricing-cta--light" href={plan.web.href}>
                {ctaWeb}<span aria-hidden="true">↗</span>
              </a>
            </section>

            <section class="pricing-product pricing-product--manager" aria-labelledby={`pricing-manager-${index}`}>
              <p class="pricing-product-label">{gestorLabel}</p>
              {
                plan.gestor.modo === 'email' ? (
                  <div class="pricing-email-delivery">
                    <span aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none"><path d="M3 6.5h18v12H3zM3 7l9 7 9-7" /></svg>
                    </span>
                    <div>
                      <h4 id={`pricing-manager-${index}`}>{plan.gestor.titulo}</h4>
                      <p>{plan.gestor.texto}</p>
                    </div>
                  </div>
                ) : (
                  <>
                    <figure
                      class:list={['pricing-manager-visual', plan.gestor.imagen === 'avanzado' && 'is-intelligent']}
                      role="img"
                      aria-label={plan.gestor.capturaAlt}
                    >
                      <div class="manager-window" aria-hidden="true">
                        <header class="manager-window-head">
                          <strong><i></i>Logic2B</strong>
                          <span><i></i><i></i><i></i></span>
                        </header>
                        <div class="manager-window-body">
                          <aside class="manager-sidebar">
                            <b></b><i></i><i></i><i></i><i></i><i></i>
                          </aside>
                          {
                            plan.gestor.imagen === 'avanzado' ? (
                              <div class="manager-intelligence">
                                <header><span></span><b></b></header>
                                <div class="manager-kpis">
                                  <span><small>78%</small><i></i></span>
                                  <span><small>24</small><i></i></span>
                                  <span><small>94%</small><i></i></span>
                                </div>
                                <div class="manager-insight-row">
                                  <div class="manager-bars">
                                    <i></i><i></i><i></i><i></i><i></i><i></i>
                                  </div>
                                  <div class="manager-recommendation">
                                    <span>✓</span><i></i><i></i><i></i>
                                  </div>
                                </div>
                              </div>
                            ) : (
                              <div class="manager-planning">
                                <header><span></span><b></b></header>
                                <div class="manager-days"><span>12</span><span>13</span><span>14</span><span>15</span><span>16</span></div>
                                <div class="manager-calendar">
                                  <i class="booking booking-a"></i>
                                  <i class="booking booking-b"></i>
                                  <i class="booking booking-c"></i>
                                  <i class="booking booking-d"></i>
                                </div>
                                <span class="manager-occupancy"><b>78%</b><i></i></span>
                              </div>
                            )
                          }
                        </div>
                      </div>
                    </figure>
                    <h4 id={`pricing-manager-${index}`}>{plan.gestor.titulo}</h4>
                    <p>{plan.gestor.texto}</p>
                    <a class="pricing-cta pricing-cta--dark" href={`${managerBase}/${plan.gestor.ruta ?? ''}`}>
                      {ctaGestor}<span aria-hidden="true">↗</span>
                    </a>
                    <ul class="pricing-feature-list pricing-feature-list--manager">
                      {plan.gestor.incluye.map((feature) => <li><span aria-hidden="true">→</span>{feature}</li>)}
                    </ul>
                  </>
                )
              }
            </section>

            <footer class="pricing-card-price">
              <strong>{plan.precio}</strong><span>{plan.periodo}</span>
            </footer>
          </article>
        ))
      }
    </div>
    <div class="pricing-assist lc-reveal">
      <p>{assistText}</p>
      <a href="#contacto">{assistCta}<span aria-hidden="true">→</span></a>
    </div>
    <p class="pricing-note">{nota}</p>
  </div>
</section>

<style>
  .pricing-showcase {
    overflow: hidden;
    background: color-mix(in srgb, var(--botanical-keylime) 48%, var(--botanical-paper));
    padding-block: clamp(70px, 7vw, 108px);
    scroll-margin-top: 112px;
  }
  .pricing-shell { width:calc(100% - clamp(32px,5vw,72px)); max-width:1600px; margin-inline:auto; }
  .pricing-heading { max-width:1040px; margin-inline:auto; text-align:center; }
  .pricing-heading h2 { margin-top:18px; color:var(--botanical-ink); font-size:clamp(52px,5.8vw,88px); letter-spacing:-.055em; line-height:.98; text-wrap:balance; }
  .pricing-heading > p:last-child { max-width:720px; margin:24px auto 0; color:color-mix(in srgb,var(--botanical-charcoal) 70%,white); font-size:clamp(16px,1.5vw,19px); line-height:1.55; }

  .pricing-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:clamp(16px,1.8vw,26px); margin-top:clamp(38px,4.5vw,56px); align-items:start; }
  .pricing-card { position:relative; overflow:hidden; border:1px solid color-mix(in srgb,var(--botanical-ink) 10%,transparent); border-radius:clamp(24px,2.2vw,32px); background:var(--botanical-paper); box-shadow:0 18px 42px color-mix(in srgb,var(--botanical-ink) 7%,transparent); }
  .pricing-card.is-featured { transform:translateY(-14px); border-color:color-mix(in srgb,var(--botanical-ink) 30%,transparent); box-shadow:0 24px 54px color-mix(in srgb,var(--botanical-ink) 13%,transparent); }

  .pricing-web-demo { position:relative; overflow:hidden; min-height:clamp(228px,20vw,278px); margin:0 12px; border-radius:clamp(17px,1.8vw,23px); background:color-mix(in srgb,var(--botanical-keylime) 68%,var(--botanical-paper)); padding:clamp(17px,1.8vw,25px) clamp(14px,1.6vw,22px); }
  .pricing-card--water .pricing-web-demo { background:color-mix(in srgb,var(--botanical-water) 48%,var(--botanical-paper)); }
  .pricing-card--forest .pricing-web-demo { background:color-mix(in srgb,var(--botanical-keylime) 48%,#87ba91); }
  .pricing-browser { position:relative; overflow:hidden; min-height:200px; border-radius:16px; background:rgb(255 255 255 / 94%); box-shadow:0 16px 32px rgb(15 62 23 / 12%); }
  .pricing-browser-top { display:grid; height:32px; grid-template-columns:auto 1fr auto; align-items:center; gap:9px; padding-inline:12px; }
  .pricing-browser-top > span { display:flex; gap:4px; }
  .pricing-browser-top i { width:6px; height:6px; border-radius:50%; background:color-mix(in srgb,var(--botanical-keylime) 72%,var(--botanical-ink)); }
  .pricing-browser-top b { overflow:hidden; color:color-mix(in srgb,var(--botanical-ink) 68%,white); font-size:8px; font-weight:650; text-overflow:ellipsis; white-space:nowrap; }
  .pricing-browser-top em { width:46px; height:9px; border-radius:999px; background:var(--botanical-ink); }
  .pricing-browser-hero { display:grid; min-height:132px; grid-template-columns:.95fr 1.05fr; margin:0 10px; overflow:hidden; border-radius:12px; background:color-mix(in srgb,var(--botanical-keylime) 72%,var(--botanical-paper)); }
  .pricing-browser-copy { display:flex; min-width:0; flex-direction:column; justify-content:center; padding:15px; }
  .pricing-browser-copy small { color:var(--botanical-ink); font-size:7px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; }
  .pricing-browser-copy strong { margin-top:7px; color:var(--botanical-ink); font-family:var(--botanical-serif); font-size:clamp(18px,1.7vw,25px); font-weight:500; letter-spacing:-.045em; line-height:.95; }
  .pricing-browser-copy > span { width:82%; height:3px; margin-top:11px; border-radius:999px; background:color-mix(in srgb,var(--botanical-ink) 24%,transparent); }
  .pricing-browser-copy > span + span { width:58%; margin-top:6px; }
  .pricing-browser-hero img { width:100%; height:100%; min-height:132px; object-fit:cover; filter:saturate(.9) contrast(.96); }

  .pricing-availability { position:relative; z-index:2; display:grid; width:calc(100% - 38px); min-height:50px; grid-template-columns:repeat(3,1fr) 36px; align-items:center; gap:5px; margin:-18px auto 13px; border:1px solid color-mix(in srgb,var(--botanical-ink) 9%,transparent); border-radius:12px; background:white; padding:7px 7px 7px 11px; box-shadow:0 9px 18px rgb(15 62 23 / 9%); }
  .pricing-availability span { min-width:0; border-right:1px solid color-mix(in srgb,var(--botanical-ink) 10%,transparent); }
  .pricing-availability small,.pricing-availability b { display:block; }
  .pricing-availability small { color:color-mix(in srgb,var(--botanical-ink) 58%,white); font-size:6px; font-weight:750; letter-spacing:.06em; text-transform:uppercase; }
  .pricing-availability b { margin-top:4px; color:var(--botanical-ink); font-size:8px; }
  .pricing-availability > i { display:grid; width:32px; height:32px; place-items:center; border-radius:9px; background:var(--botanical-ink); color:white; font-size:15px; font-style:normal; }
  .pricing-confirmation { position:absolute; right:15px; bottom:12px; z-index:3; display:grid; width:67px; height:45px; grid-template-columns:18px 1fr; grid-template-rows:1fr 1fr; align-items:center; gap:2px 5px; border-radius:11px; background:var(--botanical-ink); padding:8px; box-shadow:0 9px 18px rgb(15 62 23 / 18%); }
  .pricing-confirmation i { display:grid; grid-row:1/-1; width:18px; height:18px; place-items:center; border-radius:50%; background:var(--botanical-keylime); color:var(--botanical-ink); font-size:9px; font-style:normal; }
  .pricing-confirmation b { width:100%; height:3px; border-radius:999px; background:rgb(255 255 255 / 42%); }
  .pricing-confirmation b:last-child { width:68%; }

  .pricing-card-head { display:flex; min-height:78px; align-items:center; justify-content:space-between; gap:14px; padding:18px 25px 14px; }
  .pricing-card-head h3 { color:var(--botanical-ink); font-family:inherit; font-size:clamp(30px,2.5vw,39px); font-weight:600; letter-spacing:-.05em; line-height:1; }
  .pricing-card-head strong { flex:none; border-radius:999px; background:var(--botanical-ink); padding:7px 10px; color:var(--botanical-paper); font-size:9px; font-weight:750; letter-spacing:.05em; text-transform:uppercase; }

  .pricing-product { border-top:1px solid color-mix(in srgb,var(--botanical-ink) 10%,transparent); padding:clamp(20px,1.9vw,27px); }
  .pricing-product-label { color:var(--botanical-ink); font-size:11px; font-weight:780; letter-spacing:.1em; text-transform:uppercase; }
  .pricing-product h4 { margin-top:13px; color:var(--botanical-ink); font-size:clamp(21px,1.85vw,27px); font-weight:600; letter-spacing:-.04em; line-height:1.08; }
  .pricing-product > p:not(.pricing-product-label),.pricing-email-delivery p { margin-top:10px; color:color-mix(in srgb,var(--botanical-charcoal) 68%,white); font-size:13px; line-height:1.48; }
  .pricing-feature-list { display:grid; gap:7px; margin-top:15px; }
  .pricing-feature-list li { display:grid; grid-template-columns:18px 1fr; gap:7px; color:var(--botanical-charcoal); font-size:12px; line-height:1.35; }
  .pricing-feature-list li span { color:var(--botanical-ink); font-weight:800; }

  .pricing-product--manager { margin:8px 11px 0; border:0; border-radius:20px; background:color-mix(in srgb,var(--botanical-keylime) 30%,white); }
  .pricing-card--water .pricing-product--manager { background:color-mix(in srgb,var(--botanical-water) 20%,white); }
  .pricing-card--forest .pricing-product--manager { background:color-mix(in srgb,var(--botanical-keylime) 22%,white); }
  .pricing-product--manager > .pricing-product-label { display:flex; align-items:center; gap:8px; border-radius:11px; background:var(--botanical-ink); padding:10px 12px; color:white; }
  .pricing-product--manager > .pricing-product-label::before { width:7px; height:7px; border-radius:2px; background:var(--botanical-keylime); box-shadow:5px -3px 0 rgb(255 255 255 / 48%); content:""; }
  .pricing-manager-visual { position:relative; overflow:hidden; aspect-ratio:16/8.7; margin-top:13px; border-radius:15px; background:color-mix(in srgb,var(--botanical-water) 32%,var(--botanical-paper)); padding:12px; }
  .pricing-manager-visual.is-intelligent { background:color-mix(in srgb,var(--botanical-keylime) 42%,#a7c6aa); }
  .manager-window { height:100%; overflow:hidden; border:1px solid rgb(15 62 23 / 8%); border-radius:12px; background:rgb(255 255 255 / 96%); box-shadow:0 13px 28px rgb(15 62 23 / 10%); }
  .manager-window-head { display:flex; height:27px; align-items:center; justify-content:space-between; border-bottom:1px solid rgb(15 62 23 / 8%); padding-inline:10px; }
  .manager-window-head strong { display:flex; align-items:center; gap:5px; color:var(--botanical-ink); font-size:7px; font-weight:800; }
  .manager-window-head strong i { width:4px; height:10px; border-radius:2px; background:var(--botanical-ink); box-shadow:5px -2px 0 color-mix(in srgb,var(--botanical-keylime) 58%,var(--botanical-ink)); }
  .manager-window-head > span { display:flex; gap:3px; }
  .manager-window-head > span i { width:4px; height:4px; border-radius:50%; background:rgb(15 62 23 / 22%); }
  .manager-window-body { display:grid; height:calc(100% - 27px); grid-template-columns:36px 1fr; }
  .manager-sidebar { display:flex; flex-direction:column; align-items:center; gap:9px; border-right:1px solid rgb(15 62 23 / 7%); padding-top:11px; background:color-mix(in srgb,var(--botanical-paper) 78%,white); }
  .manager-sidebar b,.manager-sidebar i { display:block; width:13px; height:4px; border-radius:999px; background:rgb(15 62 23 / 18%); }
  .manager-sidebar b { width:18px; height:18px; border-radius:6px; background:var(--botanical-ink); }
  .manager-planning,.manager-intelligence { position:relative; min-width:0; padding:10px 10px 9px; }
  .manager-planning > header,.manager-intelligence > header { display:flex; align-items:center; justify-content:space-between; }
  .manager-planning > header span,.manager-intelligence > header span { width:54px; height:6px; border-radius:999px; background:var(--botanical-ink); }
  .manager-planning > header b,.manager-intelligence > header b { width:44px; height:14px; border:1px solid rgb(15 62 23 / 10%); border-radius:999px; background:white; }
  .manager-days { display:grid; grid-template-columns:repeat(5,1fr); margin:9px 0 0 14px; }
  .manager-days span { color:rgb(15 62 23 / 47%); font-size:5px; font-weight:700; text-align:center; }
  .manager-calendar { position:relative; height:88px; margin-top:4px; border:1px solid rgb(15 62 23 / 8%); border-radius:8px; background:repeating-linear-gradient(to right,transparent 0,transparent calc(20% - 1px),rgb(15 62 23 / 7%) calc(20% - 1px),rgb(15 62 23 / 7%) 20%),repeating-linear-gradient(to bottom,transparent 0,transparent calc(25% - 1px),rgb(15 62 23 / 6%) calc(25% - 1px),rgb(15 62 23 / 6%) 25%); }
  .booking { position:absolute; height:12px; border-radius:4px; box-shadow:inset 0 0 0 1px rgb(255 255 255 / 35%); }
  .booking-a { top:12px; left:4%; width:39%; background:#b4deb9; }
  .booking-b { top:33px; left:29%; width:48%; background:var(--botanical-water); }
  .booking-c { top:54px; left:9%; width:27%; background:#f0cd8d; }
  .booking-d { top:70px; left:56%; width:36%; background:color-mix(in srgb,var(--botanical-ink) 74%,white); }
  .manager-occupancy { position:absolute; right:17px; bottom:17px; display:grid; width:65px; height:38px; grid-template-columns:25px 1fr; align-items:center; gap:6px; border:1px solid rgb(15 62 23 / 9%); border-radius:9px; background:white; padding:6px; box-shadow:0 7px 15px rgb(15 62 23 / 12%); }
  .manager-occupancy b { color:var(--botanical-ink); font-size:10px; }
  .manager-occupancy i { height:5px; border-radius:999px; background:linear-gradient(90deg,var(--botanical-ink) 78%,rgb(15 62 23 / 10%) 78%); }
  .manager-kpis { display:grid; grid-template-columns:repeat(3,1fr); gap:5px; margin-top:10px; }
  .manager-kpis > span { min-width:0; border:1px solid rgb(15 62 23 / 7%); border-radius:8px; background:white; padding:7px; }
  .manager-kpis small { display:block; color:var(--botanical-ink); font-size:10px; font-weight:800; }
  .manager-kpis i { display:block; width:70%; height:3px; margin-top:5px; border-radius:999px; background:rgb(15 62 23 / 16%); }
  .manager-insight-row { display:grid; grid-template-columns:1.12fr .88fr; gap:6px; margin-top:6px; }
  .manager-bars,.manager-recommendation { height:75px; border:1px solid rgb(15 62 23 / 7%); border-radius:8px; background:white; }
  .manager-bars { display:flex; align-items:flex-end; justify-content:center; gap:5px; padding:10px 8px; }
  .manager-bars i { width:9px; border-radius:3px 3px 1px 1px; background:color-mix(in srgb,var(--botanical-water) 70%,var(--botanical-ink)); }
  .manager-bars i:nth-child(1) { height:28%; }.manager-bars i:nth-child(2) { height:58%; }.manager-bars i:nth-child(3) { height:42%; }.manager-bars i:nth-child(4) { height:78%; }.manager-bars i:nth-child(5) { height:64%; }.manager-bars i:nth-child(6) { height:88%; background:var(--botanical-ink); }
  .manager-recommendation { display:grid; grid-template-columns:20px 1fr; grid-template-rows:repeat(3,1fr); align-items:center; gap:2px 6px; padding:10px; }
  .manager-recommendation span { display:grid; grid-row:1/-1; width:20px; height:20px; place-items:center; border-radius:50%; background:var(--botanical-keylime); color:var(--botanical-ink); font-size:9px; font-weight:800; }
  .manager-recommendation i { width:100%; height:4px; border-radius:999px; background:rgb(15 62 23 / 15%); }
  .manager-recommendation i:nth-of-type(2) { width:78%; }.manager-recommendation i:nth-of-type(3) { width:55%; }
  .pricing-email-delivery { display:grid; min-height:150px; grid-template-columns:48px 1fr; align-content:center; gap:14px; margin-top:13px; border-radius:16px; background:rgb(255 255 255 / 72%); padding:18px; }
  .pricing-email-delivery > span { display:grid; width:48px; height:48px; place-items:center; border-radius:14px; background:var(--botanical-ink); color:var(--botanical-paper); }
  .pricing-email-delivery svg { width:23px; height:23px; stroke:currentColor; stroke-linecap:round; stroke-linejoin:round; stroke-width:1.6; }
  .pricing-email-delivery h4 { margin-top:0; }

  .pricing-cta { display:inline-flex; min-height:28px; align-items:center; gap:9px; margin-top:15px; padding:0; color:var(--botanical-ink); font-size:12px; font-weight:720; transition:opacity 160ms ease; }
  .pricing-cta span { display:grid; width:27px; height:27px; place-items:center; border-radius:50%; background:color-mix(in srgb,var(--botanical-keylime) 64%,white); color:var(--botanical-ink); font-size:12px; transition:transform 160ms ease,background-color 160ms ease; }
  .pricing-cta:hover { opacity:.74; }
  .pricing-cta:hover span { transform:translate(2px,-2px); background:var(--botanical-keylime); }
