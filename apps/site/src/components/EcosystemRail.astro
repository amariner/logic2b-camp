---
import {
  siBrevo,
  siCalendly,
  siCloudflare,
  siDropbox,
  siGooglecalendar,
  siGooglemaps,
  siMailchimp,
  siOpenstreetmap,
  siPaypal,
  siQuickbooks,
  siSignal,
  siStripe,
  siTelegram,
  siWhatsapp,
  siXero,
  siZapier,
} from 'simple-icons';

interface Item {
  nombre: string;
  icono: string;
}

interface Props {
  items: Item[];
  label: string;
}

const { items, label } = Astro.props;
const icons: Record<string, { path: string }> = {
  brevo: siBrevo,
  calendly: siCalendly,
  cloudflare: siCloudflare,
  dropbox: siDropbox,
  googlecalendar: siGooglecalendar,
  googlemaps: siGooglemaps,
  mailchimp: siMailchimp,
  openstreetmap: siOpenstreetmap,
  paypal: siPaypal,
  quickbooks: siQuickbooks,
  signal: siSignal,
  stripe: siStripe,
  telegram: siTelegram,
  whatsapp: siWhatsapp,
  xero: siXero,
  zapier: siZapier,
};
---

<div class="brand-rail" role="list" aria-label={label}>
  {
    items.map((item) => {
      const icon = icons[item.icono];
      return (
        <span class="brand-mark" role="listitem">
          <svg viewBox="0 0 24 24" role="img" aria-label={item.nombre}>
            <path d={icon.path} />
          </svg>
          <span class="brand-mark-name">{item.nombre}</span>
        </span>
      );
    })
  }
</div>

<style>
  .brand-rail {
    display:grid;
    grid-template-columns:repeat(8,minmax(0,1fr));
    align-items:center;
    gap:clamp(18px,2vw,32px);
    width:100%;
  }
  .brand-mark {
    display:flex;
    min-width:0;
    align-items:center;
    justify-content:center;
    gap:clamp(7px,.7vw,11px);
    color:#111;
  }
  .brand-mark svg {
    display:block;
    flex:0 0 auto;
    width:clamp(24px,2.35vw,34px);
    height:clamp(24px,2.35vw,34px);
    fill:currentColor;
  }
  .brand-mark-name {
    min-width:0;
    font-size:clamp(11px,.95vw,14px);
    font-weight:650;
    letter-spacing:-.025em;
    line-height:1.05;
  }
  @media (max-width:1050px) {
    .brand-rail {
      grid-template-columns:repeat(4,minmax(0,1fr));
    }
  }
  @media (max-width:767px) {
    .brand-rail {
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:24px 18px;
    }
    .brand-mark {
      justify-content:flex-start;
    }
    .brand-mark svg {
      width:28px;
      height:28px;
    }
    .brand-mark-name {
      font-size:12px;
    }
  }
</style>
