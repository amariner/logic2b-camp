---
import ManagementPanelVisual from './ManagementPanelVisual.astro';
import { localePath, type Locale } from '../lib/i18n';
import { getManagementPanelUi, getManagementPanelViews } from '../lib/managementPanels';

interface Props { locale: Locale; content: any; href: string; mode?: 'home' | 'catalog' }
const { locale, content: c, href, mode = 'home' } = Astro.props;
const views = getManagementPanelViews(locale);
const copy = getManagementPanelUi(locale);
const conversionPath = (id:string) => `${localePath(locale,'empezar/')}?panel=${encodeURIComponent(id)}`;
const detailPath = (id:string) => localePath(locale,`paneles/${id}/`);
---

<section id={mode === 'home' ? 'paneles' : undefined} class:list={['management-explorer',`is-${mode}`]} aria-labelledby={`management-explorer-title-${mode}`} data-management-explorer>
  <div class="management-explorer-shell">
    <header class="management-explorer-head lc-reveal">
      <div><p>{mode==='catalog'?copy.catalogKicker:c.kicker}</p><h2 id={`management-explorer-title-${mode}`}>{mode==='catalog'?copy.catalogTitle:c.titulo}</h2></div>
      <div><p>{mode==='catalog'?copy.catalogText:c.texto}</p>{mode==='home'&&<a href={href}>{c.verTodos}<span aria-hidden="true">↗</span></a>}</div>
    </header>
    <div class="management-explorer-toolbar lc-reveal"><p><strong>{String(views.length).padStart(2,'0')}</strong> {copy.count}</p><div><button type="button" aria-label={copy.previous} data-management-prev disabled>←</button><button type="button" aria-label={copy.next} data-management-next>→</button></div></div>
    <div class="management-explorer-track" role="region" aria-label={copy.region} tabindex="0" data-management-track>
      {views.map((view,index)=><article class:list={['management-view-card',`is-${view.level}`]}>
        <button type="button" class="management-view-visual" data-management-open={`management-preview-${mode}-${view.id}`} aria-label={`${copy.open}: ${view.name}`}><ManagementPanelVisual locale={locale} variant={view.level as 'gestion'|'avanzado'} label={view.name} ariaLabel={`${copy.open}: ${view.name}`}/><span>{view.name}</span></button>
        <div class="management-view-copy"><p><span>{String(index+1).padStart(2,'0')}</span>{view.eyebrow}</p><h3>{view.name}</h3><small>{view.description}</small><button type="button" data-management-open={`management-preview-${mode}-${view.id}`} aria-label={`${copy.open}: ${view.name}`}>↗</button></div>
      </article>)}
    </div>
  </div>
  {views.map(view=><dialog id={`management-preview-${mode}-${view.id}`} class="management-preview-dialog" data-management-dialog aria-labelledby={`management-preview-title-${mode}-${view.id}`}>
    <div class="management-preview-layout"><button type="button" class="management-preview-close" data-management-close aria-label={copy.close}>×</button>
      <div class="management-preview-browser"><div class="management-preview-bar"><i></i><i></i><i></i><span>panel.tudominio.com/{view.id}</span></div><div class="management-preview-screen"><iframe src="about:blank" data-management-frame data-management-src={view.href} title={`${copy.browser}: ${view.name}`} loading="lazy"></iframe></div></div>
      <aside class="management-preview-side"><p class="management-preview-kicker">{copy.live}</p><h2 id={`management-preview-title-${mode}-${view.id}`}>{view.name}</h2><p class="management-preview-description">{view.description}</p><div class="management-preview-tags"><span>{view.eyebrow}</span><span>{view.level==='gestion'?c.tipos[0].nombre:c.tipos[1].nombre}</span></div><ul>{view.points.map(point=><li><span aria-hidden="true">✓</span>{point}</li>)}</ul><div class="management-preview-actions"><a class="management-preview-primary" href={conversionPath(view.id)}>{copy.request}<span>→</span></a><a class="management-preview-secondary" href={detailPath(view.id)}>{copy.more}<span>↗</span></a></div><p class="management-preview-note">{copy.note}</p></aside>
    </div>
  </dialog>)}
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-management-explorer]').forEach(root=>{const track=root.querySelector<HTMLElement>('[data-management-track]');const previous=root.querySelector<HTMLButtonElement>('[data-management-prev]');const next=root.querySelector<HTMLButtonElement>('[data-management-next]');if(!track||!previous||!next)return;const update=()=>{const maximum=Math.max(0,track.scrollWidth-track.clientWidth);previous.disabled=track.scrollLeft<=2;next.disabled=track.scrollLeft>=maximum-2};const move=(direction:-1|1)=>{const card=track.querySelector<HTMLElement>('.management-view-card');const gap=Number.parseFloat(getComputedStyle(track).columnGap)||0;const count=innerWidth>=1080?3:innerWidth>=720?2:1;track.scrollBy({left:direction*(card?(card.offsetWidth+gap)*count:track.clientWidth),behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'})};previous.addEventListener('click',()=>move(-1));next.addEventListener('click',()=>move(1));track.addEventListener('scroll',update,{passive:true});addEventListener('resize',update,{passive:true});update()});
  document.querySelectorAll<HTMLButtonElement>('[data-management-open]').forEach(trigger=>trigger.addEventListener('click',()=>{const id=trigger.dataset.managementOpen;const dialog=id?document.getElementById(id):null;if(!(dialog instanceof HTMLDialogElement))return;const frame=dialog.querySelector<HTMLIFrameElement>('[data-management-frame]');if(frame?.dataset.managementSrc&&frame.src==='about:blank')frame.src=frame.dataset.managementSrc;dialog.showModal()}));
  document.querySelectorAll<HTMLDialogElement>('[data-management-dialog]').forEach(dialog=>{dialog.querySelector<HTMLButtonElement>('[data-management-close]')?.addEventListener('click',()=>dialog.close());dialog.addEventListener('click',event=>{if(event.target===dialog)dialog.close()})});
</script>

<style>
  .management-explorer{overflow:hidden;padding:clamp(78px,9vw,138px) 0;background:var(--botanical-ink);color:var(--botanical-paper)}.management-explorer.is-catalog{padding-top:clamp(70px,8vw,110px);background:var(--botanical-mint);color:var(--botanical-ink)}.management-explorer-shell{width:min(1500px,calc(100% - 48px));margin:auto}.management-explorer-head{display:grid;grid-template-columns:1.12fr .88fr;gap:clamp(40px,9vw,150px);align-items:end}.management-explorer-head>div:first-child>p{font-size:11px;font-weight:750;letter-spacing:.12em;text-transform:uppercase;color:#b9d0bd}.is-catalog .management-explorer-head>div:first-child>p{color:rgb(15 62 23/.58)}.management-explorer-head h2{max-width:850px;margin-top:17px;color:inherit;font-family:var(--botanical-serif);font-size:clamp(43px,5.5vw,82px);font-weight:400;letter-spacing:-.045em;line-height:.94}.management-explorer-head>div:last-child>p{max-width:590px;font-size:clamp(15px,1.3vw,19px);line-height:1.6;color:rgb(250 249 245/.7)}.is-catalog .management-explorer-head>div:last-child>p{color:rgb(15 62 23/.67)}.management-explorer-head a{display:inline-flex;gap:10px;margin-top:22px;border-bottom:1px solid rgb(250 249 245/.42);padding-bottom:5px;color:inherit;font-size:13px;font-weight:700}.management-explorer-toolbar{display:flex;align-items:center;justify-content:space-between;margin-top:clamp(38px,5vw,62px)}.management-explorer-toolbar>p{font-size:10px;font-weight:750;letter-spacing:.09em;text-transform:uppercase;opacity:.6}.management-explorer-toolbar>div{display:flex;gap:8px}.management-explorer-toolbar button{display:grid;width:44px;height:44px;place-items:center;border:1px solid currentColor;border-radius:50%;background:transparent;color:inherit;font:inherit;cursor:pointer}.management-explorer-toolbar button:disabled{opacity:.25}.management-explorer-track{--gutter:max(24px,calc((100vw - 1500px)/2));display:grid;width:100vw;grid-auto-columns:calc((100vw - var(--gutter)*2 - 28px)/3);grid-auto-flow:column;gap:14px;margin-left:calc(50% - 50vw);overflow-x:auto;padding:26px var(--gutter) 48px;scroll-snap-type:x mandatory;scrollbar-width:none;box-sizing:border-box}.management-explorer-track::-webkit-scrollbar{display:none}.management-view-card{min-width:0;overflow:hidden;border-radius:24px;background:#f5f7f3;color:var(--botanical-ink);box-shadow:0 18px 48px rgb(4 25 8/.16);scroll-snap-align:start}.management-view-card.is-avanzado{background:#e7eddf}.management-view-visual{position:relative;display:block;width:calc(100% - 20px);margin:10px 10px 0;overflow:hidden;border:0;border-radius:17px;padding:0;background:transparent;cursor:zoom-in}.management-view-visual :global(.management-panel-visual){aspect-ratio:1.48;min-height:0}.management-view-visual>span{position:absolute;right:12px;bottom:12px;border-radius:999px;padding:7px 10px;background:rgb(250 249 245/.88);color:var(--botanical-ink);font-size:9px;font-weight:800;text-transform:uppercase}.management-view-copy{position:relative;padding:18px 64px 22px 20px}.management-view-copy>p{display:flex;gap:10px;color:rgb(15 62 23/.53);font-size:9px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.management-view-copy h3{margin-top:13px;font-family:var(--botanical-serif);font-size:clamp(28px,2.6vw,41px);font-weight:400;letter-spacing:-.04em;line-height:.95}.management-view-copy small{display:block;min-height:3.2em;margin-top:12px;color:rgb(15 62 23/.65);font-size:12px;line-height:1.5}.management-view-copy>button{position:absolute;right:18px;bottom:20px;display:grid;width:44px;height:44px;place-items:center;border:0;border-radius:50%;background:var(--botanical-ink);color:white;font:inherit;cursor:zoom-in}.is-avanzado .management-view-copy>button{background:var(--botanical-keylime);color:var(--botanical-ink)}
  .management-preview-dialog{width:min(1760px,calc(100vw - 32px));max-width:none;height:calc(100dvh - 32px);max-height:none;margin:auto;overflow:hidden;border:0;border-radius:24px;padding:0;background:var(--botanical-paper);color:var(--botanical-ink);box-shadow:0 32px 90px rgb(6 33 12/.32)}.management-preview-dialog::backdrop{background:rgb(6 24 10/.64);backdrop-filter:blur(8px)}.management-preview-layout{position:relative;display:grid;height:100%;grid-template-columns:minmax(0,1fr) clamp(320px,27vw,410px)}.management-preview-close{position:absolute;top:16px;right:16px;z-index:5;display:grid;width:44px;height:44px;place-items:center;border:1px solid rgb(15 62 23/.18);border-radius:12px;background:rgb(250 249 245/.94);color:var(--botanical-ink);font:300 25px/1 var(--botanical-sans);cursor:pointer}.management-preview-browser{min-width:0;margin:14px 0 14px 14px;overflow:hidden;border:1px solid rgb(15 62 23/.14);border-radius:16px;background:white}.management-preview-bar{display:flex;min-height:46px;align-items:center;gap:7px;border-bottom:1px solid rgb(15 62 23/.1);padding:0 16px}.management-preview-bar i{width:10px;height:10px;border-radius:50%;background:rgb(15 62 23/.18)}.management-preview-bar span{margin-left:8px;color:rgb(15 62 23/.48);font-size:12px}.management-preview-screen{height:calc(100% - 46px)}.management-preview-screen iframe{display:block;width:100%;height:100%;border:0}.management-preview-side{display:flex;min-height:0;flex-direction:column;overflow-y:auto;padding:clamp(76px,9vh,92px) clamp(24px,2.5vw,38px) clamp(28px,4vh,48px)}.management-preview-kicker{color:rgb(15 62 23/.54);font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.management-preview-side h2{margin-top:13px;font-family:var(--botanical-serif);font-size:clamp(38px,4vw,58px);font-weight:400;letter-spacing:-.045em;line-height:.95}.management-preview-description{margin-top:20px;color:rgb(15 62 23/.67);font-size:15px;line-height:1.55}.management-preview-tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:20px}.management-preview-tags span{border:1px solid rgb(15 62 23/.15);border-radius:999px;padding:6px 11px;font-size:11px}.management-preview-side ul{display:grid;gap:12px;margin-top:26px}.management-preview-side li{display:grid;grid-template-columns:16px 1fr;gap:8px;color:rgb(15 62 23/.72);font-size:13px;line-height:1.45}.management-preview-actions{display:grid;gap:9px;margin-top:auto;padding-top:30px}.management-preview-actions a{display:flex;min-height:48px;align-items:center;justify-content:space-between;gap:16px;border-radius:999px;padding:0 18px;font-size:13px;font-weight:800}.management-preview-primary{background:var(--botanical-ink);color:white}.management-preview-secondary{border:1px solid rgb(15 62 23/.2);color:var(--botanical-ink)}.management-preview-note{margin-top:14px;color:rgb(15 62 23/.51);font-size:11px;line-height:1.45}
  @media(max-width:1079px){.management-explorer-track{grid-auto-columns:calc((100vw - var(--gutter)*2 - 14px)/2)}}@media(max-width:720px){.management-explorer-shell{width:calc(100% - 28px)}.management-explorer-head{grid-template-columns:1fr;gap:26px}.management-explorer-track{--gutter:14px;grid-auto-columns:min(86vw,350px)}.management-preview-dialog{width:100vw;height:100dvh;border-radius:0}.management-preview-layout{grid-template-columns:1fr;grid-template-rows:minmax(320px,56dvh) minmax(0,1fr)}.management-preview-browser{margin:0;border-width:0 0 1px;border-radius:0}.management-preview-close{top:10px;right:10px}.management-preview-side{padding:28px 20px 30px}.management-preview-side ul{display:none}.management-preview-actions{margin-top:22px;padding-top:0}}
</style>
