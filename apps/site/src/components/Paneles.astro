---
import Base from '../layouts/Base.astro';
import ManagementPanelVisual from './ManagementPanelVisual.astro';
import { getContent, localePath, type Locale } from '../lib/i18n';
import { getManagementPanelUi, getManagementPanelViews } from '../lib/managementPanels';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = getContent(locale);
const views = getManagementPanelViews(locale);
const ui = getManagementPanelUi(locale);
const detailPath = (id:string) => localePath(locale,`paneles/${id}/`);
const levelName = (level:'gestion'|'avanzado') => level === 'gestion' ? ui.management : ui.advanced;
---

<Base locale={locale} content={c} ruta="paneles/" seo={c.paneles.seo}>
  <div class="panel-catalog-page">
    <section class="panel-catalog-hero botanical-shell botanical-subpage-hero">
      <div><p class="botanical-eyebrow">{ui.catalogKicker}</p><h1 class="botanical-heading">{ui.catalogTitle}</h1></div>
      <div class="panel-catalog-hero-intro"><strong>{String(views.length).padStart(2,'0')}</strong><p class="botanical-copy">{ui.catalogText}</p><a href={`${localePath(locale)}#paneles`}>{ui.backHome}<span aria-hidden="true">←</span></a></div>
    </section>

    <section class="panel-catalog-browser botanical-shell" aria-label={ui.catalogKicker} data-panel-catalog>
      <div class="panel-catalog-toolbar">
        <label class="panel-catalog-search"><span class="botanical-visually-hidden">{ui.search}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg><input type="search" placeholder={ui.searchPlaceholder} data-panel-search /></label>
        <div class="panel-catalog-filters" role="group" aria-label={ui.filter}><button type="button" class="is-active" data-panel-filter="" aria-pressed="true">{ui.all}</button><button type="button" data-panel-filter="gestion" aria-pressed="false">{ui.management}</button><button type="button" data-panel-filter="avanzado" aria-pressed="false">{ui.advanced}</button></div>
      </div>
      <div class="panel-catalog-grid" data-panel-grid>
        {views.map((view,index)=><article class:list={['panel-catalog-card',`is-${view.level}`]} data-panel-card data-panel-level={view.level} data-panel-searchable={`${view.name} ${view.eyebrow} ${view.description} ${view.tags.join(' ')}`}>
          <a class="panel-catalog-visual" href={detailPath(view.id)} aria-label={`${view.name} · ${ui.cardCta}`}><ManagementPanelVisual locale={locale} variant={view.level} label={view.name} ariaLabel={`${ui.open}: ${view.name}`}/><span>{String(index+1).padStart(2,'0')}</span></a>
          <div class="panel-catalog-meta"><div class="panel-catalog-meta-top"><h2>{view.name}</h2><span>{levelName(view.level)}</span></div><p>{view.description}</p><div class="panel-catalog-tags">{view.tags.slice(0,2).map(tag=><span>{tag}</span>)}</div><a class="panel-catalog-open" href={detailPath(view.id)}>{ui.cardCta}<span aria-hidden="true">→</span></a></div>
        </article>)}
      </div>
      <p class="panel-catalog-empty" hidden data-panel-empty>{ui.empty}</p>
    </section>
    <section class="panel-catalog-note botanical-shell"><p>{ui.noteTitle}</p><a class="botanical-button" href={localePath(locale,'empezar/')}>{c.paneles.pagina.cierreCta}<span aria-hidden="true">→</span></a></section>
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-panel-catalog]').forEach(catalog=>{const search=catalog.querySelector<HTMLInputElement>('[data-panel-search]');const filters=[...catalog.querySelectorAll<HTMLButtonElement>('[data-panel-filter]')];const cards=[...catalog.querySelectorAll<HTMLElement>('[data-panel-card]')];const empty=catalog.querySelector<HTMLElement>('[data-panel-empty]');let active='';const normalize=(value:string)=>value.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();const update=()=>{const query=normalize(search?.value.trim()??'');let visible=0;cards.forEach(card=>{const show=(!active||card.dataset.panelLevel===active)&&(!query||normalize(card.dataset.panelSearchable??'').includes(query));card.hidden=!show;if(show)visible+=1});if(empty)empty.hidden=visible!==0};filters.forEach(filter=>filter.addEventListener('click',()=>{active=filter.dataset.panelFilter??'';filters.forEach(candidate=>{const selected=candidate===filter;candidate.classList.toggle('is-active',selected);candidate.setAttribute('aria-pressed',String(selected))});update()}));search?.addEventListener('input',update)});
</script>

<style>
  .panel-catalog-page{overflow:hidden;background:var(--botanical-paper)}.panel-catalog-hero{display:grid;grid-template-columns:1.2fr .8fr;gap:clamp(40px,8vw,120px);align-items:end;padding:clamp(76px,9vw,132px) 0 clamp(58px,7vw,96px)}.panel-catalog-hero h1{max-width:920px;margin-top:18px}.panel-catalog-hero-intro{display:grid;grid-template-columns:auto 1fr;gap:18px 22px;align-items:start}.panel-catalog-hero-intro>strong{grid-row:1/span 2;color:var(--botanical-sage);font-family:var(--botanical-serif);font-size:clamp(58px,7vw,104px);font-weight:400;letter-spacing:-.06em;line-height:.78}.panel-catalog-hero-intro>a{display:inline-flex;width:max-content;align-items:center;gap:9px;border-bottom:1px solid rgb(15 62 23/.3);padding-bottom:4px;color:var(--botanical-ink);font-size:13px;font-weight:720}
  .panel-catalog-browser{padding-bottom:clamp(70px,10vw,140px)}.panel-catalog-toolbar{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:30px;border-top:1px solid rgb(15 62 23/.13);padding-top:22px}.panel-catalog-search{display:flex;width:min(340px,100%);min-height:48px;align-items:center;gap:10px;border:1px solid rgb(15 62 23/.16);border-radius:999px;background:white;padding:0 16px}.panel-catalog-search svg{width:18px;height:18px}.panel-catalog-search input{width:100%;border:0;outline:0;background:transparent;color:var(--botanical-ink);font:inherit;font-size:14px}.panel-catalog-filters{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:8px}.panel-catalog-filters button{min-height:44px;border:1px solid rgb(15 62 23/.15);border-radius:999px;background:transparent;padding:0 16px;color:rgb(15 62 23/.66);font:inherit;font-size:12px;font-weight:700;cursor:pointer}.panel-catalog-filters button.is-active{border-color:var(--botanical-ink);background:var(--botanical-ink);color:white}
  .panel-catalog-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.panel-catalog-card{overflow:hidden;border:1px solid rgb(15 62 23/.1);border-radius:22px;background:white;box-shadow:0 14px 38px rgb(15 62 23/.05);transition:transform .22s ease,box-shadow .22s ease}.panel-catalog-card:hover{box-shadow:0 20px 48px rgb(15 62 23/.1);transform:translateY(-4px)}.panel-catalog-card[hidden]{display:none}.panel-catalog-visual{position:relative;display:block;margin:10px 10px 0;overflow:hidden;border-radius:15px;background:var(--botanical-mint)}.panel-catalog-visual :global(.management-panel-visual){aspect-ratio:1.42;min-height:0;transition:transform .6s cubic-bezier(.16,1,.3,1)}.panel-catalog-card:hover .panel-catalog-visual :global(.management-panel-visual){transform:scale(1.025)}.panel-catalog-visual>span{position:absolute;right:12px;bottom:12px;display:grid;width:38px;height:38px;place-items:center;border-radius:50%;background:rgb(250 249 245/.9);color:var(--botanical-ink);font-family:var(--botanical-serif);font-size:16px}.panel-catalog-meta{padding:22px 24px 25px}.panel-catalog-meta-top{display:flex;align-items:baseline;justify-content:space-between;gap:16px}.panel-catalog-meta h2{font-size:clamp(23px,2vw,30px);letter-spacing:-.035em;line-height:1}.panel-catalog-meta-top>span{font-size:9px;font-weight:800;letter-spacing:.09em;text-transform:uppercase;opacity:.5}.panel-catalog-meta>p{min-height:4.5em;margin-top:15px;color:rgb(15 62 23/.65);font-size:13px;line-height:1.5}.panel-catalog-tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:18px}.panel-catalog-tags span{border:1px solid rgb(15 62 23/.13);border-radius:999px;padding:5px 10px;color:rgb(15 62 23/.62);font-size:10px}.panel-catalog-open{display:flex;min-height:44px;align-items:center;justify-content:space-between;gap:18px;margin-top:20px;border-top:1px solid rgb(15 62 23/.11);padding-top:15px;color:var(--botanical-ink);font-size:12px;font-weight:800}.panel-catalog-empty{border:1px solid rgb(15 62 23/.12);border-radius:20px;padding:70px 24px;text-align:center}.panel-catalog-note{display:flex;align-items:center;justify-content:space-between;gap:30px;margin-bottom:clamp(28px,5vw,70px);border-radius:22px;background:var(--botanical-sage);padding:clamp(30px,5vw,58px)}.panel-catalog-note p{max-width:760px;font-family:var(--botanical-serif);font-size:clamp(24px,3vw,40px);line-height:1.15}.panel-catalog-note .botanical-button{flex:none}
  @media(max-width:1100px){.panel-catalog-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.panel-catalog-toolbar{align-items:flex-start;flex-direction:column}.panel-catalog-filters{justify-content:flex-start}}@media(max-width:760px){.panel-catalog-hero,.panel-catalog-grid{grid-template-columns:1fr}.panel-catalog-hero{gap:34px}.panel-catalog-hero-intro{grid-template-columns:70px 1fr}.panel-catalog-hero-intro>strong{font-size:66px}.panel-catalog-search{width:100%}.panel-catalog-filters{width:100%;flex-wrap:nowrap;overflow-x:auto}.panel-catalog-filters button{flex:none}.panel-catalog-meta>p{min-height:0}.panel-catalog-note{align-items:flex-start;flex-direction:column}}
</style>
