---
import Wordmark from './Wordmark.astro';
import ManagementPanelVisual from './ManagementPanelVisual.astro';
import closingBackground from '../../../../tenants/pinadamar/content/media/vida-llegada.webp?url';
import { logic2bContact } from '@logic-camp/config/contact';
import { localePath, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  content: any;
}

const { locale, content: c } = Astro.props;
const managementDemoHref = '/demos/pinadamar/gestion/#/planning';
const advancedDemoHref = '/demos/mardefondo/gestion/#/inteligente';
const whatsapp = logic2bContact(locale, 'commercial');
const copy = locale === 'es'
  ? {
      kicker: 'Logic2B Campings · demostración guiada',
      title: '¿Listo para convertir más visitas en reservas directas?',
      text: 'Descubre cómo quedarían tu web, tus reservas y la operativa diaria en una demostración preparada alrededor de tu camping.',
      cta: 'Solicitar una demostración',
      badges: ['Web con tu marca', 'Gestión diaria', 'Acompañamiento real'],
      product: 'Producto',
      explore: 'Explora',
      contact: 'Hablemos',
      links: {
        web: 'Web para campings', management: 'Panel Gestión', advanced: 'Panel Avanzado', pricing: 'Precios',
        themes: 'Los 12 temas', demos: 'Demos navegables', guides: 'Guías', panels: 'Paneles de gestión',
        demo: 'Solicitar una demo', whatsapp: 'Contactar por WhatsApp', email: 'hola@logic2b.com',
      },
      featureKicker: 'Descubre',
      featureTitle: 'Paneles que se adaptan a tu camping.',
      featureText: 'Vistas configurables para recepción, gerencia y operación.',
      featureCta: 'Conocer los paneles',
      copyright: 'Logic2B Campings · Castellón',
      visual: 'Vista simulada del panel Gestión de Logic2B Campings',
      phone: {
        label: 'Gestión',
        title: 'Gestión móvil',
        date: 'Hoy · lunes 31',
        occupancy: 'Ocupación',
        arrivals: 'Llegadas',
        upcomingArrivals: 'Próximas llegadas',
        viewAll: 'Ver todas',
        pitch: 'Parcela',
        bungalow: 'Bungalow',
      },
    }
  : {
      kicker: 'Logic2B Campings · guided demo',
      title: 'Ready to turn more visits into direct bookings?',
      text: 'See how your website, bookings and daily operation would work in a demonstration prepared around your campsite.',
      cta: 'Request a demonstration',
      badges: ['Website with your brand', 'Daily management', 'Real guidance'],
      product: 'Product',
      explore: 'Explore',
      contact: 'Let’s talk',
      links: {
        web: 'Campsite website', management: 'Management dashboard', advanced: 'Advanced dashboard', pricing: 'Pricing',
        themes: 'All 12 themes', demos: 'Live demos', guides: 'Guides', panels: 'Management dashboards',
        demo: 'Request a demo', whatsapp: 'Contact via WhatsApp', email: 'hola@logic2b.com',
      },
      featureKicker: 'Discover',
      featureTitle: 'Dashboards that adapt to your campsite.',
      featureText: 'Configurable views for reception, management and operations.',
      featureCta: 'Explore the dashboards',
      copyright: 'Logic2B Campings · Spain',
      visual: 'Simulated Logic2B Campings Management dashboard',
      phone: {
        label: 'Management',
        title: 'Mobile management',
        date: 'Today · Monday 31',
        occupancy: 'Occupancy',
        arrivals: 'Arrivals',
        upcomingArrivals: 'Upcoming arrivals',
        viewAll: 'View all',
        pitch: 'Pitch',
        bungalow: 'Bungalow',
      },
    };
---

<section id="contacto" class="home-closing-cta" aria-labelledby="home-closing-title">
  <div class="home-closing-frame">
    <div class="home-closing-panel">
      <div class="home-closing-copy lc-reveal">
        <p class="home-closing-kicker">{copy.kicker}</p>
        <h2 id="home-closing-title">{copy.title}</h2>
        <p class="home-closing-text">{copy.text}</p>
        <button type="button" class="home-closing-button" data-project-request-open>
          <span>{copy.cta}</span><i aria-hidden="true">↗</i>
        </button>
        <ul class="home-closing-badges" aria-label={copy.kicker}>
          {copy.badges.map((badge) => <li><span aria-hidden="true">✓</span>{badge}</li>)}
        </ul>
      </div>
      <div class="home-closing-visual lc-reveal">
        <img class="home-closing-image" src={closingBackground} alt="" loading="lazy" decoding="async" aria-hidden="true" />
        <ManagementPanelVisual locale={locale} variant="gestion" label={copy.phone.label} ariaLabel={copy.visual} />
        <div class="home-closing-phone" aria-hidden="true">
          <div class="home-closing-phone-status"><b>9:41</b><i></i><span></span></div>
          <div class="home-closing-phone-head">
            <div><small>Logic2B Campings</small><strong>{copy.phone.title}</strong></div>
            <span>LC</span>
          </div>
          <div class="home-closing-phone-date"><span>{copy.phone.date}</span><b>‹</b><b>›</b></div>
          <div class="home-closing-phone-metrics">
            <article><small>{copy.phone.occupancy}</small><strong>84%</strong><i style="--phone-value:84%"></i></article>
            <article><small>{copy.phone.arrivals}</small><strong>12</strong><i style="--phone-value:62%"></i></article>
          </div>
          <div class="home-closing-phone-list">
            <div class="home-closing-phone-list-head"><strong>{copy.phone.upcomingArrivals}</strong><span>{copy.phone.viewAll}</span></div>
            <article><i>AM</i><div><strong>Ana Martín</strong><small>{copy.phone.pitch} 24 · 12:30</small></div><b>→</b></article>
            <article><i>JL</i><div><strong>Joan López</strong><small>{copy.phone.bungalow} 08 · 15:00</small></div><b>→</b></article>
            <article><i>MS</i><div><strong>Marta Soler</strong><small>{copy.phone.pitch} 17 · 17:45</small></div><b>→</b></article>
          </div>
          <div class="home-closing-phone-nav"><span class="is-active"></span><span></span><span></span><span></span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<footer class="home-footer">
  <div class="home-footer-shell">
    <div class="home-footer-brand">
      <Wordmark class="home-footer-wordmark" href={localePath(locale)} />
      <p>{c.footer.tagline}</p>
    </div>

    <div class="home-footer-main">
      <nav class="home-footer-columns" aria-label={locale === 'es' ? 'Enlaces del pie de página' : 'Footer links'}>
        <div>
          <h3>{copy.product}</h3>
          <a href="/demo/">{copy.links.web}</a>
          <a href={managementDemoHref}>{copy.links.management}</a>
          <a href={advancedDemoHref}>{copy.links.advanced}</a>
          <a href={localePath(locale, 'precios/')}>{copy.links.pricing}</a>
        </div>
        <div>
          <h3>{copy.explore}</h3>
          <a href={localePath(locale, 'temas/')}>{copy.links.themes}</a>
          <a href={`${localePath(locale)}#demos`}>{copy.links.demos}</a>
          <a href={localePath(locale, 'docs/')}>{copy.links.guides}</a>
          <a href={localePath(locale, 'paneles/')}>{copy.links.panels}</a>
        </div>
        <div>
          <h3>{copy.contact}</h3>
          <button type="button" data-project-request-open>{copy.links.demo}</button>
          <a href={whatsapp.href} target="_blank" rel="noopener noreferrer">{copy.links.whatsapp}</a>
          <a href="mailto:hola@logic2b.com">{copy.links.email}</a>
        </div>
      </nav>

      <a class="home-footer-feature" href={localePath(locale, 'paneles/')}>
        <div class="home-footer-feature-copy">
          <span>{copy.featureKicker}</span>
          <h3>{copy.featureTitle}</h3>
          <p>{copy.featureText}</p>
          <b>{copy.featureCta}<i aria-hidden="true">↗</i></b>
        </div>
        <div class="home-footer-preview" aria-hidden="true">
          <div class="home-footer-preview-top"><span></span><span></span><span></span><b></b></div>
          <div class="home-footer-preview-body">
            <aside><i></i><i></i><i></i><i></i></aside>
            <div><span></span><span></span><span></span><span></span><b class="one"></b><b class="two"></b><b class="three"></b></div>
          </div>
        </div>
      </a>
    </div>

    <div class="home-footer-bottom">
      <p>© 2026 · {copy.copyright}</p>
      <nav aria-label={locale === 'es' ? 'Enlaces legales' : 'Legal links'}>
        <a href={localePath(locale, 'privacidad/')}>{c.legal.nav.privacy}</a>
        <a href={localePath(locale, 'aviso-legal/')}>{c.legal.nav.notice}</a>
        <a href={localePath(locale, 'cookies/')}>{c.legal.nav.cookies}</a>
      </nav>
      <div class="home-footer-languages">
        <a class:list={[locale === 'es' && 'is-active']} href={localePath('es')}>ES</a>
        <a class:list={[locale === 'en' && 'is-active']} href={localePath('en')}>EN</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .home-closing-cta{padding:clamp(16px,3vw,42px) clamp(12px,3vw,44px) 0;background:#f7f6f2}.home-closing-frame{overflow:hidden;border-radius:clamp(28px,4vw,54px) clamp(28px,4vw,54px) 0 0;background:repeating-linear-gradient(90deg,#cddd5d 0,#cddd5d 68px,#d8e66b 68px,#d8e66b 130px);padding:clamp(58px,7vw,105px) clamp(18px,5vw,78px) 0}.home-closing-panel{display:grid;min-height:clamp(650px,58vw,850px);grid-template-columns:minmax(0,.95fr) minmax(420px,1.05fr);overflow:hidden;border-radius:clamp(22px,3vw,42px) clamp(22px,3vw,42px) 0 0;background:#fff}.home-closing-copy{display:flex;flex-direction:column;align-items:flex-start;padding:clamp(52px,7vw,108px) clamp(32px,6vw,90px)}.home-closing-kicker{font-size:10px;font-weight:800;letter-spacing:.11em;text-transform:uppercase;color:rgb(15 62 23 / 58%)}.home-closing-copy h2{max-width:760px;margin-top:30px;font-family:var(--botanical-serif);font-size:clamp(48px,6vw,88px);font-weight:400;letter-spacing:-.055em;line-height:.9}.home-closing-text{max-width:630px;margin-top:28px;font-size:clamp(16px,1.45vw,21px);line-height:1.55;color:rgb(15 62 23 / 64%)}.home-closing-button{display:inline-flex;min-height:58px;align-items:center;gap:20px;margin-top:34px;border:0;border-radius:999px;background:var(--botanical-ink);padding:0 25px;color:white;font:inherit;font-size:14px;font-weight:800;cursor:pointer}.home-closing-button i{font-size:19px;font-style:normal}.home-closing-badges{display:flex;flex-wrap:wrap;gap:9px;margin-top:auto;padding-top:48px}.home-closing-badges li{display:flex;min-height:39px;align-items:center;gap:7px;border-radius:999px;background:#101510;padding:0 15px;color:white;font-size:10px;font-weight:700}.home-closing-badges span{color:#dbe947}.home-closing-visual{position:relative;display:flex;align-items:flex-end;overflow:hidden;border-left:1px solid rgb(15 62 23 / 10%);padding:65px 0 0 25px;background:linear-gradient(145deg,#dbe6d8,#b8ccb8)}.home-closing-visual:after{content:'';position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgb(7 28 12 / 3%),rgb(7 28 12 / 25%)),linear-gradient(90deg,rgb(237 244 234 / 8%),transparent 58%);pointer-events:none}.home-closing-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;filter:saturate(.84) contrast(1.04);transform:scale(1.015)}.home-closing-visual :global(.management-panel-visual){position:relative;z-index:2;width:112%;min-width:640px;transform:translate(28%,-8%);box-shadow:0 30px 70px rgb(4 25 8 / 30%)}
  .home-closing-phone{position:absolute;right:5%;bottom:-58px;z-index:3;width:clamp(220px,34%,292px);aspect-ratio:.545;overflow:hidden;border:8px solid #111511;border-radius:42px 42px 0 0;background:#f7f8f6;box-shadow:0 28px 70px rgb(4 25 8 / 32%);color:var(--botanical-ink);font-family:Arial,sans-serif}.home-closing-phone-status{position:relative;display:flex;height:34px;align-items:center;justify-content:space-between;padding:0 16px;background:#fff}.home-closing-phone-status b{font-size:10px}.home-closing-phone-status i{position:absolute;top:8px;left:50%;width:70px;height:19px;border-radius:999px;background:#101510;transform:translateX(-50%)}.home-closing-phone-status span{width:25px;height:8px;border-top:3px solid currentColor;border-bottom:3px solid currentColor;opacity:.75}.home-closing-phone-head{display:flex;align-items:center;justify-content:space-between;padding:17px 16px 13px;background:#fff}.home-closing-phone-head>div{display:grid;gap:3px}.home-closing-phone-head small{font-size:8px;color:rgb(15 62 23 / 52%)}.home-closing-phone-head strong{font-size:17px}.home-closing-phone-head>span{display:grid;width:31px;height:31px;place-items:center;border-radius:50%;background:var(--botanical-ink);color:#fff;font-size:9px;font-weight:800}.home-closing-phone-date{display:grid;grid-template-columns:1fr 25px 25px;gap:5px;align-items:center;margin:0 12px;border:1px solid rgb(15 62 23 / 11%);border-radius:9px;background:#fff;padding:9px 10px}.home-closing-phone-date span{font-size:10px;font-weight:700}.home-closing-phone-date b{font-size:15px;text-align:center}.home-closing-phone-metrics{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:9px 12px}.home-closing-phone-metrics article{display:grid;gap:5px;border-radius:10px;background:#fff;padding:11px}.home-closing-phone-metrics small{font-size:8px;color:rgb(15 62 23 / 54%)}.home-closing-phone-metrics strong{font-family:var(--botanical-serif);font-size:23px}.home-closing-phone-metrics i{position:relative;height:4px;border-radius:99px;background:rgb(15 62 23 / 8%)}.home-closing-phone-metrics i:after{content:'';position:absolute;inset:0 auto 0 0;width:var(--phone-value);border-radius:inherit;background:#76b382}.home-closing-phone-list{margin:0 12px;border-radius:12px;background:#fff;padding:12px}.home-closing-phone-list-head{display:flex;align-items:center;justify-content:space-between;padding-bottom:8px}.home-closing-phone-list-head strong{font-size:10px}.home-closing-phone-list-head span{font-size:7px;color:#39784a}.home-closing-phone-list>article{display:grid;grid-template-columns:28px 1fr 16px;gap:8px;align-items:center;border-top:1px solid rgb(15 62 23 / 8%);padding:9px 0}.home-closing-phone-list>article>i{display:grid;width:28px;height:28px;place-items:center;border-radius:8px;background:var(--botanical-mint);font-size:7px;font-style:normal;font-weight:800}.home-closing-phone-list article div{display:grid;gap:2px}.home-closing-phone-list article strong{font-size:9px}.home-closing-phone-list article small{font-size:7px;color:rgb(15 62 23 / 51%)}.home-closing-phone-list article>b{font-size:11px}.home-closing-phone-nav{position:absolute;right:0;bottom:52px;left:0;display:flex;height:42px;align-items:center;justify-content:space-around;border-top:1px solid rgb(15 62 23 / 9%);background:#fff}.home-closing-phone-nav span{width:14px;height:14px;border:2px solid rgb(15 62 23 / 24%);border-radius:5px}.home-closing-phone-nav .is-active{border-color:var(--botanical-ink);background:var(--botanical-ink)}
  .home-footer{background:#fff;color:var(--botanical-ink)}.home-footer-shell{width:min(1500px,calc(100% - 48px));margin:0 auto;padding:clamp(70px,8vw,120px) 0 30px}.home-footer-brand{display:grid;gap:16px}.home-footer-wordmark{font-size:clamp(23px,2.2vw,32px)}.home-footer-brand>p{max-width:490px;font-size:13px;line-height:1.55;color:rgb(15 62 23 / 58%)}.home-footer-main{display:grid;grid-template-columns:1.25fr .75fr;gap:clamp(60px,9vw,145px);align-items:start;margin-top:clamp(60px,7vw,95px)}.home-footer-columns{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:34px}.home-footer-columns>div{display:flex;flex-direction:column;align-items:flex-start;gap:13px}.home-footer-columns h3{margin-bottom:10px;color:rgb(15 62 23 / 38%);font-size:12px;font-weight:800}.home-footer-columns a,.home-footer-columns button{border:0;background:transparent;padding:0;color:inherit;font:inherit;font-size:14px;line-height:1.35;text-align:left;cursor:pointer}.home-footer-columns a:hover,.home-footer-columns button:hover{text-decoration:underline;text-underline-offset:4px}.home-footer-feature{position:relative;display:grid;min-height:315px;grid-template-columns:.9fr 1.1fr;overflow:hidden;border-radius:30px;background:#edf1e9;color:inherit}.home-footer-feature-copy{display:flex;flex-direction:column;align-items:flex-start;padding:31px 8px 28px 32px}.home-footer-feature-copy>span{font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#579063}.home-footer-feature-copy h3{max-width:330px;margin-top:36px;font-family:var(--botanical-serif);font-size:30px;font-weight:400;line-height:1}.home-footer-feature-copy p{max-width:270px;margin-top:14px;font-size:12px;line-height:1.45;color:rgb(15 62 23 / 60%)}.home-footer-feature-copy b{display:inline-flex;align-items:center;gap:8px;margin-top:auto;border-radius:999px;background:#fff;padding:12px 16px;font-size:11px}.home-footer-feature-copy b i{font-style:normal}.home-footer-preview{align-self:end;width:110%;height:210px;overflow:hidden;border:1px solid rgb(15 62 23 / 12%);border-radius:15px 0 0 0;background:white;box-shadow:-15px -12px 38px rgb(15 62 23 / 10%)}.home-footer-preview-top{display:flex;height:34px;align-items:center;gap:5px;border-bottom:1px solid rgb(15 62 23 / 9%);padding:0 10px}.home-footer-preview-top span{width:5px;height:5px;border-radius:50%;background:#9ab9a0}.home-footer-preview-top b{width:38px;height:6px;margin-left:auto;border-radius:9px;background:var(--botanical-ink)}.home-footer-preview-body{display:grid;height:176px;grid-template-columns:34px 1fr}.home-footer-preview-body aside{display:flex;flex-direction:column;align-items:center;gap:12px;border-right:1px solid rgb(15 62 23 / 8%);padding-top:13px}.home-footer-preview-body aside i{width:9px;height:9px;border:1px solid #a7b8aa;border-radius:3px}.home-footer-preview-body aside i:first-child{background:var(--botanical-ink)}.home-footer-preview-body>div{position:relative;display:grid;grid-template-columns:repeat(4,1fr);background:repeating-linear-gradient(to bottom,#fbfdfb 0,#fbfdfb 34px,rgb(15 62 23 / 7%) 34px,rgb(15 62 23 / 7%) 35px)}.home-footer-preview-body>div>span{border-right:1px solid rgb(15 62 23 / 7%)}.home-footer-preview-body b{position:absolute;height:13px;border-radius:4px}.home-footer-preview-body .one{top:22px;left:8%;width:48%;background:#afd6b5}.home-footer-preview-body .two{top:67px;left:35%;width:52%;background:#b9cdd1}.home-footer-preview-body .three{top:112px;left:16%;width:55%;background:#e7c67b}.home-footer-bottom{display:grid;grid-template-columns:1fr auto auto;gap:30px;align-items:center;margin-top:clamp(70px,8vw,118px);border-top:1px solid rgb(15 62 23 / 13%);padding-top:24px;color:rgb(15 62 23 / 58%);font-size:11px}.home-footer-bottom nav,.home-footer-languages{display:flex;flex-wrap:wrap;gap:18px}.home-footer-bottom a{color:inherit}.home-footer-languages a{font-weight:800}.home-footer-languages .is-active{color:var(--botanical-ink)}
  @media(max-width:1050px){.home-closing-panel{grid-template-columns:1fr}.home-closing-visual{min-height:430px;border-top:1px solid rgb(15 62 23 / 10%);border-left:0}.home-closing-badges{margin-top:20px}.home-closing-visual :global(.management-panel-visual){width:88%;min-width:620px;margin-left:auto;transform:translate(28%,-5%)}.home-closing-phone{right:8%;bottom:-88px;width:230px}.home-footer-main{grid-template-columns:1fr}.home-footer-feature{max-width:720px}.home-footer-bottom{grid-template-columns:1fr auto}}
  @media(max-width:700px){.home-closing-cta{padding-inline:0}.home-closing-frame{border-radius:28px 28px 0 0;padding:40px 10px 0}.home-closing-panel{min-height:0;border-radius:21px 21px 0 0}.home-closing-copy{padding:45px 25px 38px}.home-closing-copy h2{font-size:47px}.home-closing-badges{gap:6px;padding-top:30px}.home-closing-badges li{min-height:34px;padding:0 11px;font-size:9px}.home-closing-visual{min-height:335px;padding-top:36px}.home-closing-visual :global(.management-panel-visual){width:610px;min-width:610px;transform:translate(10%,-4%) scale(.82);transform-origin:bottom right}.home-closing-phone{right:16px;bottom:-110px;width:172px;border-width:6px;border-radius:31px 31px 0 0;transform:scale(.92);transform-origin:bottom right}.home-closing-phone-list>article:last-child{display:none}.home-footer-shell{width:calc(100% - 28px);padding-top:65px}.home-footer-main{gap:50px;margin-top:48px}.home-footer-columns{grid-template-columns:1fr 1fr;gap:40px 25px}.home-footer-columns>div:last-child{grid-column:1 / -1}.home-footer-feature{min-height:410px;grid-template-columns:1fr}.home-footer-feature-copy{padding:28px}.home-footer-feature-copy h3{margin-top:24px}.home-footer-feature-copy b{margin-top:24px}.home-footer-preview{width:90%;height:175px;margin-left:auto}.home-footer-bottom{grid-template-columns:1fr;gap:18px;margin-top:70px}.home-footer-bottom nav{gap:13px}}
</style>
